# ── Build output / IDE ────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.rsuser

# Claude Code local session data
.claude/

# ── Local machine paths ───────────────────────────────────────────────
# Where this machine keeps the game's assemblies and its BepInEx folder.
# Directory.Build.props.example is the tracked template.
Directory.Build.props

# ── Local migration workspace ─────────────────────────────────────────
# ModForge is a generic toolkit. A specific mod's pack, and whatever is used
# to migrate its content across, stays on the machine doing the migrating --
# none of it is needed for the editor or the PackPlugin to build or run.
# Per-mod names for these live in .git/info/exclude, not here.
modpack BAK.json
# Tools/ used to be ignored wholesale. That took the build's own scripts with
# it: MakeArtThumbnails.py regenerates the art a release ships, the
# Tools/UnityEditor extractors are the only way to refresh the vanilla
# catalogs, and none of it existed anywhere but one machine. Tracked now.
__pycache__/
*.pyc
# One-off conversion / shader-analysis scratch scripts
_convert_*.py
_port_scenes.py
_render.py
extract_shader*.py
disasm_shader.py
shader_dump/

# Local scratch packs / manifest backups
# TestPack stays a local scratch workspace. The tutorial art that used to live
# here now ships with the editor from SMSModForge/Resources/TutorialAssets/ —
# tracked, because a tutorial whose sprites exist on one machine is no tutorial.
TestPack/
# ...and belt-and-braces: never track a manifest from the shipped asset folder,
# whatever ends up in there during testing.
SMSModForge/Resources/TutorialAssets/**/modpack.json
modpack - Copy.json
