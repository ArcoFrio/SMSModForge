<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0-windows + UseWPF because the tests drive the real MainViewModel,
      which lives in a WPF assembly. They never open a window: the view model
      constructs with no Application, which is what makes this possible at all.
    -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- For the test run's progress window only: see RunProgressWindow for
         why that one is not WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The editor's warnings are the editor's business. -->
    <NoWarn>$(NoWarn);CS8600;CS8602;CS8604;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Reads the editor's own source to find English that never reached the
         translation: a literal is only a text if the syntax around it says it
         is shown, which a pattern over lines cannot tell. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMSModForge\SMSModForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real UI rectangles out of the game, with the answers Unity gave. -->
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
