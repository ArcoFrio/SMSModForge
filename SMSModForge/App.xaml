<Application x:Class="SMSModForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:SMSModForge.View"
             xmlns:conv="clr-namespace:SMSModForge.View.Converters"
             xmlns:l="clr-namespace:SMSModForge.Localization"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <!--
            Theme colours. Every one is a DynamicResource the theme replaces:
            Services/ThemeManager.cs works them out from a theme's few colours
            (window, chrome, panel, box, text, ONE accent) and writes them here,
            and answers WPF's own system colours with them too, so even a
            template not re-made below draws in the theme rather than in the
            system's light greys.

            Every control that shows words is re-templated here (1.8.0): the
            defaults drew selection, borders, check boxes and scroll bars in
            fixed light colours, which under a dark theme's light words made a
            selected row white on white (the author, 2026-10-21). A local style
            in a window must be BasedOn these, or it falls back to the default
            look - TextBlock included.

            The values below are the Light theme's, so anything drawn before
            ThemeManager.Apply has run looks right.
        -->
        <SolidColorBrush x:Key="Theme.Window"        Color="#F3F3F3"/>
        <SolidColorBrush x:Key="Theme.Chrome"        Color="#E8E8E8"/>
        <SolidColorBrush x:Key="Theme.ChromeText"    Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.Surface"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Theme.SurfaceAlt"    Color="#F8F8F8"/>
        <SolidColorBrush x:Key="Theme.Control"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Theme.ControlBorder" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="Theme.Border"        Color="#D9D9D9"/>
        <SolidColorBrush x:Key="Theme.Hover"         Color="#F0F0F0"/>
        <SolidColorBrush x:Key="Theme.Text"          Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.TextMuted"     Color="#616161"/>
        <SolidColorBrush x:Key="Theme.TextDisabled"  Color="#8F8F8F"/>
        <SolidColorBrush x:Key="Theme.Heading"       Color="#0E3A63"/>
        <SolidColorBrush x:Key="Theme.AccentText"    Color="#0E3A63"/>
        <SolidColorBrush x:Key="Theme.Accent"        Color="#005FB8"/>
        <SolidColorBrush x:Key="Theme.AccentHover"   Color="#0054A2"/>
        <SolidColorBrush x:Key="Theme.AccentSoft"    Color="#D6E6F5"/>
        <SolidColorBrush x:Key="Theme.OnAccent"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Theme.Link"          Color="#005FB8"/>
        <SolidColorBrush x:Key="Theme.Button"        Color="#EBEBEB"/>
        <SolidColorBrush x:Key="Theme.ButtonHover"   Color="#C9D9EA"/>
        <SolidColorBrush x:Key="Theme.ButtonPressed" Color="#B1CBE5"/>
        <SolidColorBrush x:Key="Theme.ButtonBorder"  Color="#BFBFBF"/>
        <SolidColorBrush x:Key="Theme.ButtonText"    Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.Selection"     Color="#C2D9EF"/>
        <SolidColorBrush x:Key="Theme.SelectionText" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.SelectionInactive"     Color="#E6E6E6"/>
        <SolidColorBrush x:Key="Theme.SelectionInactiveText" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.TabActive"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Theme.TabActiveText"   Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.TabInactive"     Color="#E8E8E8"/>
        <SolidColorBrush x:Key="Theme.TabInactiveText" Color="#5C5C5C"/>
        <SolidColorBrush x:Key="Theme.TabHover"        Color="#DCDCDC"/>
        <SolidColorBrush x:Key="Theme.Danger"        Color="#C42B1C"/>
        <SolidColorBrush x:Key="Theme.Warning"       Color="#9A6700"/>
        <SolidColorBrush x:Key="Theme.Success"       Color="#2E7D32"/>
        <SolidColorBrush x:Key="Theme.WarningSoft"   Color="#F5EDE0"/>
        <SolidColorBrush x:Key="Theme.DangerSoft"    Color="#F9E9E8"/>
        <SolidColorBrush x:Key="Theme.Splitter"      Color="#D9D9D9"/>
        <SolidColorBrush x:Key="Theme.ScrollTrack"   Color="#EDEDED"/>
        <SolidColorBrush x:Key="Theme.ScrollThumb"   Color="#C2C2C2"/>
        <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#999999"/>
        <SolidColorBrush x:Key="Theme.ToolTip"       Color="#F8F8F8"/>
        <SolidColorBrush x:Key="Theme.ToolTipText"   Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.StatusBar"     Color="#E8E8E8"/>
        <SolidColorBrush x:Key="Theme.StatusBarText" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Theme.Markup"        Color="#2F5A81"/>
        <SolidColorBrush x:Key="Theme.MarkupBack"    Color="#E5EBF0"/>
        <SolidColorBrush x:Key="Theme.VanillaSurface" Color="#EEF3FA"/>
        <SolidColorBrush x:Key="Theme.ChangedSurface" Color="#D1E1F1"/>
        <!-- How strongly a speaker's colour washes a node row: less on a dark theme. -->
        <sys:Double x:Key="Theme.WashOpacity">1</sys:Double>

        <!-- ══ Small building blocks ══════════════════════════════════════ -->

        <!-- A formatting button over a dialogue line: small, flat, and not
             focusable. NOT focusable is the load-bearing part - a button that
             took focus would take the text box's selection with it, and the
             tag would land round nothing. -->
        <Style x:Key="Theme.MarkupButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" CornerRadius="3" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{DynamicResource Theme.MarkupBack}"/>
                                <Setter TargetName="Back" Property="BorderBrush"
                                        Value="{DynamicResource Theme.Markup}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{DynamicResource Theme.Markup}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A switch rather than a tick box, for a setting that changes how
             something LOOKS rather than what it does: the two states are two
             appearances, and a switch shows which one is on without reading. -->
        <Style x:Key="Theme.Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" CornerRadius="9"
                                    Background="{DynamicResource Theme.ControlBorder}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Theme.ControlBorder}"/>
                            <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Background="{DynamicResource Theme.Control}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource Theme.OnAccent}"/>
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Theme.ComboToggleButton" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Theme.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The page halves of a scroll bar or a slider: clickable, invisible. -->
        <Style x:Key="Theme.PageButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Theme.ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" CornerRadius="4" Background="{DynamicResource Theme.ScrollThumb}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ScrollThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The arrow that opens a tree row. -->
        <Style x:Key="Theme.TreeToggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16">
                            <Path x:Name="arrow" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Theme.TextMuted}"
                                  StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Menus ═══════════════════════════════════════════════════════ -->

        <ControlTemplate x:Key="Theme.MenuTopHeader" TargetType="MenuItem">
            <Grid>
                <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="8,3">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                       IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Theme.Chrome}" BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" Padding="2">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.TabHover}"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.TabHover}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="Theme.MenuSubItem" TargetType="MenuItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="check" Grid.Column="0" Width="16" Height="16" Margin="3" Visibility="Collapsed"
                            Background="{DynamicResource Theme.Accent}" CornerRadius="3">
                        <Path Data="M0,3 L2.5,6 L6,0" Stroke="{DynamicResource Theme.OnAccent}" StrokeThickness="1.6"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                      Margin="2,4" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                               Foreground="{DynamicResource Theme.TextMuted}"
                               Margin="16,4,8,4" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="Theme.MenuSubHeader" TargetType="MenuItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                      Margin="2,4" VerticalAlignment="Center"/>
                    <Path Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.4"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right" HorizontalOffset="-3"
                           IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" PopupAnimation="Fade">
                        <Border Background="{DynamicResource Theme.Chrome}" BorderBrush="{DynamicResource Theme.Border}"
                                BorderThickness="1" Padding="2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- A heading inside a menu: the Light and Dark of the Themes menu. -->
        <ControlTemplate x:Key="Theme.MenuHeading" TargetType="MenuItem">
            <TextBlock Text="{TemplateBinding Header}" Margin="8,6,8,2" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.TextMuted}"/>
        </ControlTemplate>
        <Style x:Key="Theme.MenuHeadingItem" TargetType="MenuItem">
            <!-- Stated here: the default menu item binds both to the list it
                 sits in, and a heading declared in the menu's own items has no
                 list until the menu opens - a broken binding in every window. -->
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{StaticResource Theme.MenuHeading}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="6,3"/>
        </Style>

        <!-- ══ Text ════════════════════════════════════════════════════════
             Plain labels follow the theme foreground. Elements that set an
             explicit Foreground keep it - a local value beats the implicit style;
             hints use Theme.TextMuted, never a fixed grey. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Link}"/>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource Theme.Window}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        </Style>

        <ControlTemplate x:Key="Theme.ToolTipTemplate" TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.ToolTipText}"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </Border>
        </ControlTemplate>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Theme.ToolTip}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ToolTipText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template" Value="{DynamicResource Theme.ToolTipTemplate}"/>
        </Style>

        <!-- ══ Boxes to type in ═══════════════════════════════════════════
             One look for every box: Display name and Priority used to differ.
             The border turns the accent while the box has the keyboard; a box
             that cannot be typed in sits back on the panel's own colour. -->
        <ControlTemplate x:Key="Theme.TextBoxTemplate" TargetType="TextBoxBase">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.TextMuted}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.SurfaceAlt}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Template" Value="{DynamicResource Theme.TextBoxTemplate}"/>
        </Style>

        <Style TargetType="RichTextBox" BasedOn="{StaticResource {x:Type RichTextBox}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Template" Value="{DynamicResource Theme.TextBoxTemplate}"/>
        </Style>

        <!-- ══ Dropdowns ═══════════════════════════════════════════════════ -->
        <ControlTemplate x:Key="Theme.ComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" Style="{StaticResource Theme.ComboToggleButton}"
                              ClickMode="Press"
                              Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="6,3,26,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                <!-- No style of its own: the box around it is the ComboBox's. -->
                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Hidden"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource Theme.Text}"
                         SelectionBrush="{DynamicResource Theme.Accent}"
                         Margin="4,3,26,3" VerticalAlignment="Center" Focusable="True"
                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <!-- PART_Popup: the name ComboBox itself looks its popup up by. -->
                <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                    <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="{DynamicResource Theme.Control}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="3"/>
                        <ScrollViewer SnapsToDevicePixels="True" Margin="1">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="DropDownBorder" Property="MinHeight" Value="28"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
                <Trigger Property="IsEditable" Value="True">
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <!-- Typing narrows the list to the names that contain what was
                 typed. Set here rather than at a hundred and twenty call sites:
                 it is meant to be how a dropdown behaves, not a feature an
                 author has to be handed. See View/ComboBoxSearch.cs. -->
            <Setter Property="view:ComboBoxSearch.Enabled" Value="True"/>
            <!-- Rows one under the other, with the likely picks on top when
                 the box is opened empty (View/DropDownSuggestions.cs). The
                 list is not sorted: other boxes share it. -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <view:SuggestionsPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ControlBorder}"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template" Value="{DynamicResource Theme.ComboTemplate}"/>
            <Style.Triggers>
                <!-- The default style this is based on switches an EDITABLE
                     dropdown to a template of its own, and its triggers beat the
                     setter above: every dropdown you can type in - Actor, Level,
                     Expression - was drawn white, with the theme's words on it. -->
                <Trigger Property="IsEditable" Value="True">
                    <Setter Property="Template" Value="{DynamicResource Theme.ComboTemplate}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A suggestion's mark, at the end of a dropdown row that is on top
             because of what the record being edited mentions
             (View/DropDownSuggestions.cs). Every row template carries one. -->
        <Style x:Key="SuggestionMark" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE734;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="ToolTip" Value="{l:T suggestions.mark.tip}"/>
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static view:SuggestedConverter.Instance}">
                        <Binding/>
                        <Binding Path="(view:DropDownSuggestions.Ranking)" RelativeSource="{RelativeSource Self}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="Theme.ComboItemTemplate" TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="2">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SuggestionMark}"/>
                    <ContentPresenter/>
                </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentSoft}"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <!-- Each row asks whether it answers to what was typed. Hiding the
                 container rather than filtering the collection is deliberate -
                 several dropdowns share one list, and a filter on it would
                 narrow all of them at once. -->
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static conv:SearchMatchConverter.Instance}">
                        <Binding Path="."/>
                        <!-- The typed text is BOUND, not read off the ComboBox
                             inside the converter: a value the converter fetches
                             for itself is one WPF has no reason to re-evaluate,
                             so the list would be decided once and never again. -->
                        <Binding Path="(view:ComboBoxSearch.Typed)"
                                 RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                        <Binding RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template" Value="{DynamicResource Theme.ComboItemTemplate}"/>
        </Style>

        <!-- ══ Lists and trees ═════════════════════════════════════════════
             A selected row is the accent's while its list has the keyboard,
             and a neutral tint after - both chosen against the theme's words,
             so a selected row can never be text on its own colour. -->
        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        </Style>
        <ControlTemplate x:Key="Theme.ListItemTemplate" TargetType="ListBoxItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True" CornerRadius="2">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.SelectionInactive}"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="Selector.IsSelectionActive" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Template" Value="{DynamicResource Theme.ListItemTemplate}"/>
        </Style>

        <Style TargetType="TreeView" BasedOn="{StaticResource {x:Type TreeView}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        </Style>
        <ControlTemplate x:Key="Theme.TreeItemTemplate" TargetType="TreeViewItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <ToggleButton x:Name="Expander" Style="{StaticResource Theme.TreeToggle}" ClickMode="Press"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Border x:Name="Bd" Grid.Column="1" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="2">
                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="False">
                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsSelectionActive" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SelectionInactive}"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsSelectionActive" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Template" Value="{DynamicResource Theme.TreeItemTemplate}"/>
        </Style>

        <!-- ══ Tick boxes and choices ══════════════════════════════════════ -->
        <ControlTemplate x:Key="Theme.CheckBoxTemplate" TargetType="CheckBox">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="box" Width="15" Height="15" CornerRadius="3" VerticalAlignment="Center"
                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Path x:Name="mark" Data="M2.5,6.5 L5.5,9.5 L10.5,3.5" StrokeThickness="2"
                              Stroke="{DynamicResource Theme.OnAccent}" Visibility="Collapsed"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Rectangle x:Name="dash" Width="7" Height="2" Fill="{DynamicResource Theme.OnAccent}"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <ContentPresenter x:Name="content" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasContent" Value="False">
                    <Setter TargetName="content" Property="Margin" Value="0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="box" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                    <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="box" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                    <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ControlBorder}"/>
            <Setter Property="Template" Value="{DynamicResource Theme.CheckBoxTemplate}"/>
        </Style>
        <ControlTemplate x:Key="Theme.RadioTemplate" TargetType="RadioButton">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="15" Height="15" VerticalAlignment="Center">
                    <Ellipse x:Name="ring" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                             StrokeThickness="1"/>
                    <Ellipse x:Name="dot" Width="7" Height="7" Fill="{DynamicResource Theme.OnAccent}"
                             Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter x:Name="content" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasContent" Value="False">
                    <Setter TargetName="content" Property="Margin" Value="0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Theme.Text}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ControlBorder}"/>
            <Setter Property="Template" Value="{DynamicResource Theme.RadioTemplate}"/>
        </Style>

        <!-- ══ Sliders and scroll bars ═════════════════════════════════════ -->
        <Style x:Key="Theme.SliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="knob" Width="14" Height="14" Fill="{DynamicResource Theme.Accent}"
                                 Stroke="{DynamicResource Theme.Control}" StrokeThickness="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Theme.AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="18" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Margin="7,0" VerticalAlignment="Center"
                                    Background="{DynamicResource Theme.ControlBorder}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Theme.PageButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Theme.SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Theme.PageButton}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim, in the theme's own greys: the default bars were light grey on
             every theme, a pale stripe down every dark window. -->
        <ControlTemplate x:Key="Theme.VerticalScrollBar" TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Theme.PageButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource Theme.ScrollThumbStyle}" Margin="3,2"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Theme.PageButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="Theme.HorizontalScrollBar" TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Theme.PageButton}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource Theme.ScrollThumbStyle}" Margin="2,3"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Theme.PageButton}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource Theme.ScrollTrack}"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template" Value="{DynamicResource Theme.VerticalScrollBar}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template" Value="{DynamicResource Theme.HorizontalScrollBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource Theme.Splitter}"/>
        </Style>

        <!-- ══ Buttons ═════════════════════════════════════════════════════
             A fill of their own and a border, so a button reads as a button on
             every panel (they used to be the panel's own colour); the accent on
             the way over and in. -->
        <ControlTemplate x:Key="Theme.ButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Button}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ButtonText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ButtonBorder}"/>
            <!-- Centred by default, as a button should be — but stated here so
                 the template below can template-bind it. Hardcoding the
                 alignment in the ContentPresenter instead made
                 HorizontalContentAlignment a no-op on every button in the app,
                 which is how the preview's hierarchy rows ended up centred with
                 their indentation collapsed. -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{DynamicResource Theme.ButtonTemplate}"/>
        </Style>

        <!-- A button that stays in. Off, it is a button; on, it takes the
             accent and the accent's own text colour, so the one in use reads
             at a glance. Toggles had no look of their own until after 1.8.0:
             they got Windows' light grey and light blue with the theme's text
             on top - the mask editor's Brush and Eraser, light on light in
             every dark theme. The words follow the button's colour: the app's
             own text colour would win over it otherwise. -->
        <ControlTemplate x:Key="Theme.ToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentHover}"/>
                </MultiTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Button}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ButtonText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ButtonBorder}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template" Value="{DynamicResource Theme.ToggleButtonTemplate}"/>
        </Style>

        <!-- A picture to pick - a line's outfit or face (MainWindow's
             PictureTile): a thick border the accent marks the chosen one with. -->
        <ControlTemplate x:Key="Theme.TileTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="2" CornerRadius="5" Padding="{TemplateBinding Padding}"
                    TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>

        <!-- The one thing a window is for - Save in a prompt: the accent's. -->
        <ControlTemplate x:Key="Theme.PrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentHover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Theme.PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            <Setter Property="Template" Value="{DynamicResource Theme.PrimaryButtonTemplate}"/>
        </Style>

        <!-- ══ Tabs ════════════════════════════════════════════════════════
             The open tab is the panel's colour under an accent bar, in words
             of full strength; the others sit back in the strip (the author,
             2026-10-21: under Midnight you could not tell which tab was open). -->
        <ControlTemplate x:Key="Theme.TabTemplate" TargetType="TabItem">
            <Grid Margin="1,0,0,0">
                <Border x:Name="bd" Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Theme.Border}"
                        BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="9,4">
                    <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="bar" Height="3" VerticalAlignment="Top" CornerRadius="2,2,0,0"
                        Background="Transparent"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.TabActive}"/>
                    <Setter TargetName="bar" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TabActiveText}"/>
                    <Setter Property="Panel.ZIndex" Value="1"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="False"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.TabHover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Theme.TabActiveText}"/>
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Theme.TabInactiveText}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.TabInactive}"/>
            <Setter Property="Template" Value="{DynamicResource Theme.TabTemplate}"/>
        </Style>

        <!-- ── The ModForge landing tab ──────────────────────────────────
             Marked out from the content tabs - it is the app's home (issues and
             help), not a unit editor: a soft accent tint and the heading colour,
             and like every tab, the panel's colour under an accent bar when open. -->
        <Style x:Key="HomeTabItem" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Heading}"/>
            <Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Window}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        </Style>
        <!-- The window's own tabs: as any tab control here. EX puts them in a
             rail down the side (View/Themes/Ex.xaml). -->
        <Style x:Key="Theme.MainTabs" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"/>

        <!-- ── Menu / status chrome ─────────────────────────────────────
             The bar plus the dropdown items are themed so the leaked light
             foreground stays readable (a menu item's Background fills its row). -->
        <Style TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Chrome}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ChromeText}"/>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ChromeText}"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource Theme.MenuTopHeader}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource Theme.MenuTopHeader}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource Theme.MenuSubHeader}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource Theme.MenuSubItem}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- A themed background alone was not enough. The stock ContextMenu
             template paints its own icon gutter inside the popup, about 28px
             wide and in a system colour of its own, and the themed MenuItem
             template reserves 22 for the tick — so the band overhung the start
             of every label. The popup gets the same simple template the submenu
             popups already use: a themed border round the items, nothing else. -->
        <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Chrome}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ChromeText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Theme.Border}"
                                BorderThickness="1" Padding="2" CornerRadius="3">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The status bar: the bars' colour in Normal; the accent's in EX
             (ThemeManager.KeyStatusBar), its words with it. -->
        <Style TargetType="StatusBar" BasedOn="{StaticResource {x:Type StatusBar}}">
            <Setter Property="Background" Value="{DynamicResource Theme.StatusBar}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.StatusBarText}"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource Theme.StatusBarText}"/>
                </Style>
            </Style.Resources>
        </Style>
        <!--
            IsFocusScope="False" is the load-bearing setter here, not the colours.

            A ToolBar is a focus scope by default, and a focus scope hands focus
            BACK when you are done with it: at the end of a click on a toolbar
            button, WPF returns keyboard focus to whatever the enclosing scope
            last remembered, so a toolbar never keeps focus away from the
            document. That is the right behaviour for a word processor. Here the
            enclosing scope is the window, and what the window remembers after
            you click a tab header is the TabItem - so the click ended by
            focusing a tab header, and a TabItem that receives focus SELECTS
            itself.

            The result was the editor jumping to another tab when you pressed
            + Rule, + Variable, or any other list toolbar button: not the tab
            you were on, but whichever one the window still remembered. It only
            happened when that memory had gone stale against the tab actually
            showing, which is why it came and went.

            Every one of these toolbars sits above a unit list inside a tab.
            None of them wants to give focus back anywhere - the buttons carry
            ordinary bound commands, not RoutedCommands that need a target - so
            the scope buys nothing and costs that. Without it a click leaves
            focus on the button it landed on, like any other button.
        -->
        <Style TargetType="ToolBar" BasedOn="{StaticResource {x:Type ToolBar}}">
            <Setter Property="FocusManager.IsFocusScope" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- No grip, and the overflow tab only when something has
                         overflowed: the default drew both in system white. -->
                    <ControlTemplate TargetType="ToolBar">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ToggleButton x:Name="OverflowButton" DockPanel.Dock="Right" Width="18" Visibility="Collapsed"
                                              Style="{StaticResource Theme.ComboToggleButton}" ClickMode="Press"
                                              Background="{DynamicResource Theme.Button}" BorderBrush="{DynamicResource Theme.ButtonBorder}"
                                              IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Popup x:Name="OverflowPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=OverflowButton}"
                                       IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True" StaysOpen="False" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource Theme.Chrome}" BorderBrush="{DynamicResource Theme.Border}"
                                            BorderThickness="1" Padding="2" CornerRadius="3">
                                        <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="200"
                                                              KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                                <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasOverflowItems" Value="True">
                                <Setter TargetName="OverflowButton" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact, so a list's buttons fit its narrow panel rather than
             spilling into the overflow menu. -->
        <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="1,1"/>
        </Style>
        <Style x:Key="{x:Static ToolBar.ComboBoxStyleKey}" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
        <Style x:Key="{x:Static ToolBar.TextBoxStyleKey}" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
        <Style x:Key="{x:Static ToolBar.CheckBoxStyleKey}" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
        <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolBarTray" BasedOn="{StaticResource {x:Type ToolBarTray}}">
            <Setter Property="Background" Value="{DynamicResource Theme.Chrome}"/>
        </Style>

        <!-- ══ Groups ══════════════════════════════════════════════════════
             A card: the panel's colour inside a rounded border, its title above
             the content in the heading colour. The default group drew a white
             inner edge on every theme - a light outline round every group under
             a dark one. -->
        <ControlTemplate x:Key="Theme.GroupTemplate" TargetType="GroupBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                <DockPanel>
                    <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" RecognizesAccessKey="True"
                                      Margin="8,5,8,0" TextElement.FontWeight="SemiBold"
                                      TextElement.Foreground="{DynamicResource Theme.Heading}">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Theme.Heading}"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </DockPanel>
            </Border>
        </ControlTemplate>
        <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template" Value="{DynamicResource Theme.GroupTemplate}"/>
        </Style>

        <!-- ══ Expanders ═══════════════════════════════════════════════════ -->
        <Style x:Key="Theme.ExpanderHeader" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" Padding="2,2" CornerRadius="3">
                            <DockPanel>
                                <Path x:Name="arrow" DockPanel.Dock="Left" Data="M0,0 L4,4 L0,8" Margin="2,0,8,0"
                                      Stroke="{DynamicResource Theme.TextMuted}" StrokeThickness="1.4"
                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform>
                                </Path>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="arrow" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="90"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="Theme.ExpanderTemplate" TargetType="Expander">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Top" Style="{StaticResource Theme.ExpanderHeader}"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <ContentPresenter x:Name="content" Visibility="Collapsed" Margin="{TemplateBinding Padding}"/>
            </DockPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="content" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
            <Setter Property="Template" Value="{DynamicResource Theme.ExpanderTemplate}"/>
        </Style>

        <!--
            Historical note (kept from the original light-only theme): every
            left-hand record list and each shared option combo binds to a
            collection's default ICollectionView, so leaving
            IsSynchronizedWithCurrentItem at its WPF default made selectors on
            different tabs fight over the shared CurrentItem (adding a Map
            Button once yanked the editor to the Places tab). The ListBox /
            ComboBox styles above set it False, severing that coupling with no
            behavioural loss since every selector uses an explicit
            SelectedItem / SelectedValue binding.
        -->
    </Application.Resources>
</Application>
