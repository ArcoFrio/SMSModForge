<Window x:Class="SMSModForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SMSModForge.ViewModel"
        xmlns:ctl="clr-namespace:SMSModForge.View.Controls"
        xmlns:conv="clr-namespace:SMSModForge.View.Converters"
        xmlns:view="clr-namespace:SMSModForge.View"
        xmlns:model="clr-namespace:SMSModForge.Model"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="{Binding Title}"
        Icon="Resources/SMSModForge.ico"
        Width="1400" Height="900"
        Background="{DynamicResource Theme.Window}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!--
            Visibility converters for the Integration tab's picker /
            code mode toggle. BoolToVisibility shows when bound flag
            is true; the inverse hides on true. Both are reused
            anywhere we want a layout-collapsing show/hide tied to a
            boolean property (avoids the gap left by WPF's built-in
            converter which only sets Hidden).
        -->
        <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter             x:Key="InverseBoolConverter"/>

        <!--
            Implicit DataTemplate for NavigatorTargetOption: WPF picks
            this up wherever a NavigatorTargetOption is rendered (combo
            dropdown items, closed-state SelectedItem in non-IsEditable
            combos). Pairs with NavigatorTargetOption.ToString() returning
            Token: with no DisplayMemberPath the combo's Text falls back
            to ToString(), so SelectedValue + Text both round-trip the
            same Token to the bound property — without this, the Text
            binding would clobber SelectedValue with the display label.
        -->
        <DataTemplate DataType="{x:Type vm:NavigatorTargetOption}">
            <TextBlock Text="{Binding DisplayLabel}"/>
        </DataTemplate>

        <!--
            Compact position / rotation / scale editor for one NpcTransformViewModel
            (a placed NPC part: body / shadow / blink / wet). Three labelled rows of
            three boxes. Shared by every part row in the Places placement editor, and
            the surface the Phase-3 transform gizmo drives through the same VM.
        -->
        <DataTemplate x:Key="NpcTransformEditor" DataType="{x:Type vm:NpcTransformViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Pos" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                    <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="52" ToolTip="Position X"/>
                    <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="Position Y"/>
                    <TextBox Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="Position Z"/>
                </StackPanel>

                <TextBlock Text="Rot" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0">
                    <TextBox Text="{Binding RotX, UpdateSourceTrigger=PropertyChanged}" Width="52" ToolTip="Rotation X"/>
                    <TextBox Text="{Binding RotY, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="Rotation Y"/>
                    <TextBox Text="{Binding RotZ, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="Rotation Z"/>
                </StackPanel>

                <TextBlock Text="Scale" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="0,2,0,0">
                    <TextBox Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}" Width="52" ToolTip="Scale X (negative mirrors)"/>
                    <TextBox Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="Scale Y"/>
                    <TextBox Text="{Binding ScaleZ, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="Scale Z"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Shared unit folder trees (Actors/Places/Scenes/Wallpapers/Music/SFX):
             one implicit template pair + one container style reused by every
             tree, so the six tabs carry no per-tree markup beyond the TreeView. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:UnitFolderNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:UnitLeafNode}">
            <TextBlock Text="{Binding DisplayText}"/>
        </DataTemplate>
        <Style x:Key="UnitTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Background" Value="#5578A8E0"/>
                </DataTrigger>
                <!-- Sidebar search: rows the filter excludes collapse away. The
                     tree itself is untouched, so selection / drag-drop survive. -->
                <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar search box. DataContext is the tab's UnitTreeController;
             the ✕ clears without reaching for the keyboard. -->
        <ControlTemplate x:Key="SidebarSearchTemplate">
            <Grid Margin="2,2,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         ToolTip="Filter this list. Matches folder names and item names; folders stay visible when something inside them matches."/>
                <TextBlock Grid.Column="0" Text="Search…" Foreground="Gray" Margin="4,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center"
                           Visibility="{Binding HasFilter, Converter={StaticResource InverseBoolToVisibility}}"/>
                <Button Grid.Column="1" Content="✕" Margin="2,0,0,0" Padding="4,0" MinWidth="0"
                        Command="{Binding ClearFilterCommand}"
                        Visibility="{Binding HasFilter, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Clear the search"/>
            </Grid>
        </ControlTemplate>

        <!--
            ════════════════════════════════════════════════════════════
            Schema-driven typed param-row templates.

            Each template renders ONE row inside an action or condition's
            ParamRows list: a label (the schema's friendly Label) and one
            typed editor control (TextBox / CheckBox / ComboBox bound to
            the matching option list on MainViewModel). Templates are
            mounted into the row by ParamTypeTemplateSelector below; the
            two row templates (ActionRowTemplate, ConditionRowTemplate)
            host the selector inside an ItemsControl over ParamRows so a
            user changing the action / condition type sees the editor
            shape swap automatically.

            All the ComboBox-based templates stay IsEditable=True so the
            user can type a token that isn't yet in the underlying list
            (e.g. a vanilla GO name not declared on this pack), exactly
            like the previous hand-written specialised editors did.
            ════════════════════════════════════════════════════════════
        -->

        <!-- Reusable label+control row geometry. Each typed template
             repeats this Grid skeleton so the param-row column widths
             stay aligned across the whole list. -->
        <Style x:Key="ParamRowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <!-- Rows whose schema declares an EnabledWhen dependency grey out
                 (label included) when the controlling param isn't in the right
                 state — e.g. the Timer condition's Min/Max until Randomize is
                 checked, and its fixed Wait once it is. Every typed template
                 roots on this Grid, so gating here covers them all. Rows with
                 no dependency report IsEnabled = true and are unaffected. -->
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
        </Style>

        <DataTemplate x:Key="StringParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Bool → CheckBox. The CheckBox content is the schema label
             so the row is one line; we still use the same Grid skeleton
             so the controls align with the other typed rows. -->
        <DataTemplate x:Key="BoolParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <CheckBox  Grid.Column="1"
                           IsChecked="{Binding BoolValue}"
                           ToolTip="{Binding Tooltip}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Int / Float share the same template: a plain TextBox bound
             to Value as a string. The runtime parses with invariant
             culture, so the user can type either "3" or "3.14" and the
             editor just stores the literal string. -->
        <DataTemplate x:Key="IntParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Percent → whole number + a trailing "%" so the field reads as
             "30 %" rather than "0.3". The stored value is the bare number;
             the runtime divides by 100. The box is fixed to ~3 digits and
             the trailing column soaks up the slack, so the field doesn't
             stretch across the row for a value that can never exceed 100. -->
        <DataTemplate x:Key="PercentParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1" Width="42" MaxLength="3"
                          HorizontalAlignment="Left" HorizontalContentAlignment="Right"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"
                           FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FloatParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- PackVarRef → combobox bound to VariableNameOptions. All ref
             combos share this shape: ItemsSource via RelativeSource
             AncestorType=Window so the option list is resolved against
             the MainViewModel even though the row's DataContext is the
             ParamRowViewModel. IsEditable+Text bound to Value gives the
             "pick from list or type your own" semantics. -->
        <DataTemplate x:Key="PackVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.VariableNameOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ListVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ListVariableNameOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- BoolVarRef: variable reference that renders as True/False radio buttons
             when the variable is boolean. Falls back to the standard variable dropdown
             for non-boolean variables. -->
        <DataTemplate x:Key="BoolVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- When IsBooleanVariable is true, show radio buttons; otherwise fall through to
                     the PackVarRef dropdown. The radio panel is collapsed when the variable is not boolean. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBooleanVariable, Converter={StaticResource BoolToVisibility}}">
                    <RadioButton Content="True" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                 ToolTip="Set variable to true"/>
                    <RadioButton Content="False" IsChecked="{Binding BoolValue, Mode=TwoWay, Converter={StaticResource InverseBoolConverter}}"
                                 VerticalAlignment="Center"
                                 ToolTip="Set variable to false"/>
                </StackPanel>
                <!-- Fallback: variable dropdown when the variable is not boolean -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding DataContext.VariableNameOptions,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          IsEditable="True"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"
                          Visibility="{Binding IsBooleanVariable, Converter={StaticResource InverseBoolToVisibility}}"/>
            </Grid>
        </DataTemplate>

        <!-- GameVarRef stays free-text; no GC2-globals enumeration is
             available offline so we don't pretend to have a dropdown. -->
        <DataTemplate x:Key="GameVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LevelRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.LevelOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActorRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ActorOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- BustRef binds to ActorBustOptions — the actor-grouped list
             that pairs each actor with its declared default-bust GO
             name. Token-based SelectedValuePath so picking an entry
             writes the bust GO, not the display label. -->
        <DataTemplate x:Key="BustRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ActorBustOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExpressionRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ExpressionKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SceneRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.SceneOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Signal names are open-ended — same shape as GameVarRef. -->
        <!-- SignalRef → editable ComboBox: autocompletes the known GC2 signal
             vocabulary (KnownSignals, sourced from the host mod) while still
             letting the author type any custom signal name. -->
        <!-- SpriteRef: a pack-relative PNG. PathPickerBox is the same control
             the Places and Characters tabs use, so browsing stores the path
             relative to the pack root rather than an absolute one. -->
        <DataTemplate x:Key="SpriteRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ctl:PathPickerBox Grid.Column="1"
                                   PathText="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                   PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                   ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SignalRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           IsEditable="True"
                           ItemsSource="{Binding DataContext.SignalOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MusicRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.MusicKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SfxRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.SfxKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- GameObjectPath → editable ComboBox: autocompletes the pack's own
             named GameObjects (overlays, outfit busts) while still letting the
             author type any vanilla GO name or full hierarchy path. -->
        <DataTemplate x:Key="GameObjectPathParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           IsEditable="True"
                           FontFamily="Consolas"
                           ItemsSource="{Binding DataContext.GameObjectNameOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Fixed-choice dropdown: options come from the schema itself
             (ParamSchema.FixedOptions), not a MainViewModel list. Non-editable
             so the stored value is always one of the declared options. -->
        <DataTemplate x:Key="ChoiceParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding FixedOptions}"
                           SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Shared selector instance. ParamRowsItemsControl below
             references this via StaticResource so we don't duplicate
             the 16-template list inline. -->
        <view:ParamTypeTemplateSelector x:Key="ParamTypeTemplateSelector"
                                        StringTemplate="{StaticResource StringParamTemplate}"
                                        BoolTemplate="{StaticResource BoolParamTemplate}"
                                        IntTemplate="{StaticResource IntParamTemplate}"
                                        FloatTemplate="{StaticResource FloatParamTemplate}"
                                        PercentTemplate="{StaticResource PercentParamTemplate}"
                                        PackVarRefTemplate="{StaticResource PackVarRefParamTemplate}"
                                        ListVarRefTemplate="{StaticResource ListVarRefParamTemplate}"
                                        BoolVarRefTemplate="{StaticResource BoolVarRefParamTemplate}"
                                        GameVarRefTemplate="{StaticResource GameVarRefParamTemplate}"
                                        LevelRefTemplate="{StaticResource LevelRefParamTemplate}"
                                        ActorRefTemplate="{StaticResource ActorRefParamTemplate}"
                                        BustRefTemplate="{StaticResource BustRefParamTemplate}"
                                        ExpressionRefTemplate="{StaticResource ExpressionRefParamTemplate}"
                                        SceneRefTemplate="{StaticResource SceneRefParamTemplate}"
                                        SignalRefTemplate="{StaticResource SignalRefParamTemplate}"
                                        MusicRefTemplate="{StaticResource MusicRefParamTemplate}"
                                        SfxRefTemplate="{StaticResource SfxRefParamTemplate}"
                                        GameObjectPathTemplate="{StaticResource GameObjectPathParamTemplate}"
                                          SpriteRefTemplate="{StaticResource SpriteRefParamTemplate}"
                                        ChoiceTemplate="{StaticResource ChoiceParamTemplate}"/>

        <!--
            Shared row template for every list of NodeConditionViewModel
            (dialogue-start conditions and per-node conditions). One row
            renders:
              · a minus button driven by NodeConditionViewModel.RemoveCommand
                (CanExecute is false for IsLocked rows — the pinned
                LevelActive condition is locked, so its row stays put);
              · the Type combo (disabled on locked rows via IsTypeEditable);
              · the Negate checkbox;
              · an ItemsControl over ParamRows that picks a typed editor
                template per param via ParamTypeTemplateSelector. The
                schema for each condition type lives in
                ConditionSchemas.ByType.
        -->
        <DataTemplate x:Key="LeafConditionTemplate" DataType="{x:Type vm:NodeConditionViewModel}">
            <!-- The pinned LevelActive row is styled apart from the ordinary
                 ones: it is required rather than chosen, so it reads as part of
                 the dialogue's identity instead of one condition among many. -->
            <Border BorderThickness="1" CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="LightGray"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF6A8CAF"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#146A8CAF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Required — this dialogue only starts in this level"
                               FontWeight="SemiBold" Foreground="#FF3E6084"
                               Margin="0,0,0,4" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Header row: Type combo + Remove button. The Type
                         combo is disabled when IsTypeEditable is false
                         (locked LevelActive row). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <!-- Per-row list, not a global one: rows in a one-shot host
                             (dialogue node conditions, level hooks) also offer the
                             single-roll Random gate, which would be meaningless in
                             a per-frame-polled host. -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableTypes}"
                                  SelectedItem="{Binding DisplayType, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsTypeEditable}"
                                  ToolTip="The pinned LevelActive start-condition can't change type — edit its level instead."/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="Copy this condition to the clipboard"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="Remove this condition"/>
                        </StackPanel>
                    </Grid>
                    <!-- Negate is meaningless on the pinned row: "not in this
                         level" would leave the dialogue with no level at all,
                         and the runtime resolves its roomtalk from this token. -->
                    <CheckBox Content="Negate" IsChecked="{Binding Negate}" Margin="110,2,0,2"
                              ToolTip="Inverts this condition's result before it combines with the surrounding list.">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <!-- Schema-driven param rows. ItemsSource is the
                         ParamRows collection on the condition VM; the
                         template selector swaps in a typed editor per
                         ParamType. An empty ParamRows list (e.g.
                         AlwaysTrue) leaves the ItemsControl empty,
                         which collapses to zero height naturally. -->
                    <ItemsControl ItemsSource="{Binding ParamRows}"
                                  ItemTemplateSelector="{StaticResource ParamTypeTemplateSelector}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- Category + Target for GameObjectActive — the same row the
                         Set-Active action uses, because the condition asks about exactly
                         what that action sets. Category swaps the Target autocomplete;
                         GameObjects resolves the object inside the chosen Level. -->
                    <Grid Margin="0,2,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoActiveFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.GoCategories}"
                                  SelectedItem="{Binding GoCategory, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="How the target resolves: a bust, a GameObject inside a level, a scene, or a raw GO name/path. Asking whether a whole level is on screen is what LevelActive is for."/>

                        <!-- Level (GameObjects category only). Without it the lookup is
                             global, so a same-named object in the level being left can
                             answer for the one being entered. -->
                        <TextBlock Text="Level" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoOverlayCategory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- No DisplayMemberPath: the implicit NavigatorTargetOption template
                             shows the friendly label while ToString() (= Token) is what lands
                             in the edit box — see NavigatorTargetOption's class comment. -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding GoOverlayLevelOptions}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Which level the object lives in — only levels with authored GameObjects are listed. The Target dropdown follows this choice and stays disabled until one is chosen.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoOverlayCategory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="Target" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  IsEnabled="{Binding IsGoTargetEnabled}"
                                  Text="{Binding GoTarget, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Autocompletes from the selected Category; stays editable so any GO name/path works. An object that cannot be found reads as switched off.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <!-- default: Direct Path → all pack-named GOs -->
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.GameObjectNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="GameObjects">
                                            <Setter Property="ItemsSource" Value="{Binding GoOverlayOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Scene">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.SceneKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>

                    <!-- Unified Variable editor. Source picks Pack (per-pack store) vs
                         Vanilla (a GC2 global from the 1.8E catalog); the Name list follows
                         the Source. Comparison maps to the underlying Variable* type. -->
                    <Grid Margin="0,2,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Source" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarSource, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Pack = this pack's own variable; Vanilla = an existing 1.8E game variable."/>

                        <TextBlock Text="Comparison" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.VariableComparisons}"
                                  SelectedItem="{Binding VarComparison, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Name" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  Text="{Binding VarName, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.VariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaSource}" Value="True">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.VanillaGameVariableOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="Value" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowVariableValue}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarValue, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VarValueIsText}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- A Bool has exactly two values, and typing them is
                             where this goes wrong: True / TRUE / 1 / yes all
                             look right and none of them match. -->
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                  VerticalAlignment="Center" Content="is true"
                                  IsChecked="{Binding VarValueBool}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VarValueIsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            Group condition (parentheses): AND/OR over nested children. The
            inner ItemsControl re-uses ConditionTemplateSelector (via
            DynamicResource, since the selector is declared just below this
            template), so groups nest arbitrarily. "NOT (invert group)" maps
            to Negate, giving !( … ). Created via the "Add group" buttons; the
            mode combo flips AND↔OR.
        -->
        <DataTemplate x:Key="GroupConditionTemplate" DataType="{x:Type vm:NodeConditionViewModel}">
            <Border BorderBrush="#FF6F9BE8" BorderThickness="1.5"
                    CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Match" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <ComboBox  Grid.Column="1" Width="160"
                                   ItemsSource="{x:Static vm:NodeConditionViewModel.GroupModeOptions}"
                                   SelectedIndex="{Binding GroupModeIndex}"
                                   ToolTip="AND = every child must pass; OR = at least one child must pass."/>
                        <CheckBox  Grid.Column="2" Content="NOT (invert group)"
                                   IsChecked="{Binding Negate}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   ToolTip="Inverts the whole group — your parentheses-NOT."/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="Copy this group (with its children) to the clipboard"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}" ToolTip="Remove this group"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                        <Button Content="+ condition" Padding="6,1" Margin="0,0,4,0"
                                Command="{Binding AddLeafCommand}"/>
                        <Button Content="+ group" Padding="6,1"
                                Command="{Binding AddGroupCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Children}" Margin="14,0,0,0"
                                  ItemTemplateSelector="{DynamicResource ConditionTemplateSelector}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Leaf vs group selector; the recursion entry point. Declared after
             both templates so it references them via StaticResource. -->
        <view:ConditionTemplateSelector x:Key="ConditionTemplateSelector"
                                        LeafTemplate="{StaticResource LeafConditionTemplate}"
                                        GroupTemplate="{StaticResource GroupConditionTemplate}"/>

        <!--
            ActionRow template: type combo on top, then a params editor
            whose shape depends on Type. The generic key=value TextBox
            is the default; the four bust/expression-related action
            types swap it out for typed dropdowns so authors aren't
            typing GO names from memory:

              · LeaveBust            → Actor combo only

            Visibility flips happen via DataTrigger Setters inside each
            control's Style (not local Visibility attributes — see
            LevelActive in ConditionRowTemplate for the same pattern
            and the WPF precedence reason).
        -->
        <!--
            ActionRow template: type combo on top, then schema-driven
            ParamRows. Each NodeActionViewModel exposes ParamRows built
            from ActionSchemas.For(Type), and the ItemsControl below
            renders each row with the per-ParamType template selected
            by ParamTypeTemplateSelector. Action types with no params
            (DeactivateAllScenes) collapse the ItemsControl
            to zero height naturally.
        -->
        <DataTemplate x:Key="ActionRowTemplate" DataType="{x:Type vm:NodeActionViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DataContext.ActionTypes,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DisplayType, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="Copy this action to the clipboard"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="Remove this action"/>
                        </StackPanel>
                    </Grid>
                    <!-- Category + Target for GameObject-targeting actions (Fade / Move / Spin).
                         Additive — the action's own params (alpha, x/y, speed…) still show in
                         ParamRows below. The Target list follows the Category, and Level Overlay
                         resolves the overlay inside the chosen level. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoCategoryFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.GoCategories}"
                                  SelectedItem="{Binding GoCategory, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="How the target resolves: a plain GO path, an overlay inside a level, a whole level, or a bust."/>

                        <TextBlock Text="Level" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoOverlayCategory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Only levels that actually carry GameObjects — pack
                             places and vanilla extensions alike. Still editable so a
                             not-yet-authored level token can be typed. -->
                        <!-- No DisplayMemberPath: the implicit NavigatorTargetOption
                             template shows the friendly label in the dropdown, while
                             ToString() (= Token) is what lands in the edit box — with
                             DisplayMemberPath the Text binding would write the label
                             into the param and break selection + the strict target
                             list (see NavigatorTargetOption's class comment). -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding GoOverlayLevelOptions}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Which level the GameObject lives in — only levels with authored GameObjects are listed. The Target dropdown stays disabled until one is chosen.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoOverlayCategory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="Target" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <!-- IsEnabled: for GameObjects the target list is
                             level-scoped, so the combo stays disabled until a
                             Level is chosen above (always enabled otherwise). -->
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  IsEnabled="{Binding IsGoOverlayTargetEnabled}"
                                  Text="{Binding GoTarget, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.GameObjectNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="GameObjects">
                                            <Setter Property="ItemsSource" Value="{Binding GoOverlayOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Places">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.LevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="DisplayMemberPath" Value="Token"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>

                    <!-- Generic schema-driven params.
                         Hidden wholesale only for the Variable family, which has its
                         own editor below. The Set-Active family used to be hidden here
                         too — which silently swallowed SetSprite's Sprite and Mask
                         fields, since they are declared on the schema and nowhere
                         else. RebuildParamRows now drops just the keys the category
                         row already draws, so this collection is empty for
                         SetGameObjectActive and holds exactly the extra fields for
                         SetSprite. -->
                    <ItemsControl ItemsSource="{Binding ParamRows}"
                                  ItemTemplateSelector="{StaticResource ParamTypeTemplateSelector}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- Unified Variable editor (SetVariable + IncrementVariable). Source
                         picks Pack (per-pack store) vs Vanilla (a GC2 global from the 1.8E
                         catalog); the Name list follows the Source. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Source (Pack/Vanilla) — not used by Random-from-list. -->
                        <TextBlock Text="Source" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsRandomFromList, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarSource, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsRandomFromList, Converter={StaticResource InverseBoolToVisibility}}"
                                  ToolTip="Pack = this pack's own variable; Vanilla = an existing 1.8E game variable."/>

                        <TextBlock Text="Operation" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.VariableOperations}"
                                  SelectedItem="{Binding VarOperation, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Name"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Text" Value="Target"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  Text="{Binding VarName, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.VariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaSource}" Value="True">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.VanillaGameVariableOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Value"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Text" Value="Delta"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarValue, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VarValueIsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- Same reasoning as the condition row: a Bool takes
                             one of two values and typing them is where it goes
                             wrong. -->
                        <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                  VerticalAlignment="Center" Content="set to true"
                                  IsChecked="{Binding VarValueBool}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VarValueIsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarDelta, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- From list (Random-from-list only): a List variable name or a CSV literal. -->
                        <TextBlock Text="From list" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsRandomFromList, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.ListVariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding VarFromList, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsRandomFromList, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="A List variable to pick a random element from (or a comma-separated literal like A,B,C). The picked value lands in Target."/>

                        <!-- Excluding / If-none-left: pick-only (List count has no
                             candidate set to filter). '$name' reads a variable. -->
                        <TextBlock Text="Excluding" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.ListVariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding VarExcluding, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Optional. Entries removed from 'From list' before picking — prefix with $ to read a List variable, e.g. $HarborHome_Occupied. This is how you claim a slot nobody else holds."/>

                        <TextBlock Text="If none left" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarFallback, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="Value written to Target when 'From list' is empty or everything was excluded — an overflow destination with unlimited capacity. '$name' reads a variable. Blank clears Target."/>
                    </Grid>
                    <!-- Unified Set-Active editor (SetGameObjectActive + ActivateScene folded
                         into one row). A Category dropdown swaps the Target autocomplete:
                         Bust / Level Overlay (filtered to the node's level) / Scene / Direct Path. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetActiveFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <!-- Per-row list, not the static one: Set-Active and SetSprite
                             share this row but not the same choices (only SetSprite
                             offers Places). -->
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="How the target resolves. Changes the Target dropdown below; Scene routes through the pack's scene registry (and plays its authored sound when activated). Places addresses a whole level by its place token."/>

                        <!-- Level (Level Overlay category only): which level the overlay
                             lives in. Set it to the level you're transitioning INTO so the
                             runtime resolves the overlay there, not in the previous level.
                             The Target list below follows this choice. -->
                        <TextBlock Text="Level" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="GameObjects">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Only levels that actually carry GameObjects — pack
                             places and vanilla extensions alike. Still editable so a
                             not-yet-authored level token can be typed. -->
                        <!-- No DisplayMemberPath: the implicit NavigatorTargetOption
                             template shows the friendly label in the dropdown, while
                             ToString() (= Token) is what lands in the edit box — with
                             DisplayMemberPath the Text binding would write the label
                             into the param and break selection + the strict target
                             list (see NavigatorTargetOption's class comment). -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding OverlayLevelOptions}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding OverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding OverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Which level the GameObject lives in — only levels with authored GameObjects are listed. Set it to the level you're transitioning INTO; the Target dropdown below follows this choice and stays disabled until one is chosen.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="GameObjects">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="Target" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <!-- IsEnabled: for GameObjects the target list is
                             level-scoped, so the combo stays disabled until a
                             Level is chosen above (always enabled otherwise). -->
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  IsEnabled="{Binding IsOverlayTargetEnabled}"
                                  Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Autocompletes from the selected Category; stays editable so any GO name/path works.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <!-- default: Direct Path → all pack-named GOs -->
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.GameObjectNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="GameObjects">
                                            <!-- The overlays of the level chosen above (per-action). -->
                                            <Setter Property="ItemsSource" Value="{Binding OverlayOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Scene">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.SceneKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <!-- A whole level, by place token. The level's own
                                             GameObject holds the Base sprite's SpriteRenderer,
                                             so this is what repaints a place; the Layer picker
                                             below chooses Base or Secondary.
                                             DisplayMemberPath=Token so the token itself is
                                             what lands in the param. -->
                                        <DataTrigger Binding="{Binding Category}" Value="Places">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.LevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="DisplayMemberPath" Value="Token"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- Layer (Places only): a level draws in two sprite layers, so
                             naming the place alone doesn't say which to act on. Shown as
                             Back / Front, the same words the Places tab uses. The manifest
                             still stores the game's Base / Secondary — see
                             NodeActionViewModel.PlaceLayerShown for the translation. -->
                        <TextBlock Text="Layer" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding ShowsPlaceLayer, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.PlaceLayerDisplays}"
                                  SelectedItem="{Binding PlaceLayerShown, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding ShowsPlaceLayer, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Which of the level's two sprites to act on — the same Back and Front the Places tab authors. Front is sorting order −10, Back is −12. Saved to the pack under the game's own names: Front writes layer=Base, Back writes layer=Secondary."/>

                        <CheckBox Grid.Row="4" Grid.Column="1" Content="Active" Margin="0,2,0,0"
                                  IsChecked="{Binding Active}"
                                  Visibility="{Binding ShowsActiveToggle, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="SetActive(true/false). For Scene, unchecking turns the scene off silently; checking activates it and plays its sound."/>
                    </Grid>

                    <!-- ── DiceRoll: weighted one-of-N branch editor ─────────
                         Each branch = chance % + ONE nested action (rendered by
                         this very template via DynamicResource self-reference).
                         Exactly one branch executes per roll; the total must be
                         exactly 100% (label turns red otherwise + validation
                         raises an error). -->
                    <StackPanel Margin="0,3,0,0"
                                Visibility="{Binding IsDiceFamily, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,0,3" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding DiceTotalLabel}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiceTotalValid}" Value="False">
                                            <Setter Property="Foreground" Value="#F66"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding DiceBranches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiceBranchViewModel}">
                                    <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                                            CornerRadius="2" Padding="4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="Chance" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Width="45" Text="{Binding ChanceText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                <Button Content="− Branch" Padding="6,0"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Remove this branch (and its action)."/>
                                            </StackPanel>
                                            <ContentControl Content="{Binding Action}"
                                                            ContentTemplate="{DynamicResource ActionRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add branch" HorizontalAlignment="Left" Padding="8,2"
                                Command="{Binding AddDiceBranchCommand}"
                                ToolTip="Add a weighted branch. New branches are seeded with the chance still missing from 100%."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>


        <!--
            Row template for navigator-button list rows (place + vanilla-extension tabs).
            Adds a minus button next to the existing target / label / music fields.
        -->
        <!-- Target dropdowns list "My Room", not "vanilla:5_MyRoom". Only the
             list is templated: with IsEditable the text box still shows
             NavigatorTargetOption.ToString(), which is the Token, so what gets
             typed and what gets stored are the same string as before. -->
        <DataTemplate x:Key="TargetOptionItemTemplate" DataType="{x:Type vm:NavigatorTargetOption}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayLabel}"/>
                <TextBlock Text="{Binding Token}" Foreground="Gray" Margin="10,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NavigatorButtonRowTemplate" DataType="{x:Type vm:NavigatorButtonViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Target:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ToolTip="Where this button takes the player." Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding DataContext.AllTargetOptions,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValuePath="Token"
                              SelectedValue="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                              ItemTemplate="{StaticResource TargetOptionItemTemplate}"
                              IsEditable="True"
                              Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                        <Button Content="▲" Width="22" Height="22" Padding="0"
                                Command="{Binding MoveUpCommand}"
                                ToolTip="Move earlier in instantiation order (further left in-game)"/>
                        <Button Content="▼" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding MoveDownCommand}"
                                ToolTip="Move later in instantiation order (further right in-game)"/>
                        <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding RemoveCommand}"
                                ToolTip="Remove this navigator button"/>
                    </StackPanel>
                    <TextBlock Text="Label override:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="1" Grid.Column="1"
                             ToolTip="Button text. Supports [PV:variableName] tokens that re-resolve live from String pack variables — change the variable via a dialogue action or Integration rule and the button renames in place."/>
                    <TextBlock Text="Music (optional):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="2" Grid.Column="1"
                             ToolTip="Optional name of a child under 12_AudioPlayer to enable when this button is pressed"/>
                    <!-- Conditions -->
                    <TextBlock Text="Conditions:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                        <ItemsControl ItemsSource="{Binding Conditions}"
                                      ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="+ Add condition" Margin="0,0,4,0" Padding="6,2"
                                    Command="{Binding AddConditionCommand}"/>
                            <Button Content="+ Add group" Padding="6,2"
                                    ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                    Command="{Binding AddConditionGroupCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Implicit (keyed-by-type) so a GameObject's nested Children
             ItemsControl re-uses this very template recursively. -->
        <DataTemplate DataType="{x:Type vm:GameObjectViewModel}">
            <!-- A bound node that currently differs from the vanilla object gets
                 an accent edge + wash, so you can see at a glance which of the
                 level's own objects you've actually touched among the many the
                 editor filled in. Compared live, not from the save-time flags. -->
            <Border CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="LightGray"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <!-- Opaque, and set on every row rather than only the
                             tinted ones. These rows nest, so a row without its
                             own background shows its PARENT's — which is what
                             made a freshly added child look like an untouched
                             vanilla object and an NPC look like a changed one. -->
                        <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
                        <Style.Triggers>
                            <!-- An object of the GAME'S own, not the pack's. A
                                 seeded extension is mostly these, so they get a
                                 cool cast to separate them at a glance from the
                                 few rows the pack actually creates. -->
                            <DataTrigger Binding="{Binding Bind}" Value="True">
                                <Setter Property="BorderBrush" Value="#805B8FCB"/>
                                <Setter Property="Background" Value="{DynamicResource Theme.VanillaSurface}"/>
                            </DataTrigger>
                            <!-- Listed second on purpose: a bound node you've
                                 actually changed is the stronger signal, and the
                                 later matching trigger wins. -->
                            <DataTrigger Binding="{Binding HasVanillaChange}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{DynamicResource Theme.ChangedSurface}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="0" Grid.Column="1"
                             IsEnabled="{Binding CanEditIdentity}"
                             ToolTip="GameObject name dialogue actions target by (keep unique across the pack)."/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <!-- The NPCs container. Deliberately a CHIP and not a
                             tint: the row's background and border already carry
                             whether the object is the game's and whether the pack
                             changed it, so this rides alongside them instead of
                             overwriting either. Shows on the pack's forced node
                             and on a vanilla level's own NPCs object alike. -->
                        <Border Padding="4,0" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                                Background="#80C08A3E"
                                Visibility="{Binding IsNpcHost, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="The level's NPCs container — where NPC placements live. Its transform offsets every NPC in the room, and its subtree composes transforms down the chain.">
                            <TextBlock Text="NPCs" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Names the colour cast, so "this one is the game's"
                             doesn't rely on spotting a tint. -->
                        <Border Padding="4,0" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                                Background="#805B8FCB"
                                Visibility="{Binding Bind, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="An object the vanilla level already has. The pack reaches into it rather than creating it, and anything you don't change here is dropped on save.">
                            <TextBlock Text="vanilla" FontSize="10"/>
                        </Border>
                        <!-- Says WHY the row is highlighted, and doubles as the
                             cue that this row will actually be saved. -->
                        <Border Padding="4,0" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Theme.Accent}"
                                Visibility="{Binding HasVanillaChange, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="This differs from the vanilla object it's bound to, so it will be saved. Match the vanilla values again and it drops out.">
                            <TextBlock Text="changed" FontSize="10"/>
                        </Border>
                        <Button Content="Reset" Width="50" Height="22" Padding="0" Margin="4,0,0,0"
                                Command="{Binding ResetToVanillaCommand}"
                                Visibility="{Binding CanResetToVanilla, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Put this object back to what the vanilla level actually has — the extracted transform, active state and sorting, not zeroes. It then drops out of the manifest again."/>
                        <Button Content="Copy" Width="50" Height="22" Padding="0" Margin="4,0,0,0"
                                Command="{Binding CopyCommand}" ToolTip="Copy this GameObject to the editor clipboard"/>
                        <Button Content="Paste" Width="50" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding PasteCommand}" ToolTip="Paste the clipboard's GameObject as a sibling below this one"/>
                        <Button Content="−" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                Command="{Binding RemoveCommand}" ToolTip="Remove this GameObject"/>
                    </StackPanel>

                    <!-- One row, stacked. The NPCs note and the bind controls can
                         BOTH apply now that an extension's NPCs container is a
                         bound node, and two siblings sharing a Grid.Row draw on
                         top of each other rather than below. -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">

                    <!-- Shown for both kinds of NPCs container: the forced node a
                         pack place carries, and the vanilla object an extension
                         binds to. -->
                    <TextBlock Foreground="Gray" FontSize="10"
                               TextWrapping="Wrap" Margin="0,2,0,2"
                               Visibility="{Binding IsNpcHost, Converter={StaticResource BoolToVisibility}}"
                               Text="The level's built-in NPCs object — its transform offsets every NPC in the room, and you can give it components and children like any GameObject. Placing an NPC in it doesn't count as changing it."/>

                    <!-- Bind: address an object that already exists in the scene
                         (a vanilla level's own furniture) instead of creating one. -->
                    <StackPanel Margin="0,2,0,2"
                                Visibility="{Binding CanEditIdentity, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox IsChecked="{Binding Bind}"
                                  Content="This GameObject already exists (bind, don't create)"
                                  ToolTip="On: the Name above is looked up in the scene (a bare name or a A > B > C path) and only what you author here is applied to it — the way to modify a vanilla level you don't own. Off: this pack creates the GameObject."/>
                        <StackPanel Orientation="Horizontal" Margin="16,2,0,0"
                                    Visibility="{Binding Bind, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox IsChecked="{Binding OverrideTransform}" Content="Override its transform"
                                      ToolTip="Off (default) leaves the existing object where it is. On applies the Transform row below as LOCAL position / rotation / scale."/>
                            <CheckBox IsChecked="{Binding OverrideActive}" Content="Override active" Margin="12,0,0,0"
                                      ToolTip="Off (default) leaves the object's own active state alone. On applies the Start-active checkbox. Not needed when you're gating it with Active-when conditions."/>
                        </StackPanel>
                        <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="16,2,0,0"
                                   Visibility="{Binding Bind, Converter={StaticResource BoolToVisibility}}"
                                   Text="Components, Active-when conditions, children and NPCs always apply — they're additions either way. Everything else is left untouched unless overridden above, so a bound object you haven't changed is a no-op. If the object isn't found the runtime logs a warning and skips it rather than creating a look-alike."/>
                    </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Sprite:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <ctl:PathPickerBox PathText="{Binding Sprite, UpdateSourceTrigger=PropertyChanged}"
                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       ToolTip="Pack-relative PNG path. Leave blank for a pure container GameObject (an empty transform that just groups children)."/>

                    <TextBlock Text="Transform:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,2,2"/>
                        <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,0,2"
                                 ToolTip="World X position (level centre ≈ 0)."/>
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,0,2"
                                 ToolTip="World Y position (up = positive); e.g. two overlays use 15/18."/>
                        <TextBlock Text="Rot" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding RotationZ, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,2"
                                 ToolTip="Z rotation in degrees (in-plane spin)."/>
                        <TextBlock Text="Scale X/Y" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,2"
                                 ToolTip="Local X scale (1 = native; negative mirrors)."/>
                        <TextBox Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="4,0,0,2"
                                 ToolTip="Local Y scale."/>
                        <TextBlock Text="Sort" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding SortingOrder, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,2"
                                 ToolTip="SpriteRenderer sorting order (lower draws further back)."/>
                    </WrapPanel>

                    <!-- Row 4 nests its own rows rather than claiming more of the
                         outer Grid: the parallax settings only appear when the
                         effect is on, and a collapsed child costs no layout. -->
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Parallax" IsChecked="{Binding ParallaxEnabled}"
                                      VerticalAlignment="Center"
                                      ToolTip="Let this object drift with the mouse. Off (the default) pins it to the level, which is what almost every overlay wants."/>
                            <CheckBox Content="Start active" IsChecked="{Binding StartActive}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="Uncheck for overlays a dialogue reveals later (Flash, Portal)."/>
                            <TextBlock Text="Alpha" VerticalAlignment="Center" Margin="12,0,2,0"/>
                            <TextBox Text="{Binding StartAlpha, UpdateSourceTrigger=PropertyChanged}" Width="45"
                                     ToolTip="Initial alpha 0..1 (start at 0 for fade-in overlays like the Portal)."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,4,0,0"
                                    Visibility="{Binding ParallaxEnabled, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Drift with the level" IsChecked="{Binding ParallaxInherits}" VerticalAlignment="Center"
                                      ToolTip="On (the default) keeps the level's own strength, which is what a created object always did. Turn it off to set this object's depth independently."/>
                            <TextBox Text="{Binding ParallaxStrength, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="10,0,0,0"
                                     IsEnabled="{Binding ParallaxInherits, Converter={StaticResource InverseBoolConverter}}"
                                     ToolTip="Depth relative to the level's main sprite, which every vanilla level fixes at 0.75: lower sits further away and lags behind the room, higher sits nearer and overshoots. Vanilla objects use 0.1, 0.5, 0.75 and 1.5."/>
                            <Slider Value="{Binding ParallaxStrength}" Minimum="0" Maximum="1.5" Width="110"
                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                    IsEnabled="{Binding ParallaxInherits, Converter={StaticResource InverseBoolConverter}}"/>
                            <CheckBox Content="Reversed" IsChecked="{Binding ParallaxReversed}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="Drift WITH the cursor instead of against it."/>
                            <CheckBox Content="UI space" IsChecked="{Binding ParallaxIsUI}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="Only for an object under a Canvas — it switches the effect to canvas coordinates. A pack's own GameObjects are world sprites, so leave this off unless you're binding to a canvas object."/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Mask (opt):" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                    <ctl:PathPickerBox PathText="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                       ToolTip="Optional pack-relative mask PNG bound to _MaskTex, for shader-masked overlays (a cameo)."/>

                    <!-- Utility components attached to this GameObject. -->
                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Component" Padding="6,0"
                                        Command="{Binding AddComponentCommand}"
                                        ToolTip="Attach a generic utility component (fade, disappear, random child, blink) to this GameObject."/>
                                <TextBlock Text="Components" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- No ItemTemplate: ComponentRowViewModel resolves to the
                                 implicit template below, shared with NPC rows. -->
                            <ItemsControl ItemsSource="{Binding Components}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Activation conditions: the object switches itself on/off as
                         these pass, instead of a rule having to drive it. -->
                    <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Condition" Padding="6,0"
                                        Command="{Binding AddActiveConditionCommand}"
                                        ToolTip="Gate this GameObject on a condition. It switches on while the conditions pass."/>
                                <TextBlock Text="Active when" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Foreground="Gray" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Leave empty and the object simply keeps its Start-active state forever. Add conditions and the runtime drives it instead — so objects whose conditions are mutually exclusive take turns on their own, with no rule to write."/>
                            <ItemsControl ItemsSource="{Binding ActiveConditions}" Margin="0,4,0,0"
                                          ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding DeactivateWhenUnmet}"
                                      Visibility="{Binding HasActiveConditions, Converter={StaticResource BoolToVisibility}}"
                                      Content="Switch back off when the conditions stop matching"
                                      ToolTip="Checked (default): the object is active exactly while the conditions hold. Unchecked: it turns on the first time they pass and stays on — a one-way reveal."/>
                        </StackPanel>
                    </Border>

                    <!-- Children: nested GameObjects and NPC placements alike. NPCs
                         can only be added inside the NPCs subtree, so that button
                         hides itself elsewhere. -->
                    <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Add NPC child" Padding="6,0"
                                        Command="{Binding AddNpcCommand}"
                                        Visibility="{Binding CanHostNpcs, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Place an NPC (from the NPCs tab) as a child of this GameObject."/>
                                <Button DockPanel.Dock="Right" Content="+ Add child" Padding="6,0" Margin="0,0,4,0"
                                        Command="{Binding AddChildCommand}"
                                        ToolTip="Add a child GameObject nested under this one. Children have the same fields, components, and their own children."/>
                                <TextBlock Text="Children" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- No ItemTemplate on either: GameObjectViewModel and
                                 NpcPlacementViewModel each resolve to their implicit
                                 template, giving recursive nesting. Indented to show depth. -->
                            <ItemsControl ItemsSource="{Binding Npcs}" Margin="12,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="12,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Implicit, so every Components list (GameObject rows AND NPC rows)
             picks it up without repeating the markup. -->
        <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                                        <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1" CornerRadius="2"
                                                Background="{DynamicResource Theme.Control}" Padding="5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="−" Width="22" Padding="0"
                                                            Command="{Binding RemoveCommand}" ToolTip="Remove this component"/>
                                                    <ComboBox ItemsSource="{Binding ComponentTypes}"
                                                              SelectedItem="{Binding Type}"/>
                                                </DockPanel>

                                                <!-- FadeInSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsFadeIn, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Fades the sprite in — alpha 0 → target over the duration (after an optional delay)."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="Duration" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding FadeDuration, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Target α" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding TargetAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Delay" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding StartDelay, UpdateSourceTrigger=LostFocus}"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- FadeOutSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsFadeOut, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Fades the sprite out — current alpha → 0 over the duration (after an optional delay). Optionally deactivates it once fully faded."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="Duration" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding Duration, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Delay" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding StartDelay, UpdateSourceTrigger=LostFocus}"/>
                                                        <CheckBox Content="Deactivate on complete" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                  IsChecked="{Binding DeactivateOnComplete}"
                                                                  ToolTip="Turn the GameObject off once it's fully faded out (a flash that vanishes)."/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- RandomChildActivator -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsRandom, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="On activate, enables one random child GameObject and disables the rest."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <CheckBox Content="Reshuffle every time it's activated" IsChecked="{Binding ReshuffleOnEnable}"/>
                                                </StackPanel>

                                                <!-- BlinkingSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsBlinking, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Toggles a SpriteRenderer's alpha between min and max on a fixed interval (blink / pulse)."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="Interval" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding BlinkInterval, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Min α" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding MinAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Max α" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding MaxAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- A component the GAME defines. Parameter names come
                                                     from the vanilla extraction, so they match the real
                                                     fields; blank means "leave at the component's own
                                                     default" rather than writing an empty value. -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsGameComponent, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding TypeNote}" Foreground="Gray" FontSize="10"
                                                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <ItemsControl ItemsSource="{Binding ParamRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="170"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Name}"/>
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                                                    <TextBlock Grid.Column="2" Foreground="Gray" FontSize="10"
                                                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding Observed, StringFormat=vanilla: {0}}"
                                                                               ToolTip="What the extraction saw on a vanilla level. Shown rather than filled in, so an untouched parameter isn't pinned to another level's value."/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
        </DataTemplate>

        <!-- Implicit, so a GameObject node's nested NPCs ItemsControl picks it up. -->
        <DataTemplate DataType="{x:Type vm:NpcPlacementViewModel}">
            <!-- Opaque background: an NPC row nests inside its host GameObject's
                 row, and without one it showed that host's tint — reading as if
                 the NPC were itself a changed vanilla object. -->
            <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                    CornerRadius="3" Margin="0,3" Padding="6"
                    Background="{DynamicResource Theme.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Seven rows for seven sections: NPC, Name, part transforms,
                         Start active, Components, Active when, Children. An
                         out-of-range Grid.Row is CLAMPED by WPF rather than
                         flagged, so a missing definition here draws the last two
                         sections on top of each other instead of failing. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="NPC:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                              ItemsSource="{Binding DataContext.NpcKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="DisplayLabel"
                              SelectedValuePath="Token"
                              SelectedValue="{Binding Npc, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Key of an NPC from the NPCs tab."/>
                    <Button Grid.Row="0" Grid.Column="2" Content="−" Width="22" Height="22"
                            Padding="0" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                            ToolTip="Remove this NPC."/>

                    <TextBlock Text="Name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="GameObject name (SetGameObjectActive target). Blank = the NPC key."/>

                    <!-- All four part transforms live here on the placement, so the
                         same NPC look can sit differently in each room. Body is the NPC
                         object itself; shadow / blink / wet are its children. The level
                         preview's gizmo edits these same VMs visually. -->
                    <Expander Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"
                              Header="Part transforms" IsExpanded="True">
                        <StackPanel Margin="4,4,0,0">
                            <TextBlock Text="Body" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <ContentControl Content="{Binding Body}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                            <TextBlock Text="Shadow" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ContentControl Content="{Binding Shadow}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                            <TextBlock Text="Blink" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ContentControl Content="{Binding Blink}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                            <TextBlock Text="Wet (particle)" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ContentControl Content="{Binding Wet}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                        </StackPanel>
                    </Expander>

                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="Start active" IsChecked="{Binding StartActive}" VerticalAlignment="Center"
                                  ToolTip="Off = parked, switched on by a rule / host code by name."/>
                        <!-- Depth belongs to the ROOM, not the character: the same
                             NPC stands behind one level's furniture and in front of
                             another's, and every vanilla level picks its own orders.
                             So it sits here with the transforms. -->
                        <TextBlock Text="Sorting order" VerticalAlignment="Center" Margin="16,0,4,0"/>
                        <TextBox Width="55" Text="{Binding SortingOrder, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Overrides the NPC's own sorting order for this placement. Leave blank to use the NPC's."/>
                    </StackPanel>

                    <!-- Utility components on the NPC itself. Attached before the
                         NPC is activated, so a FadeInSprite fades it in on
                         activation instead of popping. -->
                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Component" Padding="6,0"
                                        Command="{Binding AddComponentCommand}"
                                        ToolTip="Attach a utility component to this NPC (e.g. FadeInSprite so it fades in when switched on — nothing fades by default)."/>
                                <TextBlock Text="Components" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Components}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Activation conditions for the NPC GameObject itself. -->
                    <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Condition" Padding="6,0"
                                        Command="{Binding AddActiveConditionCommand}"
                                        ToolTip="Gate this NPC on a condition. It switches on while the conditions pass."/>
                                <TextBlock Text="Active when" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Foreground="Gray" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="Leave empty and the NPC simply keeps its Start-active state forever. Add conditions and the runtime drives it instead — so NPCs whose conditions are mutually exclusive take turns on their own, with no rule to write."/>
                            <ItemsControl ItemsSource="{Binding ActiveConditions}" Margin="0,4,0,0"
                                          ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding DeactivateWhenUnmet}"
                                      Content="Switch back off when the conditions stop matching"
                                      ToolTip="Checked (default): the NPC is active exactly while the conditions hold. Unchecked: it turns on the first time they pass and stays on — a one-way reveal."/>
                        </StackPanel>
                    </Border>

                    <!-- GameObjects parented under the NPC — props that ride along
                         with the pose, alongside its Circle / Blink / Wet parts. -->
                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Add child" Padding="6,0"
                                        Command="{Binding AddChildCommand}"
                                        ToolTip="Add a GameObject parented under this NPC (a held prop, an effect). It rides along with the pose."/>
                                <TextBlock Text="Children" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="12,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One conditions-gated action group on a place's enter/exit edge.
             Reuses the dialogue editor's condition + action row templates, so
             the Places tab gets the identical editing experience. -->
        <DataTemplate x:Key="LevelHookRowTemplate" DataType="{x:Type vm:LevelHookViewModel}">
            <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                    CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="−" Width="22" Height="22" Padding="0"
                                Command="{Binding RemoveCommand}" ToolTip="Remove this action group"/>
                        <TextBlock Text="Conditions (all must pass — leave empty for 'always')"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Conditions}"
                                  ItemTemplateSelector="{DynamicResource ConditionTemplateSelector}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <Button Content="+ Add condition" Command="{Binding AddConditionCommand}" Padding="6,2" Margin="0,0,4,0"/>
                        <Button Content="+ Add group" Command="{Binding AddConditionGroupCommand}" Padding="6,2"
                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"/>
                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                        <Button Content="Copy" Command="{Binding CopyConditionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="Copy this group's conditions to the clipboard"/>
                        <Button Content="Paste" Command="{Binding PasteConditionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="Append clipboard conditions (works across dialogues, rules and hooks)"/>
                        <Button Content="Overwrite" Command="{Binding OverwriteConditionsCommand}" Padding="6,2"
                                ToolTip="Replace this group's conditions with the clipboard"/>
                    </StackPanel>
                    <TextBlock Text="Actions" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Actions}"
                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="+ Add action" Command="{Binding AddActionCommand}" Padding="6,2" Margin="0,0,4,0"/>
                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                        <Button Content="Copy" Command="{Binding CopyActionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="Copy this group's actions to the clipboard"/>
                        <Button Content="Paste" Command="{Binding PasteActionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="Append clipboard actions (works across dialogues, rules and hooks)"/>
                        <Button Content="Overwrite" Command="{Binding OverwriteActionsCommand}" Padding="6,2"
                                ToolTip="Replace this group's actions with the clipboard"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Grid wrapper exists only so the save-confirmation toast can overlay the
         top-right corner of the shell (DockPanel can't free-float a child). -->
    <Grid>
    <DockPanel LastChildFill="True">
        <!-- Menu strip -->
        <!-- Menu bar with the targeted game version pinned to its right edge
             (ModPack.CurrentGameVersion — the constant that also gets stamped
             into every saved pack for the runtime's compatibility check). -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource Theme.Chrome}">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.ChromeText}"
                       Text="{Binding GameVersionHeader}"
                       ToolTip="The game build this ModForge version targets. Saved packs are stamped with it; the in-game Mods banner flags packs whose stamp doesn't match the running game."/>
        <Menu>
            <MenuItem view:TutorialAnchor.Id="menu:file" Header="_File">
                <MenuItem Header="_New pack"      Command="{Binding NewPackCommand}"     InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open pack…"    Command="{Binding OpenPackCommand}"    InputGestureText="Ctrl+O"/>
                <MenuItem Header="Recent _files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save"          Command="{Binding SavePackCommand}"    InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _as…"     Command="{Binding SavePackAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <!-- Bundles the loose pack folder into a single .smspack
                     archive (zip) that the runtime plugin reads. Both items
                     are disabled until the pack has been saved to disk — the
                     exporter walks the on-disk folder. "Export pack" reuses
                     this pack's last export path (remembered in local editor
                     settings, never in the pack file); "as…" always asks. -->
                <MenuItem Header="_Export pack" Command="{Binding ExportPackCommand}" InputGestureText="Ctrl+E"
                          ToolTip="Save and export straight to where this pack was last exported (asks the first time)."/>
                <MenuItem Header="Export pack _as…" Command="{Binding ExportPackAsCommand}" InputGestureText="Ctrl+Shift+E"
                          ToolTip="Save and export to a chosen .smspack file; that path becomes the one-click Export target."/>
                <Separator/>
                <MenuItem Header="_Validate"      Command="{Binding ValidateCommand}"   InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Duplicate item" Command="{Binding DuplicateItemCommand}" InputGestureText="Ctrl+D"
                          ToolTip="Duplicate the selected item in the current tab's list (with a fresh key)."/>
                <MenuItem Header="_Copy item"      Command="{Binding CopyItemCommand}" InputGestureText="Ctrl+C"
                          ToolTip="Copy the selected list item — paste it into any pack open in this editor session. Ctrl+C works while the list has focus."/>
                <MenuItem Header="_Paste item"     Command="{Binding PasteItemCommand}" InputGestureText="Ctrl+V"
                          ToolTip="Paste a copied item of the matching type into the current tab's list. Ctrl+V works while the list has focus."/>
                <Separator/>
                <MenuItem Header="_Rename item…"   Command="{Binding RenameItemCommand}" InputGestureText="F2"
                          ToolTip="Rename the selected list item's key (F2 or F12 while the list has focus)."/>
                <MenuItem Header="De_lete item"    Command="{Binding DeleteItemCommand}" InputGestureText="Del"
                          ToolTip="Delete the selected list item (Del while the list has focus)."/>
            </MenuItem>
            <MenuItem Header="_Themes" ItemsSource="{Binding Themes}"
                      ToolTip="Recolour the editor. Your choice is remembered between sessions.">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <Setter Property="IsCheckable" Value="True"/>
                        <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                        <Setter Property="Command" Value="{Binding DataContext.ApplyThemeCommand,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="_Options">
                <!-- Two-way: the dialog's own "Don't ask again" writes back
                     through the same VM property, so unticking here is how you
                     get the prompt back. -->
                <MenuItem Header="_Confirm changes on save" IsCheckable="True"
                          IsChecked="{Binding ConfirmOnSave, Mode=TwoWay}"
                          ToolTip="Before writing modpack.json, list everything the save will change and ask for confirmation. Your choice is remembered between sessions."/>
                <MenuItem Header="_Spell-check node text" IsCheckable="True"
                          IsChecked="{Binding SpellCheckNodeText, Mode=TwoWay}"
                          ToolTip="Underline misspellings using Windows' own US-English spell checker — both in a node's Text field and down the node list, so mistakes are visible while scanning. Right-click a squiggle in the Text field for suggestions, to ignore it for this session, or to add the word to your Windows dictionary (the same list Edge and Office use). Turning this off also makes the node list lighter to scroll on very long dialogues. Your choice is remembered between sessions."/>
                <MenuItem Header="Add pack _names to Windows dictionary…"
                          Click="AddPackNamesToDictionary_Click"
                          ToolTip="Put every character, actor, place and NPC name this pack invents into your Windows dictionary in one go, so they stop being flagged as misspellings. Shows you the list first."/>
                <Separator/>
                <MenuItem Header="_Preview quality" ItemsSource="{Binding PreviewQualities}"
                          ToolTip="Trade live-preview smoothness for CPU. Your choice is remembered between sessions.">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                            <Setter Property="IsCheckable" Value="True"/>
                            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                            <Setter Property="Command" Value="{Binding DataContext.ApplyPreviewQualityCommand,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
        </Menu>
        </DockPanel>

        <!-- Status / issues bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock>
                <Run Text="{Binding Issues.Count, Mode=OneWay}"/>
                <Run Text=" issue(s)"/>
            </TextBlock>
        </StatusBar>

        <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- ════════════════════════════════════════════════════
                 MODFORGE TAB (index 0 — landing page)
                 Pack-wide validation issues + usage help. Hosts no
                 unit list, so the per-tab copy/paste/rename/delete
                 dispatches deliberately no-op here.
                 ════════════════════════════════════════════════════ -->
            <TabItem view:TutorialAnchor.Id="tab:modforge" Header="⚒ ModForge" Style="{StaticResource HomeTabItem}"
                     ToolTip="Home — validation issues, getting started, tutorials and documentation.">
                <Grid Margin="8">
                    <!-- Help fills ~2/3 on the left; the issues panel sits on
                         the right at ~1/3 width. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RIGHT: validation issues (moved from the Busts tab) -->
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button view:TutorialAnchor.Id="btn:validate" DockPanel.Dock="Right" Content="Validate (F5)" Padding="10,3"
                                    Command="{Binding ValidateCommand}"
                                    ToolTip="Re-run all pack checks now. Also runs automatically on every save."/>
                            <TextBlock FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                                <Run Text="Issues ("/><Run Text="{Binding Issues.Count, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                        </DockPanel>
                        <!-- Each issue is one line; double-click jumps to the tab and
                             selects the exact thing it refers to. Full text on hover. -->
                        <!-- Condition-debug tracking. The flag is a checkbox
                             buried in each dialogue's editor, so it is easy to
                             leave on and then wonder why the in-game log is
                             full of one dialogue's conditions. Docked at the
                             bottom so it only takes space when something is
                             actually tracked. -->
                        <GroupBox DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                  Visibility="{Binding HasDebuggedDialogues, Converter={StaticResource BoolToVisibility}}">
                            <GroupBox.Header>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Untrack all" Padding="8,0" Margin="8,0,0,0"
                                            Command="{Binding ClearDebugDialoguesCommand}"
                                            ToolTip="Clear condition debugging on every dialogue below."/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Tracked for condition debugging ("/><Run
                                             Text="{Binding DebuggedDialogues.Count, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </DockPanel>
                            </GroupBox.Header>
                            <ItemsControl ItemsSource="{Binding DebuggedDialogues}" MaxHeight="150">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="Untrack" Padding="6,0"
                                                    Command="{Binding DataContext.UntrackDebugDialogueCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Stop dumping this dialogue's conditions on F12."/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <!-- Same idea for integration rules, but a separate list
                             because a flagged rule logs CONTINUOUSLY rather than
                             on an F12 press — one left on is noisier than a
                             dialogue left on, so it is worth its own count. -->
                        <GroupBox DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                  Visibility="{Binding HasDebuggedRules, Converter={StaticResource BoolToVisibility}}">
                            <GroupBox.Header>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Untrack all" Padding="8,0" Margin="8,0,0,0"
                                            Command="{Binding ClearDebugRulesCommand}"
                                            ToolTip="Clear condition debugging on every rule below."/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="Rules logging decisions ("/><Run
                                             Text="{Binding DebuggedRules.Count, Mode=OneWay}"/><Run Text=")"/>
                                    </TextBlock>
                                </DockPanel>
                            </GroupBox.Header>
                            <ItemsControl ItemsSource="{Binding DebuggedRules}" MaxHeight="150">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="Untrack" Padding="6,0"
                                                    Command="{Binding DataContext.UntrackDebugRuleCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Stop logging this rule's decisions."/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Double-click an issue to jump to it" VerticalAlignment="Center"/>
                                    <!-- Silenced issues are hidden, so say they exist. A count
                                         nobody can see is how an ignore list turns into a place
                                         problems go to be forgotten. -->
                                    <Button DockPanel.Dock="Right" Content="Stop ignoring all"
                                            Padding="8,0" Margin="8,0,0,0"
                                            Click="ClearIgnoredIssues_Click"
                                            Visibility="{Binding HasIgnoredIssues, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Empty the ignore list, so every silenced issue is reported again."/>
                                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                              IsChecked="{Binding ShowIgnoredIssues}"
                                              Visibility="{Binding HasIgnoredIssues, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="List the issues you have silenced as well, so you can un-silence one.">
                                        <TextBlock>
                                            <Run Text="Show"/><Run Text=" "/><Run Text="{Binding IgnoredIssueCount, Mode=OneWay}"/><Run Text=" ignored"/>
                                        </TextBlock>
                                    </CheckBox>
                                </DockPanel>
                            </GroupBox.Header>
                            <ListBox x:Name="IssueList"
                                     ItemsSource="{Binding Issues}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="IssueList_MouseDoubleClick">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Ignore this issue" Click="IgnoreIssue_Click"
                                                  ToolTip="Stop reporting this one thing, in this one place."/>
                                        <MenuItem Header="Ignore every issue like it" Click="IgnoreIssueCode_Click"
                                                  ToolTip="Stop reporting this kind of issue anywhere in the pack."/>
                                        <Separator/>
                                        <MenuItem Header="Stop ignoring this" Click="UnignoreIssue_Click"
                                                  ToolTip="Report this again. Only does anything for an issue you have silenced."/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Message}" Cursor="Hand"
                                              Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Severity}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Where}"   Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- LEFT: usage help. Tutorial/documentation sections are
                         templates to be fleshed out — keep the structure, fill
                         the bodies in later. -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontWeight="Bold" FontSize="16" Text="SMSModForge"/>
                            <TextBlock Foreground="Gray" Margin="0,0,0,8"
                                       Text="{Binding GameVersionHeader}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Author mod packs for Starmaker Story: dialogues, places, busts, scenes, wallpapers, music, SFX, variables and integration rules — exported as a single .smspack the runtime plugin loads."/>

                            <Expander Header="Getting started" IsExpanded="True" Margin="0,0,0,6">
                                <StackPanel Margin="16,4,0,4">
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="1.  File ▸ New pack, then Save — most previews and pickers need the pack on disk to resolve file paths."/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="2.  Work left to right — the tabs follow the authoring order: who (Characters, NPCs) → where (Places, Map Buttons) → what they say (Dialogues) → what plays (Scenes, Music, SFX, Wallpapers) → state and logic (Variables, Integration). An NPC is defined on the NPCs tab and then placed into a room from the Places tab."/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="3.  Validate (F5) and fix anything listed on this page — double-click an issue to jump straight to it."/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="4.  File ▸ Export pack (Ctrl+E) and drop the .smspack into BepInEx/plugins/SMSModForge/ModPacks/."/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Guided tutorials" IsExpanded="True" Margin="0,0,0,6">
                                <!--
                                    Grouped by the part of the editor they teach, because that
                                    is how someone picks what to learn next: they are working on
                                    rooms and want the rest of the room tutorials, not the next
                                    entry in one long list. Level orders them within a group and
                                    is shown as a badge, so a first tutorial reads as one.
                                -->
                                <ItemsControl Margin="16,4,0,4">
                                    <ItemsControl.ItemsSource>
                                        <Binding Path="TutorialsView"/>
                                    </ItemsControl.ItemsSource>
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                               Margin="0,8,0,4" Opacity="0.75"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" CornerRadius="4" Margin="0,0,0,6"
                                                    Padding="10,8"
                                                    BorderBrush="{DynamicResource Theme.Accent}"
                                                    Background="{DynamicResource Theme.Surface}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="{Binding ActionLabel}"
                                                            Padding="14,4" VerticalAlignment="Center"
                                                            Margin="10,0,0,0"
                                                            Command="{Binding DataContext.StartTutorialCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Bold">
                                                            <Run Text="{Binding Mark, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Theme.Accent}"/><Run
                                                                 Text=" "/><Run Text="{Binding LevelLabel, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Theme.Accent}"/><Run
                                                                 Text=" "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                                   Opacity="0.7" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Header="Documentation" IsExpanded="False" Margin="0,0,0,6">
                              <StackPanel Margin="16,4,0,4">
                                <!-- Search. Filters titles and content alike; a
                                     topic matched by its title keeps all of its
                                     bullets, one matched only by content keeps
                                     just the bullets that hit. -->
                                <DockPanel Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Content="Clear" Padding="8,1" Margin="6,0,0,0"
                                            Command="{Binding ClearDocSearchCommand}"
                                            Visibility="{Binding IsDocSearchActive,
                                                         Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBox Text="{Binding DocQuery, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                             ToolTip="Search the reference — matches topic titles and the text inside them."/>
                                </DockPanel>
                                <TextBlock Text="{Binding DocSearchSummary}" Opacity="0.65" FontSize="11"
                                           Margin="2,0,0,6"
                                           Visibility="{Binding IsDocSearchActive,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock TextWrapping="Wrap" Opacity="0.65" FontStyle="Italic" Margin="2,4,0,4"
                                           Text="No topic mentions that. Try a word from a control's label."
                                           Visibility="{Binding HasNoDocResults,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding DocParts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                           Opacity="0.75" Margin="0,4,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Topics}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Expander Header="{Binding Title}" Margin="0,0,0,2"
                                                                      IsExpanded="{Binding StartExpanded, Mode=OneTime}">
                                                                <StackPanel Margin="16,4,0,6">
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                                               FontStyle="Italic" Opacity="0.7" Margin="0,0,0,6"/>
                                                                    <ItemsControl ItemsSource="{Binding Sections}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,0,6">
                                                                                    <TextBlock Text="{Binding Heading}" FontWeight="Bold"
                                                                                               Margin="0,2,0,3"
                                                                                               Visibility="{Binding HasHeading,
                                                                                                            Converter={StaticResource BoolToVisibility}}"/>
                                                                                    <ItemsControl ItemsSource="{Binding Bullets}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                                                                                    <Run Text="•  "/><Run Text="{Binding Term, Mode=OneWay}" FontWeight="Bold"/><Run
                                                                                                         Text="{Binding Dash, Mode=OneWay}"/><Run Text="{Binding Text, Mode=OneWay}"/>
                                                                                                </TextBlock>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 BUSTS TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Characters">
                <Grid>
                    <Grid.Resources>
                        <!-- Pack-authored and vanilla-borrowed characters read
                             very differently, so the tree groups by source
                             rather than mixing a bust you drew with one you
                             merely pointed at. -->
                        <CollectionViewSource x:Key="GroupedCharacters" Source="{Binding Characters}"
                                              IsLiveGroupingRequested="True">
                            <!-- Live, or switching a character to a vanilla bust
                                 would leave it filed under the wrong heading
                                 until the tab was rebound. -->
                            <CollectionViewSource.LiveGroupingProperties>
                                <sys:String>BustSource</sys:String>
                            </CollectionViewSource.LiveGroupingProperties>
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="BustSource"/>
                            </CollectionViewSource.GroupDescriptions>
                            <!-- Sorted WITHIN each heading. The Characters
                                 collection's own default view is sorted too, but
                                 this CollectionViewSource is a separate view and
                                 was left in insertion order. -->
                            <CollectionViewSource.SortDescriptions>
                                <scm:SortDescription PropertyName="DisplayName" Direction="Ascending"/>
                            </CollectionViewSource.SortDescriptions>
                        </CollectionViewSource>
                    </Grid.Resources>
                    <!--
                        Column 4 (the live-preview side panel) is intentionally
                        fixed: it has no GridSplitter between it and the middle
                        editor, and its width is set to fit the 512×512
                        JigglePreview + Expression/Mouth controls exactly. Don't
                        re-introduce a splitter here — the preview only renders
                        crisply at JiggleShader.Size × N (integer N), so a
                        user-draggable column would let the preview be clipped
                        or the surrounding chrome get cramped.
                    -->
                    <Grid.ColumnDefinitions>
                        <!--
                            MinWidth is set from the toolbar's own measured width on
                            load (CharacterToolBar_Loaded), not written here: the
                            buttons' width depends on the theme's font and the user's
                            DPI, so any number typed in would be wrong on somebody's
                            machine. Dragging the splitter narrower than the buttons
                            used to fold them into ToolBar's overflow popup, where
                            authors did not find them at all.
                        -->
                        <ColumnDefinition x:Name="CharacterSidebarColumn" Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="540"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: character/outfit tree -->
                    <DockPanel view:TutorialAnchor.Id="panel:characterTree" Grid.Column="0">
                        <ToolBar x:Name="CharacterToolBar" DockPanel.Dock="Top"
                                 Loaded="CharacterToolBar_Loaded">
                            <Button view:TutorialAnchor.Id="btn:addCharacter" Content="+ Character" Command="{Binding AddCharacterCommand}"
                                    ToolTip="A character this pack draws the bust for."/>
                            <Button Content="+ Vanilla" Command="{Binding AddVanillaCharacterCommand}"
                                    ToolTip="A character that borrows one of the game's own busts — pick which below. No art needed."/>
                            <Button Content="+ Voice" Command="{Binding AddVoiceCharacterCommand}"
                                    ToolTip="A speaking part with no bust at all, like John Dick."/>
                            <Button Content="+ Outfit"    Command="{Binding AddOutfitCommand}"
                                    ToolTip="Add an outfit to the selected character. Needs a character that has a bust — a voice-only character has nothing to dress."/>
                            <Separator/>
                            <Button Content="− Outfit" Command="{Binding RemoveOutfitCommand}"
                                    ToolTip="Delete the selected outfit."/>
                            <Button Content="− Character" Command="{Binding RemoveCharacterCommand}"
                                    ToolTip="Delete the selected character and all of its outfits."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding CharacterTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="CharacterTree"
                                  ItemsSource="{Binding Source={StaticResource GroupedCharacters}}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged">
                            <TreeView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="2,8,0,2" FontWeight="Bold" Foreground="Gray"
                                                       Text="{Binding Name, Converter={x:Static conv:BustSourceHeaderConverter.Instance}}"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </TreeView.GroupStyle>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:CharacterViewModel}"
                                                          ItemsSource="{Binding Outfits}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding VanillaBust, StringFormat=' ({0})'}" Foreground="Gray"
                                                   Visibility="{Binding IsVanillaBust, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:OutfitViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="• "/>
                                        <TextBlock Text="{Binding Key}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: outfit editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedOutfit}">
                        <StackPanel Margin="8">
                            <!-- The character owning this outfit. Bound through the
                                 window because this pane's DataContext is the outfit;
                                 without it the sidebar showed a character name that
                                 nothing anywhere could edit. -->
                            <!-- One Identity panel for everything that names or
                                 identifies the selection: the character, how it is
                                 drawn, and the outfit selected under it. These were
                                 four separate GroupBoxes at different depths
                                 ("Character", "Bust", "Default outfit", and a second
                                 "Identity" lower down for the outfit), which is why
                                 it was unclear which "Name:" set what. -->
                            <GroupBox Header="Identity" Margin="0,0,0,6">
                                <StackPanel>
                                    <!-- Character -->
                                    <Grid DataContext="{Binding DataContext.SelectedCharacter, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Character name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox view:TutorialAnchor.Id="field:characterName"
                                                 Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditIdentity}"
                                                 ToolTip="What the player reads on a speech line. The only name you need to write - the internal ones are derived from it."/>

                                        <TextBlock Text="Name colour:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2"
                                                    IsEnabled="{Binding CanEditNameColor}">
                                            <Border Width="22" Height="18" BorderBrush="#888" BorderThickness="1"
                                                    Background="{Binding NameColorBrush}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding NameColor, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="6,0,0,0"
                                                     ToolTip="Speaker-name tint as hex, e.g. #FF8844. Blank uses the default."/>
                                            <Button Content="Pick..." Margin="6,0,0,0" Padding="8,0"
                                                    Click="PickCharacterColor_Click"
                                                    ToolTip="Choose the colour on an RGB wheel instead of typing hex."/>
                                        </StackPanel>

                                        <TextBlock Text="Bust source:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,2" HorizontalAlignment="Left" Width="220"
                                                  SelectedValue="{Binding BustSource}" SelectedValuePath="Tag"
                                                  IsEnabled="{Binding CanEditIdentity}"
                                                  ToolTip="Where this character&apos;s bust comes from. &apos;No bust&apos; is a speaking part with no art at all.">
                                            <ComboBoxItem Content="This pack&apos;s outfits"  Tag="{x:Static model:BustSource.Pack}"/>
                                            <ComboBoxItem Content="A vanilla bust"       Tag="{x:Static model:BustSource.Vanilla}"/>
                                            <ComboBoxItem Content="No bust (voice only)" Tag="{x:Static model:BustSource.None}"/>
                                        </ComboBox>

                                        <TextBlock Text="Default outfit:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" IsEditable="True"
                                                  ItemsSource="{Binding WearableBusts}"
                                                  SelectedItem="{Binding DefaultOutfit}"
                                                  ToolTip="Which bust this character appears in before any dialogue changes it. Set to the first outfit you add; editable, so a bust built elsewhere can be named directly."/>
                                    </Grid>

                                    <!-- Selected outfit -->
                                    <Grid Margin="0,8,0,0"
                                          Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Outfit name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                                   ToolTip="What dialogue and actions reference this outfit by, and the GameObject the runtime builds."/>
                                        <TextBox ToolTip="What dialogue and actions reference this outfit by, and the GameObject the runtime builds."  Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                  Text="{Binding GameObjectName, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding DataContext.SelectedCharacter.IsPackBust,
                                                               RelativeSource={RelativeSource AncestorType=Window},
                                                               Converter={StaticResource BoolToVisibility}}"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                  ItemsSource="{Binding DataContext.SelectedCharacter.VanillaBustCatalog,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValue="{Binding GameObjectName}" SelectedValuePath="GoName"
                                                  Visibility="{Binding DataContext.SelectedCharacter.IsVanillaBust,
                                                               RelativeSource={RelativeSource AncestorType=Window},
                                                               Converter={StaticResource BoolToVisibility}}"
                                                  ToolTip="Which of the game&apos;s busts this outfit is.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding GoName}"/>
                                                        <TextBlock Text="{Binding Character}" Foreground="Gray" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10"
                                                   Text="Every outfit reference in this pack uses this name."/>
                                    </Grid>

                                    <!-- Contextual notes + the derived internal names -->
                                    <StackPanel DataContext="{Binding DataContext.SelectedCharacter, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Visibility="{Binding IsVanillaBust, Converter={StaticResource BoolToVisibility}}"
                                                   Text="This character wears the game&apos;s own busts, so its name colour belongs to the game and its outfits are bust names and nothing else - add one per bust it can appear as."/>
                                        <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Visibility="{Binding IsPlayer, Converter={StaticResource BoolToVisibility}}"
                                                   Text="The player is built in and shared by every pack: a dialogue in any mod that addresses &apos;you&apos; reaches this same character, and shows the same name in the same colour. Name, colour, key and source are all fixed for that reason. The typing voice is still yours to set."/>
                                        <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Visibility="{Binding HasNoBust, Converter={StaticResource BoolToVisibility}}"
                                                   Text="This character speaks with no bust shown. Dialogue lines, name colour and voice all work; nothing is drawn."/>

                                        <Expander Header="Internal names" Margin="0,8,0,0"
                                                  IsEnabled="{Binding CanEditIdentity}">
                                            <StackPanel Margin="0,4,0,0">
                                                <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Text="Derived from the character name above and deduplicated within this pack; two packs may both ship a Sarah, since the runtime keys by pack as well. Existing characters keep whatever they already had - these are real GameObject and dialogue references, so changing one renames what the pack builds."/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="Dialogue key:" Width="140" VerticalAlignment="Center"
                                                               ToolTip="What a dialogue node names as its speaker."/>
                                                    <TextBox ToolTip="What a dialogue node names as its speaker." Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="GameObject:" Width="140" VerticalAlignment="Center"
                                                               ToolTip="The object the character&apos;s bust is built under at runtime."/>
                                                    <TextBox ToolTip="The object the character&apos;s bust is built under at runtime." Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Voice (typewriter blip)"
                                      DataContext="{Binding DataContext.SelectedCharacter,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Text="The blip that plays as this character's line types out. Pick a preset or dial in a custom pitch range. Frequency is how often the blip fires; pitch randomises between min and max. Editing a value switches the template to Custom."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                                  Content="Enable typewriter voice" IsChecked="{Binding TypewriterEnabled}"
                                                  ToolTip="When off, this character's line types out silently."/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Template:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                                  ItemsSource="{Binding VoiceTemplates}"
                                                  SelectedItem="{Binding VoiceTemplate}"
                                                  ToolTip="Male → freq 45, pitch 0.6–0.9. Female → freq 45, pitch 1.0–1.5. Custom → your own values."/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                                 Text="{Binding TypewriterFrequencyText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="How often the blip fires as text types (GC2 Typewriter frequency). Preset value: 45."/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pitch min:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                                 Text="{Binding TypewriterPitchMinText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Low end of the random pitch range. Male 0.6, Female 1.0."/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pitch max:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                 Text="{Binding TypewriterPitchMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="High end of the random pitch range. Male 0.9, Female 1.5."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Speech expressions (per-node key → bust expression child)"
                                      DataContext="{Binding DataContext.SelectedCharacter,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="+ Add expression"
                                            Command="{Binding DataContext.AddCharacterExpressionCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="What a dialogue node's Expression field selects. If empty, the four standard expressions (Happy/Angry/Sad/Flirty) each map by name to a child of the bust's MBase1/Expressions/. Add entries to override those or to add custom ones."/>
                                    <ItemsControl ItemsSource="{Binding Expressions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ActorExpressionViewModel}">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Pack-local expression key (e.g. Happy)"/>
                                                    <TextBox Grid.Column="2" Text="{Binding ExpressionGoName, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Child name under MBase1/Expressions/ on the bust"/>
                                                    <Button Grid.Column="3" Content="−" Width="22" Margin="4,0,0,0"
                                                            Command="{Binding RemoveCommand}"
                                                            ToolTip="Remove this expression"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:outfitSprites" Header="Sprites and expressions (relative to pack root, 256×256 PNG)"
                                      Visibility="{Binding DataContext.SelectedCharacter.IsPackBust,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Base:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox view:IssueTarget.Field="baseSprite" ToolTip="The bust itself: 256x256 RGBA, relative to the pack folder."
                                                       view:TutorialAnchor.Id="field:baseSprite"
                                                       PathText="{Binding BaseSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Mask:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="1" Grid.Column="1">
                                        <Button view:TutorialAnchor.Id="btn:editMask" DockPanel.Dock="Right" Content="Edit Mask…"
                                                Margin="4,0,0,0" Padding="6,0"
                                                Click="EditMask_Click"/>
                                        <ctl:PathPickerBox view:IssueTarget.Field="maskSprite" ToolTip="Where the jiggle applies and how strongly. Leave it empty for a bust that does not move. Edit Mask opens the painter."
                                                           PathText="{Binding MaskSprite, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DockPanel>
                                    <CheckBox view:TutorialAnchor.Id="field:hasBlink" Content="Has Blink frame"
                                              IsChecked="{Binding BlinkEnabled}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                              ToolTip="Untick for a bust with no blink art. Blink is not optional by omission — leaving the path empty makes the runtime treat the outfit as broken and skip the whole bust, so this is the way to say the character simply does not blink."/>
                                    <TextBlock Text="Blink:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox view:IssueTarget.Field="blinkSprite" ToolTip="The eyes-closed overlay. Used only while Has Blink frame is ticked."
                                                       PathText="{Binding BlinkSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="3" Grid.Column="1"
                                                       IsEnabled="{Binding BlinkEnabled}"/>
                                    <CheckBox view:TutorialAnchor.Id="field:hasMouth" Content="Has Mouth frames" IsChecked="{Binding MouthEnabled}" ToolTip="Tick when the bust has numbered mouth frames, so the mouth animates while the line types." Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>
                                    <!-- Both prefix fields hold a PATH, not just a filename fragment, and
                                         that was the thing people got wrong: the grey line under each one
                                         used to describe a naming rule without ever saying where the file
                                         was looked for. The trailing hint now shows the whole thing as one
                                         line — what you typed, then what the game adds. -->
                                    <TextBlock Text="Mouth prefix:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:SuffixHintBox view:IssueTarget.Field="mouth" Grid.Row="5" Grid.Column="1"
                                                       Text="{Binding MouthPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                       Suffix="1.png/2.png/3.png/4.png"
                                                       IsEnabled="{Binding MouthEnabled}"
                                                       ToolTip="Path and filename start that the four mouth frames share, relative to the pack root — the same kind of path as the Base and Blink rows above, just without the number and the .png. Art/Anna/Mouth loads Art/Anna/Mouth1.png through Mouth4.png."/>
                                    <TextBlock Text="A path from the pack root, without the number: Art/Anna/Mouth"
                                               Grid.Row="6" Grid.Column="1" Foreground="Gray" FontSize="10"/>

                                    <!-- Expressions used to be a box of their own. They are the same kind
                                         of thing as everything above — art for this outfit, named by a
                                         prefix — and a whole panel for one tickbox and one field put them
                                         further from the sprites they belong with. The anchor id stays on
                                         the rows so tutorials still point at exactly these. -->
                                    <Grid view:TutorialAnchor.Id="panel:outfitExpressions" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox view:TutorialAnchor.Id="field:hasExpressions" Content="Has Expressions" IsChecked="{Binding ExpressionEnabled}" ToolTip="Tick when the bust has expression artwork a line can switch to." Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"/>
                                        <TextBlock Text="Expr. prefix:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:SuffixHintBox view:IssueTarget.Field="expression" Grid.Row="1" Grid.Column="1"
                                                           Text="{Binding ExpressionPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                           Suffix="Happy.png/Angry.png/Sad.png/Flirty.png"
                                                           IsEnabled="{Binding ExpressionEnabled}"
                                                           ToolTip="Path and filename start that the four expression files share, relative to the pack root. Art/Anna/Expression loads Art/Anna/ExpressionHappy.png and its three siblings. Only those four names are ever looked for."/>
                                        <TextBlock Text="A path from the pack root, without the mood: Art/Anna/Expression"
                                                   Grid.Row="2" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Jiggle (mask-driven shader)"
                                      Visibility="{Binding DataContext.SelectedCharacter.IsPackBust,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <!-- Per-row Default. These numbers are judged by eye against a
                                             preview, so getting back to a known starting point matters more
                                             here than in a field with a right answer. -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Speed"        Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ToolTip="How fast the movement cycles. Drives the Bounce and Wave layers; Noise has its own speed."/>
                                    <Slider ToolTip="How fast the movement cycles. Drives the Bounce and Wave layers; Noise has its own speed." Value="{Binding JiggleSpeed}"    Minimum="0" Maximum="10" Grid.Row="0" Grid.Column="1"/>
                                    <TextBox ToolTip="How fast the movement cycles. Drives the Bounce and Wave layers; Noise has its own speed." Text="{Binding JiggleSpeed, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="2"/>
                                    <TextBlock Text="Strength"     Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" ToolTip="How far the pixels travel. Drives the Bounce and Wave layers; Noise has its own strength."/>
                                    <Slider ToolTip="How far the pixels travel. Drives the Bounce and Wave layers; Noise has its own strength." view:TutorialAnchor.Id="field:jiggle" view:IssueTarget.Field="jiggle.strength" Value="{Binding JiggleStrength}" Minimum="-0.5" Maximum="0.5" Grid.Row="1" Grid.Column="1"/>
                                    <TextBox ToolTip="How far the pixels travel. Drives the Bounce and Wave layers; Noise has its own strength." Text="{Binding JiggleStrength, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="2"/>
                                    <TextBlock Text="Wave frequency" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" ToolTip="How many waves fit down the sprite: low sways, high ripples. Drives the Wave layer only."/>
                                    <Slider ToolTip="How many waves fit down the sprite: low sways, high ripples. Drives the Wave layer only." Value="{Binding JiggleFrequency}" Minimum="0" Maximum="40" Grid.Row="2" Grid.Column="1"/>
                                    <TextBox ToolTip="How many waves fit down the sprite: low sways, high ripples. Drives the Wave layer only." Text="{Binding JiggleFrequency, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="2"/>
                                    <TextBlock Text="Noise scale"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" ToolTip="How fine the noise grain is. Drives the Noise layer only."/>
                                    <Slider ToolTip="How fine the noise grain is. Drives the Noise layer only." Value="{Binding NoiseScale}" Minimum="0" Maximum="80" Grid.Row="3" Grid.Column="1"/>
                                    <TextBox ToolTip="How fine the noise grain is. Drives the Noise layer only." Text="{Binding NoiseScale, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="2"/>
                                    <TextBlock Text="Noise speed"  Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" ToolTip="How fast the noise drifts. Drives the Noise layer only."/>
                                    <Slider ToolTip="How fast the noise drifts. Drives the Noise layer only." Value="{Binding NoiseSpeed}" Minimum="0" Maximum="5" Grid.Row="4" Grid.Column="1"/>
                                    <TextBox ToolTip="How fast the noise drifts. Drives the Noise layer only." Text="{Binding NoiseSpeed, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="2"/>
                                    <TextBlock Text="Noise strength" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" ToolTip="How much of the noise shows through. Drives the Noise layer only."/>
                                    <Slider ToolTip="How much of the noise shows through. Drives the Noise layer only." view:IssueTarget.Field="jiggle.noiseStrength" Value="{Binding NoiseStrength}" Minimum="0" Maximum="0.5" Grid.Row="5" Grid.Column="1"/>
                                    <TextBox ToolTip="How much of the noise shows through. Drives the Noise layer only." Text="{Binding NoiseStrength, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="2"/>
                                    <TextBlock Text="Tint (hex)"   Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Tint, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" ToolTip="Multiplies the bust&apos;s colour. Almost always left white."/>
                                    <CheckBox Content="Pixel Snap" IsChecked="{Binding PixelSnap}" ToolTip="Rounds movement to whole pixels, matching the game&apos;s own look." Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"/>
                                    <Button Grid.Row="0" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Speed"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="1" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Strength"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="2" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Frequency"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="3" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseScale"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="4" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseSpeed"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="5" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseStrength"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="6" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Tint"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="7" Grid.Column="3" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="PixelSnap"
                                            ToolTip="Put this back to the value a new outfit starts with. Nothing else on the row changes."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Particles"
                                      Visibility="{Binding DataContext.SelectedCharacter.IsPackBust,
                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                   Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <CheckBox Content="Wet particle active on spawn"
                                              IsChecked="{Binding ParticleActive}"
                                              ToolTip="When checked, the Wet particle system (cloned from Anna_Towel) starts active. Typically enabled only for swim/wet outfit variants."/>
                                    <TextBlock Text="(The Wet preset is always attached — this controls whether it starts playing.)"
                                               Foreground="Gray" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: live preview + issues. No GridSplitter between
                         columns 2 and 3 — this panel is intentionally fixed
                         (see the columns block above for why). -->
                    <DockPanel view:TutorialAnchor.Id="panel:bustPreviewPane" Grid.Column="3" Margin="8">
                        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4"
                                   Text="{Binding SelectedCharacter.IsPackBust,
                                          Converter={x:Static conv:PreviewHeaderConverter.Instance}}"/>
                        <Border DockPanel.Dock="Top" Background="#222" Padding="4" ClipToBounds="True">
                            <!-- One preview for both kinds. A borrowed bust feeds
                                 the same control from the shipped vanilla art, so
                                 it sits in the same place and blinks, mouths and
                                 breathes the same way; only the jiggle is absent,
                                 since no mask is exported for those. -->
                            <ctl:JigglePreview x:Name="PreviewControl"
                                               view:TutorialAnchor.Id="panel:characterPreview"
                                               Margin="0,12,0,-20"
                                               VanillaBustKey="{Binding VanillaPreviewBustKey}"
                                               Outfit="{Binding SelectedOutfit}"
                                               PackRoot="{Binding PackRoot}"
                                               SelectedExpression="{Binding ElementName=ExpressionPicker, Path=SelectedItem.Content, Mode=OneWay, FallbackValue=None}"
                                               SelectedMouthFrame="{Binding ElementName=MouthPicker, Path=SelectedIndex, Mode=OneWay}"
                                               Blinking="{Binding ElementName=BlinkToggle, Path=IsChecked, Mode=OneWay}"
                                               Yapping="{Binding ElementName=YappingToggle, Path=IsChecked, Mode=OneWay}"
                                               Breathing="{Binding ElementName=BreathingToggle, Path=IsChecked, Mode=OneWay}"
                                               BreathingAmplitude="{Binding ElementName=BreathingDepth, Path=Value, Mode=OneWay}"/>
                        </Border>
                        <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mouth frame"/>
                                <ComboBox x:Name="MouthPicker" SelectedIndex="0"
                                          ToolTip="Show the bust holding one particular mouth frame. Preview only - it changes nothing in the pack.">
                                    <ComboBoxItem>Closed</ComboBoxItem>
                                    <ComboBoxItem>1</ComboBoxItem>
                                    <ComboBoxItem>2</ComboBoxItem>
                                    <ComboBoxItem>3</ComboBoxItem>
                                    <ComboBoxItem>4</ComboBoxItem>
                                </ComboBox>
                                <CheckBox ToolTip="Animate the mouth in the preview, the way it moves while a line types. Preview only." x:Name="YappingToggle" Content="Yapping" Margin="2,6,0,0"/>
                                <CheckBox x:Name="BlinkToggle" Content="Blinking" IsChecked="True" Margin="2,6,0,0"/>
                                <CheckBox ToolTip="Run the idle breathing motion in the preview. Preview only." x:Name="BreathingToggle" Content="Breathing" IsChecked="True" Margin="2,6,0,0"/>
                                <!-- Depth is a preview-only calibration: in game the
                                     offset moves the busts' parent, so its on-screen
                                     size depends on scene scale the editor can't see. -->
                                <StackPanel Orientation="Horizontal" Margin="2,2,0,0"
                                            IsEnabled="{Binding ElementName=BreathingToggle, Path=IsChecked}">
                                    <TextBlock Text="Depth" Foreground="Gray" FontSize="10" VerticalAlignment="Center"/>
                                    <Slider x:Name="BreathingDepth" Width="80" Margin="4,0,0,0"
                                            Minimum="0" Maximum="20" Value="4" VerticalAlignment="Center"
                                            ToolTip="Preview-only: how far the bust bobs, in preview pixels. Match it to the game by eye."/>
                                    <TextBlock Text="{Binding ElementName=BreathingDepth, Path=Value, StringFormat=F1}"
                                               Foreground="Gray" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Expression"/>
                                <ComboBox x:Name="ExpressionPicker" SelectedIndex="0"
                                          ToolTip="Show the bust in one particular expression. Preview only - it changes nothing in the pack.">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Happy"/>
                                    <ComboBoxItem Content="Angry"/>
                                    <ComboBoxItem Content="Sad"/>
                                    <ComboBoxItem Content="Flirty"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- (The validation Issues list moved to the ModForge tab.) -->
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 ACTORS TAB
                 ════════════════════════════════════════════════════ -->

            <!-- ════════════════════════════════════════════════════
                 NPCS TAB
                 Level NPCs — posed character sprites that live in a
                 place's NPCs hierarchy. Structurally a slim bust
                 (jiggle sprite + Blink + Wet) plus a procedural shadow.
                 WHERE each appears is authored per-place (Places tab →
                 NPC placements); this tab is the reusable look.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="NPCs">
                <Grid>
                    <!-- Column 4 (the live-preview side panel) is fixed like the
                         Busts tab: no GridSplitter, width sized to the 600px
                         NpcPreview. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="620"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="NPCs"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addNpc" Content="+ NPC" Command="{Binding AddNpcCommand}"/>
                            <Button Content="+ Folder" Tag="{Binding NpcTree}" Click="UnitAddFolder_Click"
                                    ToolTip="Add a folder. Drag items/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename" Tag="{Binding NpcTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove" Command="{Binding RemoveNpcCommand}"
                                    ToolTip="Remove the selected NPC, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding NpcTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="NpcTreeView"
                                 ItemsSource="{Binding NpcTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together."/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:npcDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedNpc}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this is called in the editor&apos;s own lists. Yours to read; the runtime name beside it is what the pack points at."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Runtime name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Stable key placements reference this NPC by."/>
                                    <TextBox ToolTip="Stable key placements reference this NPC by."  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Sprite &amp; mask (relative to pack root)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Pose sprite:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding Sprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"
                                                       ToolTip="Pose PNG. Any resolution — read at its own size, 100 px/unit, centre pivot."/>
                                    <TextBlock Text="Jiggle mask:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="1" Grid.Column="1">
                                        <Button view:TutorialAnchor.Id="btn:editMaskNpc" DockPanel.Dock="Right" Content="Edit Mask…"
                                                Margin="4,0,0,0" Padding="6,0"
                                                Click="EditNpcMask_Click"
                                                ToolTip="Open the mask painter for this NPC's jiggle mask."/>
                                        <ctl:PathPickerBox PathText="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           ToolTip="R=bounce, G=wave, B=noise, A=intensity — same convention as bust masks."/>
                                    </DockPanel>
                                    <TextBlock Text="Default sorting order:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="55" Text="{Binding SortingOrder, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Reference NPCs sit at -1 (under the level's props). Blink renders one step above; shadow uses its own order."/>
                                        <TextBlock Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Starting point only — set the real depth per placement on the Places tab, since it depends on the room."/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Jiggle (shared bust shader — NPC preset)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Speed:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ToolTip="How fast the movement cycles. Drives the Bounce and Wave layers; Noise has its own speed."/>
                                    <TextBox ToolTip="How fast the movement cycles. Drives the Bounce and Wave layers; Noise has its own speed." Text="{Binding JiggleSpeed, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Strength:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" ToolTip="How far the pixels travel. Drives the Bounce and Wave layers; Noise has its own strength."/>
                                    <TextBox ToolTip="How far the pixels travel. Drives the Bounce and Wave layers; Noise has its own strength." Text="{Binding JiggleStrength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="Wave frequency:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" ToolTip="How many waves fit down the sprite: low sways, high ripples. Drives the Wave layer only."/>
                                    <TextBox ToolTip="How many waves fit down the sprite: low sways, high ripples. Drives the Wave layer only." Text="{Binding JiggleFrequency, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Text="Noise scale:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" ToolTip="How fine the noise grain is. Drives the Noise layer only."/>
                                    <TextBox ToolTip="How fine the noise grain is. Drives the Noise layer only." Text="{Binding NoiseScale, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"/>
                                    <TextBlock Text="Noise speed:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" ToolTip="How fast the noise drifts. Drives the Noise layer only."/>
                                    <TextBox ToolTip="How fast the noise drifts. Drives the Noise layer only." Text="{Binding NoiseSpeed, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1"/>
                                    <TextBlock Text="Noise strength:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" ToolTip="How much of the noise shows through. Drives the Noise layer only."/>
                                    <TextBox ToolTip="How much of the noise shows through. Drives the Noise layer only." Text="{Binding NoiseStrength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1"/>
                                    <TextBlock Text="Tint (hex RGBA):" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding JiggleTint, UpdateSourceTrigger=PropertyChanged}" ToolTip="Multiplies the pose&apos;s colour. Almost always left white." Grid.Row="6" Grid.Column="1"/>
                                    <CheckBox Content="Pixel snap" IsChecked="{Binding PixelSnap}" ToolTip="Rounds movement to whole pixels, matching the game&apos;s own look." Grid.Row="7" Grid.Column="1" Margin="0,4,0,0"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Speed"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Strength"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Frequency"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseScale"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseSpeed"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="5" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseStrength"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="6" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Tint"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                    <Button Grid.Row="7" Grid.Column="2" Content="Default" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="PixelSnap"
                                            ToolTip="Put this back to the value a new NPC starts with. Nothing else on the row changes."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:npcBlink" Header="Blink (eyes-closed overlay — optional)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Blink sprite:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding BlinkSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"
                                                       ToolTip="Eyes-closed PNG. Blank = no blink child. Shares the NPC's jiggle material."/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Foreground="Gray" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,2,0,2"
                                               Text="Offset / rotation / scale are per-placement — edit the Blink transform on the Places tab."/>
                                    <TextBlock Text="Open wait min/max:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                                        <TextBox Text="{Binding BlinkMinWait, UpdateSourceTrigger=PropertyChanged}" ToolTip="Shortest time the eyes stay open between blinks. Each wait is drawn at random between this and the maximum." Width="70"/>
                                        <TextBox Text="{Binding BlinkMaxWait, UpdateSourceTrigger=PropertyChanged}" ToolTip="Longest time the eyes stay open between blinks." Width="70" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Closed hold:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding BlinkHold, UpdateSourceTrigger=PropertyChanged}" ToolTip="How long a blink lasts, in seconds." Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:npcReflection" Header="Reflection (mirrored copy of the pose)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="Draws the pose again, flipped downward — the floor-reflection pattern several vanilla levels build by hand. It reuses the pose's own sprite and material, so it costs one renderer and no extra art. Vanilla draws these IN FRONT of the body, which is what makes them read as lying on the floor."/>
                                    <CheckBox Content="Enabled" IsChecked="{Binding ReflectionEnabled}" ToolTip="Draw a mirrored copy beneath the pose, for wet streets and polished floors." Margin="0,0,0,4"/>
                                    <Grid Visibility="{Binding ReflectionEnabled, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Alpha:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionAlpha, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="0–1. Vanilla reflections read as a faint wash rather than a second character."/>
                                        <TextBlock Text="Tint:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionTint, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Hex colour. Defaults to the muted mauve the game's street reflections use (#AD92AA) — a reflection takes the colour of what it lies on."/>
                                        <TextBlock Text="Y offset:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionOffsetY, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="World units from the pose's origin. Negative pushes the reflection further down."/>
                                        <TextBlock Text="Sorting order:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionSortingOrder, UpdateSourceTrigger=PropertyChanged}" ToolTip="How far forward the reflection draws. Higher is nearer the viewer."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="field:npcShadow" Header="Shadow (procedural circle — deformed by transform)">
                                <StackPanel>
                                    <CheckBox Content="Enabled" IsChecked="{Binding ShadowEnabled}" ToolTip="Draw a simple shadow under the NPC, shaped by the pose&apos;s own transform." Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="Gray" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="Offset / rotation / squash are per-placement — edit the Shadow transform on the Places tab."/>
                                        <TextBlock Text="Colour (hex RGBA):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ShadowColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="The shadow&apos;s shade, as hex RGBA." Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Text="Sorting order:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ShadowSortingOrder, UpdateSourceTrigger=PropertyChanged}" ToolTip="How far forward the shadow draws. Higher is nearer the viewer." Grid.Row="2" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:npcWet" Header="Wet particles (optional)">
                                <StackPanel>
                                    <CheckBox Content="Enabled" IsChecked="{Binding WetEnabled}" ToolTip="Whether this NPC has the wet effect at all. Off by default - it suits swimwear and wet variants, not everyone." Margin="0,0,0,4"/>
                                    <CheckBox Content="Start active" IsChecked="{Binding WetStartActive}" ToolTip="Whether the wet effect is already running when the room loads, rather than waiting for something to switch it on." Margin="0,0,0,4"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                               Text="Emitter offset / rotation / scale are per-placement — edit the Wet transform on the Places tab."/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: live preview. Fixed column (no splitter), same as
                         the Busts tab — sized to the 600px NpcPreview. -->
                    <DockPanel Grid.Column="3" Margin="8" DataContext="{Binding SelectedNpc}">
                        <TextBlock DockPanel.Dock="Top" Text="Preview (live jiggle + shadow + blink)"
                                   FontWeight="Bold" Margin="0,0,0,4"/>
                        <Border DockPanel.Dock="Top" Background="#222" Padding="4" ClipToBounds="True"
                                VerticalAlignment="Top" HorizontalAlignment="Left">
                            <ctl:NpcPreview Npc="{Binding}"
                                            PackRoot="{Binding DataContext.PackRoot,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="Body jiggle, shadow and blink update live as you edit. Shadow tilt (rotation X/Y) foreshortens the ellipse; rotation Z spins it."/>
                        <Grid/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 PLACES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Places">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: places list + vanilla extensions list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Your places -->
                        <DockPanel view:TutorialAnchor.Id="panel:placeList" Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Text="Your places"
                                       FontWeight="Bold" Margin="6,4,0,2"/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button view:TutorialAnchor.Id="btn:addPlace" Content="+ Place" Command="{Binding AddPlaceCommand}"/>
                                <Button Content="+ Folder" Tag="{Binding PlaceTree}" Click="UnitAddFolder_Click"
                                        ToolTip="Add a folder. Drag items/folders to organize (cosmetic — doesn't change the pack)."/>
                                <Button Content="Rename" Tag="{Binding PlaceTree}" Click="UnitRenameFolder_Click"
                                        ToolTip="Rename the selected folder."/>
                                <Button Content="− Remove" Command="{Binding RemovePlaceCommand}"
                                        ToolTip="Remove the selected place, or delete the selected folder (its contents move up)."/>
                            </ToolBar>
                            <ContentControl DockPanel.Dock="Top" Focusable="False"
                                            DataContext="{Binding PlaceTree.Filter}"
                                            Template="{StaticResource SidebarSearchTemplate}"/>
                            <TreeView x:Name="PlaceTreeView"
                                 ItemsSource="{Binding PlaceTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item."/>
                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="4" Background="LightGray"
                                      HorizontalAlignment="Stretch"/>

                        <!-- Vanilla extensions: buttons added to vanilla nav strips -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="Vanilla extensions"
                                       FontWeight="Bold" Margin="6,4,0,2"
                                       ToolTip="Add buttons to existing (vanilla) places' navigator strips — e.g. an entry-point button on Beach that goes to your custom Secret Cave."/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button view:TutorialAnchor.Id="btn:addVanillaSource" Content="+ Source" Command="{Binding AddVanillaExtensionCommand}"
                                        ToolTip="Pick a vanilla place to attach buttons to"/>
                                <Button Content="− Remove" Command="{Binding RemoveVanillaExtensionCommand}"/>
                            </ToolBar>
                            <ListBox x:Name="VanillaExtList"
                                     ItemsSource="{Binding VanillaExtensions}"
                                     SelectedItem="{Binding SelectedVanillaExtension}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VanillaPlaceExtensionViewModel}">
                                        <DockPanel>
                                            <!-- Two markers, because adding to a level and reaching
                                                 into the level's own objects are different degrees
                                                 of intrusion. The editor fills every extension's
                                                 tree in from the catalog so it can be edited, and
                                                 those mirror nodes save as nothing — neither chip
                                                 counts them.
                                                 ~N (accent) = vanilla objects this changes.
                                                 +N (muted)  = GameObjects it adds. -->
                                            <Border DockPanel.Dock="Right" Margin="4,0,0,0" Padding="4,0"
                                                    CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource Theme.Accent}"
                                                    Visibility="{Binding HasModified, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="{Binding ModifiedCount, StringFormat='Changes {0} existing vanilla GameObject(s) — moved, switched, gated, or given components'}">
                                                <TextBlock Text="{Binding ModifiedCount, StringFormat='~{0}'}" FontSize="10"/>
                                            </Border>
                                            <Border DockPanel.Dock="Right" Margin="4,0,0,0" Padding="4,0"
                                                    CornerRadius="2" VerticalAlignment="Center"
                                                    Background="#55808080"
                                                    Visibility="{Binding HasAdded, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="{Binding AddedCount, StringFormat='Adds {0} new GameObject(s); existing vanilla objects are untouched'}">
                                                <TextBlock Text="{Binding AddedCount, StringFormat='+{0}'}" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: editor pane — switches between Place editor and Vanilla-extension editor based on selection -->
                    <Grid Grid.Column="2">
                        <!-- Vanilla extension editor (shown when SelectedVanillaExtension is non-null) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedVanillaExtension}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                            <StackPanel Margin="8">
                                <!-- Preview of the vanilla level itself, from the extracted
                                     art. Bound nodes carry no sprite, so what renders is the
                                     level plus whatever this extension actually adds. -->
                                <GroupBox Header="Preview">
                                    <StackPanel>
                                        <ctl:PlacePreview x:Name="ExtPreview" Margin="200,0"
                                                          PackRoot="{Binding DataContext.PackRoot,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                          BaseSprite="{Binding PreviewBaseSprite}"
                                                          SecondarySprite="{Binding PreviewSecondarySprite}"
                                                          LevelArtOrder="{Binding PreviewArtOrder}"
                                                          LevelArtSecondaryOrder="{Binding PreviewArtSecondaryOrder}"
                                                          LevelParallax="{Binding PreviewLevelParallax}"
                                                          LevelParallaxSecondary="{Binding PreviewLevelParallaxSecondary}"
                                                          LevelParallaxReversed="{Binding PreviewLevelParallaxReversed}"
                                                          LevelParallaxSecondaryReversed="{Binding PreviewLevelParallaxSecondaryReversed}"
                                                          ParallaxPreview="{Binding IsChecked, ElementName=ExtParallaxPreview}"
                                                          Shaders="{Binding IsChecked, ElementName=ExtShaders}"
                                                          LevelArtPpu="{Binding PreviewArtPpu}"
                                                          LevelScale="{Binding PreviewLevelScale}"
                                                          DimUnderInactiveParent="{Binding IsChecked, ElementName=ExtDimParent}"
                                                          DimInactive="{Binding IsChecked, ElementName=ExtDimSelf}"
                                                          GameObjects="{Binding GameObjects}"
                                                          NpcCatalog="{Binding DataContext.Npcs,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <CheckBox x:Name="ExtDimParent" IsChecked="True" Content="Fade under an inactive parent"
                                                      ToolTip="The game draws nothing beneath a switched-off parent, so these are faded to show the room as it really loads. Untick while positioning that content."/>
                                            <CheckBox x:Name="ExtDimSelf" IsChecked="True" Content="Fade objects that start inactive" Margin="12,0,0,0"
                                                      ToolTip="Objects parked for a rule to switch on. Untick to see them at full strength while you place them."/>
                                            <CheckBox x:Name="ExtParallaxPreview" IsChecked="False" Content="Preview parallax" Margin="12,0,0,0"
                                                      ToolTip="Drift the scene with the cursor, as the game does — including each vanilla object's own effect, read from the extraction. Viewing only. Leave off while positioning."/>
                                            <CheckBox x:Name="ExtShaders" IsChecked="False" Content="Apply shaders" Margin="12,0,0,0"
                                                      ToolTip="Run the real JiggleSprite pass over NPCs that have a jiggle mask, using this pack's own uniforms. Animated, so it costs a little CPU; leave off while positioning."/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CatalogSummary}" Foreground="Gray"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox view:TutorialAnchor.Id="panel:vanillaSource" Header="Vanilla source">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Source place:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox ToolTip="Which of the game&apos;s own places this extension attaches to. What you add below appears when the player is there." Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.VanillaSourceOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Token"
                                                  SelectedValue="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Text="The buttons below will appear on this vanilla place's navigator strip when the player is there."/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox view:TutorialAnchor.Id="panel:extNavigatorButtons" Header="Navigator buttons (added to this vanilla place's strip)">
                                    <DockPanel>
                                        <Button view:TutorialAnchor.Id="btn:addExtNavigatorButton" DockPanel.Dock="Bottom" Content="+ Add navigator button"
                                                Command="{Binding DataContext.AddVanillaExtensionButtonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                        <ItemsControl ItemsSource="{Binding NavigatorButtons}"
                                                      ItemTemplate="{StaticResource NavigatorButtonRowTemplate}"/>
                                    </DockPanel>
                                </GroupBox>

                                <GroupBox Header="GameObjects (layered on this vanilla place)">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="+ Add GameObject"
                                                    Command="{Binding DataContext.AddVanillaExtensionGameObjectCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,2"/>
                                            <Button Content="+ Add NPC" Margin="6,0,0,0" Padding="8,2"
                                                    Command="{Binding AddNpcCommand}"
                                                    ToolTip="Place an NPC under this vanilla level's own NPCs object. To hang it under a specific container instead, use the NPCs section on that container."/>
                                            <Button Content="Fill from vanilla hierarchy" Margin="6,0,0,0" Padding="8,2"
                                                    Command="{Binding SeedFromCatalogCommand}"
                                                    ToolTip="Add a bound node for every object the extracted catalog says this level has, seeded with its real transform. Existing entries are left alone, so it's safe to re-run — it just tops up anything new."/>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="GameObjects instantiated under the vanilla level (props, decorations, animated layers) — the pack decorates the level without owning it. Same authoring surface as a pack place's GameObjects: nest children, attach utility components, and target by Name from dialogue actions. Use 'Fill from vanilla hierarchy' to pull in the level's real objects as bound nodes you can modify; anything you leave untouched is dropped on save, so the pack only ever stores what it actually changes."/>
                                        <ItemsControl ItemsSource="{Binding GameObjects}"/>
                                    </DockPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Place editor (shown when SelectedPlace is non-null) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedPlace}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── composites secondary + base sprites with GameplayUI overlay
                                 and the live navigator buttons, same z-order as runtime. -->
                            <GroupBox view:TutorialAnchor.Id="panel:placePreview" Header="Preview">
                                <StackPanel>
                                    <ctl:PlacePreview x:Name="PlacePreviewMain" Margin="200,0"
                                                      PackRoot="{Binding DataContext.PackRoot,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                      BaseSprite="{Binding BaseSprite}"
                                                      SecondarySprite="{Binding SecondarySprite}"
                                                      MaskSprite="{Binding MaskSprite}"
                                                      SecondaryMaskSprite="{Binding SecondaryMaskSprite}"
                                                      LiveMaskBgra="{Binding LiveBaseMask}"
                                                      LiveSecondaryMaskBgra="{Binding LiveSecondaryMask}"
                                                      Buttons="{Binding NavigatorButtons}"
                                                      DimUnderInactiveParent="{Binding IsChecked, ElementName=PlaceDimParent}"
                                                      DimInactive="{Binding IsChecked, ElementName=PlaceDimSelf}"
                                                      GameObjects="{Binding GameObjects}"
                                                      LevelArtOrder="{Binding BaseSortingOrder}"
                                                      LevelArtSecondaryOrder="{Binding SecondarySortingOrder}"
                                                      LevelParallax="{Binding ParallaxStrength}"
                                                      LevelParallaxSecondary="{Binding ParallaxSecondaryStrength}"
                                                      LevelParallaxReversed="{Binding ParallaxReversed}"
                                                      LevelParallaxSecondaryReversed="{Binding ParallaxSecondaryReversed}"
                                                      ParallaxPreview="{Binding IsChecked, ElementName=PlaceParallaxPreview}"
                                                      Shaders="{Binding IsChecked, ElementName=PlaceShaders}"
                                                      NpcCatalog="{Binding DataContext.Npcs,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox x:Name="PlaceDimParent" IsChecked="True" Content="Fade under an inactive parent"
                                                  ToolTip="The game draws nothing beneath a switched-off parent, so these are faded to show the room as it really loads. Untick while positioning that content."/>
                                        <CheckBox x:Name="PlaceDimSelf" IsChecked="True" Content="Fade objects that start inactive" Margin="12,0,0,0"
                                                  ToolTip="Objects parked for a rule to switch on. Untick to see them at full strength while you place them."/>
                                        <CheckBox x:Name="PlaceParallaxPreview" IsChecked="False" Content="Preview parallax" Margin="12,0,0,0"
                                                  ToolTip="Drift the scene with the cursor, as the game does. Each layer moves by its own strength plus every parent's, and vertical travel is half horizontal. Viewing only — nothing moves in the pack. Leave off while positioning."/>
                                        <CheckBox x:Name="PlaceShaders" IsChecked="False" Content="Apply shaders" Margin="12,0,0,0"
                                                  ToolTip="Run the real JiggleSprite pass over NPCs that have a jiggle mask, using this pack's own uniforms — the same code and the same numbers the game runs. Animated, so it costs a little CPU; leave off while positioning."/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name (button):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this is called in the editor&apos;s own lists. Yours to read; the runtime name beside it is what the pack points at."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="(Used on the in-game map button label.)"
                                               Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                    <TextBlock Text="Runtime name:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="What conditions/actions and navigator targets reference this place by (place:&lt;name&gt;)."/>
                                    <TextBox ToolTip="What conditions/actions and navigator targets reference this place by (place:&lt;name&gt;)."  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Text="Internal GO name:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="internalName" Text="{Binding InternalName, UpdateSourceTrigger=PropertyChanged}" ToolTip="The object the level is built as in game." Grid.Row="3" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Level art (paths relative to pack root)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- The editor names these two layers BACK and FRONT, by where they
                                         draw. The manifest calls them baseSprite and secondarySprite,
                                         which is the game's own naming and is the source of the confusion
                                         this replaced: baseSprite is the layer IN FRONT (-10), with
                                         secondarySprite behind it (-12), so "base" means the opposite of
                                         what anyone expects a base to be.
                                    
                                         Back/front cannot be read backwards, so the editor says that and
                                         the format is left alone. Nothing here is rebound — each row still
                                         points at the property it always did. Every tooltip names the key
                                         it writes, so the mapping is never something to infer. Listed back
                                         to front, with each mask under the sprite it belongs to. -->
                                    <TextBlock Text="Back sprite (2048×1136):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="The layer drawn BEHIND — usually the room itself, or the distance seen past it. Sorting order −12 by default. Written to the pack as secondarySprite."/>
                                    <ctl:PathPickerBox ToolTip="The layer drawn BEHIND — usually the room itself, or the distance seen past it. Sorting order −12 by default. Written to the pack as secondarySprite." view:TutorialAnchor.Id="field:placeSecondarySprite" view:IssueTarget.Field="secondarySprite"
                                                       PathText="{Binding SecondarySprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Front sprite (2048×1136):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="The layer drawn IN FRONT of the back one — an object standing in the room, or a foreground the player looks past. Sorting order −10 by default. Written to the pack as baseSprite."/>
                                    <ctl:PathPickerBox ToolTip="The layer drawn IN FRONT of the back one — an object standing in the room, or a foreground the player looks past. Sorting order −10 by default. Written to the pack as baseSprite." view:TutorialAnchor.Id="field:placeBaseSprite" view:IssueTarget.Field="baseSprite"
                                                       PathText="{Binding BaseSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="Sorting order:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="back" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding SecondarySortingOrder, UpdateSourceTrigger=PropertyChanged}" Width="55"
                                                 ToolTip="Sorting order of the back sprite. −12 is the prototype's; vanilla levels use −12 or −15. Written as secondarySortingOrder."/>
                                        <TextBlock Text="front" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        <TextBox Text="{Binding BaseSortingOrder, UpdateSourceTrigger=PropertyChanged}" Width="55"
                                                 ToolTip="SpriteRenderer sorting order of the front sprite. −10 is the prototype's, and what all but four vanilla levels use. Lower it to park objects behind the level art. Written as baseSortingOrder."/>
                                    </StackPanel>
                                    <TextBlock Text="Every sprite in the game shares one sorting layer, so order alone decides what draws in front."
                                               Grid.Row="6" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <!-- Each mask names the sprite it belongs to, in the same
                                         order as the two sprite rows above, so the four read as
                                         pairs: "Back mask" edits secondaryMaskSprite. -->
                                    <TextBlock Text="Back mask (opt):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding SecondaryMaskSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="2" Grid.Column="1"
                                                       ToolTip="Optional, and bound as _MaskTex on the BACK sprite's material. Vanilla leaves that sprite on a plain material with nothing to displace it; setting a mask here gives it its own clone of the level's jiggle material, so water or foliage behind the room can move independently. Blank = vanilla behaviour. Written as secondaryMaskSprite."/>
                                    <Button Content="Edit…" Grid.Row="2" Grid.Column="2" Margin="4,0,0,0" Padding="8,0"
                                            Click="EditPlaceSecondaryMask_Click"
                                            ToolTip="Paint this mask over the back art."/>
                                    <TextBlock Text="Front mask (256×143):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox view:IssueTarget.Field="maskSprite"
                                                       PathText="{Binding MaskSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="3" Grid.Column="1"
                                                       ToolTip="Bound as _MaskTex on the FRONT sprite's material only. The back sprite and every GameObject in the place are unaffected. Loaded as linear data, not colour, because it carries amounts rather than pixels. Written as maskSprite."/>
                                    <Button Content="Edit…" Grid.Row="3" Grid.Column="2" Margin="4,0,0,0" Padding="8,0"
                                            Click="EditPlaceMask_Click"
                                            ToolTip="Paint this mask over the front art. One intensity plane, authored in alpha — the level shader reads nothing else."/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                               Text="The mod clones the Beach level and swaps in these PNGs. Each mask binds as _MaskTex on its own sprite's material, cloned per level so it can't leak into the vanilla levels that share Beach's. Only the mask's ALPHA is read — this shader has no R/G/B channels."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Behaviour">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Parallax — front:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider view:IssueTarget.Field="parallaxStrength" Value="{Binding ParallaxStrength}" Minimum="0" Maximum="1.5" Grid.Row="0" Grid.Column="1"
                                            ToolTip="How far the front sprite slides with the cursor. Every vanilla level uses 0.75. Written as parallaxStrength."/>
                                    <TextBox Text="{Binding ParallaxStrength, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="2" ToolTip="How far the front layer slides as the cursor moves. Every place in the game uses the same value, so start there."/>
                                    <TextBlock Text="Parallax — back:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <StackPanel view:TutorialAnchor.Id="field:parallax" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Content="Same as front" IsChecked="{Binding ParallaxSecondaryLinked}" VerticalAlignment="Center"
                                                  ToolTip="On (the default for an existing place) makes the back sprite copy the front, exactly as before this setting existed. Turn it off to give the level depth."/>
                                        <Slider view:IssueTarget.Field="parallaxSecondaryStrength" Value="{Binding ParallaxSecondaryStrength}" Minimum="0" Maximum="1.5"
                                                Width="150" VerticalAlignment="Center" Margin="10,0,0,0"
                                                IsEnabled="{Binding ParallaxSecondaryLinked, Converter={StaticResource InverseBoolConverter}}"
                                                ToolTip="The back sprite. THIS is what creates the depth — set it away from the front. Vanilla uses 0.1 or 0.5 for a far background, 1.5 for one that overshoots the room. Written as parallaxSecondaryStrength."/>
                                        <TextBox Text="{Binding ParallaxSecondaryStrength, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" ToolTip="The back layer&apos;s own drift. Setting it away from the front is what creates depth."
                                                 Width="60" VerticalAlignment="Center" Margin="6,0,0,0"
                                                 IsEnabled="{Binding ParallaxSecondaryLinked, Converter={StaticResource InverseBoolConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Content="Reverse back" IsChecked="{Binding ParallaxReversed}"
                                                  ToolTip="Front sprite drifts WITH the cursor instead of against it."/>
                                        <CheckBox Content="Reverse front" IsChecked="{Binding ParallaxSecondaryReversed}" Margin="12,0,0,0"
                                                  ToolTip="Back sprite drifts opposite the front art. Vanilla does this once, in 53_Hotelroom."/>
                                    </StackPanel>
                                    <TextBlock Text="Equal values slide the level as one flat card — the difference between them is the effect."
                                               Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Foreground="Gray" FontSize="10" Margin="0,2,0,0"/>
                                    <CheckBox Content="Keep beach audio (ocean ambience)"
                                              IsChecked="{Binding KeepAudio}" ToolTip="Carry the ocean ambience over from the beach this place is built on. Off for indoor rooms."
                                              Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"/>
                                    <CheckBox Content="Keep seagulls (particle system from Beach)"
                                              IsChecked="{Binding KeepSeagulls}" ToolTip="Carry the seagull particles over from the beach this place is built on. Independent of the audio."
                                              Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"/>
                                    <TextBlock Text="Weather:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <ComboBox SelectedItem="{Binding WeatherType}" ToolTip="Whether the game&apos;s rain and snow run here. None is no weather, Inside is the muted indoor version seen through windows, Outside is the full effect."
                                              Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <ComboBox.ItemsSource>
                                            <x:Array Type="{x:Type model:WeatherType}">
                                                <model:WeatherType>None</model:WeatherType>
                                                <model:WeatherType>Inside</model:WeatherType>
                                                <model:WeatherType>Outside</model:WeatherType>
                                            </x:Array>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:navigatorButtons" Header="Navigator buttons (visible while this place is active)">
                                <DockPanel>
                                    <DockPanel.Resources>
                                        <Style TargetType="TextBlock" x:Key="ColHeader">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </Style>
                                    </DockPanel.Resources>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button view:TutorialAnchor.Id="btn:addNavigatorButton" Content="+ Add navigator button"
                                                Command="{Binding DataContext.AddNavigatorButtonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,2"/>
                                        <TextBlock Text="{Binding NavigatorButtonCountLabel}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"
                                                   ToolTip="Maximum 12 navigator buttons per place."/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Up to 12 buttons per place. Order = runtime instantiation order = on-screen left→right; use ▲▼ to reorder. The preview shows them numbered in this order. The mod-side loader resolves target names into level indices at load time, so two mods can both add buttons without colliding."/>
                                    <ItemsControl ItemsSource="{Binding NavigatorButtons}"
                                                  ItemTemplate="{StaticResource NavigatorButtonRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:placeGameObjects" Header="GameObjects (this place's scene hierarchy)">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="+ Add GameObject"
                                                Command="{Binding DataContext.AddGameObjectCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,2"/>
                                        <Button view:TutorialAnchor.Id="btn:addNpcToPlace" Content="+ Add NPC" Margin="6,0,0,0" Padding="8,2"
                                                Command="{Binding AddNpcCommand}"
                                                ToolTip="Place an NPC under this level's NPCs object. To hang it under a specific container instead, use the NPCs section on that container."/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Everything this place builds under its level, as one hierarchy. A GameObject with a Sprite is a layered sprite object (backdrop, prop, animated layer); leave the Sprite blank for a pure container that just groups children. Every node takes utility components (fade, disappear, random child, blink), nested children, and NPC placements. The NPCs node is the level's own NPCs object — always present, and the home for the NPC hierarchy; its subtree composes local transforms down the chain, so moving a container moves everything under it. Target any node from dialogue by Name with SetGameObjectActive / FadeSprite / MoveGameObject / SpinGameObject. Lower sorting draws further back."/>
                                    <ItemsControl ItemsSource="{Binding GameObjects}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="On enter (once per level activation)">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="+ Add action group"
                                            Command="{Binding AddEnterHookCommand}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="Action groups run once each time this level flips inactive → active. Each group's conditions are checked at that moment; passing groups run their actions. Re-entering runs them again — gate with a variable for one-time effects."/>
                                    <ItemsControl ItemsSource="{Binding OnEnterHooks}"
                                                  ItemTemplate="{StaticResource LevelHookRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="On exit (once per level deactivation)">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="+ Add action group"
                                            Command="{Binding AddExitHookCommand}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="Same as On enter, but on the active → inactive edge (the player leaving the level)."/>
                                    <ItemsControl ItemsSource="{Binding OnExitHooks}"
                                                  ItemTemplate="{StaticResource LevelHookRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 MAP BUTTONS TAB
                 World Map radial buttons (e.g. the host mod-style
                 "House for Sale" button under the Foundry district).
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Map Buttons">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="Gray" TextWrapping="Wrap"
                               Text="Radial buttons added to the World Map's district menus. Each button travels to its target place when clicked, with optional music swap (e.g. MyTrack)."/>
                    <ToolBar DockPanel.Dock="Top">
                        <Button view:TutorialAnchor.Id="btn:addMapButton" Content="+ Map button" Command="{Binding AddMapButtonCommand}"/>
                        <Button Content="− Remove selected" Command="{Binding RemoveMapButtonCommand}"/>
                    </ToolBar>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!--
                            Top-aligned, and the anchor is on the list rather than the
                            scroller around it. A ScrollViewer stretches content that
                            is smaller than its viewport, so both reported the full
                            height of the tab — which made the spotlight cover
                            everything and left the callout no corner to sit in
                            except on top of the fields.
                        -->
                        <ItemsControl x:Name="MapButtonList"
                                      view:TutorialAnchor.Id="panel:mapButtonList"
                                      VerticalAlignment="Top"
                                      ItemsSource="{Binding MapButtons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MapButtonViewModel}">
                                    <Border BorderBrush="LightGray" BorderThickness="1"
                                            CornerRadius="3" Padding="8" Margin="0,0,0,6"
                                            MouseDown="MapButtonRow_MouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Summary header -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Display}" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="−" Width="22" Height="22"
                                                    Padding="0" Margin="4,0,0,0"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove this map button"/>

                                            <!-- Target -->
                                            <TextBlock Text="Target place:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding DataContext.AllTargetOptions,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Token"
                                                      SelectedValue="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemTemplate="{StaticResource TargetOptionItemTemplate}"
                                                      IsEditable="True"
                                                      Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- District -->
                                            <TextBlock Text="District:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding DataContext.WorldMapDistrictOptions,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Token"
                                                      DisplayMemberPath="DisplayLabel"
                                                      SelectedValue="{Binding District, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="World Map radial menu the button is placed under"/>

                                            <!-- Label -->
                                            <TextBlock Text="Label:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Button text (e.g. 'House for Sale'). Supports [PV:variableName] tokens that re-resolve live from String pack variables — change the variable via a dialogue action or Integration rule and the button renames in place."/>

                                            <!-- Music -->
                                            <TextBlock Text="Music (optional):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Optional child name under 12_AudioPlayer to enable on click (e.g. MyTrack)"/>

                                            <!-- Visibility conditions — same row shape the
                                                 navigator buttons use. All must pass for the
                                                 button to render inside its district menu. -->
                                            <TextBlock Text="Conditions:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                                                <ItemsControl ItemsSource="{Binding Conditions}"
                                                              ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Content="+ Add condition" Margin="0,0,4,0" Padding="6,2"
                                                            Command="{Binding AddConditionCommand}"/>
                                                    <Button Content="+ Add group" Padding="6,2"
                                                            ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                            Command="{Binding AddConditionGroupCommand}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 DIALOGUES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Dialogues">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DlgListCol" Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="DlgMiddleCol" Width="380"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: dialogues folder tree (cosmetic grouping; drag to organize). -->
                    <DockPanel view:TutorialAnchor.Id="panel:dialogueList" Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Dialogues"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addDialogue" Content="+ Dialogue" Command="{Binding AddDialogueCommand}"/>
                            <Button Content="+ Folder"   Command="{Binding AddDialogueFolderCommand}"
                                    ToolTip="Add a folder. Drag dialogues/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename"     Click="RenameFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove"   Command="{Binding RemoveDialogueCommand}"
                                    ToolTip="Remove the selected dialogue, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding DialogueTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="DialogueTreeView"
                                  ItemsSource="{Binding DialogueTree}"
                                  SelectedItemChanged="DialogueTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="DialogueTree_PreviewMouseLeftButtonDown"
                                  MouseMove="DialogueTree_MouseMove"
                                  Drop="DialogueTree_Drop"
                                  ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item.">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <!-- Ctrl/Shift multi-selection ride-alongs. Semi-transparent
                                             so it reads on light and dark themes alike. -->
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter Property="Background" Value="#5578A8E0"/>
                                        </DataTrigger>
                                                                            <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
</Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:DialogueFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:DialogueLeafNode}">
                                    <TextBlock Text="{Binding Dialogue.Display}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: selected dialogue (properties + node list) -->
                    <!-- HorizontalScrollBarVisibility=Disabled is load-bearing: without it the
                         ScrollViewer defaults to Hidden, which still measures its content at
                         INFINITE width. That sizes the node list to the widest node's full text,
                         so the cards hard-clip at the viewport edge instead of trimming with an
                         ellipsis at the real column edge (and they ignore the column widening). -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  DataContext="{Binding SelectedDialogue}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this dialogue is called in the editor&apos;s own lists. The only name you need to write — the runtime name beside it follows along until you set one yourself."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Runtime name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Stable identifier — what jumps, logs and other packs reference this dialogue by. Filled in from the display name while you have not set one yourself; type here and it stops following, so an established dialogue is never renamed underneath whatever already points at it."/>
                                    <TextBox ToolTip="Stable identifier — what jumps, logs and other packs reference this dialogue by. Filled in from the display name while you have not set one yourself; type here and it stops following, so an established dialogue is never renamed underneath whatever already points at it."  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    <!-- The roomtalk picker is gone: dialogues are hosted on a
                                         per-pack always-active container, and the only remaining
                                         use for a roomtalk — taking priority over vanilla — is
                                         determined by the level, so it is derived rather than
                                         chosen. -->
                                    <CheckBox Content="Prioritize this dialogue over vanilla"
                                              IsChecked="{Binding DisableVanillaTrigger}"
                                              IsEnabled="{Binding LevelHasVanillaRoomTalk}"
                                              Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="Suppresses the vanilla room's own entry dialogue while this one's start conditions hold, so yours plays instead of competing with it. Only available in vanilla rooms that have an entry dialogue to suppress."/>
                                    <CheckBox Content="Also leave on the Talk button (replayable)"
                                              IsChecked="{Binding ReplayOnTalk}"
                                              IsEnabled="{Binding CanEditReplayOnTalk}"
                                              Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="Play on arrival like normal, AND stay on the vanilla Talk button so the player can hear it again — for as long as its start conditions still hold. Without this a dialogue interrupts once and is then gone until its conditions fail and pass again. Greyed out when 'Wait for Talk button' is on, which already leaves it there."/>
                                    <CheckBox Content="Wait for Talk button (no auto-play)"
                                              IsChecked="{Binding Queued}"
                                              IsEnabled="{Binding CanEditQueued}"
                                              Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="Don't start on arrival: the dialogue parks behind the vanilla Talk button, and the player starts it by clicking (with the normal cinematic fade). No jump-scare on level entry. Greyed out when the replay option above is on — that one plays on arrival, which is the opposite of waiting."/>
                                    <CheckBox Content="Queue behind active dialogue"
                                              IsChecked="{Binding QueueBehind}"
                                              Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="If another dialogue is playing when this one's conditions pass, wait and start right after it ends. Unchecked (original behavior): it misses that window and only fires when its conditions trigger again while nothing is playing."/>
                                    <CheckBox Content="Set for condition debugging (F12)"
                                              IsChecked="{Binding DebugConditions}"
                                              Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="In-game, pressing F12 logs a pass/fail breakdown of this dialogue's start conditions (with current variable values) to the BepInEx console. Diagnostic only — no gameplay effect."/>
                                    <TextBlock Text="Priority:" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="8" Grid.Column="1" Margin="0,4,0,0" Width="60" HorizontalAlignment="Left"
                                              ToolTip="When several dialogues become eligible on the same tick, the highest priority starts first (ties: manifest order). Default 0."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Start conditions (all must pass)">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add condition" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddDialogueStartConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="+ Add group" Padding="8,2"
                                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                Command="{Binding DataContext.AddDialogueStartConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyStartConditionsCommand}"
                                                ToolTip="Copy these start conditions (except the pinned level gate) to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteStartConditionsCommand}"
                                                ToolTip="Append clipboard conditions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteStartConditionsCommand}"
                                                ToolTip="Replace these start conditions with the clipboard (keeps the pinned level gate)"/>
                                    </StackPanel>
                                    <ItemsControl view:TutorialAnchor.Id="field:startConditions" view:IssueTarget.Field="startConditions"
                                                  ItemsSource="{Binding StartConditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:dialogueNodes" Header="Nodes">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="Click a node to select it. + Child and + Sibling copy everything from the selected node except its text (and its tag), and land directly under it. Drag a node to move it (with its children): drop on the upper or lower edge of a row to place it before or after as a sibling, drop on the middle to make it a child, or drop below the list to make it a root. Ctrl+C / Ctrl+V copy a node and its children and paste them below the selection; Del removes the selected node. Nodes play top to bottom, exactly as listed. Roots are listed below."/>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
                                               Text="{Binding RootsSummary, StringFormat=Roots: {0}}" Foreground="Gray"/>
                                    <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,6,0,0">
                                        <Button view:TutorialAnchor.Id="btn:addRootNode" Content="+ Root" Margin="0,0,2,0"
                                                Command="{Binding DataContext.AddDialogueRootNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Add a new top-level node (no parent)."/>
                                        <Button Content="+ Child" Margin="2,0,2,0"
                                                Command="{Binding DataContext.AddDialogueChildNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Add a child of the currently-selected node, copying its actor, expression, outfit, conditions and actions — everything but the text and the jump tag."/>
                                        <Button Content="+ Sibling" Margin="2,0,2,0"
                                                Command="{Binding DataContext.AddDialogueSiblingNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Add a node directly below the selected one, sharing its parent (or another root when the selection is a root). Copies everything but the text and the jump tag."/>
                                        <Button Content="− Remove" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RemoveDialogueNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Delete the selected node. References to it from other nodes' children + the root list are scrubbed automatically."/>
                                    </UniformGrid>
                                    <ListBox x:Name="NodeList"
                                             ItemsSource="{Binding Nodes}"
                                             SelectedItem="{Binding DataContext.SelectedNode,
                                                            RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="240"
                                             PreviewMouseWheel="NodeList_PreviewMouseWheel"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="NodeList_PreviewMouseLeftButtonDown"
                                             MouseMove="NodeList_MouseMove"
                                             DragOver="NodeList_DragOver"
                                             DragLeave="NodeList_DragLeave"
                                             Drop="NodeList_Drop"
                                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <!-- Copy/paste a node subtree (cross-dialogue). Commands live on
                                             the MainViewModel, reached via the ListBox's Tag because a
                                             ContextMenu isn't in the visual tree. The Ctrl+C/Ctrl+V
                                             gestures are registered in code-behind against this ListBox
                                             (RegisterListShortcuts), so they only fire while the node
                                             list has focus — InputGestureText below is just the label. -->
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy node (+ children)" InputGestureText="Ctrl+C"
                                                          Command="{Binding PlacementTarget.Tag.CopyNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Paste below (sibling)" InputGestureText="Ctrl+V"
                                                          ToolTip="Paste the copied subtree directly under the selected node, sharing its parent."
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeSiblingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Paste as child"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Paste as new root"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <!--
                                                Tree-style rendering of the flat node list. Each
                                                node's IndentMargin is computed by
                                                DialogueViewModel.RecomputeDepths after every
                                                Add/Remove/ToggleRoot operation, so children
                                                visually sit underneath their parents without us
                                                having to switch the control to a TreeView.
                                            -->
                                            <DataTemplate DataType="{x:Type vm:DialogueNodeViewModel}">
                                                <!-- Speaker wash: the actor's colour from the Actors tab at low
                                                     alpha, spanning the full row width so a change of speaker is
                                                     obvious scanning down the list. Semi-transparent on purpose —
                                                     it sits over the selection highlight rather than hiding it,
                                                     and is Transparent when the node has no actor / no colour. -->
                                                <Border Background="{Binding ActorTintBrush}"
                                                        CornerRadius="2" Padding="0,1">
                                                <!-- DockPanel (not a horizontal StackPanel) so the line fills the
                                                     remaining width and rescales with the column, rather than
                                                     being laid out at its natural width and overrunning. -->
                                                <DockPanel Margin="{Binding IndentMargin}">
                                                    <!-- Kind glyph: ▸ Text, ⇄ Choice, ? Random, ◆ answer (child of a Choice). -->
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding KindGlyph}" Width="14"
                                                               FontWeight="Bold" TextAlignment="Center"/>
                                                    <!-- Tag chip: marks a node other nodes can Jump to, and shows
                                                         the tag itself so a jump target is findable at a glance. -->
                                                    <Border DockPanel.Dock="Right" Margin="4,0,0,0" Padding="4,0"
                                                            CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{DynamicResource Theme.Accent}"
                                                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{Binding Tag, StringFormat='Jump target — tag: {0}'}">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                                                    </Border>
                                                    <!-- Speaker prefix stays a plain TextBlock: it is a
                                                         character NAME, and running it through the spell
                                                         checker would squiggle the whole cast. -->
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding SpeakerPrefix}"
                                                               Margin="3,0,0,0" ToolTip="{Binding Display}"/>
                                                    <!--
                                                        The line itself is a TextBox, not a TextBlock, purely so
                                                        Windows will squiggle misspellings here too — WPF only
                                                        spell-checks TextBox/RichTextBox.

                                                        It must stay EDITABLE: IsReadOnly="True" silently turns
                                                        spell checking off. Focusable + IsHitTestVisible false is
                                                        what makes it inert instead — clicks fall through to the
                                                        row so selection and drag-and-drop still work, and there
                                                        is no way to put a caret in it. The binding is OneWay as
                                                        a second guard.

                                                        Padding/Margin/MinHeight are zeroed because App.xaml's
                                                        TextBox style adds 4,2 padding and a 2px margin, which
                                                        would make every row taller and push the text out of
                                                        line with the glyph.

                                                        Known trade-off: TextBox has no TextTrimming, so a long
                                                        line clips at the column edge instead of ending in "…".
                                                        The full text is on the row ToolTip.
                                                    -->
                                                    <TextBox Text="{Binding TextPreview, Mode=OneWay}"
                                                             ToolTip="{Binding Display}"
                                                             Focusable="False" IsHitTestVisible="False"
                                                             IsTabStop="False"
                                                             Background="Transparent" BorderThickness="0"
                                                             Padding="0" Margin="0" MinHeight="0"
                                                             VerticalContentAlignment="Center"
                                                             TextWrapping="NoWrap"
                                                             Language="en-US"
                                                             SpellCheck.IsEnabled="{Binding DataContext.SpellCheckNodeText,
                                                                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Column="3" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- RIGHT: selected node editor -->
                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedNode}">
                        <StackPanel Margin="8">
                            <!-- Live preview of what the player will see during this node:
                                 derives the bust from the selected actor's default key
                                 (looked up through the MainViewModel.SelectedNodeActorBustKey
                                 helper) and the expression from the node's Expression field. -->
                            <GroupBox Header="Preview">
                                <ctl:BustPreview MainViewModel="{Binding DataContext,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                 BustKey="{Binding DataContext.SelectedNodeActorBustKey,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                 ExpressionKey="{Binding Expression}"/>
                            </GroupBox>
                            <GroupBox view:TutorialAnchor.Id="panel:nodeEditor" Header="Node">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ID:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Id}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBlock Text="Kind:"        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox ToolTip="Text plays a line. Choice offers this node&apos;s children and lets the player pick one. Random picks one of them itself." view:TutorialAnchor.Id="field:nodeKind" Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.NodeKinds,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Actor:"       Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <!-- Editable autocomplete: bind ONLY Text (not SelectedItem). Binding
                                         both to the same property makes SelectedItem null-out and flush an
                                         empty value back to the node being navigated away from when its
                                         value isn't in the (per-node, rebuilt) ItemsSource. -->
                                    <ComboBox ToolTip="Who speaks this line, and every line after it until another node changes it. A character&apos;s runtime name; the line is labelled with that character&apos;s display name." view:IssueTarget.Field="actor" Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.ActorOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}"/>
                                    <!-- Expression and Outfit are hidden while the player is speaking: the
                                         player's bust belongs to the game, so a pack has no expressions or
                                         outfits to offer and both pickers would stand there empty. -->
                                    <TextBlock Text="Expression:"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.SelectedNodeActorIsPlayer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <ComboBox ToolTip="Which expression the speaker wears from this node onward." view:IssueTarget.Field="expression" Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SelectedNodeExpressionOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Visibility="{Binding DataContext.SelectedNodeActorIsPlayer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"
                                              Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"/>
                                    <!-- Outfit: optional per-node bust switch. The picker lists the
                                         speaking actor's authored outfits; empty keeps the current bust.
                                         A $varName picks the outfit dynamically from a pack variable. -->
                                    <TextBlock Text="Outfit:"      Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.SelectedNodeActorIsPlayer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SelectedNodeOutfitOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Visibility="{Binding DataContext.SelectedNodeActorIsPlayer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"
                                              Text="{Binding Outfit, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Switch the actor to one of their outfits for this node onward. Pick an outfit, or type $variableName to use the outfit named by a pack variable's current value (so this node chooses the outfit dynamically). Leave blank to keep the actor's current bust."/>
                                    <TextBlock Text="Text:"        Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <!-- The one field in the editor a player actually reads, so it's
                                         the one that gets Windows' spell checker. Language is pinned
                                         rather than inherited from the OS locale: the checker picks
                                         its dictionary from this, and on a Windows set to anything
                                         but English the whole script would come back underlined.
                                         The context menu is built in code-behind — WPF's own
                                         suggestions menu is internal and can't be extended, so
                                         NodeTextBox_ContextMenuOpening reproduces the suggestions and
                                         adds "Add to dictionary". -->
                                    <TextBox  x:Name="NodeTextBox" ToolTip="The line itself. [PV:name] is replaced with a pack variable. {PC} is the player&apos;s name, and {M} {D} {B} are what this player calls their mother, father and brother — write those rather than the words, because players choose them."
                                              Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="5" Grid.Column="1"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                              Language="en-US"
                                              SpellCheck.IsEnabled="{Binding DataContext.SpellCheckNodeText,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                              ContextMenuOpening="NodeTextBox_ContextMenuOpening"/>
                                    <TextBlock Text="Tag:"         Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1"
                                              ToolTip="Optional. Other nodes can use Jump → tag to resume from here."/>
                                    <TextBlock Text="Children:"    Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChildrenSummary}" Grid.Row="7" Grid.Column="1" Foreground="Gray"/>
                                    <TextBlock Text="Jump:"        Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox ToolTip="Where play goes after this node. Continue moves to the next node down the list, whether or not it is a child. Exit stops the conversation. Jump resumes at the node carrying the tag named below." Grid.Row="8" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.JumpModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding JumpMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    <!-- "Jump to", not "Jump tag": beside a Tag field that NAMES this node,
                                         two fields both called tag read as the same thing. This one is a
                                         destination, and it only appears once Jump is the mode — Continue and
                                         Exit have nowhere to go, so a tag typed against either is stored and
                                         then ignored. The list is the dialogue's own tags, still editable so a
                                         tag can be aimed at before the node carrying it exists. -->
                                    <TextBlock Text="Jump to:"     Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding IsJump, Converter={StaticResource BoolToVisibility}}"/>
                                    <ComboBox Grid.Row="9" Grid.Column="1"
                                              IsEditable="True"
                                              ItemsSource="{Binding DataContext.SelectedNodeJumpTagOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding JumpTargetTag, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsJump, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="Which tagged node to resume at. It has to match that node&apos;s Tag exactly; a tag that does not exist fails silently at runtime, so pick from the list where you can."/>
                                    <TextBlock Text="Duration:"    Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="10" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.NodeDurations,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="How a text line advances. UntilInteraction waits for the player; Timeout auto-advances after the typewriter finishes."/>
                                    <TextBlock Text="Timeout (s):" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding IsTimeout, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBox  Text="{Binding Timeout, Converter={x:Static conv:SingleConverter.Instance}}"
                                              Grid.Row="11" Grid.Column="1"
                                              Visibility="{Binding IsTimeout, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="Seconds the line lingers after typing finishes. Decimals OK, e.g. 1.5."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:nodeConditions" Header="Conditions (gate this node)">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add condition" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddNodeConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="+ Add group" Padding="8,2"
                                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                Command="{Binding DataContext.AddNodeConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyConditionsCommand}"
                                                ToolTip="Copy all conditions here to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteConditionsCommand}"
                                                ToolTip="Append clipboard conditions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteConditionsCommand}"
                                                ToolTip="Replace all conditions here with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="conditions"
                                                  ItemsSource="{Binding Conditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <!--
                                Hidden on a Choice option. When GC2 considers such a node
                                "started" is not something we can currently answer — an
                                option may well be started as the menu is drawn, in which
                                case every option's on-start actions would fire whether or
                                not the player picked it. Offering the box while that is
                                unknown invites packs that half-work.

                                On-finish is unaffected: an option finishes when it has
                                been taken, which is the moment authors actually want.
                            -->
                            <GroupBox Header="Actions on start"
                                      Visibility="{Binding IsChoiceChild,
                                                   Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add action" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddNodeActionOnStartCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsOnStartCommand}"
                                                ToolTip="Copy these actions to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsOnStartCommand}"
                                                ToolTip="Append clipboard actions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteActionsOnStartCommand}"
                                                ToolTip="Replace these actions with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="actionsOnStart"
                                                  ItemsSource="{Binding ActionsOnStart}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource Theme.Accent}"
                                    Background="{DynamicResource Theme.Surface}"
                                    Visibility="{Binding IsChoiceChild, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.85"
                                           Text="This node is one of a Choice's options, so it has no Actions on start. When an option counts as having started is not something the pack can rely on — it may be the moment the menu is drawn rather than the moment the player picks it, which would run the actions for options nobody chose. Put them on Actions on finish, which happens when the option has actually been taken."/>
                            </Border>

                            <GroupBox view:TutorialAnchor.Id="panel:actionsOnFinishBox" Header="Actions on finish">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add action" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddNodeActionOnFinishCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsOnFinishCommand}"
                                                ToolTip="Copy these actions to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsOnFinishCommand}"
                                                ToolTip="Append clipboard actions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteActionsOnFinishCommand}"
                                                ToolTip="Replace these actions with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl view:TutorialAnchor.Id="field:actionsOnFinish" view:IssueTarget.Field="actionsOnFinish"
                                                  ItemsSource="{Binding ActionsOnFinish}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 SCENES TAB

                 Each row is a pack-authored CG / story scene that ships
                 with the pack. At runtime the plugin clones the vanilla
                 "Samanthabeach" scene under 4_CG_Manager-Sexy, swaps the
                 Core SpriteRenderer (frame) and Core/Art SpriteRenderer
                 (scene image), and overrides the prototype's Trigger
                 component according to the authored sound mode.

                 Frame source: either a shipped vanilla frame (from
                 VanillaFrameOptions, copied next to the editor exe and
                 next to the plugin DLL) or a custom PNG path relative
                 to the pack root. The custom path takes precedence at
                 runtime when both are filled, so the author can keep a
                 vanilla pick "saved" while testing a custom one.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Scenes">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Scenes"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addScene" Content="+ Scene"  Command="{Binding AddSceneCommand}"/>
                            <Button Content="+ Folder" Tag="{Binding SceneTree}" Click="UnitAddFolder_Click"
                                    ToolTip="Add a folder. Drag items/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename" Tag="{Binding SceneTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove" Command="{Binding RemoveSceneCommand}"
                                    ToolTip="Remove the selected scene, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding SceneTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="SceneTreeView"
                                 ItemsSource="{Binding SceneTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item."/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:sceneDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedScene}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── composites scene image + frame, same z-order as runtime -->
                            <GroupBox Header="Preview">
                                <ctl:ScenePreview PackRoot="{Binding DataContext.PackRoot,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SceneSprite="{Binding SceneSprite}"
                                                  VanillaFrame="{Binding VanillaFrame}"
                                                  CustomFrameSprite="{Binding CustomFrameSprite}"/>
                            </GroupBox>

                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this is called in the editor&apos;s own lists. Yours to read; the runtime name beside it is what the pack points at."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Runtime name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Stable identifier actions/conditions reference this by."/>
                                    <TextBox ToolTip="Stable identifier actions/conditions reference this by."  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Scene image (relative to pack root)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sprite path:" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding SceneSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Column="1"
                                                       ToolTip="PNG path relative to the pack root — mapped onto the cloned scene's Core/Art SpriteRenderer."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Frame (Core SpriteRenderer)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Pick a vanilla frame (shipped with the plugin) or supply a custom PNG path. When both are set, the custom frame wins at runtime."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Vanilla frame:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.VanillaFrameOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Token"
                                                  SelectedValue="{Binding VanillaFrame, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  Text="{Binding VanillaFrame, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Filename of a frame in the plugin's VanillaFrames folder."/>
                                        <TextBlock Text="Custom frame:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:PathPickerBox Grid.Row="1" Grid.Column="1"
                                                           PathText="{Binding CustomFrameSprite, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           ToolTip="Pack-relative PNG path. Wins over Vanilla frame when set."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Sound (replaces prototype's Trigger)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mode:" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SceneSoundModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Sound, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Silent strips the prototype's trigger; Kiss / Flash strip it and emit the matching signal on activation; None keeps the prototype's audio."/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 MUSIC TAB
                 Pack-authored music tracks. Each track becomes a
                 sibling of vanilla audio under 12_AudioPlayer with
                 the key as its GameObject name — the existing
                 SwitchMusic node action finds it by name.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Music">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Music"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addMusic" Content="+ Music"   Command="{Binding AddMusicCommand}"/>
                            <Button Content="+ Folder" Tag="{Binding MusicTree}" Click="UnitAddFolder_Click"
                                    ToolTip="Add a folder. Drag items/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename" Tag="{Binding MusicTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove" Command="{Binding RemoveMusicCommand}"
                                    ToolTip="Remove the selected track, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding MusicTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="MusicTreeView"
                                 ItemsSource="{Binding MusicTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item."/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:musicDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedMusic}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this is called in the editor&apos;s own lists. Yours to read; the runtime name beside it is what the pack points at."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Runtime name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                              ToolTip="GameObject name under 12_AudioPlayer — also what SwitchMusic references in its `music` param."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Audio">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Audio path:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding AudioPath, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Filter="Audio files (*.ogg;*.wav;*.mp3)|*.ogg;*.wav;*.mp3|All files (*.*)|*.*"
                                                       Grid.Row="0" Grid.Column="1"
                                                       ToolTip="Pack-relative path. OGG / WAV / MP3 — extension inferred at load time."/>
                                    <TextBlock Text="Loop:"        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding LoopText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                              ToolTip="Leave blank to inherit (vanilla Beach template loops). Otherwise 'true' / 'false'."/>
                                    <TextBlock Text="Volume:"      Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding VolumeText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"
                                              ToolTip="0..1. Blank = inherit from the cloned template."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Preview">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="▶ Play" Padding="10,2"
                                            Command="{Binding DataContext.PlayMusicCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Preview the track at the volume above (blank = full). Needs the pack saved to disk. Plays once — looping is a runtime behavior."/>
                                    <Button Content="■ Stop" Padding="10,2" Margin="6,0,0,0"
                                            Command="{Binding DataContext.StopMusicCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="10"
                                               Text="Plays through the editor's own audio (OGG/WAV/MP3)."/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 SFX TAB
                 Pack-authored one-shot sound effects. Variants are
                 auto-detected from disk (<key>_1.ogg, <key>_2.ogg,
                 …) — the registry picks one at random per play.
                 textPatterns lets authors register *plap* / *smooch*
                 style triggers that fire automatically when matched
                 in a dialogue node's text.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="SFX">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="SFX"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addSfx" Content="+ SFX"     Command="{Binding AddSfxCommand}"/>
                            <Button Content="+ Folder" Tag="{Binding SfxTree}" Click="UnitAddFolder_Click"
                                    ToolTip="Add a folder. Drag items/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename" Tag="{Binding SfxTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove" Command="{Binding RemoveSfxCommand}"
                                    ToolTip="Remove the selected SFX, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding SfxTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="SfxTreeView"
                                 ItemsSource="{Binding SfxTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item."/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:sfxDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedSfx}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this is called in the editor&apos;s own lists. Yours to read; the runtime name beside it is what the pack points at."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Runtime name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                              ToolTip="Referenced by PlaySFX node actions as `clip`."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Audio">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Pack-relative path to the base clip. Variants are auto-detected — drop &lt;basename&gt;_1.&lt;ext&gt;, &lt;basename&gt;_2.&lt;ext&gt;, … beside the base and the registry picks one at random per play. OGG / WAV / MP3 are all accepted (the variant can have a different extension than the base)."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Audio path:"     Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:PathPickerBox PathText="{Binding AudioPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="The audio file, relative to the pack folder. OGG, WAV and MP3 all work. Extra recordings named _1, _2 beside it are picked between at random."
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Filter="Audio files (*.ogg;*.wav;*.mp3)|*.ogg;*.wav;*.mp3|All files (*.*)|*.*"
                                                           Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="Default volume:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox  Text="{Binding DefaultVolumeText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                                  ToolTip="0..1. Used by PlaySFX when its own volume param is blank, and as the volume for auto-pattern-matched plays."/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="▶ Play" Padding="10,2"
                                                Command="{Binding DataContext.PlaySfxCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Preview the base clip at the default volume above. Needs the pack saved to disk."/>
                                        <Button Content="■ Stop" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding DataContext.StopSfxCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="10"
                                                   Text="Plays through the editor's own audio (OGG/WAV/MP3)."/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Auto-trigger patterns">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Comma-separated list of text patterns. When any pattern appears in a dialogue node's text on node-start, the SFX fires automatically. If the effect has variants, one is picked at random each time — add them by putting files named &lt;name&gt;_1, &lt;name&gt;_2, … beside the base file (numbered without gaps). Convention: asterisk-bracketed lowercase tokens like *plap*, *smooch*. One SFX can carry multiple patterns — *yank*,*yeet* both fire the same clip just like the host mod does. Leave blank for an SFX that only plays via explicit PlaySFX actions."/>
                                    <TextBox  Text="{Binding TextPatternsCsv, UpdateSourceTrigger=PropertyChanged}" ToolTip="Words that fire this effect on their own when they appear in a line, comma-separated. The convention is a lowercase word between asterisks, like *plap*. Leave it empty for an effect only an action should play."/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 WALLPAPERS TAB
                 Pack-declared desktop wallpapers for the in-game PC.
                 Each is gated by a single VariableEquals condition
                 (typically Event_Seen*) — the editor reduces that
                 condition to two simple fields (variable name +
                 expected value) so authors don't have to hand-author
                 NodeConditionDef structures for the common case.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Wallpapers">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Wallpapers"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addWallpaper" Content="+ Wallpaper" Command="{Binding AddWallpaperCommand}"/>
                            <Button Content="+ Folder" Tag="{Binding WallpaperTree}" Click="UnitAddFolder_Click"
                                    ToolTip="Add a folder. Drag items/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename" Tag="{Binding WallpaperTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove" Command="{Binding RemoveWallpaperCommand}"
                                    ToolTip="Remove the selected wallpaper, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding WallpaperTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="WallpaperTreeView"
                                 ItemsSource="{Binding WallpaperTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item."/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:wallpaperDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedWallpaper}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── the wallpaper as the game frames it (16:9, fitted).
                                 Large by design: sizing up a wallpaper is the point of looking. -->
                            <GroupBox Header="Preview">
                                <ctl:WallpaperPreview PackRoot="{Binding DataContext.PackRoot,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SpritePath="{Binding SpritePath}"
                                                      ExternalSpritePath="{Binding ExternalSpritePath}"/>
                            </GroupBox>

                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Display name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this is called in the editor&apos;s own lists. Yours to read; the runtime name beside it is what the pack points at."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Runtime name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Stable identifier actions/conditions reference this by."/>
                                    <TextBox ToolTip="Stable identifier actions/conditions reference this by."  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Image (1920×1080)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Sprite path is pack-relative (e.g. Wallpaper/MyWallpaper.png). External path is an absolute on-disk path — used during the host mod transition. The custom (pack-relative) path wins when both are set."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Sprite path:"   Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:PathPickerBox ToolTip="The image, relative to the pack folder. It fills the screen, so author it at the game&apos;s own resolution." PathText="{Binding SpritePath, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="External path:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <!-- Absolute path by design (no PackRoot): the legacy external slot points
                                             outside the pack, so the picker stores the full path. -->
                                        <ctl:PathPickerBox ToolTip="An absolute path to an image outside the pack. It makes the pack depend on that file being present, so prefer a bundled image; set both and the bundled one wins." PathText="{Binding ExternalSpritePath, UpdateSourceTrigger=PropertyChanged}"
                                                           Grid.Row="1" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Standard condition rows (same editor as dialogues / rules /
                                 hooks) — AND semantics, groups, cross-tab copy/paste. -->
                            <GroupBox Header="Unlock conditions (all must pass — empty = always visible)">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add condition" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding AddUnlockConditionCommand}"/>
                                        <Button Content="+ Add group" Padding="8,2"
                                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                Command="{Binding AddUnlockConditionGroupCommand}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyUnlockConditionsCommand}"
                                                ToolTip="Copy all conditions here to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteUnlockConditionsCommand}"
                                                ToolTip="Append clipboard conditions (works across dialogues, rules and hooks)"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteUnlockConditionsCommand}"
                                                ToolTip="Replace all conditions here with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding UnlockConditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 VARIABLES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Variables">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Variables"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addVariable" Content="+ Variable" Command="{Binding AddVariableCommand}"/>
                            <Button Content="+ Folder"   Command="{Binding AddVariableFolderCommand}"
                                    ToolTip="Add a folder. Drag variables/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename"     Click="RenameVariableFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove"   Command="{Binding RemoveVariableCommand}"
                                    ToolTip="Remove the selected variable, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding VariableTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="VariableTreeView"
                                  ItemsSource="{Binding VariableTree}"
                                  SelectedItemChanged="VariableTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="VariableTree_PreviewMouseLeftButtonDown"
                                  MouseMove="VariableTree_MouseMove"
                                  Drop="VariableTree_Drop"
                                  ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item.">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter Property="Background" Value="#5578A8E0"/>
                                        </DataTrigger>
                                                                            <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
</Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:VariableFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:VariableLeafNode}">
                                    <TextBlock Text="{Binding Variable.Name}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:variableDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedVariable}">
                        <StackPanel Margin="8">
                                <StackPanel.Style>
                                    <!-- Nothing selected means nothing to edit. Without this the
                                         whole form sits there looking editable, bound to null. -->
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <GroupBox Header="Definition">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Name:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" ToolTip="What conditions, actions and [PV:] tokens refer to this variable by. Renaming it rewrites every reference at once."/>
                                    <TextBlock Text="Type:"          Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox ToolTip="Bool for yes-or-no, Int and Float for numbers, String for text, List for an ordered set of values." Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.VariableTypes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Default value:"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsList}" Value="True">
                                                        <Setter Property="Text" Value="Initial values:"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Scalar default (String / Int / Float). Numeric types get
                                         input filtering in the VM setter — non-numeric keystrokes
                                         are rejected and the box snaps back. -->
                                    <TextBox  view:IssueTarget.Field="defaultValue" Grid.Row="2" Grid.Column="1"
                                              Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsScalarText, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                              ToolTip="Int/Float variables only accept numbers here (a leading '-' and, for Float, one '.' are allowed); String accepts any text."/>
                                    <!-- Bool default: the only two possible values, so a toggle. -->
                                    <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,0"
                                              IsChecked="{Binding DefaultBool}"
                                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                              Content="Starts true (unchecked = starts false)"
                                              ToolTip="Bool variables can only default to true or false."/>
                                    <!-- List initial values (add as many as needed) -->
                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <ItemsControl ItemsSource="{Binding InitialValues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ListValueRow}">
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Grid.Column="1" Content="−" Width="22" Margin="4,0,0,0"
                                                                Command="{Binding RemoveCommand}" ToolTip="Remove this value"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Add value" HorizontalAlignment="Left" Padding="8,2" Margin="0,2,0,0"
                                                Command="{Binding DataContext.AddInitialValueCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Append an initial entry to this list variable's starting contents."/>
                                    </StackPanel>
                                    <CheckBox view:TutorialAnchor.Id="field:persisted" Content="Persisted (writes to per-pack save file)"
                                              IsChecked="{Binding Persisted}" ToolTip="Save this with the player&apos;s game so it survives closing and reopening. Left off, it starts fresh every session."
                                              Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                                    <!-- Refresh mode: None / Daily reset / Daily random roll / Per-level-enter random roll.
                                         Daily is a once-per-day reset; DailyRandom / LevelRandom are random-gate
                                         generalisations — LevelRandom plus a Scope token re-rolls on entry to a
                                         specific level (gated on that level's activeSelf in vanilla). -->
                                    <TextBlock Text="Refresh mode:"  Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.VariableRefreshModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding RefreshMode, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Never = no auto-refresh.  Daily = reset to default each in-game day.  DailyRandom = re-roll a fresh random number (within Min/Max, default 0–100) each in-game day.  LevelRandom = re-roll on every entry to the level picked below (gates on that level's activeSelf in vanilla)."/>
                                    <!-- Scope picker — only meaningful when RefreshMode is LevelRandom. The binding to
                                         IsLevelScoped greys it out otherwise so the relationship is obvious. The picker
                                         reuses LevelOptions so the same token format works in both LevelActive conditions
                                         and here. -->
                                    <TextBlock Text="Refresh on level:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <!-- SelectedValue only. Binding Text to the same
                                         property as well, with IsEditable and a
                                         DisplayMemberPath, made the two fight: picking
                                         an item wrote the token, then the display text
                                         wrote back over it and the field came out
                                         empty. The vanilla-source picker has always
                                         been a plain SelectedValue combo for this
                                         reason. -->
                                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.LevelOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayLabel"
                                              SelectedValuePath="Token"
                                              SelectedValue="{Binding RefreshScope, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsLevelScoped}"
                                              ToolTip="The level whose activation re-rolls this variable. Used only by LevelRandom. Format: vanilla:&lt;goName&gt; or place:&lt;key&gt; — same as a LevelActive condition."/>
                                    <TextBlock Text="Min value:"     Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="6" Grid.Column="1" Margin="0,4,0,0"
                                              IsEnabled="{Binding IsNumeric}"
                                              ToolTip="Optional lower clamp for Int/Float variables. The runtime keeps every write and increment at or above this. Also doubles as the lower bound for random refresh modes (defaults to 0 when unset)."/>
                                    <TextBlock Text="Max value:"     Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="7" Grid.Column="1"
                                              IsEnabled="{Binding IsNumeric}"
                                              ToolTip="Optional upper clamp for Int/Float variables. Also doubles as the upper bound for random refresh modes (defaults to 100 when unset)."/>
                                    <TextBlock Text="Description:"   Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
 ToolTip="A note to yourself. Shown only in the editor, never in game."                                              Grid.Row="8" Grid.Column="1" Margin="0,4,0,0"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 INTEGRATION TAB
                 Free-floating "if condition then actions" rules
                 evaluated each frame by the pack runtime. Same
                 condition / action vocabulary as dialogue nodes —
                 reuses the ConditionRowTemplate / ActionRowTemplate
                 from the Dialogues tab so authoring feels identical.
                 Each rule has a "Code mode" toggle that swaps the
                 picker UI for a JSON textbox with live validation,
                 for power users who want to author rules as text.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Integration">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Update rules"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addRule" Content="+ Rule"   Command="{Binding AddIntegrationRuleCommand}"/>
                            <Button Content="+ Folder" Command="{Binding AddIntegrationFolderCommand}"
                                    ToolTip="Add a folder. Drag rules/folders to organize (cosmetic — doesn't change when rules run)."/>
                            <Button Content="Rename"   Click="RenameIntegrationFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove" Command="{Binding RemoveIntegrationRuleCommand}"
                                    ToolTip="Remove the selected rule, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding IntegrationTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="IntegrationTreeView"
                                  ItemsSource="{Binding IntegrationTree}"
                                  SelectedItemChanged="IntegrationTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="IntegrationTree_PreviewMouseLeftButtonDown"
                                  MouseMove="IntegrationTree_MouseMove"
                                  Drop="IntegrationTree_Drop"
                                  ToolTip="Ctrl+click / Shift+click selects extra items to drag into a folder together. The detail pane follows the normally-selected item.">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter Property="Background" Value="#5578A8E0"/>
                                        </DataTrigger>
                                                                            <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
</Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:IntegrationFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:IntegrationLeafNode}">
                                    <TextBlock Text="{Binding Rule.Display}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedIntegrationRule}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Display name:"  Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="What this is called in the editor&apos;s own lists. Yours to read; the runtime name beside it is what the pack points at."  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>

                                    <TextBlock Text="Runtime name:"  Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="Stable identifier — used in logs and for the rule's edge tracking."/>
                                    <TextBox ToolTip="Stable identifier — used in logs and for the rule's edge tracking."  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>

                                    <TextBlock Text="Description:"   Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"
                                              ToolTip="Free text — shown in the editor only, not at runtime. Useful for noting why a rule exists."/>

                                    <!-- Trigger mode: when does the action list fire relative to the conditions transitioning?
                                         OnRisingEdge is the most common ('when X becomes true, do Y, once'). WhilePassing fires every frame
                                         while conditions hold (rare; for live syncs). OnSceneLoad / OnDayChange are one-shots armed by the
                                         pack's lifecycle events. -->
                                    <TextBlock Text="Trigger mode:"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox view:TutorialAnchor.Id="field:triggerMode" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.UpdateRuleTriggerModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding TriggerMode, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="OnRisingEdge = fires once when conditions become true. OnFallingEdge = fires once when they stop. WhilePassing = fires every frame conditions match. OnSceneLoad / OnDayChange = one-shot per lifecycle event."/>

                                    <!-- No keypress, unlike the dialogue flag: a rule that
                                         fails to fire leaves no trace at all, and the moment
                                         worth seeing is usually a single frame during a day
                                         change. Logs on decision CHANGE, so it stays quiet. -->
                                    <CheckBox view:TutorialAnchor.Id="field:ruleDebug" Content="Set for condition debugging" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"
                                              IsChecked="{Binding DebugConditions}"
                                              ToolTip="Log what this rule decides to the BepInEx console: which branch won, which won last tick, and whether it fired — plus a per-condition breakdown with live values whenever no branch passes. Logged only when the decision changes, so it won't flood. Diagnostic only; no gameplay effect."/>
                                </Grid>
                            </GroupBox>

                            <!-- Parameterization: run the same rule once per value, substituting
                                 {name} through its conditions and actions. Turns "one rule per
                                 subject" into one authored rule. -->
                            <GroupBox Header="Repeat for each (optional)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Text="Runs this whole rule once per value, so one rule can cover a set of subjects instead of copying it per subject. Values: a comma-separated list (A,B,C), or $variableName naming a List variable (or a String variable holding CSV) — so the set can change at runtime. Each value is substituted wherever {name} appears in any condition or action, including branches: e.g. Location_{char} as a variable name, or {char}/Slot as a GameObject path. It composes with the rest of the syntax — $Prefix_{char} dereferences the per-value variable. Every value gets its own edge state and its own Timer deadlines, so values behave exactly like the separate rules they replace (tick 'stagger' on a Timer to spread their first fire apart). Leave blank to run the rule once."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="For each value in:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.ListVariableNameOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  IsEditable="True"
                                                  Text="{Binding ForEach, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="A List variable as $name, or a literal comma-separated list. Blank = no repetition."/>
                                        <TextBlock Text="Placeholder name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                                 Text="{Binding ForEachAs, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="What to write inside braces in the conditions/actions. Defaults to 'item', i.e. {item}. Set it to 'char' to write {char}."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Mode toggle. Picker mode (default) renders the conditions + actions as rows;
                                 code mode swaps in a JSON textbox so power users can paste / hand-author the rule body. -->
                            <GroupBox Header="Editing mode">
                                <StackPanel>
                                    <CheckBox Content="Code mode (edit conditions + actions as JSON)"
                                              IsChecked="{Binding CodeMode}"
                                              ToolTip="When checked, the picker rows below are replaced with a JSON textbox. The textbox round-trips losslessly with the picker — toggling between modes preserves all data. Parse errors keep the toggle in code mode until you fix the JSON."/>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Picker mode = pick from the action / condition catalogs row-by-row. Code mode = author the rule body directly as JSON. Same data, two views."/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Picker view: conditions list + actions list, hidden when CodeMode=true. -->
                            <GroupBox view:TutorialAnchor.Id="panel:ruleConditions" Header="Conditions (all must pass)"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add condition" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddIntegrationConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="+ Add group" Padding="8,2"
                                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                Command="{Binding DataContext.AddIntegrationConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyConditionsCommand}"
                                                ToolTip="Copy all conditions here to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteConditionsCommand}"
                                                ToolTip="Append clipboard conditions (works across dialogues, rules and level hooks)"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteConditionsCommand}"
                                                ToolTip="Replace all conditions here with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Conditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:ruleActionsBox" Header="Actions (fired when conditions trigger)"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button view:TutorialAnchor.Id="field:ruleActions" Content="+ Add action" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddIntegrationActionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsCommand}"
                                                ToolTip="Copy these actions to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsCommand}"
                                                ToolTip="Append clipboard actions (works across dialogues, rules and level hooks)"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteActionsCommand}"
                                                ToolTip="Replace these actions with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Actions}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <!-- Else-if chain. Tried in order only when the main conditions
                                 (and every earlier branch) fail; the first branch whose
                                 conditions pass supplies the actions that fire. A branch with
                                 no conditions is a plain Else. Rows reuse the same
                                 conditions+actions group template as place enter/exit hooks. -->
                            <GroupBox Header="Else-if branches (first match wins)"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add else-if branch" Padding="8,2"
                                                Command="{Binding AddBranchCommand}"
                                                ToolTip="Add a branch tried when the conditions above (and every earlier branch) fail. Leave its conditions empty to make it a plain Else."/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                                   Text="If the rule's main conditions fail, these branches are tried top to bottom and the FIRST one whose conditions pass fires its actions. Edge trigger modes fire whenever the winning branch changes — ideal for schedule-style cascades (if slot A → …, else if slot B → …, else → …)."/>
                                        <ItemsControl ItemsSource="{Binding Branches}"
                                                      ItemTemplate="{StaticResource LevelHookRowTemplate}"/>
                                    </StackPanel>
                                </DockPanel>
                            </GroupBox>

                            <!-- Code view: full rule body as a JSON textbox. Visible only when CodeMode=true.
                                 Validation message above the textbox surfaces parse errors live. -->
                            <GroupBox Header="Rule body (JSON)"
                                      Visibility="{Binding CodeMode, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Edit the rule's trigger mode + conditions + actions as a JSON object. Format: { &quot;triggerMode&quot;: &quot;OnRisingEdge&quot;, &quot;conditions&quot;: [...], &quot;actions&quot;: [...], &quot;branches&quot;: [ { &quot;conditions&quot;: [...], &quot;actions&quot;: [...] } ] }. branches is the optional else-if chain (first match wins; empty conditions = plain Else). The conditions / actions arrays carry the same shape as dialogue nodes' actionsOnStart."/>
                                    <TextBlock Foreground="Red" FontSize="11" Margin="0,0,0,4"
                                               Text="{Binding CodeError}"
                                               Visibility="{Binding IsCodeValid, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <TextBox ToolTip="This rule&apos;s conditions and actions as JSON. The two views round-trip, so you can move between them freely; a parse error keeps you here until it is fixed."  Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                                              AcceptsReturn="True" AcceptsTab="True"
                                              TextWrapping="NoWrap"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              FontFamily="Consolas, Courier New, monospace"
                                              MinHeight="240"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>

        <!-- Save-confirmation toast. Starts hidden (Opacity 0); the code-behind
             fades it in and back out whenever MainViewModel.Saved fires. It never
             intercepts input (IsHitTestVisible=False) and floats top-right just
             under the menu strip. -->
        <!-- Guided tutorials. Above the app, but below the save toast, so a
             step that asks the author to save still shows them it worked.
             Collapsed until a tutorial runs. -->
        <ctl:TutorialOverlay x:Name="Tutorial"/>

        <Border x:Name="SaveToast"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,30,16,0" Padding="10,5"
                CornerRadius="4"
                Background="#E2277A3C" BorderBrush="#40FFFFFF" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💾" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Saved" Foreground="White" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
