<Window x:Class="SMSModForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SMSModForge.ViewModel"
        xmlns:ctl="clr-namespace:SMSModForge.View.Controls"
        xmlns:conv="clr-namespace:SMSModForge.View.Converters"
        xmlns:view="clr-namespace:SMSModForge.View"
        xmlns:model="clr-namespace:SMSModForge.Model"
        Title="{Binding Title}"
        Icon="Resources/SMSModForge.ico"
        Width="1400" Height="900"
        Background="{DynamicResource Theme.Window}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!--
            Visibility converters for the Integration tab's picker /
            code mode toggle. BoolToVisibility shows when bound flag
            is true; the inverse hides on true. Both are reused
            anywhere we want a layout-collapsing show/hide tied to a
            boolean property (avoids the gap left by WPF's built-in
            converter which only sets Hidden).
        -->
        <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!--
            Implicit DataTemplate for NavigatorTargetOption: WPF picks
            this up wherever a NavigatorTargetOption is rendered (combo
            dropdown items, closed-state SelectedItem in non-IsEditable
            combos). Pairs with NavigatorTargetOption.ToString() returning
            Token: with no DisplayMemberPath the combo's Text falls back
            to ToString(), so SelectedValue + Text both round-trip the
            same Token to the bound property — without this, the Text
            binding would clobber SelectedValue with the display label.
        -->
        <DataTemplate DataType="{x:Type vm:NavigatorTargetOption}">
            <TextBlock Text="{Binding DisplayLabel}"/>
        </DataTemplate>

        <!--
            ════════════════════════════════════════════════════════════
            Schema-driven typed param-row templates.

            Each template renders ONE row inside an action or condition's
            ParamRows list: a label (the schema's friendly Label) and one
            typed editor control (TextBox / CheckBox / ComboBox bound to
            the matching option list on MainViewModel). Templates are
            mounted into the row by ParamTypeTemplateSelector below; the
            two row templates (ActionRowTemplate, ConditionRowTemplate)
            host the selector inside an ItemsControl over ParamRows so a
            user changing the action / condition type sees the editor
            shape swap automatically.

            All the ComboBox-based templates stay IsEditable=True so the
            user can type a token that isn't yet in the underlying list
            (e.g. a vanilla GO name not declared on this pack), exactly
            like the previous hand-written specialised editors did.
            ════════════════════════════════════════════════════════════
        -->

        <!-- Reusable label+control row geometry. Each typed template
             repeats this Grid skeleton so the param-row column widths
             stay aligned across the whole list. -->
        <Style x:Key="ParamRowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>

        <DataTemplate x:Key="StringParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Bool → CheckBox. The CheckBox content is the schema label
             so the row is one line; we still use the same Grid skeleton
             so the controls align with the other typed rows. -->
        <DataTemplate x:Key="BoolParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <CheckBox  Grid.Column="1"
                           IsChecked="{Binding BoolValue}"
                           ToolTip="{Binding Tooltip}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Int / Float share the same template: a plain TextBox bound
             to Value as a string. The runtime parses with invariant
             culture, so the user can type either "3" or "3.14" and the
             editor just stores the literal string. -->
        <DataTemplate x:Key="IntParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FloatParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- PackVarRef → combobox bound to VariableNameOptions. All ref
             combos share this shape: ItemsSource via RelativeSource
             AncestorType=Window so the option list is resolved against
             the MainViewModel even though the row's DataContext is the
             ParamRowViewModel. IsEditable+Text bound to Value gives the
             "pick from list or type your own" semantics. -->
        <DataTemplate x:Key="PackVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.VariableNameOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ListVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ListVariableNameOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- GameVarRef stays free-text; no GC2-globals enumeration is
             available offline so we don't pretend to have a dropdown. -->
        <DataTemplate x:Key="GameVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox   Grid.Column="1"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LevelRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.LevelOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActorRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ActorOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- BustRef binds to ActorBustOptions — the actor-grouped list
             that pairs each actor with its declared default-bust GO
             name. Token-based SelectedValuePath so picking an entry
             writes the bust GO, not the display label. -->
        <DataTemplate x:Key="BustRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ActorBustOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExpressionRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ExpressionKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SceneRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.SceneOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Signal names are open-ended — same shape as GameVarRef. -->
        <!-- SignalRef → editable ComboBox: autocompletes the known GC2 signal
             vocabulary (KnownSignals, sourced from the host mod) while still
             letting the author type any custom signal name. -->
        <DataTemplate x:Key="SignalRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           IsEditable="True"
                           ItemsSource="{Binding DataContext.SignalOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MusicRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.MusicKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SfxRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.SfxKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- GameObjectPath → editable ComboBox: autocompletes the pack's own
             named GameObjects (overlays, outfit busts) while still letting the
             author type any vanilla GO name or full hierarchy path. -->
        <DataTemplate x:Key="GameObjectPathParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           IsEditable="True"
                           FontFamily="Consolas"
                           ItemsSource="{Binding DataContext.GameObjectNameOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Shared selector instance. ParamRowsItemsControl below
             references this via StaticResource so we don't duplicate
             the 16-template list inline. -->
        <view:ParamTypeTemplateSelector x:Key="ParamTypeTemplateSelector"
                                        StringTemplate="{StaticResource StringParamTemplate}"
                                        BoolTemplate="{StaticResource BoolParamTemplate}"
                                        IntTemplate="{StaticResource IntParamTemplate}"
                                        FloatTemplate="{StaticResource FloatParamTemplate}"
                                        PackVarRefTemplate="{StaticResource PackVarRefParamTemplate}"
                                        ListVarRefTemplate="{StaticResource ListVarRefParamTemplate}"
                                        GameVarRefTemplate="{StaticResource GameVarRefParamTemplate}"
                                        LevelRefTemplate="{StaticResource LevelRefParamTemplate}"
                                        ActorRefTemplate="{StaticResource ActorRefParamTemplate}"
                                        BustRefTemplate="{StaticResource BustRefParamTemplate}"
                                        ExpressionRefTemplate="{StaticResource ExpressionRefParamTemplate}"
                                        SceneRefTemplate="{StaticResource SceneRefParamTemplate}"
                                        SignalRefTemplate="{StaticResource SignalRefParamTemplate}"
                                        MusicRefTemplate="{StaticResource MusicRefParamTemplate}"
                                        SfxRefTemplate="{StaticResource SfxRefParamTemplate}"
                                        GameObjectPathTemplate="{StaticResource GameObjectPathParamTemplate}"/>

        <!--
            Shared row template for every list of NodeConditionViewModel
            (dialogue-start conditions and per-node conditions). One row
            renders:
              · a minus button driven by NodeConditionViewModel.RemoveCommand
                (CanExecute is false for IsLocked rows — the pinned
                LevelActive condition is locked, so its row stays put);
              · the Type combo (disabled on locked rows via IsTypeEditable);
              · the Negate checkbox;
              · an ItemsControl over ParamRows that picks a typed editor
                template per param via ParamTypeTemplateSelector. The
                schema for each condition type lives in
                ConditionSchemas.ByType.
        -->
        <DataTemplate x:Key="LeafConditionTemplate" DataType="{x:Type vm:NodeConditionViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <StackPanel>
                    <!-- Header row: Type combo + Remove button. The Type
                         combo is disabled when IsTypeEditable is false
                         (locked LevelActive row). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DataContext.ConditionTypes,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DisplayType, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsTypeEditable}"
                                  ToolTip="The pinned LevelActive start-condition can't change type — edit its level instead."/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="Copy this condition to the clipboard"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="Remove this condition"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="Negate" IsChecked="{Binding Negate}" Margin="110,2,0,2"
                              ToolTip="Inverts this condition's result before it combines with the surrounding list."/>
                    <!-- Schema-driven param rows. ItemsSource is the
                         ParamRows collection on the condition VM; the
                         template selector swaps in a typed editor per
                         ParamType. An empty ParamRows list (e.g.
                         AlwaysTrue) leaves the ItemsControl empty,
                         which collapses to zero height naturally. -->
                    <ItemsControl ItemsSource="{Binding ParamRows}"
                                  ItemTemplateSelector="{StaticResource ParamTypeTemplateSelector}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- Unified Variable editor. Source picks Pack (per-pack store) vs
                         Vanilla (a GC2 global from the 1.8E catalog); the Name list follows
                         the Source. Comparison maps to the underlying Variable* type. -->
                    <Grid Margin="0,2,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Source" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarSource, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Pack = this pack's own variable; Vanilla = an existing 1.8E game variable."/>

                        <TextBlock Text="Comparison" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.VariableComparisons}"
                                  SelectedItem="{Binding VarComparison, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Name" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  Text="{Binding VarName, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.VariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaSource}" Value="True">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.VanillaGameVariableOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="Value" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowVariableValue}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarValue, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowVariableValue}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            Group condition (parentheses): AND/OR over nested children. The
            inner ItemsControl re-uses ConditionTemplateSelector (via
            DynamicResource, since the selector is declared just below this
            template), so groups nest arbitrarily. "NOT (invert group)" maps
            to Negate, giving !( … ). Created via the "Add group" buttons; the
            mode combo flips AND↔OR.
        -->
        <DataTemplate x:Key="GroupConditionTemplate" DataType="{x:Type vm:NodeConditionViewModel}">
            <Border BorderBrush="#FF6F9BE8" BorderThickness="1.5"
                    CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Match" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <ComboBox  Grid.Column="1" Width="160"
                                   ItemsSource="{x:Static vm:NodeConditionViewModel.GroupModeOptions}"
                                   SelectedIndex="{Binding GroupModeIndex}"
                                   ToolTip="AND = every child must pass; OR = at least one child must pass."/>
                        <CheckBox  Grid.Column="2" Content="NOT (invert group)"
                                   IsChecked="{Binding Negate}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   ToolTip="Inverts the whole group — your parentheses-NOT."/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="Copy this group (with its children) to the clipboard"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}" ToolTip="Remove this group"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                        <Button Content="+ condition" Padding="6,1" Margin="0,0,4,0"
                                Command="{Binding AddLeafCommand}"/>
                        <Button Content="+ group" Padding="6,1"
                                Command="{Binding AddGroupCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Children}" Margin="14,0,0,0"
                                  ItemTemplateSelector="{DynamicResource ConditionTemplateSelector}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Leaf vs group selector; the recursion entry point. Declared after
             both templates so it references them via StaticResource. -->
        <view:ConditionTemplateSelector x:Key="ConditionTemplateSelector"
                                        LeafTemplate="{StaticResource LeafConditionTemplate}"
                                        GroupTemplate="{StaticResource GroupConditionTemplate}"/>

        <!--
            ActionRow template: type combo on top, then a params editor
            whose shape depends on Type. The generic key=value TextBox
            is the default; the four bust/expression-related action
            types swap it out for typed dropdowns so authors aren't
            typing GO names from memory:

              · SetActorBust         → Actor + BustKey combos
              · SetActorExpression   → Actor + Expression combos
              · DeactivateBust / LeaveBust  → Actor combo only

            Visibility flips happen via DataTrigger Setters inside each
            control's Style (not local Visibility attributes — see
            LevelActive in ConditionRowTemplate for the same pattern
            and the WPF precedence reason).
        -->
        <!--
            ActionRow template: type combo on top, then schema-driven
            ParamRows. Each NodeActionViewModel exposes ParamRows built
            from ActionSchemas.For(Type), and the ItemsControl below
            renders each row with the per-ParamType template selected
            by ParamTypeTemplateSelector. Action types with no params
            (EndDialogue, DeactivateAllScenes) collapse the ItemsControl
            to zero height naturally.
        -->
        <DataTemplate x:Key="ActionRowTemplate" DataType="{x:Type vm:NodeActionViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Type" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DataContext.ActionTypes,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DisplayType, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="Copy this action to the clipboard"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="Remove this action"/>
                        </StackPanel>
                    </Grid>
                    <!-- Category + Target for GameObject-targeting actions (Fade / Move / Spin).
                         Additive — the action's own params (alpha, x/y, speed…) still show in
                         ParamRows below. The Target list follows the Category, and Level Overlay
                         resolves the overlay inside the chosen level. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoCategoryFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.GoCategories}"
                                  SelectedItem="{Binding GoCategory, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="How the target resolves: a plain GO path, an overlay inside a level, a whole level, or a bust."/>

                        <TextBlock Text="Level" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoOverlayCategory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding DataContext.LevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Which level the overlay lives in — resolves inside it, not a same-named object elsewhere. Empty = resolve globally.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoOverlayCategory}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="Target" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  Text="{Binding GoTarget, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.GameObjectNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Extra GameObjects">
                                            <Setter Property="ItemsSource" Value="{Binding GoOverlayOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Places">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.LevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="DisplayMemberPath" Value="Token"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>

                    <!-- Generic schema-driven params; hidden for the unified Set-Active + Variable families. -->
                    <ItemsControl ItemsSource="{Binding ParamRows}"
                                  ItemTemplateSelector="{StaticResource ParamTypeTemplateSelector}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetActiveFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- Unified Variable editor (SetVariable + IncrementVariable). Source
                         picks Pack (per-pack store) vs Vanilla (a GC2 global from the 1.8E
                         catalog); the Name list follows the Source. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Source (Pack/Vanilla) — not used by Random-from-list. -->
                        <TextBlock Text="Source" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsRandomFromList, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarSource, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsRandomFromList, Converter={StaticResource InverseBoolToVisibility}}"
                                  ToolTip="Pack = this pack's own variable; Vanilla = an existing 1.8E game variable."/>

                        <TextBlock Text="Operation" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.VariableOperations}"
                                  SelectedItem="{Binding VarOperation, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Name"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Text" Value="Target"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  Text="{Binding VarName, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.VariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaSource}" Value="True">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.VanillaGameVariableOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Value"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Text" Value="Delta"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarValue, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarDelta, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- From list (Random-from-list only): a List variable name or a CSV literal. -->
                        <TextBlock Text="From list" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsRandomFromList, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.ListVariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding VarFromList, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsRandomFromList, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="A List variable to pick a random element from (or a comma-separated literal like A,B,C). The picked value lands in Target."/>
                    </Grid>
                    <!-- Unified Set-Active editor (SetGameObjectActive + ActivateScene folded
                         into one row). A Category dropdown swaps the Target autocomplete:
                         Bust / Level Overlay (filtered to the node's level) / Scene / Direct Path. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetActiveFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Category" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.SetActiveCategories}"
                                  SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="What to toggle. Changes the Target dropdown below; Scene routes through the pack's scene registry and plays its authored sound when activated."/>

                        <!-- Level (Level Overlay category only): which level the overlay
                             lives in. Set it to the level you're transitioning INTO so the
                             runtime resolves the overlay there, not in the previous level.
                             The Target list below follows this choice. -->
                        <TextBlock Text="Level" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="Extra GameObjects">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding DataContext.LevelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding OverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding OverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Which level the overlay lives in. Set this to the level you're transitioning INTO; the runtime resolves the overlay inside it instead of a same-named object in the previous level. Leave empty to resolve globally.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="Extra GameObjects">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="Target" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Autocompletes from the selected Category; stays editable so any GO name/path works.">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <!-- default: Direct Path → all pack-named GOs -->
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.GameObjectNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Extra GameObjects">
                                            <!-- The overlays of the level chosen above (per-action). -->
                                            <Setter Property="ItemsSource" Value="{Binding OverlayOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Scene">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.SceneKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <CheckBox Grid.Row="3" Grid.Column="1" Content="Active" Margin="0,2,0,0"
                                  IsChecked="{Binding Active}"
                                  ToolTip="SetActive(true/false). For Scene, unchecking turns the scene off silently; checking activates it and plays its sound."/>
                    </Grid>

                    <!-- ── DiceRoll: weighted one-of-N branch editor ─────────
                         Each branch = chance % + ONE nested action (rendered by
                         this very template via DynamicResource self-reference).
                         Exactly one branch executes per roll; the total must be
                         exactly 100% (label turns red otherwise + validation
                         raises an error). -->
                    <StackPanel Margin="0,3,0,0"
                                Visibility="{Binding IsDiceFamily, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,0,3" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding DiceTotalLabel}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiceTotalValid}" Value="False">
                                            <Setter Property="Foreground" Value="#F66"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding DiceBranches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiceBranchViewModel}">
                                    <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                                            CornerRadius="2" Padding="4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="Chance" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Width="45" Text="{Binding ChanceText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                <Button Content="− Branch" Padding="6,0"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="Remove this branch (and its action)."/>
                                            </StackPanel>
                                            <ContentControl Content="{Binding Action}"
                                                            ContentTemplate="{DynamicResource ActionRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Add branch" HorizontalAlignment="Left" Padding="8,2"
                                Command="{Binding AddDiceBranchCommand}"
                                ToolTip="Add a weighted branch. New branches are seeded with the chance still missing from 100%."/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>


        <!--
            Row template for navigator-button list rows (place + vanilla-extension tabs).
            Adds a minus button next to the existing target / label / music fields.
        -->
        <DataTemplate x:Key="NavigatorButtonRowTemplate" DataType="{x:Type vm:NavigatorButtonViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Target:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding DataContext.AllTargetOptions,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValuePath="Token"
                              SelectedValue="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                        <Button Content="▲" Width="22" Height="22" Padding="0"
                                Command="{Binding MoveUpCommand}"
                                ToolTip="Move earlier in instantiation order (further left in-game)"/>
                        <Button Content="▼" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding MoveDownCommand}"
                                ToolTip="Move later in instantiation order (further right in-game)"/>
                        <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding RemoveCommand}"
                                ToolTip="Remove this navigator button"/>
                    </StackPanel>
                    <TextBlock Text="Label override:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="1" Grid.Column="1"
                             ToolTip="Button text. Supports [PV:variableName] tokens that re-resolve live from String pack variables — change the variable via a dialogue action or Integration rule and the button renames in place."/>
                    <TextBlock Text="Music (optional):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="2" Grid.Column="1"
                             ToolTip="Optional name of a child under 12_AudioPlayer to enable when this button is pressed"/>
                    <!-- Conditions -->
                    <TextBlock Text="Conditions:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                        <ItemsControl ItemsSource="{Binding Conditions}"
                                      ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="+ Add condition" Margin="0,0,4,0" Padding="6,2"
                                    Command="{Binding AddConditionCommand}"/>
                            <Button Content="+ Add group" Padding="6,2"
                                    ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                    Command="{Binding AddConditionGroupCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Implicit (keyed-by-type) so an Extra GameObject's nested Children
             ItemsControl re-uses this very template recursively. -->
        <DataTemplate DataType="{x:Type vm:OverlayViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="0" Grid.Column="1"
                             ToolTip="GameObject name dialogue actions target by (keep unique across the pack)."/>
                    <Button Content="−" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                            Grid.Row="0" Grid.Column="2"
                            Command="{Binding RemoveCommand}" ToolTip="Remove this overlay"/>

                    <TextBlock Text="Sprite:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Sprite, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             ToolTip="Pack-relative PNG path for this overlay (any size)."/>

                    <TextBlock Text="Pos / sorting:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                 ToolTip="World X position (level centre ≈ 0)."/>
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="8,0,2,0"/>
                        <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                 ToolTip="World Y position (up = positive); e.g. two overlays use 15/18."/>
                        <TextBlock Text="Sorting" VerticalAlignment="Center" Margin="8,0,2,0"/>
                        <TextBox Text="{Binding SortingOrder, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                 ToolTip="SpriteRenderer sorting order (lower draws further back)."/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="Parallax off" IsChecked="{Binding ParallaxDisabled}"
                                  VerticalAlignment="Center"
                                  ToolTip="Disable the mouse-parallax effect on this overlay."/>
                        <CheckBox Content="Start active" IsChecked="{Binding StartActive}"
                                  VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="Uncheck for overlays a dialogue reveals later (Flash, Portal)."/>
                        <TextBlock Text="Alpha" VerticalAlignment="Center" Margin="12,0,2,0"/>
                        <TextBox Text="{Binding StartAlpha, UpdateSourceTrigger=PropertyChanged}" Width="45"
                                 ToolTip="Initial alpha 0..1 (start at 0 for fade-in overlays like the Portal)."/>
                    </StackPanel>

                    <TextBlock Text="Mask (opt):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                             ToolTip="Optional pack-relative mask PNG bound to _MaskTex, for shader-masked overlays (a cameo)."/>

                    <!-- Utility components attached to this Extra GameObject. -->
                    <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Component" Padding="6,0"
                                        Command="{Binding AddComponentCommand}"
                                        ToolTip="Attach a generic utility component (fade, disappear, random child, blink) to this Extra GameObject."/>
                                <TextBlock Text="Components" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Components}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                                        <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1" CornerRadius="2"
                                                Background="{DynamicResource Theme.Control}" Padding="5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="−" Width="22" Padding="0"
                                                            Command="{Binding RemoveCommand}" ToolTip="Remove this component"/>
                                                    <ComboBox ItemsSource="{Binding ComponentTypes}"
                                                              SelectedItem="{Binding Type}"/>
                                                </DockPanel>

                                                <!-- FadeInSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsFadeIn, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Fades the sprite in — alpha 0 → target over the duration (after an optional delay)."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="Duration" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding FadeDuration, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Target α" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding TargetAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Delay" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding StartDelay, UpdateSourceTrigger=LostFocus}"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- FadeOutSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsFadeOut, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Fades the sprite out — current alpha → 0 over the duration (after an optional delay). Optionally deactivates it once fully faded."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="Duration" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding Duration, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Delay" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding StartDelay, UpdateSourceTrigger=LostFocus}"/>
                                                        <CheckBox Content="Deactivate on complete" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                  IsChecked="{Binding DeactivateOnComplete}"
                                                                  ToolTip="Turn the GameObject off once it's fully faded out (a flash that vanishes)."/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- RandomChildActivator -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsRandom, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="On activate, enables one random child GameObject and disables the rest."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <CheckBox Content="Reshuffle every time it's activated" IsChecked="{Binding ReshuffleOnEnable}"/>
                                                </StackPanel>

                                                <!-- BlinkingSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsBlinking, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Toggles a SpriteRenderer's alpha between min and max on a fixed interval (blink / pulse)."
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="Interval" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding BlinkInterval, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Min α" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding MinAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="Max α" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding MaxAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Nested children — same template, rendered recursively. -->
                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="+ Add child" Padding="6,0"
                                        Command="{Binding AddChildCommand}"
                                        ToolTip="Add a child Extra GameObject nested under this one. Children have the same fields, components, and their own children."/>
                                <TextBlock Text="Children" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- No ItemTemplate: OverlayViewModel resolves to the implicit
                                 template above, giving recursive nesting. Indented to show depth. -->
                            <ItemsControl ItemsSource="{Binding Children}" Margin="12,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Grid wrapper exists only so the save-confirmation toast can overlay the
         top-right corner of the shell (DockPanel can't free-float a child). -->
    <Grid>
    <DockPanel LastChildFill="True">
        <!-- Menu strip -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New pack"      Command="{Binding NewPackCommand}"     InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Open pack…"    Command="{Binding OpenPackCommand}"    InputGestureText="Ctrl+O"/>
                <MenuItem Header="Recent _files" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save"          Command="{Binding SavePackCommand}"    InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save _as…"     Command="{Binding SavePackAsCommand}" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <!-- Bundles the loose pack folder into a single .smspack
                     archive (zip) that the runtime plugin reads. The menu
                     item is disabled until the pack has been saved to
                     disk — the exporter walks the on-disk folder. -->
                <MenuItem Header="_Export pack…" Command="{Binding ExportPackCommand}"  InputGestureText="Ctrl+E"
                          ToolTip="Bundle this pack into a .smspack file for the runtime plugin"/>
                <Separator/>
                <MenuItem Header="_Validate"      Command="{Binding ValidateCommand}"   InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Duplicate item" Command="{Binding DuplicateItemCommand}" InputGestureText="Ctrl+D"
                          ToolTip="Duplicate the selected item in the current tab's list (with a fresh key)."/>
                <MenuItem Header="_Copy item"      Command="{Binding CopyItemCommand}"
                          ToolTip="Copy the selected list item — paste it into any pack open in this editor session."/>
                <MenuItem Header="_Paste item"     Command="{Binding PasteItemCommand}"
                          ToolTip="Paste a copied item of the matching type into the current tab's list."/>
            </MenuItem>
            <MenuItem Header="_Themes" ItemsSource="{Binding Themes}"
                      ToolTip="Recolour the editor. Your choice is remembered between sessions.">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding Name}"/>
                        <Setter Property="IsCheckable" Value="True"/>
                        <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                        <Setter Property="Command" Value="{Binding DataContext.ApplyThemeCommand,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Preview quality" ItemsSource="{Binding PreviewQualities}"
                          ToolTip="Trade live-preview smoothness for CPU. Your choice is remembered between sessions.">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                            <Setter Property="IsCheckable" Value="True"/>
                            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                            <Setter Property="Command" Value="{Binding DataContext.ApplyPreviewQualityCommand,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Status / issues bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock>
                <Run Text="{Binding Issues.Count, Mode=OneWay}"/>
                <Run Text=" issue(s)"/>
            </TextBlock>
        </StatusBar>

        <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- ════════════════════════════════════════════════════
                 BUSTS TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Busts">
                <Grid>
                    <!--
                        Column 4 (the live-preview side panel) is intentionally
                        fixed: it has no GridSplitter between it and the middle
                        editor, and its width is set to fit the 512×512
                        JigglePreview + Expression/Mouth controls exactly. Don't
                        re-introduce a splitter here — the preview only renders
                        crisply at JiggleShader.Size × N (integer N), so a
                        user-draggable column would let the preview be clipped
                        or the surrounding chrome get cramped.
                    -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="540"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: character/outfit tree -->
                    <DockPanel Grid.Column="0">
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Character" Command="{Binding AddCharacterCommand}"/>
                            <Button Content="+ Outfit"    Command="{Binding AddOutfitCommand}"/>
                        </ToolBar>
                        <TreeView x:Name="CharacterTree"
                                  ItemsSource="{Binding Characters}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:CharacterViewModel}"
                                                          ItemsSource="{Binding Outfits}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text=" — "/>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="Gray"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:OutfitViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="• "/>
                                        <TextBlock Text="{Binding Key}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: outfit editor -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedOutfit}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Outfit key:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="GameObject name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding GameObjectName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Sprites (relative to pack root, 256×256 PNG)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Base:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="baseSprite" Text="{Binding BaseSprite, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Mask:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="1" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="Edit Mask…"
                                                Margin="4,0,0,0" Padding="6,0"
                                                Click="EditMask_Click"/>
                                        <TextBox view:IssueTarget.Field="maskSprite" Text="{Binding MaskSprite, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <TextBlock Text="Blink:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="blinkSprite" Text="{Binding BlinkSprite, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
                                    <CheckBox Content="Has Mouth frames" IsChecked="{Binding MouthEnabled}" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"/>
                                    <TextBlock Text="Mouth prefix:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="mouth" Text="{Binding MouthPrefix, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1"
                                              IsEnabled="{Binding MouthEnabled}"/>
                                    <TextBlock Text="(loads {prefix}1..4.PNG)" Grid.Row="5" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Expressions">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Content="Has Expressions" IsChecked="{Binding ExpressionEnabled}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"/>
                                    <TextBlock Text="Expr. prefix:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="expression" Text="{Binding ExpressionPrefix, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                              IsEnabled="{Binding ExpressionEnabled}"/>
                                    <TextBlock Text="(loads {prefix}Happy/Angry/Sad/Flirty.PNG)" Grid.Row="2" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Jiggle (mask-driven shader)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Speed"        Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider Value="{Binding JiggleSpeed}"    Minimum="0" Maximum="10" Grid.Row="0" Grid.Column="1"/>
                                    <TextBox Text="{Binding JiggleSpeed, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="2"/>
                                    <TextBlock Text="Strength"     Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider view:IssueTarget.Field="jiggle.strength" Value="{Binding JiggleStrength}" Minimum="-0.5" Maximum="0.5" Grid.Row="1" Grid.Column="1"/>
                                    <TextBox Text="{Binding JiggleStrength, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="2"/>
                                    <TextBlock Text="Frequency"    Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider Value="{Binding JiggleFrequency}" Minimum="0" Maximum="40" Grid.Row="2" Grid.Column="1"/>
                                    <TextBox Text="{Binding JiggleFrequency, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="2"/>
                                    <TextBlock Text="Noise Scale"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider Value="{Binding NoiseScale}" Minimum="0" Maximum="80" Grid.Row="3" Grid.Column="1"/>
                                    <TextBox Text="{Binding NoiseScale, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="2"/>
                                    <TextBlock Text="Noise Speed"  Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider Value="{Binding NoiseSpeed}" Minimum="0" Maximum="5" Grid.Row="4" Grid.Column="1"/>
                                    <TextBox Text="{Binding NoiseSpeed, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="2"/>
                                    <TextBlock Text="Noise Strength" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider view:IssueTarget.Field="jiggle.noiseStrength" Value="{Binding NoiseStrength}" Minimum="0" Maximum="0.5" Grid.Row="5" Grid.Column="1"/>
                                    <TextBox Text="{Binding NoiseStrength, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="2"/>
                                    <TextBlock Text="Tint (hex)"   Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Tint, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"/>
                                    <CheckBox Content="Pixel Snap" IsChecked="{Binding PixelSnap}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Particles">
                                <StackPanel>
                                    <CheckBox Content="Wet particle active on spawn"
                                              IsChecked="{Binding ParticleActive}"
                                              ToolTip="When checked, the Wet particle system (cloned from Anna_Towel) starts active. Typically enabled only for swim/wet outfit variants."/>
                                    <TextBlock Text="(The Wet preset is always attached — this controls whether it starts playing.)"
                                               Foreground="Gray" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: live preview + issues. No GridSplitter between
                         columns 2 and 3 — this panel is intentionally fixed
                         (see the columns block above for why). -->
                    <DockPanel Grid.Column="3" Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="Preview (live JiggleSprite)" FontWeight="Bold" Margin="0,0,0,4"/>
                        <Border DockPanel.Dock="Top" Background="#222" Padding="4" ClipToBounds="True">
                            <ctl:JigglePreview x:Name="PreviewControl"
                                               Margin="0,12,0,-20"
                                               Outfit="{Binding SelectedOutfit}"
                                               PackRoot="{Binding PackRoot}"
                                               SelectedExpression="{Binding ElementName=ExpressionPicker, Path=SelectedItem.Content, Mode=OneWay, FallbackValue=None}"
                                               SelectedMouthFrame="{Binding ElementName=MouthPicker, Path=SelectedIndex, Mode=OneWay}"
                                               Blinking="{Binding ElementName=BlinkToggle, Path=IsChecked, Mode=OneWay}"
                                               Yapping="{Binding ElementName=YappingToggle, Path=IsChecked, Mode=OneWay}"
                                               Breathing="{Binding ElementName=BreathingToggle, Path=IsChecked, Mode=OneWay}"/>
                        </Border>
                        <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Mouth frame"/>
                                <ComboBox x:Name="MouthPicker" SelectedIndex="0">
                                    <ComboBoxItem>Closed</ComboBoxItem>
                                    <ComboBoxItem>1</ComboBoxItem>
                                    <ComboBoxItem>2</ComboBoxItem>
                                    <ComboBoxItem>3</ComboBoxItem>
                                    <ComboBoxItem>4</ComboBoxItem>
                                </ComboBox>
                                <CheckBox x:Name="YappingToggle" Content="Yapping" Margin="2,6,0,0"/>
                                <CheckBox x:Name="BlinkToggle" Content="Blinking" IsChecked="True" Margin="2,6,0,0"/>
                                <CheckBox x:Name="BreathingToggle" Content="Breathing" IsChecked="True" Margin="2,6,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Expression"/>
                                <ComboBox x:Name="ExpressionPicker" SelectedIndex="0">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Happy"/>
                                    <ComboBoxItem Content="Angry"/>
                                    <ComboBoxItem Content="Sad"/>
                                    <ComboBoxItem Content="Flirty"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Fills the remaining space (it's the DockPanel's last
                             child). The list stretches with the box and scrolls
                             vertically; each issue is one line — rows stretch to
                             full width and the message ellipsis-trims at the edge,
                             with the full text on hover. -->
                        <GroupBox Header="Issues" Margin="0,8,0,0">
                            <ListBox x:Name="IssueList"
                                     ItemsSource="{Binding Issues}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="IssueList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Message}" Cursor="Hand"
                                              Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Severity}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Where}"   Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 PLACES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Places">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: places list + vanilla extensions list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Your places -->
                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Text="Your places"
                                       FontWeight="Bold" Margin="6,4,0,2"/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button Content="+ Place" Command="{Binding AddPlaceCommand}"/>
                                <Button Content="− Remove" Command="{Binding RemovePlaceCommand}"/>
                            </ToolBar>
                            <ListBox x:Name="PlaceList"
                                     ItemsSource="{Binding Places}"
                                     SelectedItem="{Binding SelectedPlace}"
                                     DisplayMemberPath="Display"/>
                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="4" Background="LightGray"
                                      HorizontalAlignment="Stretch"/>

                        <!-- Vanilla extensions: buttons added to vanilla nav strips -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="Vanilla extensions"
                                       FontWeight="Bold" Margin="6,4,0,2"
                                       ToolTip="Add buttons to existing (vanilla) places' navigator strips — e.g. an entry-point button on Beach that goes to your custom Secret Cave."/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button Content="+ Source" Command="{Binding AddVanillaExtensionCommand}"
                                        ToolTip="Pick a vanilla place to attach buttons to"/>
                                <Button Content="− Remove" Command="{Binding RemoveVanillaExtensionCommand}"/>
                            </ToolBar>
                            <ListBox x:Name="VanillaExtList"
                                     ItemsSource="{Binding VanillaExtensions}"
                                     SelectedItem="{Binding SelectedVanillaExtension}"
                                     DisplayMemberPath="Display"/>
                        </DockPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: editor pane — switches between Place editor and Vanilla-extension editor based on selection -->
                    <Grid Grid.Column="2">
                        <!-- Vanilla extension editor (shown when SelectedVanillaExtension is non-null) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedVanillaExtension}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                            <StackPanel Margin="8">
                                <GroupBox Header="Vanilla source">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Source place:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.VanillaSourceOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Token"
                                                  SelectedValue="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Text="The buttons below will appear on this vanilla place's navigator strip when the player is there."/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Navigator buttons (added to this vanilla place's strip)">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Bottom" Content="+ Add navigator button"
                                                Command="{Binding DataContext.AddVanillaExtensionButtonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                        <ItemsControl ItemsSource="{Binding NavigatorButtons}"
                                                      ItemTemplate="{StaticResource NavigatorButtonRowTemplate}"/>
                                    </DockPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Place editor (shown when SelectedPlace is non-null) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedPlace}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── composites secondary + base sprites with GameplayUI overlay
                                 and the live navigator buttons, same z-order as runtime. -->
                            <GroupBox Header="Preview">
                                <ctl:PlacePreview PackRoot="{Binding DataContext.PackRoot,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                  BaseSprite="{Binding BaseSprite}"
                                                  SecondarySprite="{Binding SecondarySprite}"
                                                  Buttons="{Binding NavigatorButtons}"/>
                            </GroupBox>

                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Place key:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Internal GO name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="internalName" Text="{Binding InternalName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="Display name (button):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Text="(Used on the in-game map button label.)"
                                               Grid.Row="3" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Level art (paths relative to pack root)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Base sprite (2048×1136):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="baseSprite" Text="{Binding BaseSprite, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Secondary sprite (2048×1136):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="secondarySprite" Text="{Binding SecondarySprite, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="Mask sprite (256×143):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="maskSprite" Text="{Binding MaskSprite, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Text="(The mod clones the Beach level and swaps in these PNGs.)"
                                               Grid.Row="3" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Behaviour">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Parallax strength:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider view:IssueTarget.Field="parallaxStrength" Value="{Binding ParallaxStrength}" Minimum="0" Maximum="1.0" Grid.Row="0" Grid.Column="1"/>
                                    <TextBox Text="{Binding ParallaxStrength, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="2"/>
                                    <CheckBox Content="Keep beach audio (ocean ambience)"
                                              IsChecked="{Binding KeepAudio}"
                                              Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"/>
                                    <CheckBox Content="Keep seagulls (particle system from Beach)"
                                              IsChecked="{Binding KeepSeagulls}"
                                              Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"/>
                                    <TextBlock Text="Weather:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <ComboBox SelectedItem="{Binding WeatherType}"
                                              Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <ComboBox.ItemsSource>
                                            <x:Array Type="{x:Type model:WeatherType}">
                                                <model:WeatherType>None</model:WeatherType>
                                                <model:WeatherType>Inside</model:WeatherType>
                                                <model:WeatherType>Outside</model:WeatherType>
                                            </x:Array>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Navigator buttons (visible while this place is active)">
                                <DockPanel>
                                    <DockPanel.Resources>
                                        <Style TargetType="TextBlock" x:Key="ColHeader">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </Style>
                                    </DockPanel.Resources>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="+ Add navigator button"
                                                Command="{Binding DataContext.AddNavigatorButtonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,2"/>
                                        <TextBlock Text="{Binding NavigatorButtonCountLabel}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"
                                                   ToolTip="Maximum 12 navigator buttons per place."/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Up to 12 buttons per place. Order = runtime instantiation order = on-screen left→right; use ▲▼ to reorder. The preview shows them numbered in this order. The mod-side loader resolves target names into level indices at load time, so two mods can both add buttons without colliding."/>
                                    <ItemsControl ItemsSource="{Binding NavigatorButtons}"
                                                  ItemTemplate="{StaticResource NavigatorButtonRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="Extra GameObjects (sprites layered on this place)">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="+ Add Extra GameObject"
                                                Command="{Binding DataContext.AddOverlayCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,2"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="Extra sprite GameObjects instantiated under this place's level (backdrops, props, animated layers). Nest them via Parent to build a hierarchy, and attach utility components (fade, disappear, random child, blink). Target them from dialogue by Name with SetGameObjectActive / FadeSprite / MoveGameObject / SpinGameObject. Lower sorting draws further back; the pan is a MoveGameObject on the level itself."/>
                                    <ItemsControl ItemsSource="{Binding Overlays}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 MAP BUTTONS TAB
                 World Map radial buttons (e.g. the host mod-style
                 "House for Sale" button under the Foundry district).
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Map Buttons">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="Gray" TextWrapping="Wrap"
                               Text="Radial buttons added to the World Map's district menus. Each button travels to its target place when clicked, with optional music swap (e.g. MyTrack)."/>
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="+ Map button" Command="{Binding AddMapButtonCommand}"/>
                        <Button Content="− Remove selected" Command="{Binding RemoveMapButtonCommand}"/>
                    </ToolBar>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MapButtonList" ItemsSource="{Binding MapButtons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MapButtonViewModel}">
                                    <Border BorderBrush="LightGray" BorderThickness="1"
                                            CornerRadius="3" Padding="8" Margin="0,0,0,6"
                                            MouseDown="MapButtonRow_MouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Summary header -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Display}" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="−" Width="22" Height="22"
                                                    Padding="0" Margin="4,0,0,0"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove this map button"/>

                                            <!-- Target -->
                                            <TextBlock Text="Target place:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding DataContext.AllTargetOptions,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Token"
                                                      SelectedValue="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- District -->
                                            <TextBlock Text="District:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding DataContext.WorldMapDistrictOptions,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Token"
                                                      DisplayMemberPath="DisplayLabel"
                                                      SelectedValue="{Binding District, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="World Map radial menu the button is placed under"/>

                                            <!-- Label -->
                                            <TextBlock Text="Label:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Button text (e.g. 'House for Sale'). Supports [PV:variableName] tokens that re-resolve live from String pack variables — change the variable via a dialogue action or Integration rule and the button renames in place."/>

                                            <!-- Music -->
                                            <TextBlock Text="Music (optional):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Optional child name under 12_AudioPlayer to enable on click (e.g. MyTrack)"/>

                                            <!-- Visibility conditions — same row shape the
                                                 navigator buttons use. All must pass for the
                                                 button to render inside its district menu. -->
                                            <TextBlock Text="Conditions:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                                                <ItemsControl ItemsSource="{Binding Conditions}"
                                                              ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Content="+ Add condition" Margin="0,0,4,0" Padding="6,2"
                                                            Command="{Binding AddConditionCommand}"/>
                                                    <Button Content="+ Add group" Padding="6,2"
                                                            ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                            Command="{Binding AddConditionGroupCommand}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 DIALOGUES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Dialogues">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DlgListCol" Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="DlgMiddleCol" Width="380"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: dialogues folder tree (cosmetic grouping; drag to organize). -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Dialogues"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Dialogue" Command="{Binding AddDialogueCommand}"/>
                            <Button Content="+ Folder"   Command="{Binding AddDialogueFolderCommand}"
                                    ToolTip="Add a folder. Drag dialogues/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename"     Click="RenameFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove"   Command="{Binding RemoveDialogueCommand}"
                                    ToolTip="Remove the selected dialogue, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <TreeView x:Name="DialogueTreeView"
                                  ItemsSource="{Binding DialogueTree}"
                                  SelectedItemChanged="DialogueTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="DialogueTree_PreviewMouseLeftButtonDown"
                                  MouseMove="DialogueTree_MouseMove"
                                  Drop="DialogueTree_Drop">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:DialogueFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:DialogueLeafNode}">
                                    <TextBlock Text="{Binding Dialogue.Display}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: selected dialogue (properties + node list) -->
                    <!-- HorizontalScrollBarVisibility=Disabled is load-bearing: without it the
                         ScrollViewer defaults to Hidden, which still measures its content at
                         INFINITE width. That sizes the node list to the widest node's full text,
                         so the cards hard-clip at the viewport edge instead of trimming with an
                         ellipsis at the real column edge (and they ignore the column widening). -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  DataContext="{Binding SelectedDialogue}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Key:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Display name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="Roomtalk:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="2" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="+ New" Margin="4,0,0,0" Padding="6,0"
                                                Click="NewRoomTalk_Click"
                                                ToolTip="Create a new custom roomtalk (vanilla:&lt;name&gt;) and point this dialogue at it. The runtime spawns the roomtalk node on the fly."/>
                                        <ComboBox x:Name="RoomTalkBox" view:IssueTarget.Field="roomTalk"
                                                  ItemsSource="{Binding DataContext.RoomTalkOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Token"
                                                  SelectedValue="{Binding RoomTalk, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  Text="{Binding RoomTalk, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                    <CheckBox Content="Disable vanilla Trigger on this roomtalk"
                                              IsChecked="{Binding DisableVanillaTrigger}"
                                              Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="Stops the parent roomtalk's default Trigger from auto-firing its own dialogue. Use for vanilla rooms whose entry dialogue you want to suppress."/>
                                    <CheckBox Content="One-shot (don't replay)"
                                              IsChecked="{Binding OneShot}"
                                              Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                                    <CheckBox Content="Queued on arrival (no fade jumpscare)"
                                              IsChecked="{Binding Queued}"
                                              Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="Ease the dialogue in on level entry — starts without the FadeUI cinematic fade and after a short delay, instead of cutting to it abruptly."/>
                                    <CheckBox Content="Set for condition debugging (F12)"
                                              IsChecked="{Binding DebugConditions}"
                                              Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="In-game, pressing F12 logs a pass/fail breakdown of this dialogue's start conditions (with current variable values) to the BepInEx console. Diagnostic only — no gameplay effect."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Start conditions (all must pass)">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add condition" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddDialogueStartConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="+ Add group" Padding="8,2"
                                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                Command="{Binding DataContext.AddDialogueStartConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyStartConditionsCommand}"
                                                ToolTip="Copy these start conditions (except the pinned level gate) to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteStartConditionsCommand}"
                                                ToolTip="Append clipboard conditions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteStartConditionsCommand}"
                                                ToolTip="Replace these start conditions with the clipboard (keeps the pinned level gate)"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="startConditions"
                                                  ItemsSource="{Binding StartConditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="Nodes">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="Click a node to select it. Use the toolbar to add a root, add a child of the current selection, or remove the selected node. Roots are listed below."/>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4"
                                               Text="{Binding RootsSummary, StringFormat=Roots: {0}}" Foreground="Gray"/>
                                    <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,6,0,0">
                                        <Button Content="+ Root" Margin="0,0,2,0"
                                                Command="{Binding DataContext.AddDialogueRootNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Add a new top-level node (no parent)."/>
                                        <Button Content="+ Child" Margin="2,0,2,0"
                                                Command="{Binding DataContext.AddDialogueChildNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Add a child of the currently-selected node."/>
                                        <Button Content="+ Sibling" Margin="2,0,2,0"
                                                Command="{Binding DataContext.AddDialogueSiblingNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Add a node next to the selected one, sharing its parent (or another root when the selection is a root)."/>
                                        <Button Content="− Remove" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RemoveDialogueNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Delete the selected node. References to it from other nodes' children + the root list are scrubbed automatically."/>
                                    </UniformGrid>
                                    <ListBox x:Name="NodeList"
                                             ItemsSource="{Binding Nodes}"
                                             SelectedItem="{Binding DataContext.SelectedNode,
                                                            RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="240"
                                             PreviewMouseWheel="NodeList_PreviewMouseWheel"
                                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <!-- Copy/paste a node subtree (cross-dialogue). Commands live on
                                             the MainViewModel, reached via the ListBox's Tag because a
                                             ContextMenu isn't in the visual tree. -->
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Copy node (+ children)"
                                                          Command="{Binding PlacementTarget.Tag.CopyNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Paste as sibling"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeSiblingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Paste as child"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Paste as new root"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <!--
                                                Tree-style rendering of the flat node list. Each
                                                node's IndentMargin is computed by
                                                DialogueViewModel.RecomputeDepths after every
                                                Add/Remove/ToggleRoot operation, so children
                                                visually sit underneath their parents without us
                                                having to switch the control to a TreeView.
                                            -->
                                            <DataTemplate DataType="{x:Type vm:DialogueNodeViewModel}">
                                                <!-- DockPanel (not a horizontal StackPanel) so the label fills the
                                                     remaining width and trims with an ellipsis as the column scales,
                                                     instead of getting hard-clipped at the viewport edge. -->
                                                <DockPanel Margin="{Binding IndentMargin}">
                                                    <!-- Kind glyph: ▸ Text, ⇄ Choice, ? Random, ◆ answer (child of a Choice). -->
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding KindGlyph}" Width="14"
                                                               FontWeight="Bold" TextAlignment="Center"/>
                                                    <TextBlock Text="{Binding Display}" Margin="3,0,0,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Display}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Column="3" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- RIGHT: selected node editor -->
                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedNode}">
                        <StackPanel Margin="8">
                            <!-- Live preview of what the player will see during this node:
                                 derives the bust from the selected actor's default key
                                 (looked up through the MainViewModel.SelectedNodeActorBustKey
                                 helper) and the expression from the node's Expression field. -->
                            <GroupBox Header="Preview">
                                <ctl:BustPreview MainViewModel="{Binding DataContext,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                 BustKey="{Binding DataContext.SelectedNodeActorBustKey,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                 ExpressionKey="{Binding Expression}"/>
                            </GroupBox>
                            <GroupBox Header="Node">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ID:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Id}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBlock Text="Kind:"        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.NodeKinds,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Actor:"       Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <!-- Editable autocomplete: bind ONLY Text (not SelectedItem). Binding
                                         both to the same property makes SelectedItem null-out and flush an
                                         empty value back to the node being navigated away from when its
                                         value isn't in the (per-node, rebuilt) ItemsSource. -->
                                    <ComboBox view:IssueTarget.Field="actor" Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.ActorOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Expression:"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox view:IssueTarget.Field="expression" Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SelectedNodeExpressionOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"/>
                                    <!-- Outfit: optional per-node bust switch. The picker lists the
                                         speaking actor's authored outfits; empty keeps the current bust. -->
                                    <TextBlock Text="Outfit:"      Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SelectedNodeOutfitOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Text="{Binding Outfit, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Switch the actor to one of their outfits for this node onward. Leave blank to keep the actor's current bust."/>
                                    <TextBlock Text="Text:"        Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="5" Grid.Column="1"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                    <TextBlock Text="Tag:"         Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1"
                                              ToolTip="Optional. Other nodes can use Jump → tag to resume from here."/>
                                    <TextBlock Text="Children:"    Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChildrenSummary}" Grid.Row="7" Grid.Column="1" Foreground="Gray"/>
                                    <TextBlock Text="Jump:"        Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="8" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.JumpModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding JumpMode, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Jump tag:"    Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding JumpTargetTag, UpdateSourceTrigger=PropertyChanged}" Grid.Row="9" Grid.Column="1"/>
                                    <TextBlock Text="Duration:"    Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="10" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.NodeDurations,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="How a text line advances. UntilInteraction waits for the player; Timeout auto-advances after the typewriter finishes."/>
                                    <TextBlock Text="Timeout (s):" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Timeout, Converter={x:Static conv:SingleConverter.Instance}}"
                                              Grid.Row="11" Grid.Column="1"
                                              IsEnabled="{Binding IsTimeout}"
                                              ToolTip="Seconds the line lingers after typing finishes (Timeout mode only). Decimals OK, e.g. 1.5."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Conditions (gate this node)">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add condition" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddNodeConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="+ Add group" Padding="8,2"
                                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                Command="{Binding DataContext.AddNodeConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyConditionsCommand}"
                                                ToolTip="Copy all conditions here to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteConditionsCommand}"
                                                ToolTip="Append clipboard conditions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteConditionsCommand}"
                                                ToolTip="Replace all conditions here with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="conditions"
                                                  ItemsSource="{Binding Conditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="Actions on start">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add action" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddNodeActionOnStartCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsOnStartCommand}"
                                                ToolTip="Copy these actions to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsOnStartCommand}"
                                                ToolTip="Append clipboard actions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteActionsOnStartCommand}"
                                                ToolTip="Replace these actions with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="actionsOnStart"
                                                  ItemsSource="{Binding ActionsOnStart}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="Actions on finish">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add action" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddNodeActionOnFinishCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="Copy all" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsOnFinishCommand}"
                                                ToolTip="Copy these actions to the clipboard"/>
                                        <Button Content="Paste" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsOnFinishCommand}"
                                                ToolTip="Append clipboard actions"/>
                                        <Button Content="Overwrite" Padding="8,2"
                                                Command="{Binding OverwriteActionsOnFinishCommand}"
                                                ToolTip="Replace these actions with the clipboard"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="actionsOnFinish"
                                                  ItemsSource="{Binding ActionsOnFinish}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 ACTORS TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Actors">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Actors"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Actor"  Command="{Binding AddActorCommand}"/>
                            <Button Content="− Remove" Command="{Binding RemoveActorCommand}"/>
                        </ToolBar>
                        <ListBox x:Name="ActorList"
                                 ItemsSource="{Binding Actors}"
                                 SelectedItem="{Binding SelectedActor}"
                                 DisplayMemberPath="Display"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedActor}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Key:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Display name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="Default bust:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox view:IssueTarget.Field="defaultBustKey" Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding Outfits}"
                                              SelectedValuePath="BustGoName"
                                              SelectedValue="{Binding DefaultBustKey, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Text="{Binding DefaultBustKey, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="The outfit shown when this actor first appears, before any node switches it. Pick one of the actor's outfits listed below."/>
                                    <TextBlock Text="Name colour:"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <!--
                                        Colour-picker row: hex TextBox + live swatch + "Pick..." button
                                        that opens the Win32 ColorDialog. Matches the host mod's
                                        TMPWordColorizer pattern — at runtime the plugin registers
                                        (displayName → Color) against the active speech UI's
                                        colorizer, which paints the speaker label accordingly.
                                    -->
                                    <DockPanel Grid.Row="3" Grid.Column="1">
                                        <Border DockPanel.Dock="Left" Width="24" Height="22"
                                                BorderBrush="Gray" BorderThickness="1"
                                                Background="{Binding NameColorBrush}"
                                                ToolTip="{Binding NameColor}"
                                                Margin="0,0,4,0"/>
                                        <Button DockPanel.Dock="Right" Content="Pick…" Margin="4,0,0,0" Padding="6,0"
                                                Click="PickActorColor_Click"
                                                ToolTip="Open the Win32 colour picker."/>
                                        <TextBox Text="{Binding NameColor, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Hex colour for the speaker name (e.g. #FF8844 or #FF8844FF). Leave blank to use the default colour."/>
                                    </DockPanel>
                                    <!-- Preview pane: composites base + default expression for the selected actor. -->
                                    <ctl:BustPreview Grid.Row="0" Grid.RowSpan="4" Grid.Column="2"
                                                     Margin="8,0,0,0"
                                                     MainViewModel="{Binding DataContext,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                     BustKey="{Binding DefaultBustKey}"
                                                     ExpressionKey=""/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Voice (typewriter blip)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Text="The blip that plays as this actor's line types out. Pick a preset or dial in a custom pitch range. Frequency is how often the blip fires; pitch randomises between min and max. Editing a value switches the template to Custom."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                                  Content="Enable typewriter voice" IsChecked="{Binding TypewriterEnabled}"
                                                  ToolTip="When off, this actor's line types out silently."/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Template:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                                  ItemsSource="{Binding VoiceTemplates}"
                                                  SelectedItem="{Binding VoiceTemplate}"
                                                  ToolTip="Male → freq 45, pitch 0.6–0.9. Female → freq 45, pitch 1.0–1.5. Custom → your own values."/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frequency:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                                 Text="{Binding TypewriterFrequencyText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="How often the blip fires as text types (GC2 Typewriter frequency). Preset value: 45."/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Pitch min:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                                 Text="{Binding TypewriterPitchMinText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Low end of the random pitch range. Male 0.6, Female 1.0."/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pitch max:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                 Text="{Binding TypewriterPitchMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="High end of the random pitch range. Male 0.9, Female 1.5."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Outfits (busts this actor can wear)">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="+ Add outfit"
                                            Command="{Binding DataContext.AddActorOutfitCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="Each entry is a bust GameObject name. A dialogue node can switch the actor to any of these outfits — the actor's previous bust is deactivated and the new one shown. The Default bust above should be one of these."/>
                                    <ItemsControl ItemsSource="{Binding Outfits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ActorOutfitViewModel}">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.BustNameOptions,
                                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Token"
                                                              SelectedValue="{Binding BustGoName, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="True"
                                                              Text="{Binding BustGoName, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="Bust GO name — a vanilla bust under 2_Bust_Manager or a pack outfit's GameObjectName."/>
                                                    <Button Grid.Column="1" Content="−" Width="22" Margin="4,0,0,0"
                                                            Command="{Binding RemoveCommand}"
                                                            ToolTip="Remove this outfit"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="Expressions (per-node key → bust expression child)">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="+ Add expression"
                                            Command="{Binding DataContext.AddActorExpressionCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="If empty, the four standard expressions (Happy/Angry/Sad/Flirty) each map by name to a child of the bust's MBase1/Expressions/. Add entries to override or add custom expressions."/>
                                    <ItemsControl ItemsSource="{Binding Expressions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ActorExpressionViewModel}">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Pack-local expression key (e.g. Happy)"/>
                                                    <TextBox Grid.Column="2" Text="{Binding ExpressionGoName, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Child name under MBase1/Expressions/ on the bust"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 SCENES TAB

                 Each row is a pack-authored CG / story scene that ships
                 with the pack. At runtime the plugin clones the vanilla
                 "Samanthabeach" scene under 4_CG_Manager-Sexy, swaps the
                 Core SpriteRenderer (frame) and Core/Art SpriteRenderer
                 (scene image), and overrides the prototype's Trigger
                 component according to the authored sound mode.

                 Frame source: either a shipped vanilla frame (from
                 VanillaFrameOptions, copied next to the editor exe and
                 next to the plugin DLL) or a custom PNG path relative
                 to the pack root. The custom path takes precedence at
                 runtime when both are filled, so the author can keep a
                 vanilla pick "saved" while testing a custom one.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Scenes">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Scenes"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Scene"  Command="{Binding AddSceneCommand}"/>
                            <Button Content="− Remove" Command="{Binding RemoveSceneCommand}"/>
                        </ToolBar>
                        <ListBox ItemsSource="{Binding Scenes}"
                                 SelectedItem="{Binding SelectedScene}"
                                 DisplayMemberPath="Display"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedScene}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── composites scene image + frame, same z-order as runtime -->
                            <GroupBox Header="Preview">
                                <ctl:ScenePreview PackRoot="{Binding DataContext.PackRoot,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SceneSprite="{Binding SceneSprite}"
                                                  VanillaFrame="{Binding VanillaFrame}"
                                                  CustomFrameSprite="{Binding CustomFrameSprite}"/>
                            </GroupBox>

                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Key:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Display name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Scene image (relative to pack root)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sprite path:" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding SceneSprite, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Column="1"
                                              ToolTip="PNG path relative to the pack root — mapped onto the cloned scene's Core/Art SpriteRenderer."/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Frame (Core SpriteRenderer)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Pick a vanilla frame (shipped with the plugin) or supply a custom PNG path. When both are set, the custom frame wins at runtime."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Vanilla frame:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.VanillaFrameOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Token"
                                                  SelectedValue="{Binding VanillaFrame, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  Text="{Binding VanillaFrame, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Filename of a frame in the plugin's VanillaFrames folder."/>
                                        <TextBlock Text="Custom frame:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding CustomFrameSprite, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Pack-relative PNG path. Wins over Vanilla frame when set."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Sound (replaces prototype's Trigger)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mode:" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SceneSoundModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Sound, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Silent strips the prototype's trigger; Kiss / Flash strip it and emit the matching signal on activation; None keeps the prototype's audio."/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 VARIABLES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Variables">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Variables"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Variable" Command="{Binding AddVariableCommand}"/>
                            <Button Content="+ Folder"   Command="{Binding AddVariableFolderCommand}"
                                    ToolTip="Add a folder. Drag variables/folders to organize (cosmetic — doesn't change the pack)."/>
                            <Button Content="Rename"     Click="RenameVariableFolder_Click"
                                    ToolTip="Rename the selected folder."/>
                            <Button Content="− Remove"   Command="{Binding RemoveVariableCommand}"
                                    ToolTip="Remove the selected variable, or delete the selected folder (its contents move up)."/>
                        </ToolBar>
                        <TreeView x:Name="VariableTreeView"
                                  ItemsSource="{Binding VariableTree}"
                                  SelectedItemChanged="VariableTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="VariableTree_PreviewMouseLeftButtonDown"
                                  MouseMove="VariableTree_MouseMove"
                                  Drop="VariableTree_Drop">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:VariableFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:VariableLeafNode}">
                                    <TextBlock Text="{Binding Variable.Name}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedVariable}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Definition">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Name:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Type:"          Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.VariableTypes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Default value:"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsList}" Value="True">
                                                        <Setter Property="Text" Value="Initial values:"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Scalar default (non-list) -->
                                    <TextBox  view:IssueTarget.Field="defaultValue" Grid.Row="2" Grid.Column="1"
                                              Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsList, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <!-- List initial values (add as many as needed) -->
                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding InitialValues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ListValueRow}">
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Grid.Column="1" Content="−" Width="22" Margin="4,0,0,0"
                                                                Command="{Binding RemoveCommand}" ToolTip="Remove this value"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="+ Add value" HorizontalAlignment="Left" Padding="8,2" Margin="0,2,0,0"
                                                Command="{Binding DataContext.AddInitialValueCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="Append an initial entry to this list variable's starting contents."/>
                                    </StackPanel>
                                    <CheckBox Content="Persisted (writes to per-pack save file)"
                                              IsChecked="{Binding Persisted}"
                                              Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                                    <!-- Refresh mode: None / Daily reset / Daily random roll / Per-level-enter random roll.
                                         Daily is a once-per-day reset; DailyRandom / LevelRandom are random-gate
                                         generalisations — LevelRandom plus a Scope token re-rolls on entry to a
                                         specific level (gated on that level's activeSelf in vanilla). -->
                                    <TextBlock Text="Refresh mode:"  Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.VariableRefreshModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding RefreshMode, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Never = no auto-refresh.  Daily = reset to default each in-game day.  DailyRandom = re-roll a fresh random number (within Min/Max, default 0–100) each in-game day.  LevelRandom = re-roll on every entry to the level picked below (gates on that level's activeSelf in vanilla)."/>
                                    <!-- Scope picker — only meaningful when RefreshMode is LevelRandom. The binding to
                                         IsLevelScoped greys it out otherwise so the relationship is obvious. The picker
                                         reuses LevelOptions so the same token format works in both LevelActive conditions
                                         and here. -->
                                    <TextBlock Text="Refresh on level:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.LevelOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayLabel"
                                              SelectedValuePath="Token"
                                              SelectedValue="{Binding RefreshScope, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Text="{Binding RefreshScope, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsLevelScoped}"
                                              ToolTip="The level whose activation re-rolls this variable. Used only by LevelRandom. Format: vanilla:&lt;goName&gt; or place:&lt;key&gt; — same as a LevelActive condition."/>
                                    <TextBlock Text="Min value:"     Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="6" Grid.Column="1" Margin="0,4,0,0"
                                              IsEnabled="{Binding IsNumeric}"
                                              ToolTip="Optional lower clamp for Int/Float variables. The runtime keeps every write and increment at or above this. Also doubles as the lower bound for random refresh modes (defaults to 0 when unset)."/>
                                    <TextBlock Text="Max value:"     Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="7" Grid.Column="1"
                                              IsEnabled="{Binding IsNumeric}"
                                              ToolTip="Optional upper clamp for Int/Float variables. Also doubles as the upper bound for random refresh modes (defaults to 100 when unset)."/>
                                    <TextBlock Text="Description:"   Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="8" Grid.Column="1" Margin="0,4,0,0"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 WALLPAPERS TAB
                 Pack-declared desktop wallpapers for the in-game PC.
                 Each is gated by a single VariableEquals condition
                 (typically Event_Seen*) — the editor reduces that
                 condition to two simple fields (variable name +
                 expected value) so authors don't have to hand-author
                 NodeConditionDef structures for the common case.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Wallpapers">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Wallpapers"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Wallpaper" Command="{Binding AddWallpaperCommand}"/>
                            <Button Content="− Remove"    Command="{Binding RemoveWallpaperCommand}"/>
                        </ToolBar>
                        <ListBox ItemsSource="{Binding Wallpapers}"
                                 SelectedItem="{Binding SelectedWallpaper}"
                                 DisplayMemberPath="Display"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedWallpaper}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Key:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="Display name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Image (1920×1080)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Sprite path is pack-relative (e.g. Wallpaper/MyWallpaper.png). External path is an absolute on-disk path — used during the host mod transition. The custom (pack-relative) path wins when both are set."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Sprite path:"   Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox  Text="{Binding SpritePath, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="External path:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox  Text="{Binding ExternalSpritePath, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Unlock condition (optional)">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="When set, the selector button stays hidden until the named pack variable equals the expected value. Leave the name blank for an always-visible wallpaper."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Variable name:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.VariableNameOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  Text="{Binding UnlockVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  ToolTip="The pack variable to check. Common pattern: Event_Seen&lt;Char&gt;&lt;Place&gt;01."/>
                                        <TextBlock Text="Expected value:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox  Text="{Binding UnlockVariableValue, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                                  ToolTip="Defaults to 'true' — the unlock fires when the variable flips to that value."/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 MUSIC TAB
                 Pack-authored music tracks. Each track becomes a
                 sibling of vanilla audio under 12_AudioPlayer with
                 the key as its GameObject name — the existing
                 SwitchMusic node action finds it by name.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Music">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Music"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Music"   Command="{Binding AddMusicCommand}"/>
                            <Button Content="− Remove"  Command="{Binding RemoveMusicCommand}"/>
                        </ToolBar>
                        <ListBox ItemsSource="{Binding Music}"
                                 SelectedItem="{Binding SelectedMusic}"
                                 DisplayMemberPath="Display"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedMusic}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Key:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"
                                              ToolTip="GameObject name under 12_AudioPlayer — also what SwitchMusic references in its `music` param."/>
                                    <TextBlock Text="Display name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Audio">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Audio path:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding AudioPath, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"
                                              ToolTip="Pack-relative path. OGG / WAV / MP3 — extension inferred at load time."/>
                                    <TextBlock Text="Loop:"        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding LoopText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                              ToolTip="Leave blank to inherit (vanilla Beach template loops). Otherwise 'true' / 'false'."/>
                                    <TextBlock Text="Volume:"      Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding VolumeText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"
                                              ToolTip="0..1. Blank = inherit from the cloned template."/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 SFX TAB
                 Pack-authored one-shot sound effects. Variants are
                 auto-detected from disk (<key>_1.ogg, <key>_2.ogg,
                 …) — the registry picks one at random per play.
                 textPatterns lets authors register *plap* / *smooch*
                 style triggers that fire automatically when matched
                 in a dialogue node's text.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="SFX">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="SFX"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ SFX"     Command="{Binding AddSfxCommand}"/>
                            <Button Content="− Remove"  Command="{Binding RemoveSfxCommand}"/>
                        </ToolBar>
                        <ListBox ItemsSource="{Binding Sfx}"
                                 SelectedItem="{Binding SelectedSfx}"
                                 DisplayMemberPath="Display"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedSfx}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Key:"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"
                                              ToolTip="Referenced by PlaySFX node actions as `clip`."/>
                                    <TextBlock Text="Display name:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Audio">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Pack-relative path to the base clip. Variants are auto-detected — drop &lt;basename&gt;_1.&lt;ext&gt;, &lt;basename&gt;_2.&lt;ext&gt;, … beside the base and the registry picks one at random per play. OGG / WAV / MP3 are all accepted (the variant can have a different extension than the base)."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Audio path:"     Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox  Text="{Binding AudioPath, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="Default volume:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox  Text="{Binding DefaultVolumeText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                                  ToolTip="0..1. Used by PlaySFX when its own volume param is blank, and as the volume for auto-pattern-matched plays."/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="▶ Play" Padding="10,2"
                                                Command="{Binding DataContext.PlaySfxCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Preview the base clip at the default volume above. Needs the pack saved to disk."/>
                                        <Button Content="■ Stop" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding DataContext.StopSfxCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="10"
                                                   Text="Plays through the editor's own audio (OGG/WAV/MP3)."/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Auto-trigger patterns">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Comma-separated list of text patterns. When any pattern appears in a dialogue node's text on node-start, the SFX fires automatically (a random variant if multiple are loaded). Convention: asterisk-bracketed lowercase tokens like *plap*, *smooch*. One SFX can carry multiple patterns — *yank*,*yeet* both fire the same clip just like the host mod does. Leave blank for an SFX that only plays via explicit PlaySFX actions."/>
                                    <TextBox  Text="{Binding TextPatternsCsv, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 INTEGRATION TAB
                 Free-floating "if condition then actions" rules
                 evaluated each frame by the pack runtime. Same
                 condition / action vocabulary as dialogue nodes —
                 reuses the ConditionRowTemplate / ActionRowTemplate
                 from the Dialogues tab so authoring feels identical.
                 Each rule has a "Code mode" toggle that swaps the
                 picker UI for a JSON textbox with live validation,
                 for power users who want to author rules as text.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="Integration">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Update rules"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button Content="+ Rule"   Command="{Binding AddIntegrationRuleCommand}"/>
                            <Button Content="− Remove" Command="{Binding RemoveIntegrationRuleCommand}"/>
                        </ToolBar>
                        <ListBox ItemsSource="{Binding IntegrationRules}"
                                 SelectedItem="{Binding SelectedIntegrationRule}"
                                 DisplayMemberPath="Display"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedIntegrationRule}">
                        <StackPanel Margin="8">
                            <GroupBox Header="Identity">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Key:"           Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>

                                    <TextBlock Text="Display name:"  Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>

                                    <TextBlock Text="Description:"   Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"
                                              ToolTip="Free text — shown in the editor only, not at runtime. Useful for noting why a rule exists."/>

                                    <!-- Trigger mode: when does the action list fire relative to the conditions transitioning?
                                         OnRisingEdge is the most common ('when X becomes true, do Y, once'). WhilePassing fires every frame
                                         while conditions hold (rare; for live syncs). OnSceneLoad / OnDayChange are one-shots armed by the
                                         pack's lifecycle events. -->
                                    <TextBlock Text="Trigger mode:"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.UpdateRuleTriggerModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding TriggerMode, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="OnRisingEdge = fires once when conditions become true. OnFallingEdge = fires once when they stop. WhilePassing = fires every frame conditions match. OnSceneLoad / OnDayChange = one-shot per lifecycle event."/>
                                </Grid>
                            </GroupBox>

                            <!-- Mode toggle. Picker mode (default) renders the conditions + actions as rows;
                                 code mode swaps in a JSON textbox so power users can paste / hand-author the rule body. -->
                            <GroupBox Header="Editing mode">
                                <StackPanel>
                                    <CheckBox Content="Code mode (edit conditions + actions as JSON)"
                                              IsChecked="{Binding CodeMode}"
                                              ToolTip="When checked, the picker rows below are replaced with a JSON textbox. The textbox round-trips losslessly with the picker — toggling between modes preserves all data. Parse errors keep the toggle in code mode until you fix the JSON."/>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="Picker mode = pick from the action / condition catalogs row-by-row. Code mode = author the rule body directly as JSON. Same data, two views."/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Picker view: conditions list + actions list, hidden when CodeMode=true. -->
                            <GroupBox Header="Conditions (all must pass)"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="+ Add condition" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddIntegrationConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="+ Add group" Padding="8,2"
                                                ToolTip="Add an AND/OR group to bundle conditions like parentheses"
                                                Command="{Binding DataContext.AddIntegrationConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Conditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="Actions (fired when conditions trigger)"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="+ Add action"
                                            Command="{Binding DataContext.AddIntegrationActionCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <ItemsControl ItemsSource="{Binding Actions}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <!-- Code view: full rule body as a JSON textbox. Visible only when CodeMode=true.
                                 Validation message above the textbox surfaces parse errors live. -->
                            <GroupBox Header="Rule body (JSON)"
                                      Visibility="{Binding CodeMode, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="Edit the rule's trigger mode + conditions + actions as a JSON object. Format: { &quot;triggerMode&quot;: &quot;OnRisingEdge&quot;, &quot;conditions&quot;: [...], &quot;actions&quot;: [...] }. The conditions / actions arrays carry the same shape as dialogue nodes' actionsOnStart — see existing dialogues for examples."/>
                                    <TextBlock Foreground="Red" FontSize="11" Margin="0,0,0,4"
                                               Text="{Binding CodeError}"
                                               Visibility="{Binding IsCodeValid, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <TextBox  Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                                              AcceptsReturn="True" AcceptsTab="True"
                                              TextWrapping="NoWrap"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              FontFamily="Consolas, Courier New, monospace"
                                              MinHeight="240"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>

        <!-- Save-confirmation toast. Starts hidden (Opacity 0); the code-behind
             fades it in and back out whenever MainViewModel.Saved fires. It never
             intercepts input (IsHitTestVisible=False) and floats top-right just
             under the menu strip. -->
        <Border x:Name="SaveToast"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,30,16,0" Padding="10,5"
                CornerRadius="4"
                Background="#E2277A3C" BorderBrush="#40FFFFFF" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💾" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="Saved" Foreground="White" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
