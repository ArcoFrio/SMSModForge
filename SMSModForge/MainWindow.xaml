<!--
    MinWidth / MinHeight: the tab splitters are proportional, so panes shrink
    with the window - but two tabs carry a preview pane that is deliberately a
    FIXED width (Characters 540, NPCs 620) because the art inside is rendered at
    a known size, and the Characters sidebar takes its minimum from its own
    toolbar. Below about 1120 the fixed pane plus that minimum leaves the middle
    column nothing and the right of the tab goes off screen, which is not a
    state worth letting somebody reach.
-->
<Window x:Class="SMSModForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:l="clr-namespace:SMSModForge.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SMSModForge.ViewModel"
        xmlns:ctl="clr-namespace:SMSModForge.View.Controls"
        xmlns:conv="clr-namespace:SMSModForge.View.Converters"
        xmlns:view="clr-namespace:SMSModForge.View"
        xmlns:model="clr-namespace:SMSModForge.Model"
        xmlns:rend="clr-namespace:SMSModForge.Rendering"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="{Binding Title}"
        Icon="Resources/SMSModForge.ico"
        Width="1400" Height="900"
        MinWidth="1120" MinHeight="640"
        Background="{DynamicResource Theme.Window}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!--
            Headings for the three music pickers. A track name says nothing
            about where it came from - the pack's and the game's are children
            of the same object and either is a legal value - so the list is
            grouped under "This pack" and "The game's own" instead.

            Declared before the templates that use it: a StaticResource is
            resolved in the order the dictionary is parsed.
        -->
        <GroupStyle x:Key="MusicOriginGroupStyle">
            <!-- A heading lives exactly as long as something under it does.
                 Without this, narrowing a grouped dropdown leaves its headings
                 standing over nothing - the one place hiding item containers
                 shows through, since a heading is not an item and never asked
                 itself the question. Every grouped dropdown in the editor uses
                 this one GroupStyle, so this is the only place it needs asking. -->
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem" BasedOn="{StaticResource {x:Type GroupItem}}">
                    <Setter Property="Visibility">
                        <Setter.Value>
                            <MultiBinding Converter="{x:Static conv:SearchMatchConverter.Instance}">
                                <Binding Path="."/>
                                <Binding Path="(view:ComboBoxSearch.Typed)"
                                         RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=ComboBox}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               Opacity="0.75" FontSize="10" Margin="0,4,0,1"/>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!--
            How every categorised dropdown scrolls.

            WPF's ScrollUnit defaults to Item, so a virtualizing list moves a
            whole row per notch. On a grouped list, where rows sit under
            headers of a different height, that reads as snapping - and the
            snap has nothing to do with how much is actually in each group,
            which is what made it feel arbitrary.

            Pixel scrolling fixes that; virtualizing-when-grouping keeps a long
            list cheap, which matters because the longest of them is about to
            be the game's 1,924 variables rather than a handful of tracks.
        -->
        <Style x:Key="GroupedComboBox" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True"/>
        </Style>
        <!--
            Visibility converters for the Integration tab's picker /
            code mode toggle. BoolToVisibility shows when bound flag
            is true; the inverse hides on true. Both are reused
            anywhere we want a layout-collapsing show/hide tied to a
            boolean property (avoids the gap left by WPF's built-in
            converter which only sets Hidden).
        -->
        <conv:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter             x:Key="InverseBoolConverter"/>

        <!--
            Implicit DataTemplate for NavigatorTargetOption: WPF picks
            this up wherever a NavigatorTargetOption is rendered (combo
            dropdown items, closed-state SelectedItem in non-IsEditable
            combos). Pairs with NavigatorTargetOption.ToString() returning
            Token: with no DisplayMemberPath the combo's Text falls back
            to ToString(), so SelectedValue + Text both round-trip the
            same Token to the bound property — without this, the Text
            binding would clobber SelectedValue with the display label.
        -->
        <DataTemplate DataType="{x:Type vm:NavigatorTargetOption}">
            <TextBlock Text="{Binding DisplayLabel}"/>
        </DataTemplate>

        <!--
            One of the Direct Path list's paths into the game (1.6.3): the path,
            and beside it a short note saying what it is, with an example. Like
            NavigatorTargetOption, GamePathOption.ToString() is what lands in the
            box - the path, slashes and all - so the note is only ever shown here.
        -->
        <DataTemplate DataType="{x:Type vm:GamePathOption}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Value}"/>
                <TextBlock Text="{Binding Note}" Foreground="Gray" FontSize="11"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!--
            Compact position / rotation / scale editor for one NpcTransformViewModel
            (a placed NPC part: body / shadow / blink / wet). Three labelled rows of
            three boxes. Shared by every part row in the Places placement editor, and
            the surface the Phase-3 transform gizmo drives through the same VM.
        -->
        <DataTemplate x:Key="NpcTransformEditor" DataType="{x:Type vm:NpcTransformViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{l:T npcTransform.pos}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1">
                    <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="52" ToolTip="{l:T npcTransform.positionX.tip}"/>
                    <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="{l:T npcTransform.positionY.tip}"/>
                    <TextBox Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="{l:T npcTransform.positionZ.tip}"/>
                </StackPanel>

                <TextBlock Text="{l:T npcTransform.rot}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0">
                    <TextBox Text="{Binding RotX, UpdateSourceTrigger=PropertyChanged}" Width="52" ToolTip="{l:T npcTransform.rotationX.tip}"/>
                    <TextBox Text="{Binding RotY, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="{l:T npcTransform.rotationY.tip}"/>
                    <TextBox Text="{Binding RotZ, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="{l:T npcTransform.rotationZ.tip}"/>
                </StackPanel>

                <TextBlock Text="{l:T npcTransform.scale}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="Gray" Margin="0,2,0,0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="0,2,0,0">
                    <TextBox Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}" Width="52" ToolTip="{l:T npcTransform.scaleXNegativeMirrors.tip}"/>
                    <TextBox Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="{l:T npcTransform.scaleY.tip}"/>
                    <TextBox Text="{Binding ScaleZ, UpdateSourceTrigger=PropertyChanged}" Width="52" Margin="4,0,0,0" ToolTip="{l:T npcTransform.scaleZ.tip}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Shared unit folder trees (Actors/Places/Scenes/Wallpapers/Music/SFX):
             one implicit template pair + one container style reused by every
             tree, so the six tabs carry no per-tree markup beyond the TreeView. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:UnitFolderNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📁" Margin="0,0,4,0"/>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:UnitLeafNode}">
            <TextBlock Text="{Binding DisplayText}"/>
        </DataTemplate>
        <Style x:Key="UnitTreeItemStyle" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- Two-way, so the view model can RELEASE the tree's selection.
                 Picking a row in the sidebar's other list used to clear the
                 selection in the view model and leave the row highlighted
                 here, and clicking it again then raised no event at all. -->
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                    <Setter Property="Background" Value="#5578A8E0"/>
                </DataTrigger>
                <!-- Sidebar search: rows the filter excludes collapse away. The
                     tree itself is untouched, so selection / drag-drop survive. -->
                <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar search box. DataContext is the tab's UnitTreeController;
             the ✕ clears without reaching for the keyboard. -->
        <ControlTemplate x:Key="SidebarSearchTemplate">
            <Grid Margin="2,2,2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                         ToolTip="{l:T sidebarSearch.filterListMatchesFolder.tip}"/>
                <TextBlock Grid.Column="0" Text="{l:T sidebarSearch.search}" Foreground="Gray" Margin="4,0,0,0"
                           IsHitTestVisible="False" VerticalAlignment="Center"
                           Visibility="{Binding HasFilter, Converter={StaticResource InverseBoolToVisibility}}"/>
                <Button Grid.Column="1" Content="✕" Margin="2,0,0,0" Padding="4,0" MinWidth="0"
                        Command="{Binding ClearFilterCommand}"
                        Visibility="{Binding HasFilter, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{l:T sidebarSearch.clearFilter.tip}"/>
            </Grid>
        </ControlTemplate>

        <!--
            ════════════════════════════════════════════════════════════
            Schema-driven typed param-row templates.

            Each template renders ONE row inside an action or condition's
            ParamRows list: a label (the schema's friendly Label) and one
            typed editor control (TextBox / CheckBox / ComboBox bound to
            the matching option list on MainViewModel). Templates are
            mounted into the row by ParamTypeTemplateSelector below; the
            two row templates (ActionRowTemplate, ConditionRowTemplate)
            host the selector inside an ItemsControl over ParamRows so a
            user changing the action / condition type sees the editor
            shape swap automatically.

            All the ComboBox-based templates stay IsEditable=True so the
            user can type a token that isn't yet in the underlying list
            (e.g. a vanilla GO name not declared on this pack), exactly
            like the previous hand-written specialised editors did.
            ════════════════════════════════════════════════════════════
        -->

        <!-- Reusable label+control row geometry. Each typed template
             repeats this Grid skeleton so the param-row column widths
             stay aligned across the whole list. -->
        <Style x:Key="ParamRowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <!-- Rows whose schema declares an EnabledWhen dependency grey out
                 (label included) when the controlling param isn't in the right
                 state — e.g. the Timer condition's Min/Max until Randomize is
                 checked, and its fixed Wait once it is. Every typed template
                 roots on this Grid, so gating here covers them all. Rows with
                 no dependency report IsEnabled = true and are unaffected. -->
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
        </Style>

        <!-- A toolbar button that says which key does the same thing. The
             hint is dimmed and small: it should be readable when looked for and
             invisible when not. Tag carries the gesture. -->
        <Style x:Key="ToolbarButtonWithKey" TargetType="Button">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Tag}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" Opacity="0.45"
                                           FontSize="10"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- How something arrives when it is switched on. Bound to a
             UiOpenViewModel, which a screen and an object each own one of. -->
        <DataTemplate x:Key="UiOpenTemplate" DataType="{x:Type vm:UiOpenViewModel}">
            <StackPanel>
                <CheckBox IsChecked="{Binding Animates, Mode=TwoWay}" Margin="0,0,0,4"
                          ToolTip="{l:T uiOpen.offAppearsVanishesOnce.tip}">
                    <TextBlock TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{l:T uiOpen.animateWhenOpens}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Closing}" Value="True">
                                        <Setter Property="Text" Value="{l:T uiOpen.animateWhenCloses}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </CheckBox>

                <StackPanel Margin="14,0,0,0" IsEnabled="{Binding Animates}"
                            Visibility="{Binding Animates, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox IsChecked="{Binding Fade, Mode=TwoWay}" Margin="0,0,0,3"
                              ToolTip="{l:T uiOpen.fadeBetweenInvisibleSolid.tip}">
                        <TextBlock TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T uiOpen.fade}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Closing}" Value="True">
                                            <Setter Property="Text" Value="{l:T uiOpen.fadeOut}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox>

                    <CheckBox IsChecked="{Binding Grows, Mode=TwoWay}" Margin="0,0,0,3"
                              ToolTip="{l:T uiOpen.moveBetweenOwnSize.tip}">
                        <TextBlock TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T uiOpen.grow}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Closing}" Value="True">
                                            <Setter Property="Text" Value="{l:T uiOpen.shrink}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </CheckBox>

                    <DockPanel Margin="14,0,0,4"
                               Visibility="{Binding Grows, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="X" Width="14" VerticalAlignment="Center"/>
                        <TextBox Width="46" Margin="0,0,6,0"
                                 Text="{Binding ScaleFromX, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/>
                        <TextBlock Text="Y" Width="14" VerticalAlignment="Center"/>
                        <TextBox Width="46" Margin="0,0,6,0"
                                 Text="{Binding ScaleFromY, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/>
                        <TextBlock Text="Z" Width="14" VerticalAlignment="Center"/>
                        <TextBox Width="46"
                                 Text="{Binding ScaleFromZ, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"/>
                        <TextBlock/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,3">
                        <TextBlock Text="{l:T uiOpen.over}" Width="42" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:T uiOpen.seconds}" DockPanel.Dock="Right" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Opacity="0.7"/>
                        <TextBox Text="{Binding Duration, UpdateSourceTrigger=LostFocus, StringFormat=0.###}"
                                 ToolTip="{l:T uiOpen.03WhatShop.tip}"/>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{l:T uiOpen.curve}" Width="42" VerticalAlignment="Center"/>
                        <ComboBox Style="{StaticResource GroupedComboBox}" ItemsSource="{Binding Easings}"
                                  SelectedItem="{Binding Easing, Mode=TwoWay}"
                                  ToolTip="{l:T uiOpen.curvesGameItselfUses.tip}"/>
                    </DockPanel>

                    <Button Content="{l:T uiOpen.playUiOpenAnimation}" Padding="10,2" HorizontalAlignment="Left"
                            Click="PlayUiOpenAnimation_Click"
                            ToolTip="{l:T uiOpen.playUiOpenAnimation.tip}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="StringParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Bool → CheckBox. The CheckBox content is the schema label
             so the row is one line; we still use the same Grid skeleton
             so the controls align with the other typed rows. -->
        <DataTemplate x:Key="BoolParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <CheckBox  Grid.Column="1"
                           IsChecked="{Binding BoolValue}"
                           ToolTip="{Binding Tooltip}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Int / Float share the same template: a plain TextBox bound
             to Value as a string. The runtime parses with invariant
             culture, so the user can type either "3" or "3.14" and the
             editor just stores the literal string. -->
        <DataTemplate x:Key="IntParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Percent → whole number + a trailing "%" so the field reads as
             "30 %" rather than "0.3". The stored value is the bare number;
             the runtime divides by 100. The box is fixed to ~3 digits and
             the trailing column soaks up the slack, so the field doesn't
             stretch across the row for a value that can never exceed 100. -->
        <DataTemplate x:Key="PercentParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1" Width="42" MaxLength="3"
                          HorizontalAlignment="Left" HorizontalContentAlignment="Right"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="4,0,0,0"
                           FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FloatParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox  Grid.Column="1"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- PackVarRef → combobox bound to VariableNameOptions. All ref
             combos share this shape: ItemsSource via RelativeSource
             AncestorType=Window so the option list is resolved against
             the MainViewModel even though the row's DataContext is the
             ParamRowViewModel. IsEditable+Text bound to Value gives the
             "pick from list or type your own" semantics. -->
        <DataTemplate x:Key="PackVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DockPanel Grid.Column="1">
                    <!-- The same note a Variable condition shows, for the same
                         reason: a row that names a variable should say what it
                         is looking at wherever it appears. -->
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VarKindNote}"
                               FontSize="10" Opacity="0.75" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{l:T params.whatVariableHolds.tip}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VarKindNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox Style="{StaticResource GroupedComboBox}"
                           ItemsSource="{Binding DataContext.VariableNameOptionsGrouped,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}">

                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ListVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VarKindNote}"
                               FontSize="10" Opacity="0.75" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{l:T params.whatVariableHolds.tip}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VarKindNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding DataContext.ListVariableNameOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- BoolVarRef: variable reference that renders as True/False radio buttons
             when the variable is boolean. Falls back to the standard variable dropdown
             for non-boolean variables. -->
        <DataTemplate x:Key="BoolVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <!-- When IsBooleanVariable is true, show radio buttons; otherwise fall through to
                     the PackVarRef dropdown. The radio panel is collapsed when the variable is not boolean. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBooleanVariable, Converter={StaticResource BoolToVisibility}}">
                    <RadioButton Content="{l:T params.true}" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                 Margin="0,0,12,0" VerticalAlignment="Center"
                                 ToolTip="{l:T params.true.tip}"/>
                    <RadioButton Content="{l:T params.false}" IsChecked="{Binding BoolValue, Mode=TwoWay, Converter={StaticResource InverseBoolConverter}}"
                                 VerticalAlignment="Center"
                                 ToolTip="{l:T params.false.tip}"/>
                </StackPanel>
                <!-- Fallback: variable dropdown when the variable is not boolean -->
                <DockPanel Grid.Column="1"
                           Visibility="{Binding IsBooleanVariable, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VarKindNote}"
                               FontSize="10" Opacity="0.75" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{l:T params.whatVariableHolds.tip}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VarKindNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ComboBox Style="{StaticResource GroupedComboBox}"
                          ItemsSource="{Binding DataContext.VariableNameOptionsGrouped,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                          IsEditable="True"
                          Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding Tooltip}">

                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <!-- GameVarRef: still free text, because a pack may address a global
             this build's catalogue does not carry. What it gained is the note:
             the game's own variables ARE enumerated now, so a name that
             resolves says what it holds, and one that resolves to nothing says
             nothing - which is the difference between a typo you find here and
             a typo you find in game. -->
        <DataTemplate x:Key="GameVarRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding VarKindNote}"
                               FontSize="10" Opacity="0.75" Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{l:T params.whatVariableHolds.tip}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VarKindNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LevelRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Style="{StaticResource GroupedComboBox}"  Grid.Column="1"
                           ItemsSource="{Binding DataContext.LevelOptionsGrouped,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}">

                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                        </ComboBox>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActorRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1" Style="{StaticResource GroupedComboBox}"
                           ItemsSource="{Binding DataContext.ActorOptionsGrouped,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}">
                    <ComboBox.GroupStyle>
                        <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                    </ComboBox.GroupStyle>
                </ComboBox>
            </Grid>
        </DataTemplate>

        <!-- BustRef binds to ActorBustOptions — the actor-grouped list
             that pairs each actor with its declared default-bust GO
             name. Token-based SelectedValuePath so picking an entry
             writes the bust GO, not the display label. -->
        <DataTemplate x:Key="BustRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ActorBustOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ExpressionRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.ExpressionKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SceneRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding DataContext.SceneOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           SelectedValuePath="Token"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Signal names are open-ended — same shape as GameVarRef. -->
        <!-- SignalRef → editable ComboBox: autocompletes the known GC2 signal
             vocabulary (KnownSignals, sourced from the host mod) while still
             letting the author type any custom signal name. -->
        <!-- SpriteRef: a pack-relative PNG. PathPickerBox is the same control
             the Places and Characters tabs use, so browsing stores the path
             relative to the pack root rather than an absolute one. -->
        <DataTemplate x:Key="SpriteRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ctl:PathPickerBox Grid.Column="1"
                                   PathText="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                   PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Filter="{Binding PickerFilter}"
                                   ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SignalRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           IsEditable="True"
                           ItemsSource="{Binding DataContext.SignalOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MusicRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Style="{StaticResource GroupedComboBox}"  Grid.Column="1"
                           IsSynchronizedWithCurrentItem="False"
                           ItemsSource="{Binding DataContext.MusicKeyOptionsGrouped,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}">

                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                        </ComboBox>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SfxRefParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Style="{StaticResource GroupedComboBox}"  Grid.Column="1"
                           ItemsSource="{Binding DataContext.SfxKeyOptions,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           IsEditable="True"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- GameObjectPath → editable ComboBox: offers paths into the game worth
             knowing (DirectPathExamples, grouped, a note beside each) while still
             letting the author type any hierarchy path. -->
        <DataTemplate x:Key="GameObjectPathParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox Style="{StaticResource GroupedComboBox}" Grid.Column="1"
                           IsEditable="True"
                           FontFamily="Consolas"
                           ItemsSource="{Binding DataContext.DirectPathExamples,
                                         RelativeSource={RelativeSource AncestorType=Window}}"
                           Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}">
                    <ComboBox.GroupStyle>
                        <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                    </ComboBox.GroupStyle>
                </ComboBox>
            </Grid>
        </DataTemplate>

        <!-- Fixed-choice dropdown: options come from the schema itself
             (ParamSchema.FixedOptions), not a MainViewModel list. Non-editable
             so the stored value is always one of the declared options. -->
        <DataTemplate x:Key="ChoiceParamTemplate" DataType="{x:Type vm:ParamRowViewModel}">
            <Grid Style="{StaticResource ParamRowGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox  Grid.Column="1"
                           ItemsSource="{Binding FixedChoices}"
                           DisplayMemberPath="Text" SelectedValuePath="Value"
                           SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="{Binding Tooltip}"/>
            </Grid>
        </DataTemplate>

        <!-- Shared selector instance. ParamRowsItemsControl below
             references this via StaticResource so we don't duplicate
             the 16-template list inline. -->
        <view:ParamTypeTemplateSelector x:Key="ParamTypeTemplateSelector"
                                        StringTemplate="{StaticResource StringParamTemplate}"
                                        BoolTemplate="{StaticResource BoolParamTemplate}"
                                        IntTemplate="{StaticResource IntParamTemplate}"
                                        FloatTemplate="{StaticResource FloatParamTemplate}"
                                        PercentTemplate="{StaticResource PercentParamTemplate}"
                                        PackVarRefTemplate="{StaticResource PackVarRefParamTemplate}"
                                        ListVarRefTemplate="{StaticResource ListVarRefParamTemplate}"
                                        BoolVarRefTemplate="{StaticResource BoolVarRefParamTemplate}"
                                        GameVarRefTemplate="{StaticResource GameVarRefParamTemplate}"
                                        LevelRefTemplate="{StaticResource LevelRefParamTemplate}"
                                        ActorRefTemplate="{StaticResource ActorRefParamTemplate}"
                                        BustRefTemplate="{StaticResource BustRefParamTemplate}"
                                        ExpressionRefTemplate="{StaticResource ExpressionRefParamTemplate}"
                                        SceneRefTemplate="{StaticResource SceneRefParamTemplate}"
                                        SignalRefTemplate="{StaticResource SignalRefParamTemplate}"
                                        MusicRefTemplate="{StaticResource MusicRefParamTemplate}"
                                        SfxRefTemplate="{StaticResource SfxRefParamTemplate}"
                                        GameObjectPathTemplate="{StaticResource GameObjectPathParamTemplate}"
                                          SpriteRefTemplate="{StaticResource SpriteRefParamTemplate}"
                                        ChoiceTemplate="{StaticResource ChoiceParamTemplate}"/>

        <!--
            Which quest, and which task: the part the Quest action and both quest
            conditions share. One template so the three rows cannot offer
            different things. The task list follows the quest and is chosen from
            rather than typed - a game task is stored by its id, and nobody
            should have to read one.
        -->
        <DataTemplate x:Key="QuestPickerTemplate" DataType="{x:Type vm:QuestPickerViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{l:T questPicker.source}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                <ComboBox x:Name="QuestSourcePicker" Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                          ItemsSource="{x:Static vm:QuestPickerViewModel.Sources}"
                          SelectedItem="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{l:T questPicker.questSourcePicker.tip}"/>

                <TextBlock Text="{l:T questPicker.quest}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                <ComboBox x:Name="QuestNamePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                          IsEditable="True"
                          ItemsSource="{Binding QuestOptions}"
                          Text="{Binding QuestKey, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{l:T questPicker.questNamePicker.tip}"/>

                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="Gray" FontSize="10"
                           TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding QuestNote}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding QuestNote}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{l:T questPicker.task}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                           Visibility="{Binding ShowsTask, Converter={StaticResource BoolToVisibility}}"/>
                <!-- Editable so it can be searched like every other dropdown. The box
                     shows the task's name and what is stored is its token - an id, for
                     one of the game's tasks - so the choice goes through SelectedValue
                     and nothing is bound to the typed text: a search that is left
                     without picking puts the chosen task back. -->
                <ComboBox x:Name="QuestTaskPicker" Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                          IsEditable="True"
                          ItemsSource="{Binding TaskOptions}"
                          SelectedValuePath="Token"
                          SelectedValue="{Binding TaskChoice, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding ShowsTask, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="{l:T questPicker.questTaskPicker.tip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuestTaskOption}">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Row="4" Grid.Column="1" Foreground="Gray" FontSize="10"
                           TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding TaskNote}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TaskNote}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowsTask}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!--
            What an action's or a condition's target looks like, under its target
            (1.6.3): see the slots in LeafConditionTemplate and ActionRowTemplate,
            and NodeActionViewModel.PreviewArt. Defined before both.
        -->
        <DataTemplate x:Key="ActionTargetPreviewTemplate" DataType="{x:Type vm:NodeActionViewModel}">
            <StackPanel Margin="0,2,0,4" Orientation="Horizontal">
                <ctl:ScenePreview BoxSize="{Binding PreviewBoxSize}" Background="Transparent"
                                  ToolTip="{l:T action.preview.before.tip}"
                                  PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SceneSprite="{Binding PreviewScene.SceneSprite, FallbackValue=''}"
                                  VanillaFrame="{Binding PreviewScene.VanillaFrame, FallbackValue=''}"
                                  CustomFrameSprite="{Binding PreviewScene.CustomFrameSprite, FallbackValue=''}"
                                  Visibility="{Binding ShowsScenePreview, Converter={StaticResource BoolToVisibility}}"/>
                <ctl:ArtThumb BoxSize="{Binding PreviewBoxSize}"
                              ToolTip="{l:T action.preview.before.tip}"
                              PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                              Sprite="{Binding PreviewArt}"
                              Visibility="{Binding ShowsArtPreview, Converter={StaticResource BoolToVisibility}}"/>
                <Path Tag="swapArrow" Data="M0,7 L20,7 M13,0 L20,7 L13,14" Stroke="{DynamicResource Theme.Text}"
                      StrokeThickness="2" Opacity="0.6" Margin="8,0" VerticalAlignment="Center"
                      Visibility="{Binding ShowsSwap, Converter={StaticResource BoolToVisibility}}"/>
                <ctl:ScenePreview BoxSize="{Binding PreviewBoxSize}" Background="Transparent"
                                  ToolTip="{l:T action.preview.after.tip}"
                                  PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SceneSprite="{Binding SceneAfterSprite}"
                                  VanillaFrame="{Binding PreviewScene.VanillaFrame, FallbackValue=''}"
                                  CustomFrameSprite="{Binding PreviewScene.CustomFrameSprite, FallbackValue=''}"
                                  Visibility="{Binding ShowsSceneAfter, Converter={StaticResource BoolToVisibility}}"/>
                <ctl:ArtThumb BoxSize="{Binding PreviewBoxSize}"
                              ToolTip="{l:T action.preview.after.tip}"
                              PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                              Sprite="{Binding ArtAfterSprite}"
                              Visibility="{Binding ShowsArtAfter, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </DataTemplate>

        <!--
            Shared row template for every list of NodeConditionViewModel
            (dialogue-start conditions and per-node conditions). One row
            renders:
              · a minus button driven by NodeConditionViewModel.RemoveCommand
                (CanExecute is false for IsLocked rows — the pinned
                LevelActive condition is locked, so its row stays put);
              · the Type combo (disabled on locked rows via IsTypeEditable);
              · the Negate checkbox;
              · an ItemsControl over ParamRows that picks a typed editor
                template per param via ParamTypeTemplateSelector. The
                schema for each condition type lives in
                ConditionSchemas.ByType.
        -->
        <DataTemplate x:Key="LeafConditionTemplate" DataType="{x:Type vm:NodeConditionViewModel}">
            <!-- The pinned LevelActive row is styled apart from the ordinary
                 ones: it is required rather than chosen, so it reads as part of
                 the dialogue's identity instead of one condition among many. -->
            <Border BorderThickness="1" CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="LightGray"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLockedHeader}" Value="True">
                                <Setter Property="BorderBrush" Value="#FF6A8CAF"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#146A8CAF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- The pinned level row's "Required", or what a locked row of the
                         game's is, when it needs saying. -->
                    <TextBlock x:Name="LockedHeaderText" Text="{Binding LockedHeader}"
                               FontWeight="SemiBold" Foreground="#FF3E6084"
                               Margin="0,0,0,4" TextWrapping="Wrap"
                               Visibility="{Binding HasLockedHeader, Converter={StaticResource BoolToVisibility}}"/>
                    <!-- Header row: Type combo + Remove button. The Type
                         combo is disabled when IsTypeEditable is false
                         (locked LevelActive row). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T condition.type}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <!-- Per-row list, not a global one: rows in a one-shot host
                             (dialogue node conditions, level hooks) also offer the
                             single-roll Random gate, which would be meaningless in
                             a per-frame-polled host. -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AvailableTypes}"
                                  SelectedItem="{Binding DisplayType, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding IsTypeEditable}"
                                  ToolTip="{l:T condition.pinnedLevelactiveStartCondition.tip}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="{l:T condition.copy.tip}"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="{l:T condition.remove.tip}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Negate is meaningless on the pinned row: "not in this
                         level" would leave the dialogue with no level at all,
                         and the runtime resolves its roomtalk from this token. -->
                    <CheckBox Content="{l:T condition.negate}" IsChecked="{Binding Negate}" Margin="110,2,0,2"
                              ToolTip="{l:T condition.negate.tip}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- Hidden on a boolean comparison: True/False already
                                         says both cases, and Negate on top of it is a second
                                         way to say the same thing. "Negate: is false" is a
                                         double negative nobody should have to unpick. -->
                                    <DataTrigger Binding="{Binding VarValueIsBool}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <!-- Schema-driven param rows. ItemsSource is the
                         ParamRows collection on the condition VM; the
                         template selector swaps in a typed editor per
                         ParamType. An empty ParamRows list (e.g.
                         AlwaysTrue) leaves the ItemsControl empty,
                         which collapses to zero height naturally. -->
                    <ItemsControl ItemsSource="{Binding ParamRows}"
                                  ItemTemplateSelector="{StaticResource ParamTypeTemplateSelector}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- InputKey: device, key, phase. The key list follows the device
                         picker, which is why this is a hand-built row rather than
                         schema-driven ones — a schema row cannot depend on a sibling.

                         The list is GROUPED, and the group headings carry the keyboard-
                         layout warning: Unity reports letters and digits by position, so
                         "A" is wherever A sits on a US board. Saying that in the heading
                         puts it where somebody choosing a key cannot miss it, and puts
                         the groups that do not move (mouse, arrows, modifiers, function
                         keys, numpad) at the top where they are the easy default. -->
                    <Grid Margin="0,2,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInputFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{l:T condition.device}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.InputDevices}"
                                  SelectedItem="{Binding InputDevice, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.whichListKeysChoose.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:KeyTextConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{l:T condition.key}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <!-- The grouped style scrolls by pixel. Without it a grouped list
                             scrolls a whole group per step, and the letters group is taller
                             than the list, so most of it could never be reached. -->
                        <ComboBox x:Name="InputKeyPicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  Style="{StaticResource GroupedComboBox}"
                                  ItemsSource="{Binding InputKeyOptions}"
                                  SelectedValuePath="Token"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding InputKeyToken, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.inputKeyPicker.tip}">
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Opacity="0.75" FontSize="10" Margin="0,4,0,1"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>

                        <TextBlock Text="{l:T condition.when}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.InputPhaseOptions}"
                                  SelectedItem="{Binding InputPhase, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.pressedReleasedMomentsTrue.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=phase}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="Gray" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="{Binding InputPhaseHelp}"/>
                    </Grid>

                    <!-- Category + Target for GameObjectActive — the same row the
                         Set-Active action uses, because the condition asks about exactly
                         what that action sets. Category swaps the Target autocomplete;
                         GameObjects resolves the object inside the chosen Level. -->
                    <Grid Margin="0,2,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoActiveFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{l:T condition.category}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.GoCategories}"
                                  SelectedItem="{Binding GoCategory, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.howTargetResolvesBust.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=kind}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Level (GameObjects category only). Without it the lookup is
                             global, so a same-named object in the level being left can
                             answer for the one being entered. -->
                        <TextBlock Text="{l:T condition.level}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoLevelScoped}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- No DisplayMemberPath: the implicit NavigatorTargetOption template
                             shows the friendly label while ToString() (= Token) is what lands
                             in the edit box — see NavigatorTargetOption's class comment. -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding GoOverlayLevelOptions}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.whichLevelObjectLives.tip}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoLevelScoped}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- "NPC" rather than "Target" for the NPCs category: the field
                             names one NPC of the level above. -->
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T condition.target}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="NPCs">
                                            <Setter Property="Text" Value="{l:T condition.npc}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  IsEnabled="{Binding IsGoTargetEnabled}"
                                  Text="{Binding GoTarget, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.autocompletesSelectedCategoryStays.tip}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <!-- default: Direct Path → paths into the game worth knowing (DirectPathExamples) -->
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.DirectPathExamples, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="GameObjects">
                                            <Setter Property="ItemsSource" Value="{Binding GoOverlayOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="NPCs">
                                            <Setter Property="ItemsSource" Value="{Binding GoNpcOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Scene">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.SceneKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <!-- What the target looks like, as on the Set-Active action (1.6.3):
                             built only while there is something to show. -->
                        <ContentControl Grid.Row="3" Grid.Column="1" Focusable="False" IsTabStop="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Content" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsAnyPreview}" Value="True">
                                            <Setter Property="Content" Value="{Binding}"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource ActionTargetPreviewTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Grid>

                    <!-- Unified Variable editor. Source picks Pack (per-pack store) vs
                         Vanilla (a GC2 global from the 1.8E catalog); the Name list follows
                         the Source. Comparison maps to the underlying Variable* type. -->
                    <Grid Margin="0,2,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <!-- What a value accepts, then where a $name in one
                                 is read from. Both collapse when they have
                                 nothing to say, so an ordinary check against a
                                 literal is four rows, as it was. -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{l:T condition.source}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarSource, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.packPackSOwn.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=variableSource}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Name before Comparison, so the rows read the way the
                             condition does: "Pack > flag > is > true". Asking for
                             the operator before naming what it operates on is a
                             sentence out of order. -->
                        <TextBlock Text="{l:T condition.name}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <DockPanel Grid.Row="1" Margin="0,0,0,2" Grid.Column="1">
                            <!--
                                What kind the named variable holds, in the words an
                                author uses. Worth saying because a comparison runs on
                                STRINGS: "True" against a variable holding "true" simply
                                does not match, and nothing else on the row says why.
                                Empty for a name nothing recognises - a note reading
                                "unknown" makes the editor look broken rather than
                                uninformed.
                            -->
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VarKindNote}"
                                       FontSize="10" Opacity="0.75" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip="{l:T condition.whatVariableHoldsYes.tip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VarKindNote}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox IsEditable="True"
                                  Text="{Binding VarName, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <!-- Based on the shared grouped style so this picker
                                     scrolls like the rest; the trigger only swaps WHICH
                                     grouped list it shows. -->
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.VariableNameOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaSource}" Value="True">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.VanillaGameVariableOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            </ComboBox>
                        </DockPanel>

                        <TextBlock Text="{l:T condition.comparison}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.VariableComparisons}"
                                  SelectedItem="{Binding VarComparison, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=comparison}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{l:T condition.value}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowVariableValue}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarValue, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VarValueIsText}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- A Bool has exactly two values, and typing them is
                             where this goes wrong: True / TRUE / 1 / yes all
                             look right and none of them match.
                             Two buttons rather than one tick, because a tick
                             says "is true" and says nothing at all about the
                             other case - an unticked box reads as "not set"
                             just as easily as "is false". Matches the radios
                             the Set-variable action already uses. -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                    Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VarValueIsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <RadioButton Content="{l:T condition.true}" Margin="0,0,12,0" VerticalAlignment="Center"
                                         IsChecked="{Binding VarValueBool, Mode=TwoWay}"
                                         ToolTip="{l:T condition.true.tip}"/>
                            <RadioButton Content="{l:T condition.false}" VerticalAlignment="Center"
                                         IsChecked="{Binding VarValueBool, Mode=TwoWay,
                                                     Converter={StaticResource InverseBoolConverter}}"
                                         ToolTip="{l:T condition.false.tip}"/>
                        </StackPanel>

                        <!-- What a value accepts, said where it is typed. The
                             row below only appears once somebody writes a
                             $name, so without this the ability to compare one
                             variable against another would have nowhere left to
                             announce itself. -->
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="Gray" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,0,0,2"
                                   Text="{l:T condition.plainValueOthervariableCompare}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VarValueIsText}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Where a $name in the value is READ from - the same
                             thing the Set-variable editor calls Read from, and
                             called the same thing here.
                             It used to say "Compare to" and sit under Value on
                             every condition, which read as a second operand and
                             had authors believing a variable check always
                             compares one variable to another. It is not an
                             operand: it picks which store a $name is looked up
                             in, and a plain value ignores it entirely - so now
                             it appears only once there is a $name to look up. -->
                        <TextBlock Text="{l:T condition.read}" Grid.Row="5" Grid.Column="0"
                                   VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValueNamesAVariable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeConditionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarValueSource, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T condition.whichVariablesNameValue.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=variableSource}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ValueNamesAVariable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>

                    <!-- Quest state / quest counter: which quest and task, then
                         what to ask about it. -->
                    <StackPanel Margin="0,2,0,0"
                                Visibility="{Binding IsQuestFamily, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl Content="{Binding QuestPicker}" Focusable="False"
                                        ContentTemplate="{StaticResource QuestPickerTemplate}"/>
                        <Grid Visibility="{Binding IsQuestStateFamily, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T condition.is}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                            <ComboBox x:Name="QuestStatePicker" Grid.Column="1" Margin="0,0,0,2"
                                      ItemsSource="{x:Static vm:NodeConditionViewModel.QuestStates}"
                                      SelectedItem="{Binding QuestState, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{l:T condition.questStatePicker.tip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=questState}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid Visibility="{Binding IsQuestCounterFamily, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T condition.count}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                      ItemsSource="{x:Static vm:NodeConditionViewModel.QuestComparisons}"
                                      SelectedItem="{Binding QuestComparison, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=comparison}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{l:T condition.value}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                     Text="{Binding QuestValue, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{l:T condition.numberVariableCompareAgainst.tip}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            Group condition (parentheses): AND/OR over nested children. The
            inner ItemsControl re-uses ConditionTemplateSelector (via
            DynamicResource, since the selector is declared just below this
            template), so groups nest arbitrarily. "NOT (invert group)" maps
            to Negate, giving !( … ). Created via the "Add group" buttons; the
            mode combo flips AND↔OR.
        -->
        <DataTemplate x:Key="GroupConditionTemplate" DataType="{x:Type vm:NodeConditionViewModel}">
            <Border BorderBrush="#FF6F9BE8" BorderThickness="1.5"
                    CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:T conditionGroup.match}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <ComboBox  Grid.Column="1" Width="160"
                                   ItemsSource="{x:Static vm:NodeConditionViewModel.GroupModeOptions}"
                                   SelectedIndex="{Binding GroupModeIndex}"
                                   ToolTip="{l:T conditionGroup.everyChildMustPass.tip}"/>
                        <CheckBox  Grid.Column="2" Content="{l:T conditionGroup.notInvertGroup}"
                                   IsChecked="{Binding Negate}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   ToolTip="{l:T conditionGroup.notInvertGroup.tip}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="{l:T conditionGroup.copy.tip}"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}" ToolTip="{l:T conditionGroup.remove.tip}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                        <Button Content="{l:T conditionGroup.addLeaf}" Padding="6,1" Margin="0,0,4,0"
                                Command="{Binding AddLeafCommand}"/>
                        <Button Content="{l:T conditionGroup.addGroup}" Padding="6,1"
                                Command="{Binding AddGroupCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Children}" Margin="14,0,0,0"
                                  ItemTemplateSelector="{DynamicResource ConditionTemplateSelector}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Leaf vs group selector; the recursion entry point. Declared after
             both templates so it references them via StaticResource. -->
        <view:ConditionTemplateSelector x:Key="ConditionTemplateSelector"
                                        LeafTemplate="{StaticResource LeafConditionTemplate}"
                                        GroupTemplate="{StaticResource GroupConditionTemplate}"/>

        <!--
            ActionRow template: type combo on top, then a params editor
            whose shape depends on Type. The generic key=value TextBox
            is the default; the four bust/expression-related action
            types swap it out for typed dropdowns so authors aren't
            typing GO names from memory:

              · LeaveBust            → Actor combo only

            Visibility flips happen via DataTrigger Setters inside each
            control's Style (not local Visibility attributes — see
            LevelActive in ConditionRowTemplate for the same pattern
            and the WPF precedence reason).
        -->
        <!--
            ActionRow template: type combo on top, then schema-driven
            ParamRows. Each NodeActionViewModel exposes ParamRows built
            from ActionSchemas.For(Type), and the ItemsControl below
            renders each row with the per-ParamType template selected
            by ParamTypeTemplateSelector. Action types with no params
            (DeactivateAllScenes) collapse the ItemsControl
            to zero height naturally.
        -->
        <DataTemplate x:Key="ActionRowTemplate" DataType="{x:Type vm:NodeActionViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="4" Margin="0,0,0,3">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T action.type}" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DataContext.ActionTypes,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding DisplayType, UpdateSourceTrigger=PropertyChanged}">
                            <!-- A vanilla step has no type to choose: it is the
                                 game's own step, and offering the picker would
                                 let one click turn it into something else. -->
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaStep}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding VanillaTypeName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaStep}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                            <Button Content="⧉" Width="22" Height="22" Padding="0"
                                    Command="{Binding CopyCommand}"
                                    ToolTip="{l:T action.copy.tip}"/>
                            <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip="{l:T action.remove.tip}"/>
                        </StackPanel>
                    </Grid>
                    <!-- A step the game does that this editor cannot express.
                         Shown rather than hidden: an author who cannot see it
                         cannot know it is there, and one who deletes the row
                         above would be deleting something never shown to them.
                         Read-only, because the parameters are Game Creator's
                         and nothing here would honour a change to them. -->
                    <Border Margin="0,3,0,0" Padding="6,4" CornerRadius="3"
                            Background="#FFFFF7E8" BorderBrush="#FFE3B961" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVanillaStep}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                       Text="{Binding VanillaTitle}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#FF7A5A12"
                                       Text="{l:T action.notAvailableModforgeStep}"/>
                            <ItemsControl ItemsSource="{Binding VanillaDetails}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Foreground="#FF7A5A12"
                                                       Text="{Binding Name}"/>
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       Text="{Binding Value}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Category + Target for GameObject-targeting actions (Fade / Move / Spin).
                         Additive — the action's own params (alpha, x/y, speed…) still show in
                         ParamRows below. The Target list follows the Category, and Level Overlay
                         resolves the overlay inside the chosen level. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGoCategoryFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{l:T action.category}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.GoCategories}"
                                  SelectedItem="{Binding GoCategory, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T action.howTargetResolvesPlain.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=kind}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{l:T action.level}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoLevelScoped}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Only levels that actually carry GameObjects — pack
                             places and vanilla extensions alike. Still editable so a
                             not-yet-authored level token can be typed. -->
                        <!-- No DisplayMemberPath: the implicit NavigatorTargetOption
                             template shows the friendly label in the dropdown, while
                             ToString() (= Token) is what lands in the edit box — with
                             DisplayMemberPath the Text binding would write the label
                             into the param and break selection + the strict target
                             list (see NavigatorTargetOption's class comment). -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding GoOverlayLevelOptions}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding GoOverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T action.whichLevelGameobjectLives.tip}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGoLevelScoped}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- "NPC" rather than "Target" for the NPCs category: the field
                             names one NPC of the level above. -->
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T action.target}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="NPCs">
                                            <Setter Property="Text" Value="{l:T action.npc}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- IsEnabled: for GameObjects the target list is
                             level-scoped, so the combo stays disabled until a
                             Level is chosen above (always enabled otherwise). -->
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  IsEnabled="{Binding IsGoOverlayTargetEnabled}"
                                  Text="{Binding GoTarget, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.DirectPathExamples, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="GameObjects">
                                            <Setter Property="ItemsSource" Value="{Binding GoOverlayOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="NPCs">
                                            <Setter Property="ItemsSource" Value="{Binding GoNpcOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GoCategory}" Value="Places">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.LevelOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="DisplayMemberPath" Value="Token"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>

                    <!-- Generic schema-driven params.
                         Hidden wholesale only for the Variable family, which has its
                         own editor below. The Set-Active family used to be hidden here
                         too — which silently swallowed SetSprite's Sprite and Mask
                         fields, since they are declared on the schema and nowhere
                         else. RebuildParamRows now drops just the keys the category
                         row already draws, so this collection is empty for
                         SetGameObjectActive and holds exactly the extra fields for
                         SetSprite. -->
                    <ItemsControl ItemsSource="{Binding ParamRows}"
                                  ItemTemplateSelector="{StaticResource ParamTypeTemplateSelector}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>

                    <!-- Unified Variable editor (SetVariable + IncrementVariable). Source
                         picks Pack (per-pack store) vs Vanilla (a GC2 global from the 1.8E
                         catalog); the Name list follows the Source. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVariableFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Source (Pack/Vanilla) — not used by Random-from-list. -->
                        <TextBlock Text="{l:T action.source}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsRandomFromList, Converter={StaticResource InverseBoolToVisibility}}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarSource, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsRandomFromList, Converter={StaticResource InverseBoolToVisibility}}"
                                  ToolTip="{l:T action.packPackSOwn.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=variableSource}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{l:T action.operation}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.VariableOperations}"
                                  SelectedItem="{Binding VarOperation, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=variableOperation}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T action.name}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Text" Value="{l:T action.target2}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <DockPanel Grid.Row="2" Margin="0,0,0,2" Grid.Column="1">
                            <!--
                                What kind the named variable holds, in the words an
                                author uses. Worth saying because a comparison runs on
                                STRINGS: "True" against a variable holding "true" simply
                                does not match, and nothing else on the row says why.
                                Empty for a name nothing recognises - a note reading
                                "unknown" makes the editor look broken rather than
                                uninformed.
                            -->
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VarKindNote}"
                                       FontSize="10" Opacity="0.75" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip="{l:T action.whatVariableHoldsYes.tip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VarKindNote}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox IsEditable="True"
                                  Text="{Binding VarName, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.VariableNameOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaSource}" Value="True">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.VanillaGameVariableOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            </ComboBox>
                        </DockPanel>

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T action.value}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Text" Value="{l:T action.delta}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarValue, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRandomFromList}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VarValueIsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <!-- Same reasoning as the condition row: a Bool takes
                             one of two values and typing them is where it goes
                             wrong. And the same pair of buttons as the
                             condition, not a tick: an unticked "set to true"
                             read as "not set" as easily as "set to false", and
                             the two rows looked like different things for the
                             same variable (2026-09-27). -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                    Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VarValueIsBool}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <RadioButton Content="{l:T params.true}" Margin="0,0,12,0" VerticalAlignment="Center"
                                         IsChecked="{Binding VarValueBool, Mode=TwoWay}"
                                         ToolTip="{l:T params.true.tip}"/>
                            <RadioButton Content="{l:T params.false}" VerticalAlignment="Center"
                                         IsChecked="{Binding VarValueBool, Mode=TwoWay,
                                                     Converter={StaticResource InverseBoolConverter}}"
                                         ToolTip="{l:T params.false.tip}"/>
                        </StackPanel>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarDelta, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIncrement}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- From list (Random-from-list only): a List variable name or a CSV literal. -->
                        <TextBlock Text="{l:T action.list}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsRandomFromList, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.ListVariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding VarFromList, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsRandomFromList, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="{l:T action.listVariablePickRandom.tip}"/>

                        <!-- Excluding / If-none-left: pick-only (List count has no
                             candidate set to filter). '$name' reads a variable. -->
                        <TextBlock Text="{l:T action.excluding}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.ListVariableNameOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Text="{Binding VarExcluding, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="{l:T action.optionalEntriesRemovedList.tip}"/>

                        <TextBlock Text="{l:T action.ifNoneLeft}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,2"
                                 Text="{Binding VarFallback, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsPickRandomOnly, Converter={StaticResource BoolToVisibility}}"
                                 ToolTip="{l:T action.valueWrittenTargetWhen.tip}"/>

                        <!-- Where a $name in the value is READ from, as against
                             Source above, which says where it is WRITTEN. The
                             two are independent: the game's own steps read one
                             vanilla global and write another. -->
                        <TextBlock Text="{l:T action.read}" Grid.Row="7" Grid.Column="0"
                                   VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding ValueNamesAVariable, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.VariableSources}"
                                  SelectedItem="{Binding VarValueSource, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding ValueNamesAVariable, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="{l:T action.whichVariablesNameValue.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=variableSource}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <!-- Unified Set-Active editor (SetGameObjectActive + ActivateScene folded
                         into one row). A Category dropdown swaps the Target autocomplete:
                         Bust / Level Overlay (filtered to the node's level) / Scene / Direct Path. -->
                    <Grid Margin="0,3,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetActiveFamily}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <!-- Category, Level, Target, Layer, the preview of what the
                                 target looks like (after the Layer, which it depends on),
                                 Switch, and the line under Switch explaining the state. -->
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{l:T action.category}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                        <!-- Per-row list, not the static one: Set-Active and SetSprite
                             share this row but not the same choices (only SetSprite
                             offers Places). -->
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T action.howTargetResolvesChanges.tip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=kind}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Level (Level Overlay category only): which level the overlay
                             lives in. Set it to the level you're transitioning INTO so the
                             runtime resolves the overlay there, not in the previous level.
                             The Target list below follows this choice. -->
                        <TextBlock Text="{l:T action.level}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsOverlayLevel}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Only levels that actually carry GameObjects — pack
                             places and vanilla extensions alike. Still editable so a
                             not-yet-authored level token can be typed. -->
                        <!-- No DisplayMemberPath: the implicit NavigatorTargetOption
                             template shows the friendly label in the dropdown, while
                             ToString() (= Token) is what lands in the edit box — with
                             DisplayMemberPath the Text binding would write the label
                             into the param and break selection + the strict target
                             list (see NavigatorTargetOption's class comment). -->
                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{Binding OverlayLevelOptions}"
                                  SelectedValuePath="Token"
                                  SelectedValue="{Binding OverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Text="{Binding OverlayLevel, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T action.whichLevelGameobjectLives.tip2}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsOverlayLevel}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- "NPC" rather than "Target" for the NPCs category: the field
                             names one NPC of the level above. -->
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{l:T action.target}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="NPCs">
                                            <Setter Property="Text" Value="{l:T action.npc}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- IsEnabled: for GameObjects the target list is
                             level-scoped, so the combo stays disabled until a
                             Level is chosen above (always enabled otherwise). -->
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,2"
                                  IsEditable="True"
                                  IsEnabled="{Binding IsOverlayTargetEnabled}"
                                  Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="{l:T action.autocompletesSelectedCategoryStays.tip}">
                            <ComboBox.GroupStyle>
                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                            </ComboBox.GroupStyle>
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                    <!-- default: Direct Path → paths into the game worth knowing (DirectPathExamples) -->
                                    <Setter Property="ItemsSource"
                                            Value="{Binding DataContext.DirectPathExamples, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Category}" Value="Bust">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.BustNameOnlyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="GameObjects">
                                            <!-- The overlays of the level chosen above (per-action). -->
                                            <Setter Property="ItemsSource" Value="{Binding OverlayOptions}"/>
                                        </DataTrigger>
                                        <!-- The NPCs placed in that level. -->
                                        <DataTrigger Binding="{Binding Category}" Value="NPCs">
                                            <Setter Property="ItemsSource" Value="{Binding NpcOptions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Category}" Value="Scene">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.SceneKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <!-- A screen of the pack's own, by id -
                                             which is what makes one screen open
                                             another. No DisplayMemberPath, so the
                                             list reads "Name (id)" while the id
                                             itself is what lands in the box; the
                                             box stays editable because a target
                                             can also be a path INSIDE a screen,
                                             "shop/Panel/Close". -->
                                        <DataTrigger Binding="{Binding Category}" Value="UI">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.UiIdOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </DataTrigger>
                                        <!-- A whole level, by place token. The level's own
                                             GameObject holds the Base sprite's SpriteRenderer,
                                             so this is what repaints a place; the Layer picker
                                             below chooses Base or Secondary.
                                             DisplayMemberPath=Token so the token itself is
                                             what lands in the param. -->
                                        <DataTrigger Binding="{Binding Category}" Value="Places">
                                            <Setter Property="ItemsSource"
                                                    Value="{Binding DataContext.LevelOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="DisplayMemberPath" Value="Token"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <!-- Layer (Places only): a level draws in two sprite layers, so
                             naming the place alone doesn't say which to act on. Shown as
                             Back / Front, the same words the Places tab uses. The manifest
                             still stores the game's Base / Secondary — see
                             NodeActionViewModel.PlaceLayerShown for the translation. -->
                        <TextBlock Text="{l:T action.layer}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                   Visibility="{Binding ShowsPlaceLayer, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Style="{StaticResource GroupedComboBox}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,2"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.PlaceLayerDisplays}"
                                  SelectedItem="{Binding PlaceLayerShown, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding ShowsPlaceLayer, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="{l:T action.whichLevelSTwo.tip}"/>

                        <!-- What the target looks like, small, so it is picked by how it
                             looks as well as by its name (1.6.3): a scene with its frame,
                             or a bust, a level's GameObject or a whole place. A sprite
                             swap shows it before and after, with an arrow between. Shown
                             only once the target names something the editor can draw;
                             every input is empty while its part is hidden, so a hidden
                             preview loads nothing. See NodeActionViewModel.PreviewArt.
                             No background: it sits in the row like the rest of it. -->
                        <!-- Built only while there is something to show: every action row
                             carries this slot, and most never preview anything. -->
                        <ContentControl Grid.Row="4" Grid.Column="1" Focusable="False" IsTabStop="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="Content" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsAnyPreview}" Value="True">
                                            <Setter Property="Content" Value="{Binding}"/>
                                            <Setter Property="ContentTemplate" Value="{StaticResource ActionTargetPreviewTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>

                        <!-- Three states, not a tick. Toggle is the one a checkbox could not
                             offer: flip it to whatever it is not. -->
                        <TextBlock Text="{l:T action.switch}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,4,0"
                                   Visibility="{Binding ShowsActiveToggle, Converter={StaticResource BoolToVisibility}}"/>
                        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,2,0,0"
                                  ItemsSource="{x:Static vm:NodeActionViewModel.SwitchModes}"
                                  SelectedItem="{Binding SwitchMode, UpdateSourceTrigger=PropertyChanged}"
                                  Visibility="{Binding ShowsActiveToggle, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="{l:T action.activateSwitchesDeactivateSwitches.tip}">
                                  <ComboBox.ItemTemplate>
                                      <DataTemplate>
                                          <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=switch}"/>
                                      </DataTemplate>
                                  </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Row="6" Grid.Column="1" Foreground="Gray" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,1,0,0"
                                   Text="{Binding SwitchHelp}"
                                   Visibility="{Binding ShowsActiveToggle, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>

                    <!-- Quest: which quest (and task), what to do to it, and a
                         number for the counter operations. -->
                    <StackPanel Margin="0,3,0,0"
                                Visibility="{Binding IsQuestFamily, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl Content="{Binding QuestPicker}" Focusable="False"
                                        ContentTemplate="{StaticResource QuestPickerTemplate}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:T action.do}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"/>
                            <ComboBox x:Name="QuestOperationPicker" Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                      ItemsSource="{x:Static vm:NodeActionViewModel.QuestOperations}"
                                      SelectedItem="{Binding QuestOperation, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=questOperation}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{l:T action.value2}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,2"
                                       Visibility="{Binding QuestTakesValue, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,2"
                                     Text="{Binding QuestValue, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding QuestTakesValue, Converter={StaticResource BoolToVisibility}}"
                                     ToolTip="{l:T action.numberVariableUseOne.tip}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Foreground="Gray" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,0,0,2" Text="{Binding QuestOperationHelp}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ── DiceRoll: weighted one-of-N branch editor ─────────
                         Each branch = chance % + ONE nested action (rendered by
                         this very template via DynamicResource self-reference).
                         Exactly one branch executes per roll; the total must be
                         exactly 100% (label turns red otherwise + validation
                         raises an error). -->
                    <StackPanel Margin="0,3,0,0"
                                Visibility="{Binding IsDiceFamily, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,0,3" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding DiceTotalLabel}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiceTotalValid}" Value="False">
                                            <Setter Property="Foreground" Value="#F66"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding DiceBranches}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiceBranchViewModel}">
                                    <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                                            CornerRadius="2" Padding="4" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{l:T action.chance}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBox Width="45" Text="{Binding ChanceText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="%" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                <Button Content="{l:T action.remove}" Padding="6,0"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="{l:T action.remove.tip2}"/>
                                            </StackPanel>
                                            <ContentControl Content="{Binding Action}"
                                                            ContentTemplate="{DynamicResource ActionRowTemplate}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{l:T action.addDiceBranch}" HorizontalAlignment="Left" Padding="8,2"
                                Command="{Binding AddDiceBranchCommand}"
                                ToolTip="{l:T action.addDiceBranch.tip}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>


        <!--
            Row template for navigator-button list rows (place + vanilla-extension tabs).
            Adds a minus button next to the existing target / label / music fields.
        -->
        <!-- Target dropdowns list "My Room", not "vanilla:5_MyRoom". Only the
             list is templated: with IsEditable the text box still shows
             NavigatorTargetOption.ToString(), which is the Token, so what gets
             typed and what gets stored are the same string as before. -->
        <DataTemplate x:Key="TargetOptionItemTemplate" DataType="{x:Type vm:NavigatorTargetOption}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayLabel}"/>
                <TextBlock Text="{Binding Token}" Foreground="Gray" Margin="10,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NavigatorButtonRowTemplate" DataType="{x:Type vm:NavigatorButtonViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="1"
                    CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:T navButton.target}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ToolTip="{l:T navButton.whereButtonTakesPlayer.tip}" Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding DataContext.AllTargetOptions,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedValuePath="Token"
                              SelectedValue="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                              ItemTemplate="{StaticResource TargetOptionItemTemplate}"
                              IsEditable="True"
                              Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                        <Button Content="▲" Width="22" Height="22" Padding="0"
                                Command="{Binding MoveUpCommand}"
                                ToolTip="{l:T navButton.moveUp.tip}"/>
                        <Button Content="▼" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding MoveDownCommand}"
                                ToolTip="{l:T navButton.moveDown.tip}"/>
                        <Button Content="−" Width="22" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding RemoveCommand}"
                                ToolTip="{l:T navButton.remove.tip}"/>
                    </StackPanel>
                    <TextBlock Text="{l:T navButton.labelOverride}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="1" Grid.Column="1"
                             ToolTip="{l:T navButton.buttonTextSupportsPV.tip}"/>
                    <!-- The pack's own tracks and the game's, grouped - the same list the
                         SwitchMusic action offers. Editable rather than a closed list: the
                         field names a child under 12_AudioPlayer, and the catalogued names
                         come from a dump of an older build, so a track added since has to
                         remain typable.

                         Starts empty, unlike a map button: a door within an area should
                         let the area keep its music. See PlaceViewModel.AddNavigatorButton. -->
                    <TextBlock Text="{l:T navButton.musicOptional}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource GroupedComboBox}" Grid.Row="2" Grid.Column="1"
                              IsSynchronizedWithCurrentItem="False"
                              IsEditable="True"
                              ItemsSource="{Binding DataContext.MusicKeyOptionsGrouped,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                              Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{l:T navButton.trackSwitchWhenButton.tip}">
                        <ComboBox.GroupStyle>
                            <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                    <!-- Conditions -->
                    <TextBlock Text="{l:T navButton.conditions}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                        <ItemsControl ItemsSource="{Binding Conditions}"
                                      ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="{l:T navButton.addCondition}" Margin="0,0,4,0" Padding="6,2"
                                    Command="{Binding AddConditionCommand}"/>
                            <Button Content="{l:T navButton.addConditionGroup}" Padding="6,2"
                                    ToolTip="{l:T navButton.addConditionGroup.tip}"
                                    Command="{Binding AddConditionGroupCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Implicit (keyed-by-type) so a GameObject's nested Children
             ItemsControl re-uses this very template recursively. -->
        <DataTemplate DataType="{x:Type vm:GameObjectViewModel}">
            <!-- A bound node that currently differs from the vanilla object gets
                 an accent edge + wash, so you can see at a glance which of the
                 level's own objects you've actually touched among the many the
                 editor filled in. Compared live, not from the save-time flags. -->
            <Border CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="LightGray"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <!-- Opaque, and set on every row rather than only the
                             tinted ones. These rows nest, so a row without its
                             own background shows its PARENT's — which is what
                             made a freshly added child look like an untouched
                             vanilla object and an NPC look like a changed one. -->
                        <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
                        <Style.Triggers>
                            <!-- An object of the GAME'S own, not the pack's. A
                                 seeded extension is mostly these, so they get a
                                 cool cast to separate them at a glance from the
                                 few rows the pack actually creates. -->
                            <DataTrigger Binding="{Binding Bind}" Value="True">
                                <Setter Property="BorderBrush" Value="#805B8FCB"/>
                                <Setter Property="Background" Value="{DynamicResource Theme.VanillaSurface}"/>
                            </DataTrigger>
                            <!-- Listed second on purpose: a bound node you've
                                 actually changed is the stronger signal, and the
                                 later matching trigger wins. -->
                            <DataTrigger Binding="{Binding HasVanillaChange}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="{DynamicResource Theme.ChangedSurface}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{l:T gameObject.name}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="0" Grid.Column="1"
                             IsEnabled="{Binding CanEditIdentity}"
                             ToolTip="{l:T gameObject.gameobjectNameDialogueActions.tip}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <!-- The NPCs container. Deliberately a CHIP and not a
                             tint: the row's background and border already carry
                             whether the object is the game's and whether the pack
                             changed it, so this rides alongside them instead of
                             overwriting either. Shows on the pack's forced node
                             and on a vanilla level's own NPCs object alike. -->
                        <Border Padding="4,0" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                                Background="#80C08A3E"
                                Visibility="{Binding IsNpcHost, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{l:T gameObject.levelSNpcsContainer.tip}">
                            <TextBlock Text="{l:T gameObject.npcs}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Names the colour cast, so "this one is the game's"
                             doesn't rely on spotting a tint. -->
                        <Border Padding="4,0" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                                Background="#805B8FCB"
                                Visibility="{Binding Bind, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{l:T gameObject.objectVanillaLevelAlready.tip}">
                            <TextBlock Text="{l:T gameObject.vanilla}" FontSize="10"/>
                        </Border>
                        <!-- Says WHY the row is highlighted, and doubles as the
                             cue that this row will actually be saved. -->
                        <Border Padding="4,0" Margin="4,0,0,0" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource Theme.Accent}"
                                Visibility="{Binding HasVanillaChange, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{l:T gameObject.differsVanillaObjectS.tip}">
                            <TextBlock Text="{l:T gameObject.changed}" FontSize="10"/>
                        </Border>
                        <Button Content="{l:T gameObject.resetToVanilla}" Width="50" Height="22" Padding="0" Margin="4,0,0,0"
                                Command="{Binding ResetToVanillaCommand}"
                                Visibility="{Binding CanResetToVanilla, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{l:T gameObject.resetToVanilla.tip}"/>
                        <Button Content="{l:T gameObject.copy}" Width="50" Height="22" Padding="0" Margin="4,0,0,0"
                                Command="{Binding CopyCommand}" ToolTip="{l:T gameObject.copy.tip}"/>
                        <Button Content="{l:T gameObject.paste}" Width="50" Height="22" Padding="0" Margin="2,0,0,0"
                                Command="{Binding PasteCommand}" ToolTip="{l:T gameObject.paste.tip}"/>
                        <Button Content="−" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                                Command="{Binding RemoveCommand}" ToolTip="{l:T gameObject.remove.tip}"/>
                    </StackPanel>

                    <!-- One row, stacked. The NPCs note and the bind controls can
                         BOTH apply now that an extension's NPCs container is a
                         bound node, and two siblings sharing a Grid.Row draw on
                         top of each other rather than below. -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">

                    <!-- Shown for both kinds of NPCs container: the forced node a
                         pack place carries, and the vanilla object an extension
                         binds to. -->
                    <TextBlock Foreground="Gray" FontSize="10"
                               TextWrapping="Wrap" Margin="0,2,0,2"
                               Visibility="{Binding IsNpcHost, Converter={StaticResource BoolToVisibility}}"
                               Text="{l:T gameObject.levelSBuiltNpcs}"/>

                    <!-- Bind: address an object that already exists in the scene
                         (a vanilla level's own furniture) instead of creating one. -->
                    <StackPanel Margin="0,2,0,2"
                                Visibility="{Binding CanEditIdentity, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox IsChecked="{Binding Bind}"
                                  Content="{l:T gameObject.gameobjectAlreadyExistsBind}"
                                  ToolTip="{l:T gameObject.gameobjectAlreadyExistsBind.tip}"/>
                        <StackPanel Orientation="Horizontal" Margin="16,2,0,0"
                                    Visibility="{Binding Bind, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox IsChecked="{Binding OverrideTransform}" Content="{l:T gameObject.overrideTransform}"
                                      ToolTip="{l:T gameObject.overrideTransform.tip}"/>
                            <CheckBox IsChecked="{Binding OverrideActive}" Content="{l:T gameObject.overrideActive}" Margin="12,0,0,0"
                                      ToolTip="{l:T gameObject.overrideActive.tip}"/>
                        </StackPanel>
                        <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="16,2,0,0"
                                   Visibility="{Binding Bind, Converter={StaticResource BoolToVisibility}}"
                                   Text="{l:T gameObject.componentsActiveWhenConditions}"/>
                    </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{l:T gameObject.sprite}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <ctl:PathPickerBox PathText="{Binding Sprite, UpdateSourceTrigger=PropertyChanged}"
                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       ToolTip="{l:T gameObject.packRelativePNGPath.tip}"/>

                    <TextBlock Text="{l:T gameObject.transform}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,2,2"/>
                        <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,0,2"
                                 ToolTip="{l:T gameObject.worldXPositionLevel.tip}"/>
                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,0,2"
                                 ToolTip="{l:T gameObject.worldYPositionUp.tip}"/>
                        <TextBlock Text="{l:T gameObject.rot}" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding RotationZ, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,2"
                                 ToolTip="{l:T gameObject.zRotationDegreesPlane.tip}"/>
                        <TextBlock Text="{l:T gameObject.scaleXY}" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding ScaleX, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,2"
                                 ToolTip="{l:T gameObject.localXScale1.tip}"/>
                        <TextBox Text="{Binding ScaleY, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="4,0,0,2"
                                 ToolTip="{l:T gameObject.localYScale.tip}"/>
                        <TextBlock Text="{l:T gameObject.sort}" VerticalAlignment="Center" Margin="8,0,2,2"/>
                        <TextBox Text="{Binding SortingOrder, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="0,0,0,2"
                                 ToolTip="{l:T gameObject.spriterendererSortingOrderLower.tip}"/>
                    </WrapPanel>

                    <!-- Row 4 nests its own rows rather than claiming more of the
                         outer Grid: the parallax settings only appear when the
                         effect is on, and a collapsed child costs no layout. -->
                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{l:T gameObject.parallax}" IsChecked="{Binding ParallaxEnabled}"
                                      VerticalAlignment="Center"
                                      ToolTip="{l:T gameObject.parallax.tip}"/>
                            <CheckBox Content="{l:T gameObject.startActive}" IsChecked="{Binding StartActive}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="{l:T gameObject.startActive.tip}"/>
                            <TextBlock Text="{l:T gameObject.alpha}" VerticalAlignment="Center" Margin="12,0,2,0"/>
                            <TextBox Text="{Binding StartAlpha, UpdateSourceTrigger=PropertyChanged}" Width="45"
                                     ToolTip="{l:T gameObject.initialAlpha01.tip}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="16,4,0,0"
                                    Visibility="{Binding ParallaxEnabled, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="{l:T gameObject.driftLevel}" IsChecked="{Binding ParallaxInherits}" VerticalAlignment="Center"
                                      ToolTip="{l:T gameObject.driftLevel.tip}"/>
                            <TextBox Text="{Binding ParallaxStrength, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="10,0,0,0"
                                     IsEnabled="{Binding ParallaxInherits, Converter={StaticResource InverseBoolConverter}}"
                                     ToolTip="{l:T gameObject.depthRelativeLevelS.tip}"/>
                            <Slider Value="{Binding ParallaxStrength}" Minimum="0" Maximum="1.5" Width="110"
                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                    IsEnabled="{Binding ParallaxInherits, Converter={StaticResource InverseBoolConverter}}"/>
                            <CheckBox Content="{l:T gameObject.reversed}" IsChecked="{Binding ParallaxReversed}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="{l:T gameObject.reversed.tip}"/>
                            <CheckBox Content="{l:T gameObject.uiSpace}" IsChecked="{Binding ParallaxIsUI}"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="{l:T gameObject.uiSpace.tip}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{l:T gameObject.maskOpt}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                    <ctl:PathPickerBox PathText="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                       ToolTip="{l:T gameObject.optionalPackRelativeMask.tip}"/>

                    <!-- Utility components attached to this GameObject. -->
                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T gameObject.addComponent}" Padding="6,0"
                                        Command="{Binding AddComponentCommand}"
                                        ToolTip="{l:T gameObject.addComponent.tip}"/>
                                <TextBlock Text="{l:T gameObject.components}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- No ItemTemplate: ComponentRowViewModel resolves to the
                                 implicit template below, shared with NPC rows. -->
                            <ItemsControl ItemsSource="{Binding Components}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- Activation conditions: the object switches itself on/off as
                         these pass, instead of a rule having to drive it. -->
                    <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T gameObject.addActiveCondition}" Padding="6,0"
                                        Command="{Binding AddActiveConditionCommand}"
                                        ToolTip="{l:T gameObject.addActiveCondition.tip}"/>
                                <TextBlock Text="{l:T gameObject.activeWhen}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Foreground="Gray" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="{l:T gameObject.leaveEmptyObjectSimply}"/>
                            <ItemsControl ItemsSource="{Binding ActiveConditions}" Margin="0,4,0,0"
                                          ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding DeactivateWhenUnmet}"
                                      Visibility="{Binding HasActiveConditions, Converter={StaticResource BoolToVisibility}}"
                                      Content="{l:T gameObject.switchBackOffWhen}"
                                      ToolTip="{l:T gameObject.switchBackOffWhen.tip}"/>
                        </StackPanel>
                    </Border>

                    <!-- Children: nested GameObjects and NPC placements alike. NPCs
                         can only be added inside the NPCs subtree, so that button
                         hides itself elsewhere. -->
                    <Border Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T gameObject.addNpc}" Padding="6,0"
                                        Command="{Binding AddNpcCommand}"
                                        Visibility="{Binding CanHostNpcs, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{l:T gameObject.addNpc.tip}"/>
                                <Button DockPanel.Dock="Right" Content="{l:T gameObject.addChild}" Padding="6,0" Margin="0,0,4,0"
                                        Command="{Binding AddChildCommand}"
                                        ToolTip="{l:T gameObject.addChild.tip}"/>
                                <TextBlock Text="{l:T gameObject.children}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <!-- No ItemTemplate on either: GameObjectViewModel and
                                 NpcPlacementViewModel each resolve to their implicit
                                 template, giving recursive nesting. Indented to show depth. -->
                            <ItemsControl ItemsSource="{Binding Npcs}" Margin="12,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="12,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Implicit, so every Components list (GameObject rows AND NPC rows)
             picks it up without repeating the markup. -->
        <DataTemplate DataType="{x:Type vm:ComponentRowViewModel}">
                                        <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1" CornerRadius="2"
                                                Background="{DynamicResource Theme.Control}" Padding="5" Margin="0,0,0,4">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="−" Width="22" Padding="0"
                                                            Command="{Binding RemoveCommand}" ToolTip="{l:T component.remove.tip}"/>
                                                    <ComboBox Style="{StaticResource GroupedComboBox}" ItemsSource="{Binding ComponentTypes}"
                                                              SelectedItem="{Binding Type}"/>
                                                </DockPanel>

                                                <!-- FadeInSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsFadeIn, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{l:T component.fadesSpriteAlpha0}"
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="{l:T component.duration}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding FadeDuration, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="{l:T component.target}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding TargetAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="{l:T component.delay}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding StartDelay, UpdateSourceTrigger=LostFocus}"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- FadeOutSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsFadeOut, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{l:T component.fadesSpriteOutCurrent}"
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="{l:T component.duration}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding Duration, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="{l:T component.delay}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding StartDelay, UpdateSourceTrigger=LostFocus}"/>
                                                        <CheckBox Content="{l:T component.deactivateComplete}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                  IsChecked="{Binding DeactivateOnComplete}"
                                                                  ToolTip="{l:T component.deactivateComplete.tip}"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- RandomChildActivator -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsRandom, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{l:T component.activateEnablesOneRandom}"
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <CheckBox Content="{l:T component.reshuffleEveryTimeS}" IsChecked="{Binding ReshuffleOnEnable}"/>
                                                </StackPanel>

                                                <!-- BlinkingSprite -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsBlinking, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{l:T component.togglesSpriterendererSAlpha}"
                                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <WrapPanel>
                                                        <TextBlock Text="{l:T component.interval}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                        <TextBox Width="45" Text="{Binding BlinkInterval, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="{l:T component.min}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding MinAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                        <TextBlock Text="{l:T component.max}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                        <TextBox Width="40" Text="{Binding MaxAlpha, UpdateSourceTrigger=LostFocus}"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- A component the GAME defines. Parameter names come
                                                     from the vanilla extraction, so they match the real
                                                     fields; blank means "leave at the component's own
                                                     default" rather than writing an empty value. -->
                                                <StackPanel Margin="0,4,0,0"
                                                            Visibility="{Binding IsGameComponent, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding TypeNote}" Foreground="Gray" FontSize="10"
                                                               TextWrapping="Wrap" Margin="0,0,0,3"/>
                                                    <ItemsControl ItemsSource="{Binding ParamRows}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="170"/>
                                                                        <ColumnDefinition Width="90"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding Name}"/>
                                                                    <TextBox Grid.Column="1"
                                                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                                                    <TextBlock Grid.Column="2" Foreground="Gray" FontSize="10"
                                                                               VerticalAlignment="Center" Margin="6,0,0,0"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Text="{Binding Observed, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=component.observed}"
                                                                               ToolTip="{l:T component.whatExtractionSawVanilla.tip}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
        </DataTemplate>

        <!-- Implicit, so a GameObject node's nested NPCs ItemsControl picks it up. -->
        <DataTemplate DataType="{x:Type vm:NpcPlacementViewModel}">
            <!-- Opaque background: an NPC row nests inside its host GameObject's
                 row, and without one it showed that host's tint — reading as if
                 the NPC were itself a changed vanilla object. -->
            <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                    CornerRadius="3" Margin="0,3" Padding="6"
                    Background="{DynamicResource Theme.Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Seven rows for seven sections: NPC, Name, part transforms,
                         Start active, Components, Active when, Children. An
                         out-of-range Grid.Row is CLAMPED by WPF rather than
                         flagged, so a missing definition here draws the last two
                         sections on top of each other instead of failing. -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{l:T npcPlacement.npc}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True"
                              ItemsSource="{Binding DataContext.NpcKeyOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="DisplayLabel"
                              SelectedValuePath="Token"
                              SelectedValue="{Binding Npc, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="{l:T npcPlacement.keyNPCNpcsTab.tip}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="−" Width="22" Height="22"
                            Padding="0" Margin="4,0,0,0" Command="{Binding RemoveCommand}"
                            ToolTip="{l:T npcPlacement.remove.tip}"/>

                    <TextBlock Text="{l:T npcPlacement.name}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{l:T npcPlacement.gameobjectNameSetgameobjectactiveTarget.tip}"/>

                    <!-- All four part transforms live here on the placement, so the
                         same NPC look can sit differently in each room. Body is the NPC
                         object itself; shadow / blink / wet are its children. The level
                         preview's gizmo edits these same VMs visually. -->
                    <Expander Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"
                              Header="{l:T npcPlacement.partTransforms}" IsExpanded="True">
                        <StackPanel Margin="4,4,0,0">
                            <TextBlock Text="{l:T npcPlacement.body}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <ContentControl Content="{Binding Body}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                            <TextBlock Text="{l:T npcPlacement.shadow}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ContentControl Content="{Binding Shadow}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                            <TextBlock Text="{l:T npcPlacement.blink}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ContentControl Content="{Binding Blink}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                            <TextBlock Text="{l:T npcPlacement.wetParticle}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                            <ContentControl Content="{Binding Wet}" ContentTemplate="{StaticResource NpcTransformEditor}"/>
                        </StackPanel>
                    </Expander>

                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="{l:T npcPlacement.startActive}" IsChecked="{Binding StartActive}" VerticalAlignment="Center"
                                  ToolTip="{l:T npcPlacement.startActive.tip}"/>
                        <!-- Depth belongs to the ROOM, not the character: the same
                             NPC stands behind one level's furniture and in front of
                             another's, and every vanilla level picks its own orders.
                             So it sits here with the transforms. -->
                        <TextBlock Text="{l:T npcPlacement.sortingOrder}" VerticalAlignment="Center" Margin="16,0,4,0"/>
                        <TextBox Width="55" Text="{Binding SortingOrder, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="{l:T npcPlacement.overridesNPCSOwn.tip}"/>
                    </StackPanel>

                    <!-- Utility components on the NPC itself. Attached before the
                         NPC is activated, so a FadeInSprite fades it in on
                         activation instead of popping. -->
                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T npcPlacement.addComponent}" Padding="6,0"
                                        Command="{Binding AddComponentCommand}"
                                        ToolTip="{l:T npcPlacement.addComponent.tip}"/>
                                <TextBlock Text="{l:T npcPlacement.components}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Components}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Activation conditions for the NPC GameObject itself. -->
                    <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T npcPlacement.addActiveCondition}" Padding="6,0"
                                        Command="{Binding AddActiveConditionCommand}"
                                        ToolTip="{l:T npcPlacement.addActiveCondition.tip}"/>
                                <TextBlock Text="{l:T npcPlacement.activeWhen}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Foreground="Gray" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Text="{l:T npcPlacement.leaveEmptyNPCSimply}"/>
                            <ItemsControl ItemsSource="{Binding ActiveConditions}" Margin="0,4,0,0"
                                          ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                            <CheckBox Margin="0,4,0,0" IsChecked="{Binding DeactivateWhenUnmet}"
                                      Content="{l:T npcPlacement.switchBackOffWhen}"
                                      ToolTip="{l:T npcPlacement.switchBackOffWhen.tip}"/>
                        </StackPanel>
                    </Border>

                    <!-- GameObjects parented under the NPC — props that ride along
                         with the pose, alongside its Circle / Blink / Wet parts. -->
                    <Border Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                            BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="0,4,0,0">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T npcPlacement.addChild}" Padding="6,0"
                                        Command="{Binding AddChildCommand}"
                                        ToolTip="{l:T npcPlacement.addChild.tip}"/>
                                <TextBlock Text="{l:T npcPlacement.children}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="12,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One list of conditions, or of actions, with the buttons every
             other editor of them has. For lists that stand on their own - the
             Quests tab has three, and none of them come in a pair the way a
             place hook's do. -->
        <DataTemplate x:Key="ConditionListTemplate" DataType="{x:Type vm:ConditionListViewModel}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplateSelector="{DynamicResource ConditionTemplateSelector}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Content="{l:T conditionList.add}" Command="{Binding AddCommand}" Padding="6,2" Margin="0,0,4,0"/>
                    <Button Content="{l:T conditionList.addGroup}" Command="{Binding AddGroupCommand}" Padding="6,2"
                            ToolTip="{l:T conditionList.addGroup.tip}"/>
                    <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                    <Button Content="{l:T conditionList.copy}" Command="{Binding CopyCommand}" Padding="6,2" Margin="0,0,4,0"
                            ToolTip="{l:T conditionList.copy.tip}"/>
                    <Button Content="{l:T conditionList.paste}" Command="{Binding PasteCommand}" Padding="6,2" Margin="0,0,4,0"
                            ToolTip="{l:T conditionList.paste.tip}"/>
                    <Button Content="{l:T conditionList.overwrite}" Command="{Binding OverwriteCommand}" Padding="6,2"
                            ToolTip="{l:T conditionList.overwrite.tip}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ActionListTemplate" DataType="{x:Type vm:ActionListViewModel}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource ActionRowTemplate}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Button Content="{l:T actionList.add}" Command="{Binding AddCommand}" Padding="6,2" Margin="0,0,4,0"/>
                    <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                    <Button Content="{l:T actionList.copy}" Command="{Binding CopyCommand}" Padding="6,2" Margin="0,0,4,0"
                            ToolTip="{l:T actionList.copy.tip}"/>
                    <Button Content="{l:T actionList.paste}" Command="{Binding PasteCommand}" Padding="6,2" Margin="0,0,4,0"
                            ToolTip="{l:T actionList.paste.tip}"/>
                    <Button Content="{l:T actionList.overwrite}" Command="{Binding OverwriteCommand}" Padding="6,2"
                            ToolTip="{l:T actionList.overwrite.tip}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- One of the game's conditions, as a row that can be taken out and put
             back. Taken out, it stays on screen, faded and struck through, with
             the way back beside it. -->
        <DataTemplate x:Key="GameConditionRowTemplate" DataType="{x:Type vm:GameConditionRowViewModel}">
            <DockPanel Margin="0,1">
                <Button DockPanel.Dock="Right" Content="{l:T gameCondition.remove}" Padding="6,0" Margin="6,0,0,0" FontSize="10"
                        VerticalAlignment="Center" Command="{Binding RemoveCommand}" ToolTip="{Binding Note}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanRemove}" Value="True"/>
                                        <Condition Binding="{Binding IsRemoved}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Content="{l:T gameCondition.undo}" Padding="6,0" Margin="6,0,0,0" FontSize="10"
                        VerticalAlignment="Center" Command="{Binding UndoCommand}"
                        ToolTip="{l:T gameCondition.undo.tip}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CanRemove}" Value="True"/>
                                        <Condition Binding="{Binding IsRemoved}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Border DockPanel.Dock="Right" Background="#FFB06A00" CornerRadius="2" Padding="3,0" Margin="6,0,0,0"
                        VerticalAlignment="Center" ToolTip="{Binding Note}"
                        Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:T gameCondition.takenOut}" Foreground="White" FontSize="9"/>
                </Border>
                <Border DockPanel.Dock="Right" Background="#FF2F6FB0" CornerRadius="2" Padding="3,0" Margin="6,0,0,0"
                        VerticalAlignment="Center" ToolTip="{Binding Note}"
                        Visibility="{Binding IsYours, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{l:T gameCondition.yours}" Foreground="White" FontSize="9"/>
                </Border>
                <Grid ToolTip="{Binding Note}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <ContentControl Content="{Binding Condition}" IsEnabled="False" Focusable="False"
                                    ContentTemplateSelector="{StaticResource ConditionTemplateSelector}"
                                    Visibility="{Binding IsTranslated, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontStyle="Italic" VerticalAlignment="Center"
                               Visibility="{Binding IsTranslated, Converter={StaticResource InverseBoolToVisibility}}"/>
                    <!-- The strike: a condition row is a template of its own, so a
                         line drawn across it is what says "not any more". -->
                    <Rectangle Height="1.5" VerticalAlignment="Center" Fill="#FFB06A00" IsHitTestVisible="False"
                               Visibility="{Binding IsRemoved, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!-- The game's conditions that live together: one line's, or one
             script's. -->
        <DataTemplate x:Key="GameConditionGroupTemplate" DataType="{x:Type vm:GameConditionGroupViewModel}">
            <StackPanel Margin="0,3,0,0">
                <TextBlock Text="{Binding Title}" Foreground="Gray" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Note}" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Rows}" Margin="12,0,0,0"
                              ItemTemplate="{StaticResource GameConditionRowTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <!-- One place the game changes or asks about one of its quests:
             what it does, where, when, and what has to be true. A place that
             starts or resets the quest can be changed: the game's conditions
             taken out and put back, and conditions of yours the step waits
             for - marked, and resettable, the way a changed line of a
             conversation is. -->
        <DataTemplate x:Key="GameQuestSiteTemplate" DataType="{x:Type vm:GameQuestSiteViewModel}">
            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,3,0,5">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T questPlace.openGameConversation}" Padding="6,0" Margin="6,0,0,0"
                                VerticalAlignment="Top" FontSize="10"
                                Click="OpenGameConversation_Click"
                                Visibility="{Binding CanOpenConversation, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="{l:T questPlace.openGameConversation.tip}"/>
                        <Button DockPanel.Dock="Right" Content="&#x21BA;" Width="18" Padding="0" Margin="6,0,0,0"
                                VerticalAlignment="Top" FontSize="11" Command="{Binding ResetCommand}"
                                ToolTip="{l:T questPlace.reset.tip}"
                                Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#x25CF;" Width="10" FontSize="10" VerticalAlignment="Top"
                                   Foreground="{DynamicResource Theme.Accent}" ToolTip="{Binding ChangedText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditable}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{Binding What, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" - "/><Run Text="{Binding Where, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding When}" TextWrapping="Wrap" Margin="0,1,0,0"
                               Visibility="{Binding HasWhen, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,1,0,0"
                               Visibility="{Binding HasPath, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding Standing}" TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,1,0,0"
                               Visibility="{Binding HasStanding, Converter={StaticResource BoolToVisibility}}"/>
                    <ItemsControl ItemsSource="{Binding ConditionGroups}" Margin="0,2,0,0"
                                  ItemTemplate="{StaticResource GameConditionGroupTemplate}"/>
                    <TextBlock Text="{Binding PlaysNote}" TextWrapping="Wrap" Foreground="Gray" FontSize="10" Margin="0,2,0,0"
                               Visibility="{Binding HasPlaysNote, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding RuleNote}" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"
                               Foreground="{DynamicResource Theme.Accent}"
                               Visibility="{Binding HasRuleNote, Converter={StaticResource BoolToVisibility}}"/>
                    <StackPanel Margin="0,4,0,0"
                                Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:T questPlace.onlyIfYours}" Foreground="Gray"/>
                        <TextBlock Text="{Binding ExtraNote}" Foreground="Gray" FontSize="10" TextWrapping="Wrap"/>
                        <ContentControl Focusable="False" Margin="12,0,0,0" Content="{Binding ExtraConditions}"
                                        ContentTemplate="{StaticResource ConditionListTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameQuestSiteGroupTemplate" DataType="{x:Type vm:GameQuestSiteGroup}">
            <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,2,0,0">
                <ItemsControl ItemsSource="{Binding Sites}" Margin="16,0,0,0"
                              ItemTemplate="{StaticResource GameQuestSiteTemplate}"/>
            </Expander>
        </DataTemplate>

        <!-- One conditions-gated action group on a place's enter/exit edge.
             Reuses the dialogue editor's condition + action row templates, so
             the Places tab gets the identical editing experience. -->
        <DataTemplate x:Key="LevelHookRowTemplate" DataType="{x:Type vm:LevelHookViewModel}">
            <Border BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                    CornerRadius="3" Padding="6" Margin="0,0,0,4">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="−" Width="22" Height="22" Padding="0"
                                Command="{Binding RemoveCommand}" ToolTip="{l:T levelHook.remove.tip}"/>
                        <TextBlock Text="{l:T levelHook.conditionsAllMustPass}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Conditions}"
                                  ItemTemplateSelector="{DynamicResource ConditionTemplateSelector}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <Button Content="{l:T levelHook.addCondition}" Command="{Binding AddConditionCommand}" Padding="6,2" Margin="0,0,4,0"/>
                        <Button Content="{l:T levelHook.addConditionGroup}" Command="{Binding AddConditionGroupCommand}" Padding="6,2"
                                ToolTip="{l:T levelHook.addConditionGroup.tip}"/>
                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                        <Button Content="{l:T levelHook.copyConditions}" Command="{Binding CopyConditionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="{l:T levelHook.copyConditions.tip}"/>
                        <Button Content="{l:T levelHook.pasteConditions}" Command="{Binding PasteConditionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="{l:T levelHook.pasteConditions.tip}"/>
                        <Button Content="{l:T levelHook.overwriteConditions}" Command="{Binding OverwriteConditionsCommand}" Padding="6,2"
                                ToolTip="{l:T levelHook.overwriteConditions.tip}"/>
                    </StackPanel>
                    <TextBlock Text="{l:T levelHook.actions}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Actions}"
                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Button Content="{l:T levelHook.addAction}" Command="{Binding AddActionCommand}" Padding="6,2" Margin="0,0,4,0"/>
                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                        <Button Content="{l:T levelHook.copyConditions}" Command="{Binding CopyActionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="{l:T levelHook.copyConditions.tip2}"/>
                        <Button Content="{l:T levelHook.pasteConditions}" Command="{Binding PasteActionsCommand}" Padding="6,2" Margin="0,0,4,0"
                                ToolTip="{l:T levelHook.pasteConditions.tip2}"/>
                        <Button Content="{l:T levelHook.overwriteConditions}" Command="{Binding OverwriteActionsCommand}" Padding="6,2"
                                ToolTip="{l:T levelHook.overwriteConditions.tip2}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Grid wrapper exists only so the save-confirmation toast can overlay the
         top-right corner of the shell (DockPanel can't free-float a child). -->
    <Grid>
    <DockPanel LastChildFill="True">
        <!-- Menu strip -->
        <!-- Menu bar with the targeted game version pinned to its right edge
             (ModPack.CurrentGameVersion — the constant that also gets stamped
             into every saved pack for the runtime's compatibility check). -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource Theme.Chrome}">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.ChromeText}"
                       Text="{Binding GameVersionHeader}"
                       ToolTip="{l:T menu.gameBuildModforgeVersion.tip}"/>
        <Menu>
            <MenuItem view:TutorialAnchor.Id="menu:file" Header="{l:T menu.file}">
                <MenuItem Header="{l:T menu.newPack}"      Command="{Binding NewPackCommand}"     InputGestureText="{l:T menu.newPack.keys}"/>
                <MenuItem Header="{l:T menu.openPack}"    Command="{Binding OpenPackCommand}"    InputGestureText="{l:T menu.openPack.keys}"/>
                <MenuItem Header="{l:T menu.recentFiles}" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T menu.savePack}"          Command="{Binding SavePackCommand}"    InputGestureText="{l:T menu.savePack.keys}"/>
                <MenuItem Header="{l:T menu.savePackAs}"     Command="{Binding SavePackAsCommand}" InputGestureText="{l:T menu.savePackAs.keys}"/>
                <Separator/>
                <!-- Bundles the loose pack folder into a single .smspack
                     archive (zip) that the runtime plugin reads. Both items
                     are disabled until the pack has been saved to disk — the
                     exporter walks the on-disk folder. "Export pack" reuses
                     this pack's last export path (remembered in local editor
                     settings, never in the pack file); "as…" always asks. -->
                <MenuItem Header="{l:T menu.exportPack}" Command="{Binding ExportPackCommand}" InputGestureText="{l:T menu.exportPack.keys}"
                          ToolTip="{l:T menu.exportPack.tip}"/>
                <MenuItem Header="{l:T menu.exportPackAs}" Command="{Binding ExportPackAsCommand}" InputGestureText="{l:T menu.exportPackAs.keys}"
                          ToolTip="{l:T menu.exportPackAs.tip}"/>
                <Separator/>
                <!-- Publish is not a bigger Export. Export makes a pack file to
                     test with and touches nothing else; Publish makes the
                     release - it validates, moves the version, and packages the
                     Mods folder so a player extracts it into the game and is
                     finished. Separated so the two are not reached for
                     interchangeably. -->
                <MenuItem Header="{l:T menu.publishPack}" Command="{Binding PublishPackCommand}"
                          ToolTip="{l:T menu.publishPack.tip}"/>
                <MenuItem Header="{l:T menu.packTranslations}" ToolTip="{l:T menu.packTranslations.tip}">
                    <MenuItem Header="{l:T menu.packTranslations.new}" ToolTip="{l:T menu.packTranslations.new.tip}"
                              Click="PackTranslationNew_Click"/>
                    <MenuItem Header="{l:T menu.packTranslations.translate}" ToolTip="{l:T menu.packTranslations.translate.tip}"
                              Click="PackTranslationTranslate_Click"/>
                    <MenuItem Header="{l:T menu.packTranslations.check}" ToolTip="{l:T menu.packTranslations.check.tip}"
                              Click="PackTranslationCheck_Click"/>
                    <MenuItem Header="{l:T menu.packTranslations.open}" ToolTip="{l:T menu.packTranslations.open.tip}"
                              Click="PackTranslationOpen_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{l:T menu.validate}"      Command="{Binding ValidateCommand}"   InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="{l:T menu.edit}">
                <MenuItem Header="{l:T menu.duplicateItem}" Command="{Binding DuplicateItemCommand}" InputGestureText="{l:T menu.duplicateItem.keys}"
                          ToolTip="{l:T menu.duplicateItem.tip}"/>
                <MenuItem Header="{l:T menu.copyItem}"      Command="{Binding CopyItemCommand}" InputGestureText="{l:T menu.copyItem.keys}"
                          ToolTip="{l:T menu.copyItem.tip}"/>
                <MenuItem Header="{l:T menu.pasteItem}"     Command="{Binding PasteItemCommand}" InputGestureText="{l:T menu.pasteItem.keys}"
                          ToolTip="{l:T menu.pasteItem.tip}"/>
                <Separator/>
                <MenuItem Header="{l:T menu.renameItem}"   Command="{Binding RenameItemCommand}" InputGestureText="F2"
                          ToolTip="{l:T menu.renameItem.tip}"/>
                <MenuItem Header="{l:T menu.deleteItem}"    Command="{Binding DeleteItemCommand}" InputGestureText="{l:T menu.deleteItem.keys}"
                          ToolTip="{l:T menu.deleteItem.tip}"/>
            </MenuItem>
            <MenuItem Header="{l:T menu.themes}" ItemsSource="{Binding Themes}"
                      ToolTip="{l:T menu.themes.tip}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding DisplayName}"/>
                        <Setter Property="IsCheckable" Value="True"/>
                        <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                        <Setter Property="Command" Value="{Binding DataContext.ApplyThemeCommand,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Setter Property="CommandParameter" Value="{Binding}"/>
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="{l:T menu.options}">
                <!-- Two-way: the dialog's own "Don't ask again" writes back
                     through the same VM property, so unticking here is how you
                     get the prompt back. -->
                <MenuItem Header="{l:T menu.confirmChangesSave}" IsCheckable="True"
                          IsChecked="{Binding ConfirmOnSave, Mode=TwoWay}"
                          ToolTip="{l:T menu.confirmChangesSave.tip}"/>
                <MenuItem Header="{l:T menu.spellCheckNodeText}" IsCheckable="True"
                          IsChecked="{Binding SpellCheckNodeText, Mode=TwoWay}"
                          ToolTip="{l:T menu.spellCheckNodeText.tip}"/>
                <Separator/>
                <MenuItem Header="{l:T menu.versionPackAutomatically}" IsCheckable="True"
                          IsChecked="{Binding AutoVersion, Mode=TwoWay}"
                          ToolTip="{l:T menu.versionPackAutomatically.tip}"/>
                <MenuItem Header="{l:T menu.warnWhenVersionGoes}" IsCheckable="True"
                          IsChecked="{Binding WarnOnLowerVersion, Mode=TwoWay}"
                          ToolTip="{l:T menu.warnWhenVersionGoes.tip}"/>
                <MenuItem Header="{l:T menu.warnAboutLargeExports}" IsCheckable="True"
                          IsChecked="{Binding WarnOnLargeExport, Mode=TwoWay}"
                          ToolTip="{l:T menu.warnAboutLargeExports.tip}"/>
                <MenuItem Header="{l:T menu.offerTranslationOnExport}" IsCheckable="True"
                          IsChecked="{Binding OfferTranslationOnExport, Mode=TwoWay}"
                          ToolTip="{l:T menu.offerTranslationOnExport.tip}"/>
                <Separator/>
                <MenuItem Header="{l:T menu.addPackNamesToDictionary}"
                          Click="AddPackNamesToDictionary_Click"
                          ToolTip="{l:T menu.addPackNamesToDictionary.tip}"/>
                <Separator/>
                <MenuItem Header="{l:T menu.checkUpdatesStart}" IsCheckable="True"
                          IsChecked="{Binding CheckForUpdatesOnStart, Mode=TwoWay}"
                          ToolTip="{l:T menu.checkUpdatesStart.tip}"/>
                <MenuItem Header="{l:T menu.installUpdatesWithoutAsking}" IsCheckable="True"
                          IsChecked="{Binding InstallUpdatesWithoutAsking, Mode=TwoWay}"
                          ToolTip="{l:T menu.installUpdatesWithoutAsking.tip}"/>
                <MenuItem Header="{l:T menu.setGameFolder}" Click="SetGameFolder_Click"
                          ToolTip="{l:T menu.setGameFolder.tip}"/>
                <MenuItem Header="{l:T menu.dialogueRowsLookLike}" IsCheckable="True"
                          IsChecked="{Binding GameLookNodeRows, Mode=TwoWay}"
                          ToolTip="{l:T menu.dialogueRowsLookLike.tip}"/>
                <MenuItem Header="{l:T menu.checkForUpdates}" Click="CheckForUpdates_Click"
                          ToolTip="{l:T menu.checkForUpdates.tip}"/>
                <Separator/>
                <MenuItem Header="{l:T menu.previewQuality}" ItemsSource="{Binding PreviewQualities}"
                          ToolTip="{l:T menu.previewQuality.tip}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding DisplayName}"/>
                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                            <Setter Property="IsCheckable" Value="True"/>
                            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}"/>
                            <Setter Property="Command" Value="{Binding DataContext.ApplyPreviewQualityCommand,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>
            <!-- A globe as well as a word: somebody who cannot read the
                 language on screen can still find the way out of it. Filled
                 as it opens, so a translation added a moment ago is there. -->
            <MenuItem x:Name="LanguageMenu" SubmenuOpened="LanguageMenu_Opened"
                      ToolTip="{l:T language.menu.tip}">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐" Margin="0,0,4,0"/>
                        <AccessText Text="{l:T language.menu}"/>
                    </StackPanel>
                </MenuItem.Header>
                <MenuItem/>
            </MenuItem>
        </Menu>
        </DockPanel>

        <!-- Said for as long as it is true. Editing in the wrong language is an
             easy mistake with a slow discovery - the words look right, they are
             just in the wrong file - so the reminder stays up rather than being
             said once when the language was chosen. -->
        <Border DockPanel.Dock="Top" Background="#FF2E5A88" Padding="10,4"
                Visibility="{Binding IsEditingTranslation, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="White" TextWrapping="Wrap" Text="{l:T editingLanguage.banner}"/>
        </Border>

        <!-- Status / issues bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <!-- The notice is FIRST because a StatusBar lays its items out in a
                 DockPanel: docking it right before the issue count is added is
                 what pins it to the far edge rather than trailing the count. -->
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock FontWeight="SemiBold" Margin="0,0,4,0"
                           Text="{l:T statusBar.modforgeFreeGetArvus}"
                           ToolTip="{l:T statusBar.modforgeFreeGetArvus.tip}"/>
            </StatusBarItem>
            <TextBlock Text="{Binding Issues.Count, Mode=OneWay, Converter={x:Static l:PluralConverter.Instance}, ConverterParameter=statusBar.issues}"/>
        </StatusBar>

        <!-- The tabs, with the language the pack is being edited in at the right
             end of their row, under the game version. It changes every tab at
             once - every text a player reads, everywhere, shows the chosen
             language - so it sits over all of them rather than in one. The tab
             headers are kept clear of it (MainWindow.KeepTabsClearOfLanguage). -->
        <Grid>
        <TabControl x:Name="MainTabs" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <!-- ════════════════════════════════════════════════════
                 MODFORGE TAB (index 0 — landing page)
                 Pack-wide validation issues + usage help. Hosts no
                 unit list, so the per-tab copy/paste/rename/delete
                 dispatches deliberately no-op here.
                 ════════════════════════════════════════════════════ -->
            <TabItem view:TutorialAnchor.Id="tab:modforge" Header="{l:T home.modforge}" Style="{StaticResource HomeTabItem}"
                     ToolTip="{l:T home.modforge.tip}">
                <Grid Margin="8">
                    <!-- Help fills ~2/3 on the left; the issues panel sits on
                         the right at ~1/3 width. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- RIGHT: validation issues (moved from the Busts tab) -->
                    <DockPanel Grid.Column="2">
                        <!-- The pack's own version: what a player sees beside its
                             name in the main menu. Only shown when there is a pack
                             to number - an empty editor has nothing to version. -->
                        <GroupBox DockPanel.Dock="Top" Header="{l:T home.packVersion}" Margin="0,0,0,6"
                                  Visibility="{Binding HasPack, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="{l:T home.version}" Width="60"
                                               VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PackVersionText, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalAlignment="Center"
                                             ToolTip="{l:T home.threeNumbersMajorMinor.tip}"/>
                                </DockPanel>
                                <TextBlock Foreground="{DynamicResource Theme.Danger}" FontSize="10"
                                           Margin="60,2,0,0" TextWrapping="Wrap"
                                           Text="{l:T home.notVersionThreeNumbers}"
                                           Visibility="{Binding PackVersionIsValid, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <TextBlock Foreground="Gray" FontSize="10" Margin="60,2,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding AutoVersionNote}"
                                           Visibility="{Binding AutoVersionOn, Converter={StaticResource BoolToVisibility}}"/>
                                <!-- The language the pack's own words are in, with a
                                     line under it saying what that means: the word
                                     alone reads like the language the editor is in. -->
                                <StackPanel view:TutorialAnchor.Id="panel:packLanguage" Margin="0,6,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="{l:T home.packLanguage}" Width="60"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="PackLanguagePicker"
                                                  ItemsSource="{Binding PackLanguageOptions}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Code"
                                                  SelectedValue="{Binding PackLanguage}"
                                                  IsEnabled="{Binding IsEditingTranslation, Converter={StaticResource InverseBoolConverter}}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="{l:T home.packLanguage.tip}"/>
                                    </DockPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="60,2,0,0" TextWrapping="Wrap"
                                               Text="{l:T home.packLanguage.note}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button view:TutorialAnchor.Id="btn:validate" DockPanel.Dock="Right" Content="{l:T home.validate}" Padding="10,3"
                                    Command="{Binding ValidateCommand}"
                                    ToolTip="{l:T home.validate.tip}"/>
                            <TextBlock FontWeight="Bold" FontSize="14" VerticalAlignment="Center">
                                <Run Text="{Binding Issues.Count, Mode=OneWay, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=home.issuesCount}"/>
                            </TextBlock>
                        </DockPanel>
                        <!-- Each issue is one line; double-click jumps to the tab and
                             selects the exact thing it refers to. Full text on hover. -->
                        <!-- Condition-debug tracking. The flag is a checkbox
                             buried in each dialogue's editor, so it is easy to
                             leave on and then wonder why the in-game log is
                             full of one dialogue's conditions. Docked at the
                             bottom so it only takes space when something is
                             actually tracked. -->
                        <GroupBox DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                  Visibility="{Binding HasDebuggedDialogues, Converter={StaticResource BoolToVisibility}}">
                            <GroupBox.Header>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T home.clearDebugDialogues}" Padding="8,0" Margin="8,0,0,0"
                                            Command="{Binding ClearDebugDialoguesCommand}"
                                            ToolTip="{l:T home.clearDebugDialogues.tip}"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding DebuggedDialogues.Count, Mode=OneWay, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=home.debuggedDialogues}"/>
                                    </TextBlock>
                                </DockPanel>
                            </GroupBox.Header>
                            <ItemsControl ItemsSource="{Binding DebuggedDialogues}" MaxHeight="150">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="{l:T home.untrackDebugDialogue}" Padding="6,0"
                                                    Command="{Binding DataContext.UntrackDebugDialogueCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{l:T home.untrackDebugDialogue.tip}"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <!-- Same idea for integration rules, but a separate list
                             because a flagged rule logs CONTINUOUSLY rather than
                             on an F12 press — one left on is noisier than a
                             dialogue left on, so it is worth its own count. -->
                        <GroupBox DockPanel.Dock="Bottom" Margin="0,6,0,0"
                                  Visibility="{Binding HasDebuggedRules, Converter={StaticResource BoolToVisibility}}">
                            <GroupBox.Header>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:T home.clearDebugDialogues}" Padding="8,0" Margin="8,0,0,0"
                                            Command="{Binding ClearDebugRulesCommand}"
                                            ToolTip="{l:T home.clearDebugDialogues.tip2}"/>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding DebuggedRules.Count, Mode=OneWay, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=home.debuggedRules}"/>
                                    </TextBlock>
                                </DockPanel>
                            </GroupBox.Header>
                            <ItemsControl ItemsSource="{Binding DebuggedRules}" MaxHeight="150">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Content="{l:T home.untrackDebugDialogue}" Padding="6,0"
                                                    Command="{Binding DataContext.UntrackDebugRuleCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{l:T home.untrackDebugDialogue.tip2}"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </GroupBox>

                        <GroupBox>
                            <GroupBox.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{l:T home.doubleClickIssueJump}" VerticalAlignment="Center"/>
                                    <!-- Silenced issues are hidden, so say they exist. A count
                                         nobody can see is how an ignore list turns into a place
                                         problems go to be forgotten. -->
                                    <Button DockPanel.Dock="Right" Content="{l:T home.clearIgnoredIssues}"
                                            Padding="8,0" Margin="8,0,0,0"
                                            Click="ClearIgnoredIssues_Click"
                                            Visibility="{Binding HasIgnoredIssues, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="{l:T home.clearIgnoredIssues.tip}"/>
                                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                              IsChecked="{Binding ShowIgnoredIssues}"
                                              Visibility="{Binding HasIgnoredIssues, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="{l:T home.listIssuesHaveSilenced.tip}">
                                        <TextBlock>
                                            <Run Text="{Binding IgnoredIssueCount, Mode=OneWay, Converter={x:Static l:PluralConverter.Instance}, ConverterParameter=home.showIgnored}"/>
                                        </TextBlock>
                                    </CheckBox>
                                </DockPanel>
                            </GroupBox.Header>
                            <ListBox x:Name="IssueList"
                                     ItemsSource="{Binding Issues}"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="IssueList_MouseDoubleClick"
                                     ContextMenuOpening="IssueList_ContextMenuOpening">
                                <!-- The three entries are enabled by what the selected row IS,
                                     in IssueList_ContextMenuOpening. All three used to be offered
                                     on every row, including "Stop ignoring this" on rows that are
                                     not ignored — which reads as an action with no way to reach
                                     it, since silenced issues are hidden until the Show checkbox
                                     above lists them. -->
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="MenuIgnoreIssue" Header="{l:T home.menuIgnoreIssue}" Click="IgnoreIssue_Click"
                                                  ToolTip="{l:T home.menuIgnoreIssue.tip}"/>
                                        <MenuItem x:Name="MenuIgnoreCode" Header="{l:T home.menuIgnoreCode}" Click="IgnoreIssueCode_Click"
                                                  ToolTip="{l:T home.menuIgnoreCode.tip}"/>
                                        <Separator/>
                                        <MenuItem x:Name="MenuUnignoreIssue" Header="{l:T home.menuUnignoreIssue}" Click="UnignoreIssue_Click"
                                                  ToolTip="{l:T home.menuUnignoreIssue.tip}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Dimmed and marked when the row is one of the silenced ones,
                                             which only appear at all while Show ignored is ticked. Without
                                             the marking the list mixes dealt-with and outstanding issues
                                             with nothing to tell them apart. -->
                                        <Grid ToolTip="{Binding Message}" Cursor="Hand"
                                              Background="Transparent">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ignored}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Severity}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Where}"   Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{l:T home.ignoredMark}" Foreground="Gray" FontStyle="Italic" Margin="0,0,8,0"
                                                       Visibility="{Binding Ignored, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- LEFT: usage help. Tutorial/documentation sections are
                         templates to be fleshed out — keep the structure, fill
                         the bodies in later. -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock FontWeight="Bold" FontSize="16" Text="{l:T home.smsmodforge}"/>
                            <TextBlock Foreground="Gray" Margin="0,0,0,8"
                                       Text="{Binding GameVersionHeader}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="{l:T home.authorModPacksStarmaker}"/>

                            <Expander Header="{l:T home.gettingStarted}" IsExpanded="True" Margin="0,0,0,6">
                                <StackPanel Margin="16,4,0,4">
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T home.1FileNewPack}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T home.2WorkLeftRight}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T home.3ValidateF5Fix}"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T home.4FileExportPack}"/>
                                </StackPanel>
                            </Expander>

                            <Expander Header="{l:T home.guidedTutorials}" IsExpanded="True" Margin="0,0,0,6">
                                <!--
                                    Grouped by the part of the editor they teach, because that
                                    is how someone picks what to learn next: they are working on
                                    rooms and want the rest of the room tutorials, not the next
                                    entry in one long list. Level orders them within a group and
                                    is shown as a badge, so a first tutorial reads as one.
                                -->
                                <ItemsControl Margin="16,4,0,4">
                                    <ItemsControl.ItemsSource>
                                        <Binding Path="TutorialsView"/>
                                    </ItemsControl.ItemsSource>
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                               Margin="0,8,0,4" Opacity="0.75"/>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" CornerRadius="4" Margin="0,0,0,6"
                                                    Padding="10,8"
                                                    BorderBrush="{DynamicResource Theme.Accent}"
                                                    Background="{DynamicResource Theme.Surface}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right"
                                                            Content="{Binding ActionLabel}"
                                                            Padding="14,4" VerticalAlignment="Center"
                                                            Margin="10,0,0,0"
                                                            Command="{Binding DataContext.StartTutorialCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <StackPanel>
                                                        <TextBlock FontWeight="Bold">
                                                            <Run Text="{Binding Mark, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Theme.Accent}"/><Run
                                                                 Text=" "/><Run Text="{Binding LevelLabel, Mode=OneWay}"
                                                                 Foreground="{DynamicResource Theme.Accent}"/><Run
                                                                 Text=" "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                                   Opacity="0.7" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Header="{l:T home.documentation}" IsExpanded="False" Margin="0,0,0,6">
                              <StackPanel Margin="16,4,0,4">
                                <!-- Search. Filters titles and content alike; a
                                     topic matched by its title keeps all of its
                                     bullets, one matched only by content keeps
                                     just the bullets that hit. -->
                                <DockPanel Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Content="{l:T home.clearDocSearch}" Padding="8,1" Margin="6,0,0,0"
                                            Command="{Binding ClearDocSearchCommand}"
                                            Visibility="{Binding IsDocSearchActive,
                                                         Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBox Text="{Binding DocQuery, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                             ToolTip="{l:T home.searchReferenceMatchesTopic.tip}"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DocSearchSummary}" Opacity="0.65" FontSize="11"
                                           Margin="2,0,0,6"
                                           Visibility="{Binding IsDocSearchActive,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock TextWrapping="Wrap" Opacity="0.65" FontStyle="Italic" Margin="2,4,0,4"
                                           Text="{l:T home.noTopicMentionsTry}"
                                           Visibility="{Binding HasNoDocResults,
                                                        Converter={StaticResource BoolToVisibility}}"/>
                                <ItemsControl ItemsSource="{Binding DocParts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                           Opacity="0.75" Margin="0,4,0,4"/>
                                                <ItemsControl ItemsSource="{Binding Topics}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Expander Header="{Binding Title}" Margin="0,0,0,2"
                                                                      IsExpanded="{Binding StartExpanded, Mode=OneTime}">
                                                                <StackPanel Margin="16,4,0,6">
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                                                               FontStyle="Italic" Opacity="0.7" Margin="0,0,0,6"/>
                                                                    <ItemsControl ItemsSource="{Binding Sections}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,0,6">
                                                                                    <TextBlock Text="{Binding Heading}" FontWeight="Bold"
                                                                                               Margin="0,2,0,3"
                                                                                               Visibility="{Binding HasHeading,
                                                                                                            Converter={StaticResource BoolToVisibility}}"/>
                                                                                    <ItemsControl ItemsSource="{Binding Bullets}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                                                                                    <Run Text="•  "/><Run Text="{Binding Term, Mode=OneWay}" FontWeight="Bold"/><Run
                                                                                                         Text="{Binding Dash, Mode=OneWay}"/><Run Text="{Binding Text, Mode=OneWay}"/>
                                                                                                </TextBlock>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 BUSTS TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T characters.characters}">
                <Grid x:Name="CharactersGrid" SizeChanged="BustPreviewRoom_Changed">
                    <Grid.Resources>
                        <!-- Pack-authored and vanilla-borrowed characters read
                             very differently, so the tree groups by source
                             rather than mixing a bust you drew with one you
                             merely pointed at. -->
                        <CollectionViewSource x:Key="GroupedCharacters" Source="{Binding Characters}"
                                              IsLiveGroupingRequested="True">
                            <!-- Live, or switching a character to a vanilla bust
                                 would leave it filed under the wrong heading
                                 until the tab was rebound. -->
                            <CollectionViewSource.LiveGroupingProperties>
                                <sys:String>BustSource</sys:String>
                            </CollectionViewSource.LiveGroupingProperties>
                            <CollectionViewSource.GroupDescriptions>
                                <PropertyGroupDescription PropertyName="BustSource"/>
                            </CollectionViewSource.GroupDescriptions>
                            <!-- Sorted WITHIN each heading. The Characters
                                 collection's own default view is sorted too, but
                                 this CollectionViewSource is a separate view and
                                 was left in insertion order. -->
                            <CollectionViewSource.SortDescriptions>
                                <scm:SortDescription PropertyName="DisplayName" Direction="Ascending"/>
                            </CollectionViewSource.SortDescriptions>
                        </CollectionViewSource>
                    </Grid.Resources>
                    <!--
                        Column 4 (the live-preview side panel) has no
                        GridSplitter, and should not get one: the preview is
                        pinned to its own size, so a column an author could drag
                        narrower than that would clip it rather than shrink it.
                        What the author drags instead is the ZOOM picker under
                        the preview, and the column is sized FROM that — the
                        panel grows with the picture rather than the picture
                        growing inside a panel that stays put.
                    -->
                    <Grid.ColumnDefinitions>
                        <!--
                            MinWidth is set from the toolbar's own measured width on
                            load (CharacterToolBar_Loaded), not written here: the
                            buttons' width depends on the theme's font and the user's
                            DPI, so any number typed in would be wrong on somebody's
                            machine. Dragging the splitter narrower than the buttons
                            used to fold them into ToolBar's overflow popup, where
                            authors did not find them at all.
                        -->
                        <ColumnDefinition x:Name="CharacterSidebarColumn" Width="2*" MinWidth="180"/>
                        <ColumnDefinition x:Name="CharacterSplitterColumn" Width="Auto"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="{Binding BustPreviewColumnWidth}"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: character/outfit tree -->
                    <DockPanel view:TutorialAnchor.Id="panel:characterTree" Grid.Column="0">
                        <ToolBar x:Name="CharacterToolBar" DockPanel.Dock="Top"
                                 Loaded="CharacterToolBar_Loaded">
                            <Button view:TutorialAnchor.Id="btn:addCharacter" Content="{l:T characters.addCharacter}" Command="{Binding AddCharacterCommand}"
                                    ToolTip="{l:T characters.addCharacter.tip}"/>
                            <Button Content="{l:T characters.addVoiceCharacter}" Command="{Binding AddVoiceCharacterCommand}"
                                    ToolTip="{l:T characters.addVoiceCharacter.tip}"/>
                            <Button Content="{l:T characters.addOutfit}"    Command="{Binding AddOutfitCommand}"
                                    ToolTip="{l:T characters.addOutfit.tip}"/>
                            <Separator/>
                            <Button Content="{l:T characters.removeOutfit}" Command="{Binding RemoveOutfitCommand}"
                                    ToolTip="{l:T characters.removeOutfit.tip}"/>
                            <Button Content="{l:T characters.removeCharacter}" Command="{Binding RemoveCharacterCommand}"
                                    ToolTip="{l:T characters.removeCharacter.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding CharacterTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="CharacterTree"
                                  ItemsSource="{Binding Source={StaticResource GroupedCharacters}}"
                                  SelectedItemChanged="TreeView_SelectedItemChanged">
                            <TreeView.GroupStyle>
                                <GroupStyle>
                                    <!--
                                        The expander lives in the CONTAINER style, not the
                                        header one. A header template draws only the heading;
                                        the group's rows are presented by the GroupItem
                                        itself, so an ItemsPresenter put in the header had
                                        nothing to present and the arrow did nothing when
                                        clicked. Retemplating the GroupItem is what puts the
                                        heading and its rows inside one expander.
                                    -->
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="GroupItem">
                                                        <!-- Through Tag, because a GroupItem has
                                                             no IsExpanded of its own to bind to.
                                                             TwoWay so a heading the author opens
                                                             stays open: the binding writes a local
                                                             value, which outranks the style below
                                                             until the pack is loaded afresh. -->
                                                        <Expander IsExpanded="{Binding Tag,
                                                                      RelativeSource={RelativeSource TemplatedParent},
                                                                      Mode=TwoWay}"
                                                                  Margin="0,6,0,0">
                                                            <Expander.Header>
                                                                <TextBlock FontWeight="Bold" Foreground="Gray">
                                                                    <Run Text="{Binding Name, Mode=OneWay,
                                                                         Converter={x:Static conv:BustSourceHeaderConverter.Instance}}"/>
                                                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}"
                                                                         FontWeight="Normal"/>
                                                                </TextBlock>
                                                            </Expander.Header>
                                                            <ItemsPresenter/>
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>

                                            <!--
                                                Open by default, except the game's own cast.
                                                That one heading holds 119 characters an
                                                author did not write and mostly is not
                                                looking for, so a pack opens showing the
                                                dozen that are theirs.
                                            -->
                                            <Setter Property="Tag" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="Vanilla">
                                                    <Setter Property="Tag" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </TreeView.GroupStyle>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:CharacterViewModel}"
                                                          ItemsSource="{Binding Outfits}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- An untouched one of the game's characters is deliberately
                                             quiet: this heading holds a hundred and nineteen of them
                                             and the two or three that were touched are what an author
                                             is looking for. The same treatment the UI tree gives its
                                             own 1434 vanilla rows. A character of the pack's own is
                                             never dimmed — the whole entry is theirs. -->
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsQuietVanilla}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- The same chip the level tree and the UI tree use for the
                                             same fact, in the same words: this row differs from what
                                             the game has, so it is one of the few that will be saved.
                                             Three names for one thing across three tabs would be three
                                             things to learn. -->
                                        <Border CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                                VerticalAlignment="Center" Background="#B26A00"
                                                Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.packHasChangedSomething.tip}">
                                            <TextBlock Text="{l:T characters.changed}" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:OutfitViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="• "/>
                                        <TextBlock Text="{Binding Key}"/>
                                        <!-- The same chip the character above carries, and the same
                                             words the level and UI trees use. On the row rather than
                                             only on the character because a borrowed character can
                                             have sixty-five outfits and one replaced texture: the
                                             character&apos;s tag says something in there changed, this
                                             one says which row to open.
                                             new     = a bust this pack drew for one of the game&apos;s.
                                             changed = one of theirs, painted over. -->
                                        <Border CornerRadius="2" Padding="4,0" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasChangedTag, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#B26A00"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChangedTag}" Value="new">
                                                            <Setter Property="Background" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ChangedTag}" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: outfit editor - and the character's own settings above it.
                         Shown for any character, not only one with an outfit selected: a
                         voice-only character (John Dick) has no outfit at all, and hiding the
                         pane with the outfit hid their name, pronouns, colour and voice with it
                         (author, 2026-09-27). What belongs to an outfit hides itself when there
                         is none (FallbackValue=Collapsed: no outfit, no value). -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedOutfit}"
                                  Visibility="{Binding DataContext.SelectedCharacter,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- The character owning this outfit. Bound through the
                                 window because this pane's DataContext is the outfit;
                                 without it the sidebar showed a character name that
                                 nothing anywhere could edit. -->
                            <!-- One Identity panel for everything that names or
                                 identifies the selection: the character, how it is
                                 drawn, and the outfit selected under it. These were
                                 four separate GroupBoxes at different depths
                                 ("Character", "Bust", "Default outfit", and a second
                                 "Identity" lower down for the outfit), which is why
                                 it was unclear which "Name:" set what. -->
                            <GroupBox Header="{l:T characters.identity}" Margin="0,0,0,6">
                                <StackPanel>
                                    <!-- The tag in the sidebar says this character differs. This
                                         says what differs, which is the question that follows it -
                                         and some of the answers are things an author cannot see
                                         anywhere else, like a dialogue key sitting in an expander
                                         that is greyed out for one of the game's characters.
                                         The per-field Reset buttons handle a field at a time. This
                                         one is for having decided you want the character as the
                                         game has them: it reaches the faces, the replaced textures
                                         and the busts the pack drew, which no single field button
                                         can. It asks first, because unlike the others it destroys
                                         work rather than putting a number back. -->
                                    <Border DataContext="{Binding DataContext.SelectedCharacter,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding HasChangedFields, Converter={StaticResource BoolToVisibility}}"
                                            Background="{DynamicResource Theme.ChangedSurface}"
                                            BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="1"
                                            CornerRadius="3" Padding="6,4" Margin="0,0,0,8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{l:T characters.resetCharacter}"
                                                    Padding="8,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ResetCharacterCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="{l:T characters.resetCharacter.tip}"/>
                                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Text="{Binding ChangedFields, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=characters.packChanges}"/>
                                        </DockPanel>
                                    </Border>
                                    <!-- Character -->
                                    <Grid DataContext="{Binding DataContext.SelectedCharacter, RelativeSource={RelativeSource AncestorType=Window}}"
                                          Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{l:T characters.characterName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox view:TutorialAnchor.Id="field:characterName"
                                                 Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding CanEditIdentity}"
                                                 ToolTip="{l:T characters.characterName.tip}"/>

                                        <!-- Right under the name: who the character is, and what a
                                             translation has to know about them. Greyed on the player and
                                             the game's characters, showing the game's answer. -->
                                        <TextBlock Text="{l:T characters.pronouns}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                            <ComboBox x:Name="PronounsPicker" view:TutorialAnchor.Id="field:pronouns"
                                                      Width="140" SelectedValuePath="Tag"
                                                      SelectedValue="{Binding Pronouns}"
                                                      IsEnabled="{Binding CanEditPronouns}"
                                                      ToolTip="{l:T characters.pronouns.tip}">
                                                <ComboBoxItem Content="{l:T characters.pronouns.male}"    Tag="{x:Static model:Pronouns.Male}"/>
                                                <ComboBoxItem Content="{l:T characters.pronouns.female}"  Tag="{x:Static model:Pronouns.Female}"/>
                                                <ComboBoxItem Content="{l:T characters.pronouns.neutral}" Tag="{x:Static model:Pronouns.Neutral}"/>
                                            </ComboBox>
                                            <TextBlock Text="{l:T characters.pronouns.missing}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="#D9534F" TextWrapping="Wrap"
                                                       Visibility="{Binding NeedsPronouns, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>

                                        <TextBlock Text="{l:T characters.nameColour}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2"
                                                    IsEnabled="{Binding CanEditNameColor}">
                                            <Border Width="22" Height="18" BorderBrush="#888" BorderThickness="1"
                                                    Background="{Binding NameColorBrush}" VerticalAlignment="Center"/>
                                            <TextBox Text="{Binding NameColor, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="6,0,0,0"
                                                     ToolTip="{l:T characters.speakerNameTintHex.tip}"/>
                                            <Button Content="{l:T characters.pickCharacterColor}" Margin="6,0,0,0" Padding="8,0"
                                                    Click="PickCharacterColor_Click"
                                                    ToolTip="{l:T characters.pickCharacterColor.tip}"/>
                                            <!-- Disabled rather than collapsed, which is a departure
                                                 from how the dialogue editor does these — and the
                                                 reason is that hiding it does not work here.
                                                 The box now SHOWS a colour whether or not the pack set
                                                 one, so the row an author looks at while wondering how
                                                 to get the original back is exactly the row where
                                                 nothing is stored and a collapsed button is not there.
                                                 It was reported missing twice on that row.
                                                 Hiding earns its keep in the dialogue editor because
                                                 the alternative is thirteen buttons with twelve greyed;
                                                 one greyed button beside Pick is not that. -->
                                            <Button x:Name="ResetNameColorButton"
                                                    Content="{l:T characters.resetField}" Margin="6,0,0,0" Padding="8,0"
                                                    Command="{Binding ResetFieldCommand}" CommandParameter="NameColor"
                                                    IsEnabled="{Binding CanResetNameColor}"
                                                    Visibility="{Binding ShowsResets, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="{l:T characters.resetField.tip}"/>
                                        </StackPanel>

                                        <TextBlock Text="{l:T characters.bustSource}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,2" HorizontalAlignment="Left" Width="220"
                                                  SelectedValue="{Binding BustSource}" SelectedValuePath="Tag"
                                                  IsEnabled="{Binding CanEditBustSource}"
                                                  ToolTip="{l:T characters.whereCharacterSBust.tip}">
                                            <ComboBoxItem Content="{l:T characters.packSOutfits}"  Tag="{x:Static model:BustSource.Pack}"/>
                                            <ComboBoxItem Content="{l:T characters.vanillaBust}"       Tag="{x:Static model:BustSource.Vanilla}"/>
                                            <ComboBoxItem Content="{l:T characters.noBustVoiceOnly}" Tag="{x:Static model:BustSource.None}"/>
                                        </ComboBox>

                                        <!-- Not for a voice, which has no outfit to start in. -->
                                        <TextBlock Text="{l:T characters.defaultOutfit}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                                                   Visibility="{Binding HasBust, Converter={StaticResource BoolToVisibility}}"/>
                                        <!-- The field is greyed on one of the game&apos;s characters, so this
                                             button is the only way back from an answer an older editor
                                             wrote: it adopted a character through whichever bust the pack
                                             first used and recorded that as the default. -->
                                        <Button Grid.Row="4" Grid.Column="1" Content="{l:T characters.resetField}" Padding="8,0"
                                                Margin="0,2" HorizontalAlignment="Right"
                                                Command="{Binding ResetFieldCommand}" CommandParameter="DefaultOutfit"
                                                IsEnabled="{Binding CanResetDefaultOutfit}"
                                                Visibility="{Binding ShowsResets, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.resetField.tip2}"/>
                                        <ComboBox x:Name="DefaultOutfitPicker" Grid.Row="4" Grid.Column="1" Margin="0,2,58,2" IsEditable="True"
                                                  Visibility="{Binding HasBust, Converter={StaticResource BoolToVisibility}}"
                                                  ItemsSource="{Binding WearableBusts}"
                                                  SelectedItem="{Binding DefaultOutfit}"
                                                  IsEnabled="{Binding CanEditDefaultOutfit}"
                                                  ToolTip="{l:T characters.defaultOutfitPicker.tip}"/>
                                    </Grid>

                                    <!-- Selected outfit -->
                                    <Grid Margin="0,8,0,0"
                                          Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T characters.outfitName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                                   ToolTip="{l:T characters.outfitName.tip}"/>
                                        <!-- Which of these shows follows the OUTFIT rather than the
                                             character, and it has to: one of the game&apos;s characters can
                                             wear both kinds at once now - the busts the game gave them,
                                             whose name is simply which bust it is, and a bust this pack
                                             drew for them, which is named like any other outfit. -->
                                        <TextBox ToolTip="{l:T characters.outfitName.tip}"  Grid.Row="0" Grid.Column="1" Margin="0,2"
                                                  Text="{Binding GameObjectName, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding CanEditName, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" IsReadOnly="True" IsEnabled="False"
                                                  Text="{Binding GameObjectName, Mode=OneWay}"
                                                  Visibility="{Binding IsVanillaBust, Converter={StaticResource BoolToVisibility}}"
                                                  ToolTip="{l:T characters.whichGameSBusts.tip}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10"
                                                   Text="{l:T characters.everyOutfitReferencePack}"
                                                   Visibility="{Binding CanEditName, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Text="{l:T characters.oneGameSOwn}"
                                                   Visibility="{Binding IsVanillaBust, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Text="{l:T characters.bustPackDrawsOne}"
                                                   Visibility="{Binding IsAddedToVanilla, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>

                                    <!-- The toggle the replace-textures panel hangs off. It sits with
                                         the outfit name because that is what it qualifies: the name
                                         above is somebody else&apos;s bust, and this is the one thing a
                                         pack can do to it. -->
                                    <CheckBox Margin="0,8,0,0" Content="{l:T characters.replaceTexturesBust}"
                                              IsChecked="{Binding OverridesShown}"
                                              Visibility="{Binding IsVanillaBust, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                              ToolTip="{l:T characters.replaceTexturesBust.tip}"/>

                                    <!-- Contextual notes + the derived internal names -->
                                    <StackPanel DataContext="{Binding DataContext.SelectedCharacter, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Visibility="{Binding IsVanillaBust, Converter={StaticResource BoolToVisibility}}"
                                                   Text="{l:T characters.characterWearsGameS}"/>
                                        <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Visibility="{Binding IsPlayer, Converter={StaticResource BoolToVisibility}}"
                                                   Text="{l:T characters.playerBuiltSharedEvery}"/>
                                        <TextBlock Margin="0,6,0,0" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Visibility="{Binding HasNoBust, Converter={StaticResource BoolToVisibility}}"
                                                   Text="{l:T characters.characterSpeaksNoBust}"/>

                                        <!-- The key is greyed for one of the game's characters, and a pack
                                             written by an older editor can be carrying one of its own
                                             ("mobster" where the catalog says "mobster1"). It could not be
                                             migrated: every dialogue node in the pack names the character
                                             by it. So it is a reset, and the rename takes the lines with
                                             it rather than leaving them pointing at nobody. -->
                                        <Button Content="{l:T characters.resetCharacterKey}" Padding="8,0" Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Command="{Binding DataContext.ResetCharacterKeyCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanResetKey, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.resetCharacterKey.tip}"/>
                                        <Expander Header="{l:T characters.internalNames}" Margin="0,8,0,0"
                                                  IsEnabled="{Binding CanEditIdentity}">
                                            <StackPanel Margin="0,4,0,0">
                                                <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           Text="{l:T characters.derivedCharacterNameAbove}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{l:T characters.dialogueKey}" Width="140" VerticalAlignment="Center"
                                                               ToolTip="{l:T characters.dialogueKey.tip}"/>
                                                    <TextBox ToolTip="{l:T characters.dialogueKey.tip}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{l:T characters.gameobject}" Width="140" VerticalAlignment="Center"
                                                               ToolTip="{l:T characters.gameobject.tip}"/>
                                                    <TextBox ToolTip="{l:T characters.gameobject.tip}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T characters.voiceTypewriterBlip}"
                                      DataContext="{Binding DataContext.SelectedCharacter,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Text="{l:T characters.blipPlaysCharacterS}"/>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Text="{l:T characters.playerVoiceFixed}"
                                               Visibility="{Binding IsPlayer, Converter={StaticResource BoolToVisibility}}"/>
                                    <!-- Greyed for the player: every field and button below. -->
                                    <Grid x:Name="TypewriterFields" IsEnabled="{Binding CanEditVoice}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <!-- A column of its own, so the fields do not shift
                                                 sideways as buttons appear and go. -->
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                                  Content="{l:T characters.enableTypewriterVoice}" IsChecked="{Binding TypewriterEnabled}"
                                                  ToolTip="{l:T characters.enableTypewriterVoice.tip}"/>
                                        <!-- The whole voice, and REMOVED rather than set back to
                                             matching numbers: a typewriter holding the defaults is
                                             still written to the manifest, and the character would
                                             go on counting as changed for a voice identical to the
                                             one they already had. Also the only way back from
                                             having switched the voice off. -->
                                        <Button Grid.Row="0" Grid.Column="2" Content="{l:T characters.resetField2}" Padding="4,0"
                                                Margin="4,0,0,6" VerticalAlignment="Center"
                                                Command="{Binding ResetFieldCommand}" CommandParameter="Voice"
                                                IsEnabled="{Binding CanResetVoice}"
                                                Visibility="{Binding ShowsResets, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.resetField2.tip}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T characters.template}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                                  ItemsSource="{x:Static vm:CharacterViewModel.VoiceTemplates}"
                                                  SelectedItem="{Binding VoiceTemplate}"
                                                  ToolTip="{l:T characters.maleFreq45Pitch.tip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=voiceTemplate}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Row="2" Grid.Column="2" Content="{l:T characters.resetField}" Padding="4,0"
                                                Margin="4,0,0,4" VerticalAlignment="Center"
                                                Command="{Binding ResetFieldCommand}" CommandParameter="TypewriterFrequencyText"
                                                IsEnabled="{Binding CanResetFrequency}"
                                                Visibility="{Binding ShowsResets, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.resetField.tip3}"/>
                                        <Button Grid.Row="3" Grid.Column="2" Content="{l:T characters.resetField}" Padding="4,0"
                                                Margin="4,0,0,4" VerticalAlignment="Center"
                                                Command="{Binding ResetFieldCommand}" CommandParameter="TypewriterPitchMinText"
                                                IsEnabled="{Binding CanResetPitchMin}"
                                                Visibility="{Binding ShowsResets, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.resetField.tip4}"/>
                                        <Button Grid.Row="4" Grid.Column="2" Content="{l:T characters.resetField}" Padding="4,0"
                                                Margin="4,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding ResetFieldCommand}" CommandParameter="TypewriterPitchMaxText"
                                                IsEnabled="{Binding CanResetPitchMax}"
                                                Visibility="{Binding ShowsResets, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.resetField.tip5}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{l:T characters.frequency}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                                 Text="{Binding TypewriterFrequencyText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T characters.howOftenBlipFires.tip}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{l:T characters.pitchMin}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4"
                                                 Text="{Binding TypewriterPitchMinText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T characters.lowEndRandomPitch.tip}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{l:T characters.pitchMax}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                 Text="{Binding TypewriterPitchMaxText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T characters.highEndRandomPitch.tip}"/>
                                        <!-- The character&apos;s own numbers, not the editor&apos;s generic
                                             ones. GC2&apos;s typewriter is per character rather than per
                                             speech skin, so there is a real answer for each of the
                                             game&apos;s - and an author who changes the pitch should be
                                             changing something rather than discovering the field was
                                             never theirs. Still theirs to change. -->
                                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                                   Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                                   Text="{Binding GameVoiceSummary}"
                                                   Visibility="{Binding HasGameVoice, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Not for a voice: a face is picked for a bust, and a voice has none. -->
                            <GroupBox x:Name="SpeechExpressionsBox" Header="{l:T characters.speechExpressionsPerNode}"
                                      DataContext="{Binding DataContext.SelectedCharacter,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                      Visibility="{Binding HasBust, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="{l:T characters.addCharacterExpression}"
                                            Command="{Binding DataContext.AddCharacterExpressionCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="{l:T characters.whatDialogueNodeS}"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,6"
                                               TextWrapping="Wrap"
                                               Text="{l:T characters.addRowGiveCharacter}"/>
                                    <ItemsControl ItemsSource="{Binding Expressions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ActorExpressionViewModel}">
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding CanEdit}"
                                                             ToolTipService.ShowOnDisabled="True"
                                                             ToolTip="{Binding KeyToolTip}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding ExpressionGoName, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding CanEdit}"
                                                             ToolTip="{l:T characters.childNameUnderMbase1.tip}"/>
                                                    <!-- The game&apos;s own faces have no remove button rather than a
                                                         disabled one: there is nothing to remove. They are not in the
                                                         manifest at all - they are read from the shipped dataset each
                                                         time this panel is shown, so a pack that never touched this
                                                         character still writes nothing about them. -->
                                                    <Button Grid.Column="3" Content="−" Width="22" Margin="4,0,0,0"
                                                            Command="{Binding RemoveCommand}"
                                                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{l:T characters.remove.tip}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </GroupBox>

                            <!-- What a pack can do to somebody else's bust.
                                 One row per texture, and each row is a tick and a path.
                                 The tick is not a field: it IS whether the manifest carries
                                 an entry for that slot, so a slot nobody ticked is a slot
                                 the pack never mentions and the runtime leaves exactly as
                                 the game drew it. That is the whole promise of the feature,
                                 and a second boolean beside the path would be a second
                                 thing to keep in step with it.

                                 No Has Blink / Has Mouth / Has Expressions here on purpose:
                                 those say what a bust HAS, and this bust's answer is the
                                 game's rather than the pack's. -->
                            <GroupBox Header="{l:T characters.replaceTexturesBust}"
                                      Visibility="{Binding ShowOverridesPanel, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,6"
                                               TextWrapping="Wrap"
                                               Text="{l:T characters.tickOnlyWhatReplacing}"/>
                                    <ItemsControl ItemsSource="{Binding Overrides}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SpriteOverrideViewModel}">
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                                              Content="{Binding Label}"
                                                              IsChecked="{Binding Replaced}"
                                                              ToolTip="{l:T characters.tickReplaceTextureUnticked.tip}"/>
                                                    <!-- The mask row gets the painter, the way a pack
                                                         outfit's does. It is the one texture here that
                                                         nobody authors by hand: three intensity planes
                                                         in R/G/B, which is what the painter is for.
                                                         Every other row is a PNG somebody drew, so the
                                                         button is only on this one. -->
                                                    <DockPanel Grid.Column="1">
                                                        <Button DockPanel.Dock="Right" Content="{l:T characters.editOverrideMask}"
                                                                Margin="4,0,0,0" Padding="6,0"
                                                                IsEnabled="{Binding Replaced}"
                                                                Visibility="{Binding IsMask, Converter={StaticResource BoolToVisibility}}"
                                                                Click="EditOverrideMask_Click"/>
                                                        <ctl:PathPickerBox
                                                                       PathText="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                                       IsEnabled="{Binding Replaced}"
                                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       ToolTip="{l:T characters.256x256RGBAPNGRelative.tip}"/>
                                                    </DockPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:outfitSprites" Header="{l:T characters.outfitSprites}"
                                      Visibility="{Binding ShowsPackArt, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T characters.base}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox view:IssueTarget.Field="baseSprite" ToolTip="{l:T characters.baseSprite.tip}"
                                                       view:TutorialAnchor.Id="field:baseSprite"
                                                       PathText="{Binding BaseSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T characters.mask}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="1" Grid.Column="1">
                                        <Button view:TutorialAnchor.Id="btn:editMask" DockPanel.Dock="Right" Content="{l:T characters.editOverrideMask}"
                                                Margin="4,0,0,0" Padding="6,0"
                                                Click="EditMask_Click"/>
                                        <!-- Same FILE as the default outfit, not a copy of it, which
                                             is why this one asks first: the painter writes to the
                                             file, so editing either outfit's mask afterwards edits
                                             both. -->
                                        <Button x:Name="MaskSameAsDefaultButton" DockPanel.Dock="Right" Content="{l:T characters.useDefaultMask}"
                                                FontSize="10" Padding="5,0" Margin="4,0,0,0"
                                                Command="{Binding DataContext.UseDefaultMaskCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanUseDefaultParts,
                                                             Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.useDefaultMask.tip}"/>
                                        <ctl:PathPickerBox view:IssueTarget.Field="maskSprite" ToolTip="{l:T characters.whereJiggleAppliesHow.tip}"
                                                           PathText="{Binding MaskSprite, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </DockPanel>
                                    <CheckBox view:TutorialAnchor.Id="field:hasBlink" Content="{l:T characters.hasBlink}"
                                              IsChecked="{Binding BlinkEnabled}" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                              ToolTip="{l:T characters.hasBlink.tip}"/>
                                    <TextBlock Text="{l:T characters.blink}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="3" Grid.Column="1">
                                        <Button x:Name="BlinkSameAsDefaultButton" DockPanel.Dock="Right" Content="{l:T characters.useDefaultMask}"
                                                FontSize="10" Padding="5,0" Margin="4,0,0,0"
                                                Command="{Binding DataContext.UseDefaultBlinkCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanUseDefaultParts,
                                                             Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.useDefaultMask.tip2}"/>
                                        <ctl:PathPickerBox view:IssueTarget.Field="blinkSprite" ToolTip="{l:T characters.eyesClosedOverlayUsed.tip}"
                                                           PathText="{Binding BlinkSprite, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           IsEnabled="{Binding BlinkEnabled}"/>
                                    </DockPanel>
                                    <CheckBox view:TutorialAnchor.Id="field:hasMouth" Content="{l:T characters.hasMouth}" IsChecked="{Binding MouthEnabled}" ToolTip="{l:T characters.hasMouth.tip}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"/>
                                    <!-- Both prefix fields hold a PATH, not just a filename fragment, and
                                         that was the thing people got wrong: the grey line under each one
                                         used to describe a naming rule without ever saying where the file
                                         was looked for. The trailing hint now shows the whole thing as one
                                         line — what you typed, then what the game adds. -->
                                    <TextBlock Text="{l:T characters.mouthPrefix}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="5" Grid.Column="1">
                                        <Button x:Name="MouthSameAsDefaultButton" DockPanel.Dock="Right" Content="{l:T characters.useDefaultMask}"
                                                FontSize="10" Padding="5,0" Margin="4,0,0,0"
                                                Command="{Binding DataContext.UseDefaultMouthPrefixCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanUseDefaultParts,
                                                             Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.useDefaultMask.tip3}"/>
                                        <ctl:SuffixHintBox view:IssueTarget.Field="mouth"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Text="{Binding MouthPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                           Suffix="1.png/2.png/3.png/4.png"
                                                           IsEnabled="{Binding MouthEnabled}"
                                                           ToolTip="{l:T characters.pathFilenameStartFour.tip}"/>
                                    </DockPanel>
                                    <TextBlock Text="{l:T characters.pathPackRootWithout}"
                                               Grid.Row="6" Grid.Column="1" Foreground="Gray" FontSize="10"/>

                                    <!-- Expressions used to be a box of their own. They are the same kind
                                         of thing as everything above — art for this outfit, named by a
                                         prefix — and a whole panel for one tickbox and one field put them
                                         further from the sprites they belong with. The anchor id stays on
                                         the rows so tutorials still point at exactly these. -->
                                    <Grid view:TutorialAnchor.Id="panel:outfitExpressions" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox view:TutorialAnchor.Id="field:hasExpressions" Content="{l:T characters.hasExpressions}" IsChecked="{Binding ExpressionEnabled}" ToolTip="{l:T characters.hasExpressions.tip}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0"/>
                                        <TextBlock Text="{l:T characters.exprPrefix}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <DockPanel Grid.Row="1" Grid.Column="1">
                                            <Button x:Name="ExpressionSameAsDefaultButton" DockPanel.Dock="Right" Content="{l:T characters.useDefaultMask}"
                                                FontSize="10" Padding="5,0" Margin="4,0,0,0"
                                                Command="{Binding DataContext.UseDefaultExpressionPrefixCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanUseDefaultParts,
                                                             Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T characters.useDefaultMask.tip4}"/>
                                            <ctl:SuffixHintBox view:IssueTarget.Field="expression"
                                                               PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Text="{Binding ExpressionPrefix, UpdateSourceTrigger=PropertyChanged}"
                                                               Suffix="{Binding ExpressionFilesHint}"
                                                               IsEnabled="{Binding ExpressionEnabled}"
                                                               ToolTip="{l:T characters.pathFilenameStartBust.tip}"/>
                                        </DockPanel>
                                        <TextBlock Text="{l:T characters.pathPackRootWithout2}"
                                                   Grid.Row="2" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T characters.jiggleMaskDrivenShader}"
                                      Visibility="{Binding ShowsPackArt, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <!-- Per-row Default. These numbers are judged by eye against a
                                             preview, so getting back to a known starting point matters more
                                             here than in a field with a right answer. -->
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T characters.speed}"        Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T characters.speed.tip}"/>
                                    <Slider ToolTip="{l:T characters.speed.tip}" Value="{Binding JiggleSpeed}"    Minimum="0" Maximum="10" Grid.Row="0" Grid.Column="1"/>
                                    <TextBox ToolTip="{l:T characters.speed.tip}" Text="{Binding JiggleSpeed, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="2"/>
                                    <TextBlock Text="{l:T characters.strength}"     Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T characters.strength.tip}"/>
                                    <Slider ToolTip="{l:T characters.strength.tip}" view:TutorialAnchor.Id="field:jiggle" view:IssueTarget.Field="jiggle.strength" Value="{Binding JiggleStrength}" Minimum="-0.5" Maximum="0.5" Grid.Row="1" Grid.Column="1"/>
                                    <TextBox ToolTip="{l:T characters.strength.tip}" Text="{Binding JiggleStrength, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="2"/>
                                    <TextBlock Text="{l:T characters.waveFrequency}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T characters.waveFrequency.tip}"/>
                                    <Slider ToolTip="{l:T characters.waveFrequency.tip}" Value="{Binding JiggleFrequency}" Minimum="0" Maximum="40" Grid.Row="2" Grid.Column="1"/>
                                    <TextBox ToolTip="{l:T characters.waveFrequency.tip}" Text="{Binding JiggleFrequency, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="2"/>
                                    <TextBlock Text="{l:T characters.noiseScale}"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T characters.noiseScale.tip}"/>
                                    <Slider ToolTip="{l:T characters.noiseScale.tip}" Value="{Binding NoiseScale}" Minimum="0" Maximum="80" Grid.Row="3" Grid.Column="1"/>
                                    <TextBox ToolTip="{l:T characters.noiseScale.tip}" Text="{Binding NoiseScale, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="2"/>
                                    <TextBlock Text="{l:T characters.noiseSpeed}"  Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T characters.noiseSpeed.tip}"/>
                                    <Slider ToolTip="{l:T characters.noiseSpeed.tip}" Value="{Binding NoiseSpeed}" Minimum="0" Maximum="5" Grid.Row="4" Grid.Column="1"/>
                                    <TextBox ToolTip="{l:T characters.noiseSpeed.tip}" Text="{Binding NoiseSpeed, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="2"/>
                                    <TextBlock Text="{l:T characters.noiseStrength}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T characters.noiseStrength.tip}"/>
                                    <Slider ToolTip="{l:T characters.noiseStrength.tip}" view:IssueTarget.Field="jiggle.noiseStrength" Value="{Binding NoiseStrength}" Minimum="0" Maximum="0.5" Grid.Row="5" Grid.Column="1"/>
                                    <TextBox ToolTip="{l:T characters.noiseStrength.tip}" Text="{Binding NoiseStrength, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="2"/>
                                    <TextBlock Text="{l:T characters.tintHex}"   Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Tint, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" ToolTip="{l:T characters.multipliesBustSColour.tip}"/>
                                    <CheckBox Content="{l:T characters.pixelSnap}" IsChecked="{Binding PixelSnap}" ToolTip="{l:T characters.pixelSnap.tip}" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"/>
                                    <Button Grid.Row="0" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Speed"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                    <Button Grid.Row="1" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Strength"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                    <Button Grid.Row="2" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Frequency"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                    <Button Grid.Row="3" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseScale"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                    <Button Grid.Row="4" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseSpeed"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                    <Button Grid.Row="5" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseStrength"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                    <Button Grid.Row="6" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Tint"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                    <Button Grid.Row="7" Grid.Column="3" Content="{l:T characters.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="PixelSnap"
                                            ToolTip="{l:T characters.resetJiggle.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:outfitParticles" Header="{l:T characters.outfitParticles}"
                                      Visibility="{Binding ShowsPackArt, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <StackPanel>
                                    <CheckBox Content="{l:T characters.wetParticleActiveSpawn}"
                                              IsChecked="{Binding ParticleActive}"
                                              ToolTip="{l:T characters.wetParticleActiveSpawn.tip}"/>
                                    <TextBlock Text="{l:T characters.wetPresetAlwaysAttached}"
                                               Foreground="Gray" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: live preview + issues. No GridSplitter between
                         columns 2 and 3 — this panel is intentionally fixed
                         (see the columns block above for why). -->
                    <!-- Sized so nothing in it ever leaves the window: see
                         BustPreviewRoom_Changed and BustPreviewShownZoom. The
                         options do not fill what is left, so what they measure
                         is what they take. -->
                    <DockPanel x:Name="BustPreviewPane" view:TutorialAnchor.Id="panel:bustPreviewPane" Grid.Column="3" Margin="8"
                               LastChildFill="False" SizeChanged="BustPreviewRoom_Changed">
                        <TextBlock x:Name="BustPreviewHeader" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,4"
                                   Text="{Binding SelectedOutfit.ShowsPackArt,
                                          Converter={x:Static conv:PreviewHeaderConverter.Instance}}"/>
                        <Border x:Name="BustPreviewFrame" DockPanel.Dock="Top" Background="#222" Padding="4" ClipToBounds="True">
                            <!-- One preview for both kinds. A borrowed bust feeds
                                 the same control from the shipped vanilla art, so
                                 it sits in the same place and blinks, mouths and
                                 breathes the same way; only the jiggle is absent,
                                 since no mask is exported for those. -->
                            <ctl:JigglePreview x:Name="PreviewControl"
                                               view:TutorialAnchor.Id="panel:characterPreview"
                                               Margin="0,12,0,-20"
                                               Zoom="{Binding DataContext.BustPreviewShownZoom,
                                                      RelativeSource={RelativeSource AncestorType=Window},
                                                      Mode=OneWay}"
                                               VanillaBustKey="{Binding VanillaPreviewBustKey}"
                                               Outfit="{Binding SelectedOutfit}"
                                               PackRoot="{Binding PackRoot}"
                                               SelectedExpression="{Binding ElementName=ExpressionPicker, Path=SelectedValue, Mode=OneWay, TargetNullValue=''}"
                                               SelectedMouthFrame="{Binding ElementName=MouthPicker, Path=SelectedIndex, Mode=OneWay}"
                                               Blinking="{Binding ElementName=BlinkToggle, Path=IsChecked, Mode=OneWay}"
                                               Yapping="{Binding ElementName=YappingToggle, Path=IsChecked, Mode=OneWay}"
                                               Breathing="{Binding ElementName=BreathingToggle, Path=IsChecked, Mode=OneWay}"
                                               BreathingAmplitude="{Binding ElementName=BreathingDepth, Path=Value, Mode=OneWay}"/>
                        </Border>
                        <Grid x:Name="BustPreviewOptions" DockPanel.Dock="Top" Margin="0,8,0,0"
                              SizeChanged="BustPreviewRoom_Changed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <!-- Size, first, because it changes the whole panel:
                                     the column is bound to it, so the preview and the
                                     room around it grow together. -->
                                <TextBlock Text="{l:T characters.previewSize}"/>
                                <ComboBox ItemsSource="{Binding DataContext.BustPreviewZoomSteps,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DataContext.BustPreviewZoom,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Mode=TwoWay}"
                                          x:Name="BustPreviewSizePicker"
                                          Margin="0,0,0,6"
                                          ToolTip="{l:T characters.previewSize.tip}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}{0}×}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- Only when the window is too small for the size picked:
                                     the picker keeps saying what was chosen, and this says
                                     what is shown instead, and why. -->
                                <TextBlock x:Name="BustPreviewShrunkText" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,-4,0,6"
                                           Text="{Binding DataContext.BustPreviewShrunkNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Visibility="{Binding DataContext.BustPreviewShrunk, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{l:T characters.mouthFrame}"/>
                                <ComboBox x:Name="MouthPicker" SelectedIndex="0"
                                          ToolTip="{l:T characters.mouthPicker.tip}">
                                    <ComboBoxItem Content="{l:T characters.mouthClosed}"/>
                                    <ComboBoxItem>1</ComboBoxItem>
                                    <ComboBoxItem>2</ComboBoxItem>
                                    <ComboBoxItem>3</ComboBoxItem>
                                    <ComboBoxItem>4</ComboBoxItem>
                                </ComboBox>
                                <CheckBox ToolTip="{l:T characters.yappingToggle.tip}" x:Name="YappingToggle" Content="{l:T characters.yappingToggle}" Margin="2,6,0,0"/>
                                <CheckBox x:Name="BlinkToggle" Content="{l:T characters.blinkToggle}" IsChecked="True" Margin="2,6,0,0"/>
                                <CheckBox ToolTip="{l:T characters.breathingToggle.tip}" x:Name="BreathingToggle" Content="{l:T characters.breathingToggle}" IsChecked="True" Margin="2,6,0,0"/>
                                <!-- Depth is a preview-only calibration: in game the
                                     offset moves the busts' parent, so its on-screen
                                     size depends on scene scale the editor can't see. -->
                                <StackPanel Orientation="Horizontal" Margin="2,2,0,0"
                                            IsEnabled="{Binding ElementName=BreathingToggle, Path=IsChecked}">
                                    <TextBlock Text="{l:T characters.depth}" Foreground="Gray" FontSize="10" VerticalAlignment="Center"/>
                                    <Slider x:Name="BreathingDepth" Width="80" Margin="4,0,0,0"
                                            Minimum="0" Maximum="20" Value="4" VerticalAlignment="Center"
                                            ToolTip="{l:T characters.breathingDepth.tip}"/>
                                    <TextBlock Text="{Binding ElementName=BreathingDepth, Path=Value, StringFormat=F1}"
                                               Foreground="Gray" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <!-- Back to 4. A calibration slider is one an author
                                         moves to see what it does, and getting a fiddly
                                         value back by dragging is guesswork. -->
                                    <Button Content="↺" Click="ResetBreathingDepth_Click"
                                            Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                            FontSize="10" VerticalAlignment="Center"
                                            ToolTip="{l:T characters.resetBreathingDepth.tip}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{l:T characters.expression}"/>
                                <!-- The faces THIS bust has, published by the preview
                                     from the textures it actually loaded. It used to be
                                     five fixed entries here, which offered four faces on
                                     busts that have none and handed the preview the
                                     translated LABEL to look sprites up by - so every
                                     expression stopped working in any language but
                                     English. SelectedValue carries the game's name. -->
                                <ComboBox x:Name="ExpressionPicker"
                                          ItemsSource="{Binding ElementName=PreviewControl, Path=ExpressionChoices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Key"
                                          IsSynchronizedWithCurrentItem="True"
                                          ToolTip="{l:T characters.expressionPicker.tip}"/>
                            </StackPanel>
                        </Grid>

                        <!-- (The validation Issues list moved to the ModForge tab.) -->
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 ACTORS TAB
                 ════════════════════════════════════════════════════ -->

            <!-- ════════════════════════════════════════════════════
                 NPCS TAB
                 Level NPCs — posed character sprites that live in a
                 place's NPCs hierarchy. Structurally a slim bust
                 (jiggle sprite + Blink + Wet) plus a procedural shadow.
                 WHERE each appears is authored per-place (Places tab →
                 NPC placements); this tab is the reusable look.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T npcs.npcs}">
                <Grid>
                    <!-- Column 4 (the live-preview side panel) is fixed like the
                         Busts tab: no GridSplitter, width sized to the 600px
                         NpcPreview. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="620"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T npcs.npcs}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addNpc" Content="{l:T npcs.addNpc}" Command="{Binding AddNpcCommand}"/>
                            <Button Content="{l:T npcs.unitAddFolder}" Tag="{Binding NpcTree}" Click="UnitAddFolder_Click"
                                    ToolTip="{l:T npcs.unitAddFolder.tip}"/>
                            <Button Content="{l:T npcs.unitRenameFolder}" Tag="{Binding NpcTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="{l:T npcs.unitRenameFolder.tip}"/>
                            <Button Content="{l:T npcs.removeNpc}" Command="{Binding RemoveNpcCommand}"
                                    ToolTip="{l:T npcs.removeNpc.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding NpcTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="NpcTreeView"
                                 ItemsSource="{Binding NpcTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="{l:T npcs.npcTreeView.tip}"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:npcDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedNpc}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <GroupBox Header="{l:T npcs.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T npcs.displayName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="{l:T npcs.whatCalledEditorS.tip}"  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T npcs.runtimeName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T npcs.runtimeName.tip}"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T npcs.namePackItselfUses.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T npcs.spriteMaskRelativePack}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T npcs.poseSprite}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding Sprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"
                                                       ToolTip="{l:T npcs.posePNGAnyResolution.tip}"/>
                                    <TextBlock Text="{l:T npcs.jiggleMask}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="1" Grid.Column="1">
                                        <Button view:TutorialAnchor.Id="btn:editMaskNpc" DockPanel.Dock="Right" Content="{l:T npcs.editNpcMask}"
                                                Margin="4,0,0,0" Padding="6,0"
                                                Click="EditNpcMask_Click"
                                                ToolTip="{l:T npcs.editNpcMask.tip}"/>
                                        <ctl:PathPickerBox PathText="{Binding Mask, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           ToolTip="{l:T npcs.rBounceGWave.tip}"/>
                                    </DockPanel>
                                    <TextBlock Text="{l:T npcs.defaultSortingOrder}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                        <TextBox Width="55" Text="{Binding SortingOrder, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T npcs.referenceNpcsSit1.tip}"/>
                                        <TextBlock Foreground="Gray" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{l:T npcs.startingPointOnlySet}"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T npcs.jiggleSharedBustShader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T npcs.speed}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T npcs.speed.tip}"/>
                                    <TextBox ToolTip="{l:T npcs.speed.tip}" Text="{Binding JiggleSpeed, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T npcs.strength}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T npcs.strength.tip}"/>
                                    <TextBox ToolTip="{l:T npcs.strength.tip}" Text="{Binding JiggleStrength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="{l:T npcs.waveFrequency}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T npcs.waveFrequency.tip}"/>
                                    <TextBox ToolTip="{l:T npcs.waveFrequency.tip}" Text="{Binding JiggleFrequency, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
                                    <TextBlock Text="{l:T npcs.noiseScale}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T npcs.noiseScale.tip}"/>
                                    <TextBox ToolTip="{l:T npcs.noiseScale.tip}" Text="{Binding NoiseScale, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"/>
                                    <TextBlock Text="{l:T npcs.noiseSpeed}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T npcs.noiseSpeed.tip}"/>
                                    <TextBox ToolTip="{l:T npcs.noiseSpeed.tip}" Text="{Binding NoiseSpeed, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1"/>
                                    <TextBlock Text="{l:T npcs.noiseStrength}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" ToolTip="{l:T npcs.noiseStrength.tip}"/>
                                    <TextBox ToolTip="{l:T npcs.noiseStrength.tip}" Text="{Binding NoiseStrength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="5" Grid.Column="1"/>
                                    <TextBlock Text="{l:T npcs.tintHexRGBA}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding JiggleTint, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T npcs.multipliesPoseSColour.tip}" Grid.Row="6" Grid.Column="1"/>
                                    <CheckBox Content="{l:T npcs.pixelSnap}" IsChecked="{Binding PixelSnap}" ToolTip="{l:T npcs.pixelSnap.tip}" Grid.Row="7" Grid.Column="1" Margin="0,4,0,0"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Speed"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                    <Button Grid.Row="1" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Strength"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                    <Button Grid.Row="2" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Frequency"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                    <Button Grid.Row="3" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseScale"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                    <Button Grid.Row="4" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseSpeed"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                    <Button Grid.Row="5" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="NoiseStrength"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                    <Button Grid.Row="6" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="Tint"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                    <Button Grid.Row="7" Grid.Column="2" Content="{l:T npcs.resetJiggle}" Padding="6,0" Margin="4,0,0,0" MinWidth="56"
                                            Command="{Binding ResetJiggleCommand}" CommandParameter="PixelSnap"
                                            ToolTip="{l:T npcs.resetJiggle.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:npcBlink" Header="{l:T npcs.npcBlink}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T npcs.blinkSprite}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding BlinkSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"
                                                       ToolTip="{l:T npcs.eyesClosedPNGBlank.tip}"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Foreground="Gray" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,2,0,2"
                                               Text="{l:T npcs.offsetRotationScalePer}"/>
                                    <TextBlock Text="{l:T npcs.openWaitMinMax}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
                                        <TextBox Text="{Binding BlinkMinWait, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T npcs.shortestTimeEyesStay.tip}" Width="70"/>
                                        <TextBox Text="{Binding BlinkMaxWait, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T npcs.longestTimeEyesStay.tip}" Width="70" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{l:T npcs.closedHold}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding BlinkHold, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T npcs.howLongBlinkLasts.tip}" Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:npcReflection" Header="{l:T npcs.npcReflection}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T npcs.drawsPoseAgainFlipped}"/>
                                    <CheckBox Content="{l:T npcs.enabled}" IsChecked="{Binding ReflectionEnabled}" ToolTip="{l:T npcs.enabled.tip}" Margin="0,0,0,4"/>
                                    <Grid Visibility="{Binding ReflectionEnabled, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T npcs.alpha}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionAlpha, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T npcs.01VanillaReflections.tip}"/>
                                        <TextBlock Text="{l:T npcs.tint}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionTint, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T npcs.hexColourDefaultsMuted.tip}"/>
                                        <TextBlock Text="{l:T npcs.yOffset}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionOffsetY, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T npcs.worldUnitsPoseS.tip}"/>
                                        <TextBlock Text="{l:T npcs.sortingOrder}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                 Text="{Binding ReflectionSortingOrder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T npcs.howFarForwardReflection.tip}"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="field:npcShadow" Header="{l:T npcs.npcShadow}">
                                <StackPanel>
                                    <CheckBox Content="{l:T npcs.enabled}" IsChecked="{Binding ShadowEnabled}" ToolTip="{l:T npcs.enabled.tip2}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Foreground="Gray" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Text="{l:T npcs.offsetRotationSquashPer}"/>
                                        <TextBlock Text="{l:T npcs.colourHexRGBA}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ShadowColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T npcs.shadowSShadeHex.tip}" Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Text="{l:T npcs.sortingOrder}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ShadowSortingOrder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T npcs.howFarForwardShadow.tip}" Grid.Row="2" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:npcWet" Header="{l:T npcs.npcWet}">
                                <StackPanel>
                                    <CheckBox Content="{l:T npcs.enabled}" IsChecked="{Binding WetEnabled}" ToolTip="{l:T npcs.enabled.tip3}" Margin="0,0,0,4"/>
                                    <CheckBox Content="{l:T npcs.startActive}" IsChecked="{Binding WetStartActive}" ToolTip="{l:T npcs.startActive.tip}" Margin="0,0,0,4"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                               Text="{l:T npcs.emitterOffsetRotationScale}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- RIGHT: live preview. Fixed column (no splitter), same as
                         the Busts tab — sized to the 600px NpcPreview. -->
                    <DockPanel Grid.Column="3" Margin="8" DataContext="{Binding SelectedNpc}"
                    Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T npcs.previewLiveJiggleShadow}"
                                   FontWeight="Bold" Margin="0,0,0,4"/>
                        <Border DockPanel.Dock="Top" Background="#222" Padding="4" ClipToBounds="True"
                                VerticalAlignment="Top" HorizontalAlignment="Left">
                            <ctl:NpcPreview Npc="{Binding}"
                                            PackRoot="{Binding DataContext.PackRoot,
                                                       RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Border>
                        <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Text="{l:T npcs.bodyJiggleShadowBlink}"/>
                        <Grid/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 PLACES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T places.places}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: places list + vanilla extensions list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Your places -->
                        <DockPanel view:TutorialAnchor.Id="panel:placeList" Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Text="{l:T places.places2}"
                                       FontWeight="Bold" Margin="6,4,0,2"/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button view:TutorialAnchor.Id="btn:addPlace" Content="{l:T places.addPlace}" Command="{Binding AddPlaceCommand}"/>
                                <Button Content="{l:T places.unitAddFolder}" Tag="{Binding PlaceTree}" Click="UnitAddFolder_Click"
                                        ToolTip="{l:T places.unitAddFolder.tip}"/>
                                <Button Content="{l:T places.unitRenameFolder}" Tag="{Binding PlaceTree}" Click="UnitRenameFolder_Click"
                                        ToolTip="{l:T places.unitRenameFolder.tip}"/>
                                <Button Content="{l:T places.removePlace}" Command="{Binding RemovePlaceCommand}"
                                        ToolTip="{l:T places.removePlace.tip}"/>
                            </ToolBar>
                            <ContentControl DockPanel.Dock="Top" Focusable="False"
                                            DataContext="{Binding PlaceTree.Filter}"
                                            Template="{StaticResource SidebarSearchTemplate}"/>
                            <TreeView x:Name="PlaceTreeView"
                                 ItemsSource="{Binding PlaceTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="{l:T places.placeTreeView.tip}"/>
                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="4" Background="LightGray"
                                      HorizontalAlignment="Stretch"/>

                        <!-- Vanilla extensions: buttons added to vanilla nav strips -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="{l:T places.vanillaExtensions}"
                                       FontWeight="Bold" Margin="6,4,0,2"
                                       ToolTip="{l:T places.vanillaExtensions.tip}"/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button view:TutorialAnchor.Id="btn:addVanillaSource" Content="{l:T places.addVanillaExtension}" Command="{Binding AddVanillaExtensionCommand}"
                                        ToolTip="{l:T places.addVanillaExtension.tip}"/>
                                <Button Content="{l:T places.removePlace}" Command="{Binding RemoveVanillaExtensionCommand}"/>
                            </ToolBar>
                            <ListBox x:Name="VanillaExtList"
                                     ItemsSource="{Binding VanillaExtensions}"
                                     SelectedItem="{Binding SelectedVanillaExtension}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:VanillaPlaceExtensionViewModel}">
                                        <DockPanel>
                                            <!-- Two markers, because adding to a level and reaching
                                                 into the level's own objects are different degrees
                                                 of intrusion. The editor fills every extension's
                                                 tree in from the catalog so it can be edited, and
                                                 those mirror nodes save as nothing — neither chip
                                                 counts them.
                                                 ~N (accent) = vanilla objects this changes.
                                                 +N (muted)  = GameObjects it adds. -->
                                            <Border DockPanel.Dock="Right" Margin="4,0,0,0" Padding="4,0"
                                                    CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource Theme.Accent}"
                                                    Visibility="{Binding HasModified, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="{Binding ModifiedCount, Converter={x:Static l:PluralConverter.Instance}, ConverterParameter=places.gameObjectsChanged}">
                                                <TextBlock Text="{Binding ModifiedCount, StringFormat='~{0}'}" FontSize="10"/>
                                            </Border>
                                            <Border DockPanel.Dock="Right" Margin="4,0,0,0" Padding="4,0"
                                                    CornerRadius="2" VerticalAlignment="Center"
                                                    Background="#55808080"
                                                    Visibility="{Binding HasAdded, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="{Binding AddedCount, Converter={x:Static l:PluralConverter.Instance}, ConverterParameter=places.gameObjectsAdded}">
                                                <TextBlock Text="{Binding AddedCount, StringFormat='+{0}'}" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: editor pane — switches between Place editor and Vanilla-extension editor based on selection -->
                    <Grid Grid.Column="2">
                        <!-- Vanilla extension editor (shown when SelectedVanillaExtension is non-null) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedVanillaExtension}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                            <StackPanel Margin="8">
                                <!-- Preview of the vanilla level itself, from the extracted
                                     art. Bound nodes carry no sprite, so what renders is the
                                     level plus whatever this extension actually adds. -->
                                <GroupBox Header="{l:T places.preview}">
                                    <StackPanel>
                                        <ctl:PlacePreview x:Name="ExtPreview" Margin="200,0"
                                                          PackRoot="{Binding DataContext.PackRoot,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                          BaseSprite="{Binding PreviewBaseSprite}"
                                                          SecondarySprite="{Binding PreviewSecondarySprite}"
                                                          LevelArtOrder="{Binding PreviewArtOrder}"
                                                          LevelArtSecondaryOrder="{Binding PreviewArtSecondaryOrder}"
                                                          LevelParallax="{Binding PreviewLevelParallax}"
                                                          LevelParallaxSecondary="{Binding PreviewLevelParallaxSecondary}"
                                                          LevelParallaxReversed="{Binding PreviewLevelParallaxReversed}"
                                                          LevelParallaxSecondaryReversed="{Binding PreviewLevelParallaxSecondaryReversed}"
                                                          ParallaxPreview="{Binding IsChecked, ElementName=ExtParallaxPreview}"
                                                          Shaders="{Binding IsChecked, ElementName=ExtShaders}"
                                                          LevelArtPpu="{Binding PreviewArtPpu}"
                                                          LevelScale="{Binding PreviewLevelScale}"
                                                          DimUnderInactiveParent="{Binding IsChecked, ElementName=ExtDimParent}"
                                                          DimInactive="{Binding IsChecked, ElementName=ExtDimSelf}"
                                                          GameObjects="{Binding GameObjects}"
                                                          NpcCatalog="{Binding DataContext.Npcs,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <CheckBox x:Name="ExtDimParent" IsChecked="True" Content="{l:T places.extDimParent}"
                                                      ToolTip="{l:T places.extDimParent.tip}"/>
                                            <CheckBox x:Name="ExtDimSelf" IsChecked="True" Content="{l:T places.extDimSelf}" Margin="12,0,0,0"
                                                      ToolTip="{l:T places.extDimSelf.tip}"/>
                                            <CheckBox x:Name="ExtParallaxPreview" IsChecked="False" Content="{l:T places.extParallaxPreview}" Margin="12,0,0,0"
                                                      ToolTip="{l:T places.extParallaxPreview.tip}"/>
                                            <CheckBox x:Name="ExtShaders" IsChecked="False" Content="{l:T places.extShaders}" Margin="12,0,0,0"
                                                      ToolTip="{l:T places.extShaders.tip}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CatalogSummary}" Foreground="Gray"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox view:TutorialAnchor.Id="panel:vanillaSource" Header="{l:T places.vanillaSource}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T places.sourcePlace}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox ToolTip="{l:T places.whichGameSOwn.tip}" Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.VanillaSourceOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Token"
                                                  SelectedValue="{Binding Source, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Text="{l:T places.buttonsBelowWillAppear}"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox view:TutorialAnchor.Id="panel:extNavigatorButtons" Header="{l:T places.extNavigatorButtons}">
                                    <DockPanel>
                                        <Button view:TutorialAnchor.Id="btn:addExtNavigatorButton" DockPanel.Dock="Bottom" Content="{l:T places.addVanillaExtensionButton}"
                                                Command="{Binding DataContext.AddVanillaExtensionButtonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                        <ItemsControl ItemsSource="{Binding NavigatorButtons}"
                                                      ItemTemplate="{StaticResource NavigatorButtonRowTemplate}"/>
                                    </DockPanel>
                                </GroupBox>

                                <GroupBox Header="{l:T places.gameobjectsLayeredVanillaPlace}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="{l:T places.addVanillaExtensionGameObject}"
                                                    Command="{Binding DataContext.AddVanillaExtensionGameObjectCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Padding="8,2"/>
                                            <Button Content="{l:T places.addNpc}" Margin="6,0,0,0" Padding="8,2"
                                                    Command="{Binding AddNpcCommand}"
                                                    ToolTip="{l:T places.addNpc.tip}"/>
                                            <Button Content="{l:T places.seedFromCatalog}" Margin="6,0,0,0" Padding="8,2"
                                                    Command="{Binding SeedFromCatalogCommand}"
                                                    ToolTip="{l:T places.seedFromCatalog.tip}"/>
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="{l:T places.gameobjectsInstantiatedUnderVanilla}"/>
                                        <ItemsControl ItemsSource="{Binding GameObjects}"/>
                                    </DockPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Place editor (shown when SelectedPlace is non-null) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      DataContext="{Binding SelectedPlace}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── composites secondary + base sprites with GameplayUI overlay
                                 and the live navigator buttons, same z-order as runtime. -->
                            <GroupBox view:TutorialAnchor.Id="panel:placePreview" Header="{l:T places.preview}">
                                <StackPanel>
                                    <ctl:PlacePreview x:Name="PlacePreviewMain" Margin="200,0"
                                                      PackRoot="{Binding DataContext.PackRoot,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                      BaseSprite="{Binding BaseSprite}"
                                                      SecondarySprite="{Binding SecondarySprite}"
                                                      MaskSprite="{Binding MaskSprite}"
                                                      SecondaryMaskSprite="{Binding SecondaryMaskSprite}"
                                                      LiveMaskBgra="{Binding LiveBaseMask}"
                                                      LiveSecondaryMaskBgra="{Binding LiveSecondaryMask}"
                                                      Buttons="{Binding NavigatorButtons}"
                                                      DimUnderInactiveParent="{Binding IsChecked, ElementName=PlaceDimParent}"
                                                      DimInactive="{Binding IsChecked, ElementName=PlaceDimSelf}"
                                                      GameObjects="{Binding GameObjects}"
                                                      LevelArtOrder="{Binding BaseSortingOrder}"
                                                      LevelArtSecondaryOrder="{Binding SecondarySortingOrder}"
                                                      LevelParallax="{Binding ParallaxStrength}"
                                                      LevelParallaxSecondary="{Binding ParallaxSecondaryStrength}"
                                                      LevelParallaxReversed="{Binding ParallaxReversed}"
                                                      LevelParallaxSecondaryReversed="{Binding ParallaxSecondaryReversed}"
                                                      ParallaxPreview="{Binding IsChecked, ElementName=PlaceParallaxPreview}"
                                                      Shaders="{Binding IsChecked, ElementName=PlaceShaders}"
                                                      NpcCatalog="{Binding DataContext.Npcs,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox x:Name="PlaceDimParent" IsChecked="True" Content="{l:T places.extDimParent}"
                                                  ToolTip="{l:T places.extDimParent.tip}"/>
                                        <CheckBox x:Name="PlaceDimSelf" IsChecked="True" Content="{l:T places.extDimSelf}" Margin="12,0,0,0"
                                                  ToolTip="{l:T places.extDimSelf.tip}"/>
                                        <CheckBox x:Name="PlaceParallaxPreview" IsChecked="False" Content="{l:T places.extParallaxPreview}" Margin="12,0,0,0"
                                                  ToolTip="{l:T places.extParallaxPreview.tip2}"/>
                                        <CheckBox x:Name="PlaceShaders" IsChecked="False" Content="{l:T places.extShaders}" Margin="12,0,0,0"
                                                  ToolTip="{l:T places.extShaders.tip2}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T places.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T places.displayNameButton}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="{l:T places.whatCalledEditorS.tip}"  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T places.usedGameMapButton}"
                                               Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10"/>
                                    <TextBlock Text="{l:T places.runtimeName}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T places.runtimeName.tip}"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T places.namePackItselfUses.tip}"/>
                                    <TextBlock Text="{l:T places.internalGOName}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  view:IssueTarget.Field="internalName" Text="{Binding InternalName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T places.objectLevelBuiltGame.tip}" Grid.Row="3" Grid.Column="1"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T places.levelArtPathsRelative}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- The editor names these two layers BACK and FRONT, by where they
                                         draw. The manifest calls them baseSprite and secondarySprite,
                                         which is the game's own naming and is the source of the confusion
                                         this replaced: baseSprite is the layer IN FRONT (-10), with
                                         secondarySprite behind it (-12), so "base" means the opposite of
                                         what anyone expects a base to be.
                                    
                                         Back/front cannot be read backwards, so the editor says that and
                                         the format is left alone. Nothing here is rebound — each row still
                                         points at the property it always did. Every tooltip names the key
                                         it writes, so the mapping is never something to infer. Listed back
                                         to front, with each mask under the sprite it belongs to. -->
                                    <TextBlock Text="{l:T places.backSprite20481136}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T places.backSprite20481136.tip}"/>
                                    <ctl:PathPickerBox ToolTip="{l:T places.backSprite20481136.tip}" view:TutorialAnchor.Id="field:placeSecondarySprite" view:IssueTarget.Field="secondarySprite"
                                                       PathText="{Binding SecondarySprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T places.frontSprite20481136}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T places.frontSprite20481136.tip}"/>
                                    <ctl:PathPickerBox ToolTip="{l:T places.frontSprite20481136.tip}" view:TutorialAnchor.Id="field:placeBaseSprite" view:IssueTarget.Field="baseSprite"
                                                       PathText="{Binding BaseSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Text="{l:T places.sortingOrder}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{l:T places.back}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding SecondarySortingOrder, UpdateSourceTrigger=PropertyChanged}" Width="55"
                                                 ToolTip="{l:T places.sortingOrderBackSprite.tip}"/>
                                        <TextBlock Text="{l:T places.front}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        <TextBox Text="{Binding BaseSortingOrder, UpdateSourceTrigger=PropertyChanged}" Width="55"
                                                 ToolTip="{l:T places.spriterendererSortingOrderFront.tip}"/>
                                    </StackPanel>
                                    <TextBlock Text="{l:T places.everySpriteGameShares}"
                                               Grid.Row="6" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <!-- Each mask names the sprite it belongs to, in the same
                                         order as the two sprite rows above, so the four read as
                                         pairs: "Back mask" edits secondaryMaskSprite. -->
                                    <TextBlock Text="{l:T places.backMaskOpt}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding SecondaryMaskSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="2" Grid.Column="1"
                                                       ToolTip="{l:T places.optionalBoundMasktexBACK.tip}"/>
                                    <Button Content="{l:T places.editPlaceSecondaryMask}" Grid.Row="2" Grid.Column="2" Margin="4,0,0,0" Padding="8,0"
                                            Click="EditPlaceSecondaryMask_Click"
                                            ToolTip="{l:T places.editPlaceSecondaryMask.tip}"/>
                                    <TextBlock Text="{l:T places.frontMask256143}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox view:IssueTarget.Field="maskSprite"
                                                       PathText="{Binding MaskSprite, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Grid.Row="3" Grid.Column="1"
                                                       ToolTip="{l:T places.boundMasktexFRONTSprite.tip}"/>
                                    <Button Content="{l:T places.editPlaceSecondaryMask}" Grid.Row="3" Grid.Column="2" Margin="4,0,0,0" Padding="8,0"
                                            Click="EditPlaceMask_Click"
                                            ToolTip="{l:T places.editPlaceSecondaryMask.tip2}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                               Text="{l:T places.modClonesBeachLevel}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T places.behaviour}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T places.parallaxFront}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Slider view:IssueTarget.Field="parallaxStrength" Value="{Binding ParallaxStrength}" Minimum="0" Maximum="1.5" Grid.Row="0" Grid.Column="1"
                                            ToolTip="{l:T places.howFarFrontSprite.tip}"/>
                                    <TextBox Text="{Binding ParallaxStrength, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="2" ToolTip="{l:T places.howFarFrontLayer.tip}"/>
                                    <TextBlock Text="{l:T places.parallaxBack}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <StackPanel view:TutorialAnchor.Id="field:parallax" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Content="{l:T places.sameFront}" IsChecked="{Binding ParallaxSecondaryLinked}" VerticalAlignment="Center"
                                                  ToolTip="{l:T places.sameFront.tip}"/>
                                        <Slider view:IssueTarget.Field="parallaxSecondaryStrength" Value="{Binding ParallaxSecondaryStrength}" Minimum="0" Maximum="1.5"
                                                Width="150" VerticalAlignment="Center" Margin="10,0,0,0"
                                                IsEnabled="{Binding ParallaxSecondaryLinked, Converter={StaticResource InverseBoolConverter}}"
                                                ToolTip="{l:T places.backSpriteWhatCreates.tip}"/>
                                        <TextBox Text="{Binding ParallaxSecondaryStrength, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T places.backLayerSOwn.tip}"
                                                 Width="60" VerticalAlignment="Center" Margin="6,0,0,0"
                                                 IsEnabled="{Binding ParallaxSecondaryLinked, Converter={StaticResource InverseBoolConverter}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox Content="{l:T places.reverseBack}" IsChecked="{Binding ParallaxReversed}"
                                                  ToolTip="{l:T places.reverseBack.tip}"/>
                                        <CheckBox Content="{l:T places.reverseFront}" IsChecked="{Binding ParallaxSecondaryReversed}" Margin="12,0,0,0"
                                                  ToolTip="{l:T places.reverseFront.tip}"/>
                                    </StackPanel>
                                    <TextBlock Text="{l:T places.equalValuesSlideLevel}"
                                               Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Foreground="Gray" FontSize="10" Margin="0,2,0,0"/>
                                    <CheckBox Content="{l:T places.keepBeachAudioOcean}"
                                              IsChecked="{Binding KeepAudio}" ToolTip="{l:T places.keepBeachAudioOcean.tip}"
                                              Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,6,0,0"/>
                                    <CheckBox Content="{l:T places.keepSeagullsParticleSystem}"
                                              IsChecked="{Binding KeepSeagulls}" ToolTip="{l:T places.keepSeagullsParticleSystem.tip}"
                                              Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0"/>
                                    <TextBlock Text="{l:T places.weather}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,6,0,0"/>
                                    <ComboBox SelectedItem="{Binding WeatherType}" ToolTip="{l:T places.whetherGameSRain.tip}"
                                              Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static l:EnumTextConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemsSource>
                                            <x:Array Type="{x:Type model:WeatherType}">
                                                <model:WeatherType>None</model:WeatherType>
                                                <model:WeatherType>Inside</model:WeatherType>
                                                <model:WeatherType>Outside</model:WeatherType>
                                            </x:Array>
                                        </ComboBox.ItemsSource>
                                    </ComboBox>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:navigatorButtons" Header="{l:T places.navigatorButtons}">
                                <DockPanel>
                                    <DockPanel.Resources>
                                        <Style TargetType="TextBlock" x:Key="ColHeader">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                        </Style>
                                    </DockPanel.Resources>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button view:TutorialAnchor.Id="btn:addNavigatorButton" Content="{l:T places.addVanillaExtensionButton}"
                                                Command="{Binding DataContext.AddNavigatorButtonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,2"/>
                                        <TextBlock Text="{Binding NavigatorButtonCountLabel}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray"
                                                   ToolTip="{l:T places.maximum12NavigatorButtons.tip}"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{l:T places.up12ButtonsPer}"/>
                                    <ItemsControl ItemsSource="{Binding NavigatorButtons}"
                                                  ItemTemplate="{StaticResource NavigatorButtonRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:placeGameObjects" Header="{l:T places.placeGameObjects}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{l:T places.addVanillaExtensionGameObject}"
                                                Command="{Binding DataContext.AddGameObjectCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="8,2"/>
                                        <Button view:TutorialAnchor.Id="btn:addNpcToPlace" Content="{l:T places.addNpc}" Margin="6,0,0,0" Padding="8,2"
                                                Command="{Binding AddNpcCommand}"
                                                ToolTip="{l:T places.addNpc.tip2}"/>
                                    </StackPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" FontSize="10"
                                               Margin="0,6,0,0" TextWrapping="Wrap"
                                               Text="{l:T places.everythingPlaceBuildsUnder}"/>
                                    <ItemsControl ItemsSource="{Binding GameObjects}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T places.enterOncePerLevel}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="{l:T places.addEnterHook}"
                                            Command="{Binding AddEnterHookCommand}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="{l:T places.actionGroupsRunOnce}"/>
                                    <ItemsControl ItemsSource="{Binding OnEnterHooks}"
                                                  ItemTemplate="{StaticResource LevelHookRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T places.exitOncePerLevel}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Content="{l:T places.addEnterHook}"
                                            Command="{Binding AddExitHookCommand}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"/>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="{l:T places.sameEnterButActive}"/>
                                    <ItemsControl ItemsSource="{Binding OnExitHooks}"
                                                  ItemTemplate="{StaticResource LevelHookRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 MAP BUTTONS TAB
                 World Map radial buttons (e.g. the host mod-style
                 "House for Sale" button under the Foundry district).
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T mapButtons.mapButtons}">
                <DockPanel Margin="6">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="Gray" TextWrapping="Wrap"
                               Text="{l:T mapButtons.radialButtonsAddedWorld}"/>
                    <ToolBar DockPanel.Dock="Top">
                        <Button view:TutorialAnchor.Id="btn:addMapButton" Content="{l:T mapButtons.addMapButton}" Command="{Binding AddMapButtonCommand}"/>
                        <Button Content="{l:T mapButtons.removeMapButton}" Command="{Binding RemoveMapButtonCommand}"/>
                    </ToolBar>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!--
                            Top-aligned, and the anchor is on the list rather than the
                            scroller around it. A ScrollViewer stretches content that
                            is smaller than its viewport, so both reported the full
                            height of the tab — which made the spotlight cover
                            everything and left the callout no corner to sit in
                            except on top of the fields.
                        -->
                        <ItemsControl x:Name="MapButtonList"
                                      view:TutorialAnchor.Id="panel:mapButtonList"
                                      VerticalAlignment="Top"
                                      ItemsSource="{Binding MapButtons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MapButtonViewModel}">
                                    <Border BorderBrush="LightGray" BorderThickness="1"
                                            CornerRadius="3" Padding="8" Margin="0,0,0,6"
                                            MouseDown="MapButtonRow_MouseDown">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Summary header -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding Display}" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <Button Grid.Row="0" Grid.Column="2" Content="−" Width="22" Height="22"
                                                    Padding="0" Margin="4,0,0,0"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="{l:T mapButtons.remove.tip}"/>

                                            <!-- Target -->
                                            <TextBlock Text="{l:T mapButtons.targetPlace}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Style="{StaticResource GroupedComboBox}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding DataContext.AllTargetOptions,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Token"
                                                      SelectedValue="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemTemplate="{StaticResource TargetOptionItemTemplate}"
                                                      IsEditable="True"
                                                      Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- District -->
                                            <TextBlock Text="{l:T mapButtons.district}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                      ItemsSource="{Binding DataContext.WorldMapDistrictOptions,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValuePath="Token"
                                                      DisplayMemberPath="DisplayLabel"
                                                      SelectedValue="{Binding District, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="{l:T mapButtons.worldMapRadialMenu.tip}"/>

                                            <!-- Label -->
                                            <TextBlock Text="{l:T mapButtons.label}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{l:T mapButtons.buttonTextEG.tip}"/>

                                            <!-- Music -->
                                            <TextBlock Text="{l:T mapButtons.musicOptional}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                            <ComboBox Style="{StaticResource GroupedComboBox}" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                                      IsSynchronizedWithCurrentItem="False"
                                                      IsEditable="True"
                                                      ItemsSource="{Binding DataContext.MusicKeyOptionsGrouped,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Music, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="{l:T mapButtons.trackSwitchWhenButton.tip}">
                                                <ComboBox.GroupStyle>
                                                    <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                                                </ComboBox.GroupStyle>
                                            </ComboBox>

                                            <!-- Visibility conditions — same row shape the
                                                 navigator buttons use. All must pass for the
                                                 button to render inside its district menu. -->
                                            <TextBlock Text="{l:T mapButtons.conditions}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                            <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,0,0">
                                                <ItemsControl ItemsSource="{Binding Conditions}"
                                                              ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Content="{l:T mapButtons.addCondition}" Margin="0,0,4,0" Padding="6,2"
                                                            Command="{Binding AddConditionCommand}"/>
                                                    <Button Content="{l:T mapButtons.addConditionGroup}" Padding="6,2"
                                                            ToolTip="{l:T mapButtons.addConditionGroup.tip}"
                                                            Command="{Binding AddConditionGroupCommand}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 DIALOGUES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T dialogues.dialogues}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DlgListCol" Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition x:Name="DlgMiddleCol" Width="3*" MinWidth="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: dialogues folder tree (cosmetic grouping; drag to organize). -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="90"/>
                        </Grid.RowDefinitions>
                        <DockPanel view:TutorialAnchor.Id="panel:dialogueList" Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T dialogues.dialogues}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addDialogue" Content="{l:T dialogues.addDialogue}" Command="{Binding AddDialogueCommand}"/>
                            <Button Content="{l:T dialogues.addDialogueFolder}"   Command="{Binding AddDialogueFolderCommand}"
                                    ToolTip="{l:T dialogues.addDialogueFolder.tip}"/>
                            <Button Content="{l:T dialogues.renameFolder}"     Click="RenameFolder_Click"
                                    ToolTip="{l:T dialogues.renameFolder.tip}"/>
                            <Button Content="{l:T dialogues.removeDialogue}"   Command="{Binding RemoveDialogueCommand}"
                                    ToolTip="{l:T dialogues.removeDialogue.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding DialogueTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <!-- Token cheatsheet, pinned under the list.
                             One column, each token with what it stands for written beside it.
                             The markup used to share this panel, which is what squeezed it into
                             two columns of one-word labels with the meaning on a hover; the
                             formatting buttons over the Text box write the markup now, so the
                             room went back to the tokens, which have no button.
                             Still bounded and foldable, because the dialogue tree shares this
                             column and the tree is where the work happens: a MaxHeight with its
                             own scrollbar keeps the panel from ever taking more of it, and the
                             fold is remembered for anyone who knows these by heart. Open by
                             default, because the point is being seen by somebody who does not
                             know the tokens exist. Docked before the TreeView so the tree keeps
                             the remaining height. -->
                        <Expander DockPanel.Dock="Bottom" Margin="4,4,4,4"
                                  IsExpanded="{Binding ShowTextTokenTips, Mode=TwoWay}"
                                  ToolTip="{l:T dialogues.gameSwapsEachToken.tip}">
                            <Expander.Header>
                                <TextBlock Text="{l:T dialogues.dialogueText}" FontWeight="SemiBold" FontSize="10"
                                           Opacity="0.8"/>
                            </Expander.Header>
                            <Border Padding="6,4" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{DynamicResource Theme.Accent}"
                                    Background="{DynamicResource Theme.Surface}">
                                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{}{PC}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,1"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:T dialogues.playerSName}"
                                                   FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{}{M}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,1"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:T dialogues.whatTheyCallAnna}"
                                                   FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{}{D}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,1"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{l:T dialogues.whatTheyCallJosef}"
                                                   FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{}{B}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,1"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{l:T dialogues.whatPlayerAdrianCall}"
                                                   FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{}{S}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,1"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{l:T dialogues.whatAnnaJosefCall}"
                                                   FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{}{DA}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,1"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{l:T dialogues.whatMarioCallsEmma}"
                                                   FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,0,1"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{}{F}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,1"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{l:T dialogues.whatTheyCallFamily}"
                                                   FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,0,1"/>
                                    </Grid>
                                    <TextBlock Text="{l:T dialogues.playersChooseAllThese}"
                                               FontSize="9" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Expander>
                        <TreeView x:Name="DialogueTreeView"
                                  ItemsSource="{Binding DialogueTree}"
                                  SelectedItemChanged="DialogueTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="DialogueTree_PreviewMouseLeftButtonDown"
                                  MouseMove="DialogueTree_MouseMove"
                                  Drop="DialogueTree_Drop"
                                  ToolTip="{l:T dialogues.dialogueTreeView.tip}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <!-- Two-way for the same reason as the other trees: so
                                         choosing a vanilla conversation can let this tree go. -->
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <!-- Ctrl/Shift multi-selection ride-alongs. Semi-transparent
                                             so it reads on light and dark themes alike. -->
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter Property="Background" Value="#5578A8E0"/>
                                        </DataTrigger>
                                                                            <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
</Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:DialogueFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:DialogueLeafNode}">
                                    <TextBlock Text="{Binding Dialogue.Display}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="4" Background="LightGray"
                                      HorizontalAlignment="Stretch"/>

                        <!-- Changes to conversations the game already has.
                             Listed apart from the pack's own because they are a
                             different kind of thing: these are the game's, found
                             by where they sit in the scene, and folders and
                             renaming mean nothing to them. -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="{l:T dialogues.vanillaDialogues}"
                                       FontWeight="Bold" Margin="6,4,0,2"
                                       ToolTip="{l:T dialogues.vanillaDialogues.tip}"/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button Content="{l:T dialogues.addVanillaDialogue}" Command="{Binding AddVanillaDialogueCommand}"
                                        ToolTip="{l:T dialogues.addVanillaDialogue.tip}"/>
                                <Button Content="{l:T dialogues.removeDialogue}" Command="{Binding RemoveVanillaDialogueCommand}"
                                        ToolTip="{l:T dialogues.removeDialogue.tip2}"/>
                            </ToolBar>
                            <ListBox ItemsSource="{Binding VanillaDialogues}"
                                     SelectedItem="{Binding SelectedVanillaDialogue, Mode=TwoWay}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DialogueViewModel}">
                                        <DockPanel ToolTip="{Binding ChangeSummary}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeSummary}"
                                                       Foreground="Gray" FontSize="10"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- MIDDLE: selected dialogue (properties + node list) -->
                    <!-- HorizontalScrollBarVisibility=Disabled is load-bearing: without it the
                         ScrollViewer defaults to Hidden, which still measures its content at
                         INFINITE width. That sizes the node list to the widest node's full text,
                         so the cards hard-clip at the viewport edge instead of trimming with an
                         ellipsis at the real column edge (and they ignore the column widening). -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  DataContext="{Binding SelectedDialogue}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- Only for a change to one of the game's own
                                 conversations. Collapsed entirely otherwise, so
                                 a dialogue of the pack's own is never asked a
                                 question that has no answer. -->
                            <GroupBox Header="{l:T dialogues.vanillaConversation}">
                                <GroupBox.Style>
                                    <Style TargetType="GroupBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowsSourcePicker}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </GroupBox.Style>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{l:T dialogues.conversation}" Width="120" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding DataContext.AvailableVanillaDialogues,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding VanillaSource, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{l:T dialogues.whichGameSConversations.tip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Id}"/>
                                                        <TextBlock Text="{Binding Summary}" Foreground="Gray" FontSize="11"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{l:T dialogues.changes}" Width="120" VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right" Content="{l:T dialogues.resetVanillaDialogue}" Padding="8,1"
                                                Click="ResetVanillaDialogue_Click"
                                                ToolTip="{l:T dialogues.resetVanillaDialogue.tip}"/>
                                        <TextBlock Text="{Binding ChangeSummary}" VerticalAlignment="Center"
                                                   Foreground="Gray"/>
                                    </DockPanel>

                                    <!-- The same warning the game gives a player: a conversation
                                         the story runs through can set or skip what the story
                                         needs. -->
                                    <Border x:Name="DialogueChangeWarning" Margin="0,2,0,6" Padding="6,4" BorderThickness="1"
                                            BorderBrush="#FFB06A00" Background="#1FB06A00">
                                        <TextBlock Foreground="#FFB06A00" FontSize="11" TextWrapping="Wrap"
                                                   Text="{l:T dialogues.changingOneGameS}"/>
                                    </Border>

                                    <!-- The room's gate. It decides whether this conversation
                                         happens at all, and it belongs to the room rather than to
                                         the conversation: a condition taken out of it changes the
                                         room's script, so the Quests tab shows the same change. -->
                                    <TextBlock Text="{l:T dialogues.gamePlaysWhen}" Margin="0,4,0,0"
                                               Foreground="Gray"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                               Text="{l:T dialogues.anyOneThesePlaces}"
                                               Visibility="{Binding HasGateGroups, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl x:Name="DialogueGateGroups" ItemsSource="{Binding GateGroups}" Margin="12,0,0,0"
                                                  ItemTemplate="{StaticResource GameConditionGroupTemplate}"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{l:T dialogues.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T dialogues.displayName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <!-- Read-only for a change to one of the game's own
                                         conversations: the name is how it is found in the
                                         scene, so it is the game's rather than the pack's.
                                         Greyed and unbordered when so, matching the runtime
                                         name below - a box that looks typeable and silently
                                         is not reads as broken. -->
                                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                             Grid.Row="0" Grid.Column="1"
                                             IsReadOnly="{Binding NameIsReadOnly}"
                                             IsReadOnlyCaretVisible="False"
                                             ToolTip="{l:T dialogues.whatDialogueCalledEditor.tip}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NameIsReadOnly}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                        <Setter Property="Cursor" Value="Arrow"/>
                                                        <Setter Property="ToolTip" Value="{l:T dialogues.conversationGameSSo.tip}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="{l:T dialogues.runtimeName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T dialogues.runtimeName.tip}"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T dialogues.namePackItselfUses.tip}"/>
                                    <!-- The roomtalk picker is gone: dialogues are hosted on a
                                         per-pack always-active container, and the only remaining
                                         use for a roomtalk — taking priority over vanilla — is
                                         determined by the level, so it is derived rather than
                                         chosen. -->
                                    <CheckBox Content="{l:T dialogues.prioritizeDialogueOverVanilla}"
                                              IsChecked="{Binding DisableVanillaTrigger}"
                                              IsEnabled="{Binding LevelHasVanillaRoomTalk}"
                                              Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="{l:T dialogues.prioritizeDialogueOverVanilla.tip}"/>
                                    <CheckBox Content="{l:T dialogues.alsoLeaveTalkButton}"
                                              IsChecked="{Binding ReplayOnTalk}"
                                              IsEnabled="{Binding CanEditReplayOnTalk}"
                                              Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="{l:T dialogues.alsoLeaveTalkButton.tip}"/>
                                    <CheckBox Content="{l:T dialogues.waitTalkButtonNo}"
                                              IsChecked="{Binding Queued}"
                                              IsEnabled="{Binding CanEditQueued}"
                                              Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="{l:T dialogues.waitTalkButtonNo.tip}"/>
                                    <CheckBox Content="{l:T dialogues.queueBehindActiveDialogue}"
                                              IsChecked="{Binding QueueBehind}"
                                              Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="{l:T dialogues.queueBehindActiveDialogue.tip}"/>
                                    <CheckBox Content="{l:T dialogues.setConditionDebuggingF12}"
                                              IsChecked="{Binding DebugConditions}"
                                              Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"
                                              ToolTip="{l:T dialogues.setConditionDebuggingF12.tip}"/>
                                    <TextBlock Text="{l:T dialogues.priority}" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="8" Grid.Column="1" Margin="0,4,0,0" Width="60" HorizontalAlignment="Left"
                                              ToolTip="{l:T dialogues.whenSeveralDialoguesBecome.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T dialogues.startConditionsAllMust}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="{l:T dialogues.addDialogueStartCondition}" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddDialogueStartConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="{l:T dialogues.addDialogueStartConditionGroup}" Padding="8,2"
                                                ToolTip="{l:T dialogues.addDialogueStartConditionGroup.tip}"
                                                Command="{Binding DataContext.AddDialogueStartConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="{l:T dialogues.copyStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyStartConditionsCommand}"
                                                ToolTip="{l:T dialogues.copyStartConditions.tip}"/>
                                        <Button Content="{l:T dialogues.pasteStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteStartConditionsCommand}"
                                                ToolTip="{l:T dialogues.pasteStartConditions.tip}"/>
                                        <Button Content="{l:T dialogues.overwriteStartConditions}" Padding="8,2"
                                                Command="{Binding OverwriteStartConditionsCommand}"
                                                ToolTip="{l:T dialogues.overwriteStartConditions.tip}"/>
                                    </StackPanel>
                                    <ItemsControl view:TutorialAnchor.Id="field:startConditions" view:IssueTarget.Field="startConditions"
                                                  ItemsSource="{Binding StartConditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:dialogueNodes" Header="{l:T dialogues.dialogueNodes}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="10" Margin="0,0,0,4"
                                               TextWrapping="Wrap"
                                               Text="{l:T dialogues.clickNodeSelectChild}"/>
                                    <!-- The root node ids used to be printed here. Nobody
                                         needs them: they are internal numbers, and the roots
                                         are the rows at the left edge of the list anyway. -->
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                                Margin="0,0,0,4">
                                        <ToggleButton x:Name="GameLookSwitch"
                                                      Style="{StaticResource Theme.Switch}"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding DataContext.GameLookNodeRows,
                                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                                  Mode=TwoWay}"
                                                      ToolTip="{l:T dialogues.gameLookSwitch.tip}"/>
                                        <TextBlock Text="{l:T dialogues.gameLook}" Margin="6,0,0,0" FontSize="11"
                                                   VerticalAlignment="Center" Foreground="Gray"
                                                   ToolTip="{l:T dialogues.gameLookSwitch.tip}"/>
                                    </StackPanel>
                                    <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,6,0,0">
                                        <Button view:TutorialAnchor.Id="btn:addRootNode" Content="{l:T dialogues.addDialogueRootNode}" Margin="0,0,2,0"
                                                Command="{Binding DataContext.AddDialogueRootNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{l:T dialogues.addDialogueRootNode.tip}"/>
                                        <Button Content="{l:T dialogues.addDialogueChildNode}" Margin="2,0,2,0"
                                                Command="{Binding DataContext.AddDialogueChildNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{l:T dialogues.addDialogueChildNode.tip}"/>
                                        <Button Content="{l:T dialogues.addDialogueSiblingNode}" Margin="2,0,2,0"
                                                Command="{Binding DataContext.AddDialogueSiblingNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{l:T dialogues.addDialogueSiblingNode.tip}"/>
                                        <Button Content="{l:T dialogues.removeDialogue}" Margin="2,0,0,0"
                                                Command="{Binding DataContext.RemoveDialogueNodeCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{l:T dialogues.removeDialogue.tip3}"/>
                                    </UniformGrid>
                                    <!-- The whole box takes the game's dark panel when the
                                         game look is on, not just the lines: a dark strip per
                                         row with the list's own background between them reads
                                         as stripes rather than as a conversation. The rows
                                         paint the same colour, so the two meet seamlessly. -->
                                    <ListBox x:Name="NodeList"
                                             ItemsSource="{Binding Nodes}"
                                             SelectedItem="{Binding DataContext.SelectedNode,
                                                            RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="240"
                                             PreviewMouseWheel="NodeList_PreviewMouseWheel"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="NodeList_PreviewMouseLeftButtonDown"
                                             MouseMove="NodeList_MouseMove"
                                             DragOver="NodeList_DragOver"
                                             DragLeave="NodeList_DragLeave"
                                             Drop="NodeList_Drop"
                                             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.GameLookNodeRows,
                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{x:Static ctl:DialogueLinePreview.Panel}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                        <!-- Copy/paste a node subtree (cross-dialogue). Commands live on
                                             the MainViewModel, reached via the ListBox's Tag because a
                                             ContextMenu isn't in the visual tree. The Ctrl+C/Ctrl+V
                                             gestures are registered in code-behind against this ListBox
                                             (RegisterListShortcuts), so they only fire while the node
                                             list has focus — InputGestureText below is just the label. -->
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:T dialogues.copyNode}" InputGestureText="{l:T dialogues.copyNode.keys}"
                                                          Command="{Binding PlacementTarget.Tag.CopyNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="{l:T dialogues.pasteNodeSibling}" InputGestureText="{l:T dialogues.pasteNodeSibling.keys}"
                                                          ToolTip="{l:T dialogues.pasteNodeSibling.tip}"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeSiblingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{l:T dialogues.pasteNodeChild}"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeChildCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="{l:T dialogues.pasteNodeRoot}"
                                                          Command="{Binding PlacementTarget.Tag.PasteNodeRootCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <!--
                                                Tree-style rendering of the flat node list. Each
                                                node's IndentMargin is computed by
                                                DialogueViewModel.RecomputeDepths after every
                                                Add/Remove/ToggleRoot operation, so children
                                                visually sit underneath their parents without us
                                                having to switch the control to a TreeView.
                                            -->
                                            <DataTemplate DataType="{x:Type vm:DialogueNodeViewModel}">
                                                <!-- Speaker wash: the actor's colour from the Actors tab at low
                                                     alpha, spanning the full row width so a change of speaker is
                                                     obvious scanning down the list. Semi-transparent on purpose —
                                                     it sits over the selection highlight rather than hiding it,
                                                     and is Transparent when the node has no actor / no colour. -->
                                                <Border Background="{Binding ActorTintBrush}"
                                                        CornerRadius="2" Padding="0,1">
                                                <!-- DockPanel (not a horizontal StackPanel) so the line fills the
                                                     remaining width and rescales with the column, rather than
                                                     being laid out at its natural width and overrunning. -->
                                                <DockPanel>
                                                    <!-- What this node is inside, drawn in the
                                                         space the indent was already leaving
                                                         blank. Docked FIRST, so it is the
                                                         leftmost thing on the row. -->
                                                    <ctl:NodeDepthRail DockPanel.Dock="Left"
                                                                       Depth="{Binding Depth}">
                                                        <ctl:NodeDepthRail.Style>
                                                            <Style TargetType="ctl:NodeDepthRail">
                                                                <Setter Property="Rail"
                                                                        Value="{DynamicResource Theme.Text}"/>
                                                                <Setter Property="Opacity" Value="0.42"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.GameLookNodeRows,
                                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Value="True">
                                                                        <Setter Property="Rail"
                                                                                Value="{x:Static ctl:DialogueLinePreview.Rail}"/>
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ctl:NodeDepthRail.Style>
                                                    </ctl:NodeDepthRail>
                                                    <!-- Changed-from-the-game marker, and the way back.
                                                         Only on a change to one of the game's own
                                                         conversations, and only on the lines that differ:
                                                         an author looking at 118 lines needs to see the
                                                         three they touched. -->
                                                    <!-- One field at a time, listed because only the
                                                         changed ones are offered: thirteen buttons,
                                                         twelve of them greyed, answers "what did I
                                                         change here" worse than a short list of what
                                                         did. -->
                                                    <ItemsControl DockPanel.Dock="Right"
                                                                  ItemsSource="{Binding ResettableFields}"
                                                                  Margin="2,0,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Label}" FontSize="9"
                                                                        Padding="4,0" Margin="2,0,0,0"
                                                                        Command="{Binding Reset}"
                                                                        ToolTip="{Binding Label, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=dialogues.resetLinePart.tip}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button DockPanel.Dock="Right" Content="↺" Width="18" Padding="0"
                                                            Margin="2,0,0,0" FontSize="11"
                                                            Command="{Binding ResetToVanillaCommand}"
                                                            ToolTip="{Binding ResetTooltip}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChangedFromVanilla}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <TextBlock DockPanel.Dock="Left" Text="●" Width="10"
                                                               FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Theme.Accent}"
                                                               ToolTip="{Binding ChangedFieldsText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsChangedFromVanilla}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <!-- Hidden rather than collapsed above, so
                                                                         the lines stay aligned whether or not
                                                                         any of them is marked; gone entirely
                                                                         for a conversation of the pack's own. -->
                                                                    <DataTrigger Binding="{Binding IsVanillaLine}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Kind glyph: ▸ Text, ⇄ Choice, ? Random, ◆ answer (child of a Choice).
                                                         Its colour is the theme's until the list goes dark, at
                                                         which point a theme brush is a coin toss - on the light
                                                         theme it is near-black on near-black. -->
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding KindGlyph}" Width="14"
                                                               FontWeight="Bold" TextAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.GameLookNodeRows,
                                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{x:Static ctl:DialogueLinePreview.OnPanel}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- Tag chip: marks a node other nodes can Jump to, and shows
                                                         the tag itself so a jump target is findable at a glance. -->
                                                    <Border DockPanel.Dock="Right" Margin="4,0,0,0" Padding="4,0"
                                                            CornerRadius="2" VerticalAlignment="Center"
                                                            Background="{DynamicResource Theme.Accent}"
                                                            Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}"
                                                            ToolTip="{Binding Tag, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=dialogues.jumpTag.tip}">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                                                    </Border>
                                                    <!-- Speaker prefix stays a plain TextBlock: it is a
                                                         character NAME, and running it through the spell
                                                         checker would squiggle the whole cast. -->
                                                    <!-- The bracketed [Name] belongs to the plain row: it
                                                         tells a name apart from the words when both are
                                                         the same size and colour. The game-look row draws
                                                         the name itself, bigger and in the character's own
                                                         colour, so this would be a second one. -->
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding SpeakerPrefix}"
                                                               Margin="3,0,0,0" ToolTip="{Binding Display}"
                                                               Visibility="{Binding DataContext.PlainNodeRows,
                                                                            RelativeSource={RelativeSource AncestorType=Window},
                                                                            Converter={StaticResource BoolToVisibility}}"/>
                                                    <!--
                                                        The line itself is a TextBox, not a TextBlock, purely so
                                                        Windows will squiggle misspellings here too — WPF only
                                                        spell-checks TextBox/RichTextBox.

                                                        It must stay EDITABLE: IsReadOnly="True" silently turns
                                                        spell checking off. Focusable + IsHitTestVisible false is
                                                        what makes it inert instead — clicks fall through to the
                                                        row so selection and drag-and-drop still work, and there
                                                        is no way to put a caret in it. The binding is OneWay as
                                                        a second guard.

                                                        Padding/Margin/MinHeight are zeroed because App.xaml's
                                                        TextBox style adds 4,2 padding and a 2px margin, which
                                                        would make every row taller and push the text out of
                                                        line with the glyph.

                                                        Known trade-off: neither has TextTrimming, so a long
                                                        line clips at the column edge instead of ending in "…".
                                                        The full text is on the row ToolTip.

                                                        HidesTags: the line as the player reads it. Formatting
                                                        applied, markup GONE rather than greyed — this row is
                                                        for scanning what a conversation says, and in a column
                                                        this narrow four characters of a tag cost real words.
                                                        That also makes the control display-only, which suits a
                                                        row that was already inert.
                                                    -->
                                                    <ctl:MarkupTextBox Text="{Binding TextPreview, Mode=OneWay}"
                                                             HidesTags="True"
                                                             ToolTip="{Binding Display}"
                                                             Focusable="False" IsHitTestVisible="False"
                                                             IsTabStop="False"
                                                             Background="Transparent" BorderThickness="0"
                                                             Padding="0" Margin="0" MinHeight="0"
                                                             VerticalContentAlignment="Center"
                                                             Language="{Binding DataContext.TextLanguage, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Visibility="{Binding DataContext.PlainNodeRows,
                                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                                          Converter={StaticResource BoolToVisibility}}"
                                                             SpellCheck.IsEnabled="{Binding DataContext.SpellCheckNodeText,
                                                                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <!--
                                                        The same line, drawn the way the game draws it:
                                                        its font, its black outline and drop shadow, the
                                                        speaker in their own colour on a dark panel. Off
                                                        by default — see EditorPrefs.GameLookNodeRows.

                                                        Collapsed rather than removed, and that is the
                                                        cheap half of the switch: WPF does not measure a
                                                        collapsed element, so the one that is off never
                                                        rasterises anything.

                                                        Squiggles are DRAWN here rather than had for
                                                        free: WPF only underlines inside a TextBox and
                                                        this is the game's own glyph atlas, blitted. The
                                                        words come from Windows' speller all the same —
                                                        the same dictionary the box below the list uses,
                                                        so a word added there stops being marked in both.
                                                    -->
                                                    <ctl:DialogueLinePreview Line="{Binding TextPreview, Mode=OneWay}"
                                                             Speaker="{Binding SpeakerName, Mode=OneWay}"
                                                             SpeakerColor="{Binding SpeakerColorHex, Mode=OneWay}"
                                                             ToolTip="{Binding Display}"
                                                             ChecksSpelling="{Binding DataContext.SpellCheckNodeText,
                                                                              RelativeSource={RelativeSource AncestorType=Window},
                                                                              Mode=OneWay}"
                                                             Visibility="{Binding DataContext.GameLookNodeRows,
                                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                                          Converter={StaticResource BoolToVisibility}}"/>
                                                </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Column="3" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <!-- RIGHT: selected node editor -->
                    <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedNode}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- Live preview of what the player will see during this node:
                                 derives the bust from the selected actor's default key
                                 (looked up through the MainViewModel.SelectedNodeActorBustKey
                                 helper) and the face from the node's Expression through the
                                 speaker's expression list, as the game does
                                 (MainViewModel.SelectedNodeFace). -->
                            <GroupBox Header="{l:T dialogues.preview}">
                                <ctl:BustPreview MainViewModel="{Binding DataContext,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                 BustKey="{Binding DataContext.SelectedNodeActorBustKey,
                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Face="{Binding DataContext.SelectedNodeFace,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </GroupBox>
                            <GroupBox view:TutorialAnchor.Id="panel:nodeEditor" Header="{l:T dialogues.nodeEditor}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T dialogues.id}"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Id}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Foreground="Gray"/>
                                    <TextBlock Text="{l:T dialogues.kind}"        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox ToolTip="{l:T dialogues.nodeKind.tip}" view:TutorialAnchor.Id="field:nodeKind" Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.NodeKinds,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              Visibility="{Binding IsChoiceChild, Converter={StaticResource InverseBoolToVisibility}}"
                                              SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static l:EnumTextConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- What an option IS, rather than a kind to pick. Its role comes
                                         from its parent being a Choice, so a dropdown here would offer
                                         changes that do not apply. -->
                                    <TextBlock Text="{l:T dialogues.choiceOption}" Grid.Row="1" Grid.Column="1"
                                               VerticalAlignment="Center" Foreground="Gray" FontStyle="Italic"
                                               ToolTip="{l:T dialogues.choiceOption.tip}"
                                               Visibility="{Binding IsChoiceChild, Converter={StaticResource BoolToVisibility}}"/>
                                    <!-- The actor is hidden only on an option of a Choice, which is a
                                         button rather than a line. Never for the player: hiding it
                                         there left no way to pick anybody else for the line
                                         (1.6.2). -->
                                    <TextBlock Text="{l:T dialogues.actor}"       Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding IsChoiceChild, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <!-- Editable autocomplete: bind ONLY Text (not SelectedItem). Binding
                                         both to the same property makes SelectedItem null-out and flush an
                                         empty value back to the node being navigated away from when its
                                         value isn't in the (per-node, rebuilt) ItemsSource. -->
                                    <!-- Under "This pack" and "The game's own", like the music
                                         pickers: a pack that adopts the game's cast lists
                                         dozens of speakers, and the ones an author wrote are
                                         the ones they are usually looking for. -->
                                    <ComboBox x:Name="NodeActorPicker" Style="{StaticResource GroupedComboBox}"
                                              ToolTip="{l:T dialogues.nodeActorPicker.tip}" view:IssueTarget.Field="actor" Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.ActorOptionsGrouped,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Visibility="{Binding IsChoiceChild, Converter={StaticResource InverseBoolToVisibility}}"
                                              Text="{Binding Actor, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.GroupStyle>
                                            <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                    <!-- Expression and outfit are hidden for the two nodes that have
                                         no bust worth asking about: the player's, whose bust belongs to
                                         the game, and an option on a Choice, which is a button rather
                                         than a line. See SelectedNodeShowsExpressionAndOutfit. -->
                                    <TextBlock Text="{l:T dialogues.expression}"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.SelectedNodeShowsExpressionAndOutfit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                    <ComboBox x:Name="NodeExpressionPicker" ToolTip="{l:T dialogues.whichExpressionSpeakerWears.tip}" view:IssueTarget.Field="expression" Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SelectedNodeExpressionOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Visibility="{Binding DataContext.SelectedNodeShowsExpressionAndOutfit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                              Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"/>
                                    <!-- Outfit: optional per-node bust switch. The picker lists the
                                         speaking actor's authored outfits; empty keeps the current bust.
                                         A $varName picks the outfit dynamically from a pack variable. -->
                                    <TextBlock Text="{l:T dialogues.outfit}"      Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding DataContext.SelectedNodeShowsExpressionAndOutfit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SelectedNodeOutfitOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="True"
                                              Visibility="{Binding DataContext.SelectedNodeShowsExpressionAndOutfit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                              Text="{Binding Outfit, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{l:T dialogues.switchActorOneTheir.tip}"/>
                                    <TextBlock Text="{l:T dialogues.text}"        Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <!-- The one field in the editor a player actually reads, so it's
                                         the one that gets Windows' spell checker. Language is pinned
                                         rather than inherited from the OS locale: the checker picks
                                         its dictionary from this, and on a Windows set to anything
                                         but English the whole script would come back underlined.
                                         The context menu is built in code-behind — WPF's own
                                         suggestions menu is internal and can't be extended, so
                                         NodeTextBox_ContextMenuOpening reproduces the suggestions and
                                         adds "Add to dictionary". -->
                                    <DockPanel Grid.Row="5" Grid.Column="1">
                                        <!--
                                            Writing markup by hand means remembering that it is
                                            <b> and not <bold>, and typing the closing half in
                                            the right place. These do both, round whatever is
                                            selected.

                                            Focusable="False" on every one of them, from the
                                            shared style: a button that took focus would take
                                            the selection with it, and the tag would land round
                                            nothing. The shortcuts are handled inside the box -
                                            see MarkupTextBox.OnPreviewKeyDown, which also has
                                            to take Ctrl+B back off WPF, whose own idea of bold
                                            is not markup and does not survive a redraw.
                                        -->
                                        <StackPanel x:Name="NodeTextToolbar" DockPanel.Dock="Top"
                                                    Orientation="Horizontal" Margin="0,0,0,3">
                                            <Button x:Name="MarkupBoldButton"
                                                    Style="{StaticResource Theme.MarkupButton}"
                                                    Click="MarkupBold_Click"
                                                    ToolTip="{l:T dialogues.markupBold.tip}">
                                                <TextBlock Text="B" FontFamily="Georgia, Times New Roman, serif"
                                                           FontSize="13" FontWeight="Bold"/>
                                            </Button>
                                            <Button x:Name="MarkupItalicButton"
                                                    Style="{StaticResource Theme.MarkupButton}"
                                                    Click="MarkupItalic_Click"
                                                    ToolTip="{l:T dialogues.markupItalic.tip}">
                                                <TextBlock Text="I" FontFamily="Georgia, Times New Roman, serif"
                                                           FontSize="13" FontStyle="Italic"/>
                                            </Button>
                                            <Button x:Name="MarkupColorButton"
                                                    Style="{StaticResource Theme.MarkupButton}"
                                                    Click="MarkupColor_Click"
                                                    ToolTip="{l:T dialogues.markupColor.tip}">
                                                <Grid Width="14" Height="15">
                                                    <TextBlock Text="A" FontSize="11" Margin="0,-1,0,0"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"/>
                                                    <Border Height="3" VerticalAlignment="Bottom"
                                                            CornerRadius="1" Background="#E05A5A"/>
                                                </Grid>
                                            </Button>
                                            <Button x:Name="MarkupSizeButton"
                                                    Style="{StaticResource Theme.MarkupButton}"
                                                    Click="MarkupSize_Click"
                                                    ToolTip="{l:T dialogues.markupSize.tip}">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="A" FontSize="13"/>
                                                    <TextBlock Text="A" FontSize="9" Margin="1,0,0,0"
                                                               VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    <!-- How the line is translated: exactly as written everywhere,
                                         or its words kept and only its letters changed. Only for
                                         words that are the pack's - see TextIsThePacks. -->
                                    <StackPanel DockPanel.Dock="Bottom" Margin="2,4,0,0"
                                                Visibility="{Binding TextIsThePacks, Converter={StaticResource BoolToVisibility}}">
                                        <CheckBox x:Name="NodeTextSameEverywhere" Content="{l:T dialogues.textSameEverywhere}"
                                                  IsChecked="{Binding TextSameEverywhere}"
                                                  ToolTip="{l:T dialogues.textSameEverywhere.tip}"/>
                                        <CheckBox x:Name="NodeTextLettersOnly" Content="{l:T dialogues.textLettersOnly}" Margin="0,2,0,0"
                                                  IsChecked="{Binding TextLettersOnly}"
                                                  ToolTip="{l:T dialogues.textLettersOnly.tip}"/>
                                    </StackPanel>
                                    <!-- How the line will sit in the game's box: shrunk, or running out of it. -->
                                    <TextBlock x:Name="NodeFitNote" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11" Margin="2,2,2,0"
                                               Text="{Binding DataContext.SelectedNodeFitNote,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                               Visibility="{Binding DataContext.SelectedNodeFitNote,
                                                            RelativeSource={RelativeSource AncestorType=Window},
                                                            Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.SelectedNodeFitSpills,
                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ctl:MarkupTextBox x:Name="NodeTextBox" ToolTip="{l:T dialogues.nodeTextBox.tip}"
                                              Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                              MinHeight="60"
                                              Language="{Binding DataContext.TextLanguage, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SpellCheck.IsEnabled="{Binding DataContext.SpellCheckNodeText,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                              ContextMenuOpening="NodeTextBox_ContextMenuOpening"/>
                                    </DockPanel>
                                    <TextBlock Text="{l:T dialogues.tag}"         Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Tag, UpdateSourceTrigger=PropertyChanged}" Grid.Row="6" Grid.Column="1"
                                              ToolTip="{l:T dialogues.optionalOtherNodesCan.tip}"/>
                                    <TextBlock Text="{l:T dialogues.children}"    Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChildrenSummary}" Grid.Row="7" Grid.Column="1" Foreground="Gray"/>
                                    <TextBlock Text="{l:T dialogues.jump}"        Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox ToolTip="{l:T dialogues.wherePlayGoesAfter.tip}" Grid.Row="8" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.JumpModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding JumpMode, UpdateSourceTrigger=PropertyChanged}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static l:EnumTextConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- "Jump to", not "Jump tag": beside a Tag field that NAMES this node,
                                         two fields both called tag read as the same thing. This one is a
                                         destination, and it only appears once Jump is the mode — Continue and
                                         Exit have nowhere to go, so a tag typed against either is stored and
                                         then ignored. The list is the dialogue's own tags, still editable so a
                                         tag can be aimed at before the node carrying it exists. -->
                                    <TextBlock Text="{l:T dialogues.jump2}"     Grid.Row="9" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding IsJump, Converter={StaticResource BoolToVisibility}}"/>
                                    <ComboBox Grid.Row="9" Grid.Column="1"
                                              IsEditable="True"
                                              ItemsSource="{Binding DataContext.SelectedNodeJumpTagOptions,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding JumpTargetTag, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsJump, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="{l:T dialogues.whichTaggedNodeResume.tip}"/>
                                    <TextBlock Text="{l:T dialogues.duration}"    Grid.Row="10" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Row="10" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.NodeDurations,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Duration, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{l:T dialogues.howTextLineAdvances.tip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static l:EnumTextConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{l:T dialogues.timeoutS}" Grid.Row="11" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding IsTimeout, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBox  Text="{Binding Timeout, Converter={x:Static conv:SingleConverter.Instance}}"
                                              Grid.Row="11" Grid.Column="1"
                                              Visibility="{Binding IsTimeout, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="{l:T dialogues.secondsLineLingersAfter.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:nodeConditions" Header="{l:T dialogues.nodeConditions}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="{l:T dialogues.addDialogueStartCondition}" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddNodeConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="{l:T dialogues.addDialogueStartConditionGroup}" Padding="8,2"
                                                ToolTip="{l:T dialogues.addDialogueStartConditionGroup.tip}"
                                                Command="{Binding DataContext.AddNodeConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="{l:T dialogues.copyStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyConditionsCommand}"
                                                ToolTip="{l:T dialogues.copyStartConditions.tip2}"/>
                                        <Button Content="{l:T dialogues.pasteStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteConditionsCommand}"
                                                ToolTip="{l:T dialogues.pasteStartConditions.tip}"/>
                                        <Button Content="{l:T dialogues.overwriteStartConditions}" Padding="8,2"
                                                Command="{Binding OverwriteConditionsCommand}"
                                                ToolTip="{l:T dialogues.overwriteStartConditions.tip2}"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="conditions"
                                                  ItemsSource="{Binding Conditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <!--
                                Hidden on a Choice option. When GC2 considers such a node
                                "started" is not something we can currently answer — an
                                option may well be started as the menu is drawn, in which
                                case every option's on-start actions would fire whether or
                                not the player picked it. Offering the box while that is
                                unknown invites packs that half-work.

                                On-finish is unaffected: an option finishes when it has
                                been taken, which is the moment authors actually want.
                            -->
                            <GroupBox Header="{l:T dialogues.actionsStart}"
                                      Visibility="{Binding IsChoiceChild,
                                                   Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="{l:T dialogues.addNodeActionOnStart}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddNodeActionOnStartCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="{l:T dialogues.copyStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsOnStartCommand}"
                                                ToolTip="{l:T dialogues.copyStartConditions.tip3}"/>
                                        <Button Content="{l:T dialogues.pasteStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsOnStartCommand}"
                                                ToolTip="{l:T dialogues.pasteStartConditions.tip2}"/>
                                        <Button Content="{l:T dialogues.overwriteStartConditions}" Padding="8,2"
                                                Command="{Binding OverwriteActionsOnStartCommand}"
                                                ToolTip="{l:T dialogues.overwriteStartConditions.tip3}"/>
                                    </StackPanel>
                                    <ItemsControl view:IssueTarget.Field="actionsOnStart"
                                                  ItemsSource="{Binding ActionsOnStart}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="4"
                                    BorderThickness="1" BorderBrush="{DynamicResource Theme.Accent}"
                                    Background="{DynamicResource Theme.Surface}"
                                    Visibility="{Binding IsChoiceChild, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.85"
                                           Text="{l:T dialogues.nodeOneChoiceS}"/>
                            </Border>

                            <GroupBox view:TutorialAnchor.Id="panel:actionsOnFinishBox" Header="{l:T dialogues.actionsOnFinishBox}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="{l:T dialogues.addNodeActionOnStart}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddNodeActionOnFinishCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="{l:T dialogues.copyStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsOnFinishCommand}"
                                                ToolTip="{l:T dialogues.copyStartConditions.tip3}"/>
                                        <Button Content="{l:T dialogues.pasteStartConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsOnFinishCommand}"
                                                ToolTip="{l:T dialogues.pasteStartConditions.tip2}"/>
                                        <Button Content="{l:T dialogues.overwriteStartConditions}" Padding="8,2"
                                                Command="{Binding OverwriteActionsOnFinishCommand}"
                                                ToolTip="{l:T dialogues.overwriteStartConditions.tip3}"/>
                                    </StackPanel>
                                    <ItemsControl view:TutorialAnchor.Id="field:actionsOnFinish" view:IssueTarget.Field="actionsOnFinish"
                                                  ItemsSource="{Binding ActionsOnFinish}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 SCENES TAB

                 Each row is a pack-authored CG / story scene that ships
                 with the pack. At runtime the plugin clones the vanilla
                 "Samanthabeach" scene under 4_CG_Manager-Sexy, swaps the
                 Core SpriteRenderer (frame) and Core/Art SpriteRenderer
                 (scene image), and overrides the prototype's Trigger
                 component according to the authored sound mode.

                 Frame source: either a shipped vanilla frame (from
                 VanillaFrameOptions, copied next to the editor exe and
                 next to the plugin DLL) or a custom PNG path relative
                 to the pack root. The custom path takes precedence at
                 runtime when both are filled, so the author can keep a
                 vanilla pick "saved" while testing a custom one.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T scenes.scenes}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T scenes.scenes}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addScene" Content="{l:T scenes.addScene}"  Command="{Binding AddSceneCommand}"/>
                            <Button Content="{l:T scenes.unitAddFolder}" Tag="{Binding SceneTree}" Click="UnitAddFolder_Click"
                                    ToolTip="{l:T scenes.unitAddFolder.tip}"/>
                            <Button Content="{l:T scenes.unitRenameFolder}" Tag="{Binding SceneTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="{l:T scenes.unitRenameFolder.tip}"/>
                            <Button Content="{l:T scenes.removeScene}" Command="{Binding RemoveSceneCommand}"
                                    ToolTip="{l:T scenes.removeScene.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding SceneTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="SceneTreeView"
                                 ItemsSource="{Binding SceneTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="{l:T scenes.sceneTreeView.tip}"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:sceneDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedScene}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── composites scene image + frame, same z-order as runtime -->
                            <GroupBox Header="{l:T scenes.preview}">
                                <ctl:ScenePreview PackRoot="{Binding DataContext.PackRoot,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SceneSprite="{Binding SceneSprite}"
                                                  VanillaFrame="{Binding VanillaFrame}"
                                                  CustomFrameSprite="{Binding CustomFrameSprite}"/>
                            </GroupBox>

                            <GroupBox Header="{l:T scenes.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T scenes.displayName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="{l:T scenes.whatCalledEditorS.tip}"  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T scenes.runtimeName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T scenes.runtimeName.tip}"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T scenes.namePackItselfUses.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T scenes.sceneImageRelativePack}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:T scenes.spritePath}" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:PathPickerBox PathText="{Binding SceneSprite, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Grid.Column="1"
                                                           Filter="{x:Static view:PickerFilters.SceneArt}"
                                                           ToolTip="{l:T scenes.pathRelativePackRoot.tip}"/>
                                    </Grid>

                                    <!-- What the picked file turned out to be. Read from the
                                         file rather than asked of the author, so it appears as
                                         soon as a path is typed. -->
                                    <TextBlock Text="{Binding MediaSummary}" Foreground="Gray"
                                               FontSize="10" Margin="144,2,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MediaSummary}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Only for something that moves. A loop checkbox on a PNG
                                         is a control over nothing. -->
                                    <CheckBox Content="{l:T scenes.loop}" IsChecked="{Binding Loop}"
                                              Margin="144,6,0,0"
                                              Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="{l:T scenes.loop.tip}"/>

                                    <!-- And only for a video that actually carries sound, which
                                         is read from the file's own header. -->
                                    <Grid Margin="0,6,0,0"
                                          Visibility="{Binding HasAudioTrack, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{l:T scenes.volume}" Grid.Column="0" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="{Binding Volume, UpdateSourceTrigger=PropertyChanged}"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ToolTip="{l:T scenes.howLoudVideoS.tip}"/>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   MinWidth="34" Foreground="Gray" FontSize="10"
                                                   Text="{Binding Volume, StringFormat={}{0:P0}}"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T scenes.frameCoreSpriterenderer}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="{l:T scenes.pickVanillaFrameShipped}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T scenes.vanillaFrame}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.VanillaFrameOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Token"
                                                  SelectedValue="{Binding VanillaFrame, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  Text="{Binding VanillaFrame, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{l:T scenes.filenameFramePluginS.tip}"/>
                                        <TextBlock Text="{l:T scenes.customFrame}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:PathPickerBox Grid.Row="1" Grid.Column="1"
                                                           PathText="{Binding CustomFrameSprite, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           ToolTip="{l:T scenes.packRelativePNGPath.tip}"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T scenes.soundReplacesPrototypeS}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T scenes.mode}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding DataContext.SceneSoundModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Sound, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{l:T scenes.silentStripsPrototypeS.tip}"/>
                                </Grid>
                            </GroupBox>

                            <!-- Off by default and per scene. A pack whose scenes
                                 are story art would otherwise have every one of
                                 them paying out followers and raising the day's
                                 income. -->
                            <GroupBox Header="{l:T scenes.starmaker}">
                                <StackPanel>
                                    <CheckBox Content="{l:T scenes.starmakerPhoto}"
                                              IsChecked="{Binding StarmakerPhoto, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{l:T scenes.starmakerPhoto.tip}"/>
                                    <TextBlock Text="{l:T scenes.starmakerPhoto.note}"
                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap"
                                               Margin="20,4,4,0"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 MUSIC TAB
                 Pack-authored music tracks. Each track becomes a
                 sibling of vanilla audio under 12_AudioPlayer with
                 the key as its GameObject name — the existing
                 SwitchMusic node action finds it by name.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T music.music}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T music.music}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addMusic" Content="{l:T music.addMusic}"   Command="{Binding AddMusicCommand}"/>
                            <Button Content="{l:T music.unitAddFolder}" Tag="{Binding MusicTree}" Click="UnitAddFolder_Click"
                                    ToolTip="{l:T music.unitAddFolder.tip}"/>
                            <Button Content="{l:T music.unitRenameFolder}" Tag="{Binding MusicTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="{l:T music.unitRenameFolder.tip}"/>
                            <Button Content="{l:T music.removeMusic}" Command="{Binding RemoveMusicCommand}"
                                    ToolTip="{l:T music.removeMusic.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding MusicTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="MusicTreeView"
                                 ItemsSource="{Binding MusicTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="{l:T music.musicTreeView.tip}"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:musicDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedMusic}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <GroupBox Header="{l:T music.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T music.displayName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="{l:T music.whatCalledEditorS.tip}"  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T music.runtimeName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T music.namePackItselfUses.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T music.audio}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T music.audioPath}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctl:PathPickerBox PathText="{Binding AudioPath, UpdateSourceTrigger=PropertyChanged}"
                                                       PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Filter="{x:Static view:PickerFilters.Audio}"
                                                       Grid.Row="0" Grid.Column="1"
                                                       ToolTip="{l:T music.packRelativePathOGG.tip}"/>
                                    <TextBlock Text="{l:T music.loop}"        Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding LoopText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                              ToolTip="{l:T music.leaveBlankInheritVanilla.tip}"/>
                                    <TextBlock Text="{l:T music.volume}"      Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding VolumeText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"
                                              ToolTip="{l:T music.01BlankInherit.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T music.preview}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{l:T music.playMusic}" Padding="10,2"
                                            Command="{Binding DataContext.PlayMusicCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{l:T music.playMusic.tip}"/>
                                    <Button Content="{l:T music.stopMusic}" Padding="10,2" Margin="6,0,0,0"
                                            Command="{Binding DataContext.StopMusicCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="10"
                                               Text="{l:T music.playsThroughEditorS}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 SFX TAB
                 Pack-authored one-shot sound effects. Variants are
                 auto-detected from disk (<key>_1.ogg, <key>_2.ogg,
                 …) — the registry picks one at random per play.
                 textPatterns lets authors register *plap* / *smooch*
                 style triggers that fire automatically when matched
                 in a dialogue node's text.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T sfx.sfx}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T sfx.sfx}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addSfx" Content="{l:T sfx.addSfx}"     Command="{Binding AddSfxCommand}"/>
                            <Button Content="{l:T sfx.unitAddFolder}" Tag="{Binding SfxTree}" Click="UnitAddFolder_Click"
                                    ToolTip="{l:T sfx.unitAddFolder.tip}"/>
                            <Button Content="{l:T sfx.unitRenameFolder}" Tag="{Binding SfxTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="{l:T sfx.unitRenameFolder.tip}"/>
                            <Button Content="{l:T sfx.removeSfx}" Command="{Binding RemoveSfxCommand}"
                                    ToolTip="{l:T sfx.removeSfx.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding SfxTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="SfxTreeView"
                                 ItemsSource="{Binding SfxTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="{l:T sfx.sfxTreeView.tip}"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:sfxDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedSfx}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <GroupBox Header="{l:T sfx.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T sfx.displayName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="{l:T sfx.whatCalledEditorS.tip}"  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T sfx.runtimeName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T sfx.namePackItselfUses.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T sfx.audio}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="{l:T sfx.packRelativePathBase}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T sfx.audioPath}"     Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:PathPickerBox PathText="{Binding AudioPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T sfx.audioFileRelativePack.tip}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Filter="{x:Static view:PickerFilters.Audio}"
                                                           Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="{l:T sfx.defaultVolume}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox  Text="{Binding DefaultVolumeText, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"
                                                  ToolTip="{l:T sfx.01UsedPlaysfx.tip}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="{l:T sfx.playSfx}" Padding="10,2"
                                                Command="{Binding DataContext.PlaySfxCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{l:T sfx.playSfx.tip}"/>
                                        <Button Content="{l:T sfx.stopSfx}" Padding="10,2" Margin="6,0,0,0"
                                                Command="{Binding DataContext.StopSfxCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="10"
                                                   Text="{l:T sfx.playsThroughEditorS}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T sfx.autoTriggerPatterns}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="{l:T sfx.commaSeparatedListText}"/>
                                    <TextBox  Text="{Binding TextPatternsCsv, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T sfx.wordsFireEffectTheir.tip}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 WALLPAPERS TAB
                 Pack-declared desktop wallpapers for the in-game PC.
                 Each is gated by a single VariableEquals condition
                 (typically Event_Seen*) — the editor reduces that
                 condition to two simple fields (variable name +
                 expected value) so authors don't have to hand-author
                 NodeConditionDef structures for the common case.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T wallpapers.wallpapers}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T wallpapers.wallpapers}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addWallpaper" Content="{l:T wallpapers.addWallpaper}" Command="{Binding AddWallpaperCommand}"/>
                            <Button Content="{l:T wallpapers.unitAddFolder}" Tag="{Binding WallpaperTree}" Click="UnitAddFolder_Click"
                                    ToolTip="{l:T wallpapers.unitAddFolder.tip}"/>
                            <Button Content="{l:T wallpapers.unitRenameFolder}" Tag="{Binding WallpaperTree}" Click="UnitRenameFolder_Click"
                                    ToolTip="{l:T wallpapers.unitRenameFolder.tip}"/>
                            <Button Content="{l:T wallpapers.removeWallpaper}" Command="{Binding RemoveWallpaperCommand}"
                                    ToolTip="{l:T wallpapers.removeWallpaper.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding WallpaperTree.Filter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="WallpaperTreeView"
                                 ItemsSource="{Binding WallpaperTree.Tree}"
                                 ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                 AllowDrop="True"
                                 ToolTip="{l:T wallpapers.wallpaperTreeView.tip}"/>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:wallpaperDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedWallpaper}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- ── Preview ── the wallpaper as the game frames it (16:9, fitted).
                                 Large by design: sizing up a wallpaper is the point of looking. -->
                            <GroupBox Header="{l:T wallpapers.preview}">
                                <ctl:WallpaperPreview PackRoot="{Binding DataContext.PackRoot,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SpritePath="{Binding SpritePath}"
                                                      ExternalSpritePath="{Binding ExternalSpritePath}"/>
                            </GroupBox>

                            <GroupBox Header="{l:T wallpapers.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T wallpapers.displayName}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="{l:T wallpapers.whatCalledEditorS.tip}"  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Text="{l:T wallpapers.runtimeName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T wallpapers.runtimeName.tip}"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T wallpapers.namePackItselfUses.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T wallpapers.image19201080}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="{l:T wallpapers.spritePathPackRelative}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T wallpapers.spritePath}"   Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ctl:PathPickerBox ToolTip="{l:T wallpapers.imageRelativePackFolder.tip}" PathText="{Binding SpritePath, UpdateSourceTrigger=PropertyChanged}"
                                                           PackRoot="{Binding DataContext.PackRoot, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="{l:T wallpapers.externalPath}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                        <!-- Absolute path by design (no PackRoot): the legacy external slot points
                                             outside the pack, so the picker stores the full path. -->
                                        <ctl:PathPickerBox ToolTip="{l:T wallpapers.absolutePathImageOutside.tip}" PathText="{Binding ExternalSpritePath, UpdateSourceTrigger=PropertyChanged}"
                                                           Grid.Row="1" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Standard condition rows (same editor as dialogues / rules /
                                 hooks) — AND semantics, groups, cross-tab copy/paste. -->
                            <GroupBox Header="{l:T wallpapers.unlockConditionsAllMust}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="{l:T wallpapers.addUnlockCondition}" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding AddUnlockConditionCommand}"/>
                                        <Button Content="{l:T wallpapers.addUnlockConditionGroup}" Padding="8,2"
                                                ToolTip="{l:T wallpapers.addUnlockConditionGroup.tip}"
                                                Command="{Binding AddUnlockConditionGroupCommand}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="{l:T wallpapers.copyUnlockConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyUnlockConditionsCommand}"
                                                ToolTip="{l:T wallpapers.copyUnlockConditions.tip}"/>
                                        <Button Content="{l:T wallpapers.pasteUnlockConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteUnlockConditionsCommand}"
                                                ToolTip="{l:T wallpapers.pasteUnlockConditions.tip}"/>
                                        <Button Content="{l:T wallpapers.overwriteUnlockConditions}" Padding="8,2"
                                                Command="{Binding OverwriteUnlockConditionsCommand}"
                                                ToolTip="{l:T wallpapers.overwriteUnlockConditions.tip}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding UnlockConditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 VARIABLES TAB
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T variables.variables}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T variables.variables}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addVariable" Content="{l:T variables.addVariable}" Command="{Binding AddVariableCommand}"/>
                            <Button Content="{l:T variables.addVariableFolder}"   Command="{Binding AddVariableFolderCommand}"
                                    ToolTip="{l:T variables.addVariableFolder.tip}"/>
                            <Button Content="{l:T variables.renameVariableFolder}"     Click="RenameVariableFolder_Click"
                                    ToolTip="{l:T variables.renameVariableFolder.tip}"/>
                            <Button Content="{l:T variables.removeVariable}"   Command="{Binding RemoveVariableCommand}"
                                    ToolTip="{l:T variables.removeVariable.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding VariableTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="VariableTreeView"
                                  ItemsSource="{Binding VariableTree}"
                                  SelectedItemChanged="VariableTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="VariableTree_PreviewMouseLeftButtonDown"
                                  MouseMove="VariableTree_MouseMove"
                                  Drop="VariableTree_Drop"
                                  ToolTip="{l:T variables.variableTreeView.tip}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter Property="Background" Value="#5578A8E0"/>
                                        </DataTrigger>
                                                                            <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
</Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:VariableFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:VariableLeafNode}">
                                    <TextBlock Text="{Binding Variable.Name}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:variableDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedVariable}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                                <StackPanel.Style>
                                    <!-- Nothing selected means nothing to edit. Without this the
                                         whole form sits there looking editable, bound to null. -->
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <GroupBox Header="{l:T variables.definition}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{l:T variables.name}"          Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" ToolTip="{l:T variables.whatConditionsActionsPV.tip}"/>
                                    <TextBlock Text="{l:T variables.type}"          Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox ToolTip="{l:T variables.boolYesNoInt.tip}" Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding DataContext.VariableTypes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{l:T variables.defaultValue}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsList}" Value="True">
                                                        <Setter Property="Text" Value="{l:T variables.initialValues}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Scalar default (String / Int / Float). Numeric types get
                                         input filtering in the VM setter — non-numeric keystrokes
                                         are rejected and the box snaps back. -->
                                    <TextBox  view:IssueTarget.Field="defaultValue" Grid.Row="2" Grid.Column="1"
                                              Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding IsScalarText, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                              ToolTip="{l:T variables.intFloatVariablesOnly.tip}"/>
                                    <!-- Bool default: two buttons rather than one tick, the same
                                         pair the Variable condition and the Set-variable action
                                         use. A tick says "starts true" and says nothing about the
                                         other case: an unticked box reads as "not set" just as
                                         easily as "starts false", and a default is exactly the
                                         thing an author wants stated rather than implied. -->
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,3,0,0"
                                                Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <RadioButton Content="{l:T variables.startsTrue}" Margin="0,0,12,0"
                                                     VerticalAlignment="Center"
                                                     IsChecked="{Binding DefaultBool, Mode=TwoWay}"
                                                     ToolTip="{l:T variables.startsTrue.tip}"/>
                                        <RadioButton Content="{l:T variables.startsFalse}" VerticalAlignment="Center"
                                                     IsChecked="{Binding DefaultBool, Mode=TwoWay,
                                                                 Converter={StaticResource InverseBoolConverter}}"
                                                     ToolTip="{l:T variables.startsFalse.tip}"/>
                                    </StackPanel>
                                    <!-- List initial values (add as many as needed) -->
                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                Visibility="{Binding IsList, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                        <ItemsControl ItemsSource="{Binding InitialValues}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ListValueRow}">
                                                    <Grid Margin="0,0,0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <Button Grid.Column="1" Content="−" Width="22" Margin="4,0,0,0"
                                                                Command="{Binding RemoveCommand}" ToolTip="{l:T variables.remove.tip}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{l:T variables.addInitialValue}" HorizontalAlignment="Left" Padding="8,2" Margin="0,2,0,0"
                                                Command="{Binding DataContext.AddInitialValueCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{l:T variables.addInitialValue.tip}"/>
                                    </StackPanel>
                                    <CheckBox view:TutorialAnchor.Id="field:persisted" Content="{l:T variables.persisted}"
                                              IsChecked="{Binding Persisted}" ToolTip="{l:T variables.persisted.tip}"
                                              Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0"/>
                                    <!-- Refresh mode: None / Daily reset / Daily random roll / Per-level-enter random roll.
                                         Daily is a once-per-day reset; DailyRandom / LevelRandom are random-gate
                                         generalisations — LevelRandom plus a Scope token re-rolls on entry to a
                                         specific level (gated on that level's activeSelf in vanilla). -->
                                    <TextBlock Text="{l:T variables.refreshMode}"  Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.VariableRefreshModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding RefreshMode, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{l:T variables.neverNoAutoRefresh.tip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static l:EnumTextConverter.Instance}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- Scope picker — only meaningful when RefreshMode is LevelRandom. The binding to
                                         IsLevelScoped greys it out otherwise so the relationship is obvious. The picker
                                         reuses LevelOptions so the same token format works in both LevelActive conditions
                                         and here. -->
                                    <TextBlock Text="{l:T variables.refreshLevel}" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <!-- SelectedValue only. Binding Text to the same
                                         property as well, with IsEditable and a
                                         DisplayMemberPath, made the two fight: picking
                                         an item wrote the token, then the display text
                                         wrote back over it and the field came out
                                         empty. The vanilla-source picker has always
                                         been a plain SelectedValue combo for this
                                         reason. -->
                                    <ComboBox Style="{StaticResource GroupedComboBox}" Grid.Row="5" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.LevelOptionsGrouped,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="DisplayLabel"
                                              SelectedValuePath="Token"
                                              SelectedValue="{Binding RefreshScope, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsLevelScoped}"
                                              ToolTip="{l:T variables.levelWhoseActivationRe.tip}">
                                        <ComboBox.GroupStyle>
                                            <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                    <TextBlock Text="{l:T variables.minValue}"     Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="6" Grid.Column="1" Margin="0,4,0,0"
                                              IsEnabled="{Binding IsNumeric}"
                                              ToolTip="{l:T variables.optionalLowerClampInt.tip}"/>
                                    <TextBlock Text="{l:T variables.maxValue}"     Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox  Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}"
                                              Grid.Row="7" Grid.Column="1"
                                              IsEnabled="{Binding IsNumeric}"
                                              ToolTip="{l:T variables.optionalUpperClampInt.tip}"/>
                                    <TextBlock Text="{l:T variables.description}"   Grid.Row="8" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
 ToolTip="{l:T variables.noteYourselfShownOnly.tip}"                                              Grid.Row="8" Grid.Column="1" Margin="0,4,0,0"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 INTEGRATION TAB
                 Free-floating "if condition then actions" rules
                 evaluated each frame by the pack runtime. Same
                 condition / action vocabulary as dialogue nodes —
                 reuses the ConditionRowTemplate / ActionRowTemplate
                 from the Dialogues tab so authoring feels identical.
                 Each rule has a "Code mode" toggle that swaps the
                 picker UI for a JSON textbox with live validation,
                 for power users who want to author rules as text.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T integration.integration}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T integration.updateRules}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <Button view:TutorialAnchor.Id="btn:addRule" Content="{l:T integration.addIntegrationRule}"   Command="{Binding AddIntegrationRuleCommand}"/>
                            <Button Content="{l:T integration.addIntegrationFolder}" Command="{Binding AddIntegrationFolderCommand}"
                                    ToolTip="{l:T integration.addIntegrationFolder.tip}"/>
                            <Button Content="{l:T integration.renameIntegrationFolder}"   Click="RenameIntegrationFolder_Click"
                                    ToolTip="{l:T integration.renameIntegrationFolder.tip}"/>
                            <Button Content="{l:T integration.removeIntegrationRule}" Command="{Binding RemoveIntegrationRuleCommand}"
                                    ToolTip="{l:T integration.removeIntegrationRule.tip}"/>
                        </ToolBar>
                        <ContentControl DockPanel.Dock="Top" Focusable="False"
                                        DataContext="{Binding IntegrationTreeFilter}"
                                        Template="{StaticResource SidebarSearchTemplate}"/>
                        <TreeView x:Name="IntegrationTreeView"
                                  ItemsSource="{Binding IntegrationTree}"
                                  SelectedItemChanged="IntegrationTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="IntegrationTree_PreviewMouseLeftButtonDown"
                                  MouseMove="IntegrationTree_MouseMove"
                                  Drop="IntegrationTree_Drop"
                                  ToolTip="{l:T integration.integrationTreeView.tip}">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                            <Setter Property="Background" Value="#5578A8E0"/>
                                        </DataTrigger>
                                                                            <!-- Sidebar search: filtered-out rows collapse away. -->
                                        <DataTrigger Binding="{Binding IsFilteredIn}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
</Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:IntegrationFolderNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type vm:IntegrationLeafNode}">
                                    <TextBlock Text="{Binding Rule.Display}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedIntegrationRule}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <GroupBox Header="{l:T integration.identity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:T integration.displayName}"  Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox ToolTip="{l:T integration.whatCalledEditorS.tip}"  Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>

                                    <TextBlock Text="{l:T integration.runtimeName}"  Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                               ToolTip="{l:T integration.runtimeName.tip}"/>
                                    <!-- Read-only: the runtime name is written from the display name, so
                                         there is nothing to type. Still a TextBox rather than a TextBlock
                                         because it has to be selectable - the log, the validation messages
                                         and cross-pack references all quote this string back at you. -->
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Key, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             ToolTip="{l:T integration.namePackItselfUses.tip}"/>

                                    <TextBlock Text="{l:T integration.description}"   Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                    <TextBox  Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                              AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"
                                              ToolTip="{l:T integration.freeTextShownEditor.tip}"/>

                                    <!-- Trigger mode: when does the action list fire relative to the conditions transitioning?
                                         OnRisingEdge is the most common ('when X becomes true, do Y, once'). WhilePassing fires every frame
                                         while conditions hold (rare; for live syncs). OnSceneLoad / OnDayChange are one-shots armed by the
                                         pack's lifecycle events. -->
                                    <TextBlock Text="{l:T integration.triggerMode}"  Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                    <ComboBox view:TutorialAnchor.Id="field:triggerMode" Grid.Row="3" Grid.Column="1" Margin="0,4,0,0"
                                              ItemsSource="{Binding DataContext.UpdateRuleTriggerModes,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding TriggerMode, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{l:T integration.triggerMode.tip}"/>

                                    <!-- No keypress, unlike the dialogue flag: a rule that
                                         fails to fire leaves no trace at all, and the moment
                                         worth seeing is usually a single frame during a day
                                         change. Logs on decision CHANGE, so it stays quiet. -->
                                    <CheckBox view:TutorialAnchor.Id="field:ruleDebug" Content="{l:T integration.ruleDebug}" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"
                                              IsChecked="{Binding DebugConditions}"
                                              ToolTip="{l:T integration.ruleDebug.tip}"/>
                                </Grid>
                            </GroupBox>

                            <!-- Parameterization: run the same rule once per value, substituting
                                 {name} through its conditions and actions. Turns "one rule per
                                 subject" into one authored rule. -->
                            <GroupBox Header="{l:T integration.repeatEachOptional}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"
                                               Text="{l:T integration.runsWholeRuleOnce}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T integration.eachValue}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding DataContext.ListVariableNameOptions,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                  IsEditable="True"
                                                  Text="{Binding ForEach, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{l:T integration.listVariableNameLiteral.tip}"/>
                                        <TextBlock Text="{l:T integration.placeholderName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                                 Text="{Binding ForEachAs, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{l:T integration.whatWriteInsideBraces.tip}"/>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- Mode toggle. Picker mode (default) renders the conditions + actions as rows;
                                 code mode swaps in a JSON textbox so power users can paste / hand-author the rule body. -->
                            <GroupBox Header="{l:T integration.editingMode}">
                                <StackPanel>
                                    <CheckBox Content="{l:T integration.codeModeEditConditions}"
                                              IsChecked="{Binding CodeMode}"
                                              ToolTip="{l:T integration.codeModeEditConditions.tip}"/>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Text="{l:T integration.pickerModePickAction}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Picker view: conditions list + actions list, hidden when CodeMode=true. -->
                            <GroupBox view:TutorialAnchor.Id="panel:ruleConditions" Header="{l:T integration.ruleConditions}"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="{l:T integration.addIntegrationCondition}" Margin="0,0,4,0" Padding="8,2"
                                                Command="{Binding DataContext.AddIntegrationConditionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Button Content="{l:T integration.addIntegrationConditionGroup}" Padding="8,2"
                                                ToolTip="{l:T integration.addIntegrationConditionGroup.tip}"
                                                Command="{Binding DataContext.AddIntegrationConditionGroupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="{l:T integration.copyConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyConditionsCommand}"
                                                ToolTip="{l:T integration.copyConditions.tip}"/>
                                        <Button Content="{l:T integration.pasteConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteConditionsCommand}"
                                                ToolTip="{l:T integration.pasteConditions.tip}"/>
                                        <Button Content="{l:T integration.overwriteConditions}" Padding="8,2"
                                                Command="{Binding OverwriteConditionsCommand}"
                                                ToolTip="{l:T integration.overwriteConditions.tip}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Conditions}"
                                                  ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:ruleActionsBox" Header="{l:T integration.ruleActionsBox}"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button view:TutorialAnchor.Id="field:ruleActions" Content="{l:T integration.addIntegrationAction}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.AddIntegrationActionCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <Border Width="1" Background="LightGray" Margin="8,2,8,2"/>
                                        <Button Content="{l:T integration.copyConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding CopyActionsCommand}"
                                                ToolTip="{l:T integration.copyConditions.tip2}"/>
                                        <Button Content="{l:T integration.pasteConditions}" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding PasteActionsCommand}"
                                                ToolTip="{l:T integration.pasteConditions.tip2}"/>
                                        <Button Content="{l:T integration.overwriteConditions}" Padding="8,2"
                                                Command="{Binding OverwriteActionsCommand}"
                                                ToolTip="{l:T integration.overwriteConditions.tip2}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Actions}"
                                                  ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                </DockPanel>
                            </GroupBox>

                            <!-- Else-if chain. Tried in order only when the main conditions
                                 (and every earlier branch) fail; the first branch whose
                                 conditions pass supplies the actions that fire. A branch with
                                 no conditions is a plain Else. Rows reuse the same
                                 conditions+actions group template as place enter/exit hooks. -->
                            <GroupBox Header="{l:T integration.elseIfBranchesFirst}"
                                      Visibility="{Binding CodeMode, Converter={StaticResource InverseBoolToVisibility}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                                HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <Button Content="{l:T integration.addBranch}" Padding="8,2"
                                                Command="{Binding AddBranchCommand}"
                                                ToolTip="{l:T integration.addBranch.tip}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                                   Text="{l:T integration.ifRuleSMain}"/>
                                        <ItemsControl ItemsSource="{Binding Branches}"
                                                      ItemTemplate="{StaticResource LevelHookRowTemplate}"/>
                                    </StackPanel>
                                </DockPanel>
                            </GroupBox>

                            <!-- Code view: full rule body as a JSON textbox. Visible only when CodeMode=true.
                                 Validation message above the textbox surfaces parse errors live. -->
                            <GroupBox Header="{l:T integration.ruleBodyJSON}"
                                      Visibility="{Binding CodeMode, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"
                                               Text="{l:T integration.editRuleSTrigger}"/>
                                    <TextBlock Foreground="Red" FontSize="11" Margin="0,0,0,4"
                                               Text="{Binding CodeError}"
                                               Visibility="{Binding IsCodeValid, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    <TextBox ToolTip="{l:T integration.ruleSConditionsActions.tip}"  Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                                              AcceptsReturn="True" AcceptsTab="True"
                                              TextWrapping="NoWrap"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              FontFamily="Consolas, Courier New, monospace"
                                              MinHeight="240"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 UI TAB (index 12 — deliberately last)
                 Added after Integration rather than beside Places so
                 every existing tab keeps its index. Several tests
                 address tabs by number, and a silent renumbering
                 would make them assert about the wrong screen while
                 still passing.

                 An extension holds the WHOLE vanilla screen so it can
                 be edited in place; what reaches the manifest is only
                 what changed, worked out at save time. So the tree on
                 the left can be thousands of rows while the pack stays
                 a few lines, and the "stored" count in the header is
                 what tells an author which is which.
                 ═══════════════════════════════════════════════════ -->
            <TabItem Header="{l:T ui.ui}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4*" MinWidth="240"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="5*" MinWidth="240"/>
                    </Grid.ColumnDefinitions>

                    <!-- Which screens this pack changes -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="{l:T ui.ui}"
                                   FontWeight="Bold" Margin="6,4,0,2"/>
                        <ToolBar DockPanel.Dock="Top">
                            <!-- A button and a menu beside it. The button is
                                 the plain panel in one click; the menu is for
                                 choosing a shape, and the shapes are the
                                 game's own. Keeping the button a Button also
                                 keeps it a keyboard-focus target, which a Menu
                                 is not. -->
                            <Button view:TutorialAnchor.Id="btn:addUiExtension"
                                    Content="{l:T ui.addOwnUi}" Command="{Binding AddOwnUiCommand}"
                                    ToolTip="{l:T ui.addOwnUi.tip}"/>
                            <Menu Background="Transparent">
                            </Menu>
                            <Button Content="{l:T ui.addVanillaUi}" Command="{Binding AddVanillaUiCommand}"
                                    ToolTip="{l:T ui.addVanillaUi.tip}"/>
                            <Button Content="{l:T ui.removeUi}" Command="{Binding RemoveUiCommand}"/>
                        </ToolBar>
                        <ListBox x:Name="UiList" ItemsSource="{Binding Uis}"
                                 SelectedItem="{Binding SelectedUi, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <!-- Which kind, said once here so every row
                                             in the tree below can be about the
                                             objects rather than about the kind. -->
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVanillaBased}" Value="True">
                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.7"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

                    <!-- The screen's objects. The whole column is hidden
                         until a screen is picked: a name box, a tree toolbar and
                         a property panel with nothing behind them are furniture,
                         and they invite clicks that do nothing. -->
                    <DockPanel Grid.Column="2" DataContext="{Binding SelectedUi}"
                               view:TutorialAnchor.Id="panel:uiDetail"
                               Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel DockPanel.Dock="Top" Margin="6,4">
                            <!-- A name and a parenting choice belong to a UI of the
                                 pack's own. One built on a vanilla screen is named
                                 by that screen and inherits its place in the
                                 hierarchy, so these are hidden rather than shown
                                 disabled: a disabled box invites an author to
                                 wonder what would happen if they could use it. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowsScreenPicker}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{l:T ui.name}" FontWeight="Bold"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,2,0,6"/>
                                <!-- What this actually chooses is WHERE the screen
                                     lives: inside the game's own canvas, or on one
                                     of its own with a sorting order. It was labelled
                                     as fading with the game's interface, which it
                                     does not do - fading is a FadeUI signal that an
                                     object has to listen for, not something that
                                     happens by sharing a canvas. -->
                                <CheckBox IsChecked="{Binding HidesWithGameplayUi, Mode=TwoWay}"
                                          Margin="0,0,0,6"
                                          ToolTip="{l:T ui.tickedScreenOneObject.tip}">
                                    <TextBlock Text="{l:T ui.sitInsideGameS}"
                                               TextWrapping="Wrap"/>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding StartsOpen, Mode=TwoWay}"
                                          Margin="0,0,0,6"
                                          ToolTip="{l:T ui.mostUINotScreen.tip}">
                                    <TextBlock Text="{l:T ui.screenStart}" TextWrapping="Wrap"/>
                                </CheckBox>

                                <!-- One decision for the whole screen. Setting a
                                     sound on thirty buttons one at a time is not
                                     authoring, it is data entry. -->
                                <CheckBox IsChecked="{Binding ButtonsMakeSound, Mode=TwoWay}"
                                          Margin="0,0,0,4"
                                          ToolTip="{l:T ui.buttonsScreenClickWhen.tip}">
                                    <TextBlock Text="{l:T ui.buttonsMakeSound}" TextWrapping="Wrap"/>
                                </CheckBox>

                                <ContentControl Content="{Binding Open}"
                                                ContentTemplate="{StaticResource UiOpenTemplate}"
                                                Margin="0,0,0,6"/>

                                <!-- Played by an ACTION switching the screen off.
                                     A screen hidden by an activation condition
                                     goes at once: nothing asked first, and a
                                     deactivated object cannot animate itself. -->
                                <ContentControl Content="{Binding Close}"
                                                ContentTemplate="{StaticResource UiOpenTemplate}"
                                                Margin="0,0,0,6"/>

                                <!-- Blank is not nothing: it is the game's own
                                     click. The line below says so, because a
                                     field that looks empty reads as silent. -->
                                <DockPanel Margin="0,0,0,2"
                                           IsEnabled="{Binding ButtonsMakeSound}">
                                    <TextBlock Text="{l:T ui.buttonSound}" Width="96" VerticalAlignment="Center"/>
                                    <ComboBox IsEditable="True"
                                              Text="{Binding ButtonSound, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.ButtonSoundOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="{l:T ui.leaveBlankGameS.tip}"/>
                                </DockPanel>

                                <TextBlock Margin="96,0,0,6" FontSize="10" Opacity="0.6"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ShowsDefaultButtonSound, Converter={StaticResource BoolToVisibility}}"
                                           Text="{Binding ButtonSoundInEffect}"/>

                                <!-- Only where it does something. Inside the
                                     gameplay canvas this UI is one object among
                                     the game's, and order there is the object
                                     tree below, not a number. -->
                                <DockPanel Margin="0,0,0,6">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowsSortingOrder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <TextBlock Text="{l:T ui.sortingOrder}" Width="90" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding SortingOrder, UpdateSourceTrigger=LostFocus}"
                                             ToolTip="{l:T ui.drawOrderAgainstOther.tip}"/>
                                </DockPanel>
                            </StackPanel>

                            <TextBlock Text="{l:T ui.whichScreen}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowsScreenPicker}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableUiScreens,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValue="{Binding Source, Mode=TwoWay}"
                                      SelectedValuePath="Token" DisplayMemberPath="Id"
                                      IsEditable="False" Margin="0,2,0,0"
                                      ToolTip="{l:T ui.everyUIGameHas.tip}"/>
                            <TextBlock Text="{Binding Warning}" Foreground="#C08A2B" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Stranded}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <ToolBar DockPanel.Dock="Top" Margin="0,4,0,0">
                            <Button view:TutorialAnchor.Id="btn:addUiObject"
                                    Content="{l:T ui.addChild}" Command="{Binding AddChildCommand}"
                                    Style="{StaticResource ToolbarButtonWithKey}" Tag="{l:T ui.addChild.keys}"
                                    ToolTip="{l:T ui.addChild.tip}"/>
                            <Menu Background="Transparent">
                                <!-- A piece of one of the game's screens, brought
                                     in as a child. Its own screens are assembled
                                     this way - the gift window is two lists and a
                                     close button - so a pack building something
                                     similar needs the same pieces. -->
                                <MenuItem x:Name="AddCopyChildMenu" Header="{l:T ui.addCopyChildMenu}"
                                          ToolTip="{l:T ui.addCopyChildMenu.tip}"
                                          ItemsSource="{Binding DataContext.CopyableUiScreens,
                                                        RelativeSource={RelativeSource AncestorType=Window}}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Id}"/>
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.SelectedUi.AddCopyChildCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <!-- Whole shapes belong here too. They used to
                                     sit on the list beside "+ UI", which put
                                     "make a new screen" and "put a window in
                                     this one" in different places for no reason
                                     an author can see. Everything that adds an
                                     object is on the tree; the list only makes
                                     and removes screens. -->
                                <MenuItem x:Name="AddShapeMenu" Header="{l:T ui.addShapeMenu}"
                                          ToolTip="{l:T ui.addShapeMenu.tip}"
                                          ItemsSource="{Binding Source={x:Static model:UiTemplate.Screens}}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}"/>
                                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.SelectedUi.AddChildTemplateCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem x:Name="AddPieceMenu" Header="{l:T ui.addPieceMenu}"
                                          ToolTip="{l:T ui.addPieceMenu.tip}"
                                          ItemsSource="{Binding Source={x:Static model:UiTemplate.Pieces}}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}"/>
                                            <Setter Property="ToolTip" Value="{Binding Summary}"/>
                                            <Setter Property="Command"
                                                    Value="{Binding DataContext.SelectedUi.AddChildTemplateCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <Setter Property="CommandParameter" Value="{Binding}"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </Menu>
                            <Button Content="{l:T ui.removeUi}" Command="{Binding RemoveNodeCommand}"
                                    Style="{StaticResource ToolbarButtonWithKey}" Tag="{l:T ui.removeUi.keys}"
                                    ToolTip="{l:T ui.removeUi.tip}"/>
                            <Separator/>
                            <Button Content="{l:T ui.copyNode}" Command="{Binding CopyNodeCommand}"
                                    Style="{StaticResource ToolbarButtonWithKey}" Tag="{l:T ui.copyNode.keys}"
                                    ToolTip="{l:T ui.copyNode.tip}"/>
                            <Button Content="{l:T ui.pasteNode}" Command="{Binding PasteNodeCommand}"
                                    Style="{StaticResource ToolbarButtonWithKey}" Tag="{l:T ui.pasteNode.keys}"
                                    ToolTip="{l:T ui.pasteNode.tip}"/>
                            <Button Content="{l:T ui.duplicateNode}" Command="{Binding DuplicateNodeCommand}"
                                    Style="{StaticResource ToolbarButtonWithKey}" Tag="{l:T ui.duplicateNode.keys}"
                                    ToolTip="{l:T ui.duplicateNode.tip}"/>
                            <Separator/>
                            <!-- A canvas has no depth: an object is in front of
                                 another because it comes after it. So these are
                                 not a tidying-up tool, they decide what covers
                                 what. -->
                            <Button Content="&#x25B2;" Command="{Binding SelectedNode.MoveUpCommand}"
                                    Style="{StaticResource ToolbarButtonWithKey}"
                                    ToolTip="{l:T ui.moveUp.tip}"/>
                            <Button Content="&#x25BC;" Command="{Binding SelectedNode.MoveDownCommand}"
                                    Style="{StaticResource ToolbarButtonWithKey}"
                                    ToolTip="{l:T ui.moveDown.tip}"/>
                        </ToolBar>

                        <TreeView x:Name="UiTree" view:TutorialAnchor.Id="tree:uiObjects"
                                  ItemsSource="{Binding Nodes}" Margin="0,4,0,0"
                                  SelectedItemChanged="UiTree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="UiTree_MouseDown"
                                  MouseMove="UiTree_MouseMove"
                                  DragOver="UiTree_DragOver"
                                  Drop="UiTree_Drop">
                            <!-- Selection and expansion live on the row, because
                                 a click in the preview has to be able to push a
                                 selection INTO the tree, and TreeView.SelectedItem
                                 is read-only. -->
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <!-- The pack's own objects are marked, because
                                             what may be done to a row depends entirely
                                             on whether the game owns it. -->
                                        <!-- An untouched vanilla row is deliberately
                                             quiet: a screen can hold 1434 of them and
                                             the two or three that were touched are
                                             what an author is looking for. The marker
                                             uses the same rule that decides what gets
                                             saved, so a marked row and a stored row
                                             are the same rows. -->
                                        <Border CornerRadius="2" Padding="4,0" Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="new">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Background" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="changed">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="Background" Value="#B26A00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBlock Text="{Binding Display}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUntouched}" Value="False">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Opacity="0.65" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

                    <!-- What it looks like -->
                    <DockPanel Grid.Column="4">
                        <DockPanel DockPanel.Dock="Top" Margin="6,4,6,2">
                            <TextBlock Text="{l:T ui.preview}" FontWeight="Bold"/>
                        </DockPanel>

                        <!-- Under the picture rather than beside it, so the
                             preview keeps the width. Every box here writes
                             straight through to the model and the picture
                             redraws, which is the whole point of having them
                             next to each other. -->
                        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0"
                                view:TutorialAnchor.Id="panel:uiObjectDetail"
                                BorderBrush="{DynamicResource Theme.Accent}"
                                Padding="8,6" DataContext="{Binding SelectedUi}">
                            <Grid>
                                <TextBlock x:Name="UiNoSelectionHint"
                                           Text="{l:T ui.selectObjectTreeChange}"
                                           Opacity="0.6" Margin="0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Shown by the OWNER's HasSelection rather than by
                                     testing SelectedNode against null, which needs a
                                     converter that does not exist and would be the
                                     same fact spelled twice. -->
                                <StackPanel x:Name="UiNodeFields"
                                            DataContext="{Binding SelectedNode}"
                                            Visibility="{Binding DataContext.HasSelection,
                                                RelativeSource={RelativeSource AncestorType=Border},
                                                Converter={StaticResource BoolToVisibility},
                                                FallbackValue=Collapsed,
                                                TargetNullValue=Collapsed}">

                                    <!-- Name. Read-only on an object the game
                                         owns: the name is what its binding is
                                         built from, so renaming would quietly
                                         unhook the change from the object. -->
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{l:T ui.name}" Width="66" VerticalAlignment="Center"/>
                                        <!-- Only enabled on a vanilla object that
                                             currently differs: on the pack's own
                                             there is no default to go back to, and
                                             on an untouched one it would do
                                             nothing. -->
                                        <Button Content="{l:T ui.reset}" DockPanel.Dock="Right" Padding="8,0"
                                                Margin="6,0,0,0" Command="{Binding ResetCommand}"
                                                ToolTip="{l:T ui.reset.tip}"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsVanilla}"
                                                 ToolTip="{l:T ui.objectsGameOwnsKeep.tip}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{l:T ui.position}" Width="66" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding PositionX, UpdateSourceTrigger=LostFocus}"
                                                 Width="70" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding PositionY, UpdateSourceTrigger=LostFocus}"
                                                 Width="70" Margin="0,0,4,0"/>
                                        <TextBlock Text="{l:T ui.anchorsCanvasPixels}"
                                                   Opacity="0.6" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{l:T ui.size}" Width="66" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Width, UpdateSourceTrigger=LostFocus}"
                                                 Width="70" Margin="0,0,4,0"/>
                                        <TextBox Text="{Binding Height, UpdateSourceTrigger=LostFocus}"
                                                 Width="70" Margin="0,0,4,0"/>
                                        <CheckBox IsChecked="{Binding StartActive}" VerticalAlignment="Center"
                                                  Content="{l:T ui.visibleStart}"
                                                  ToolTip="{l:T ui.visibleStart.tip}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{l:T ui.sprite}" Width="66" VerticalAlignment="Center"/>
                                        <Button Content="..." DockPanel.Dock="Right" Padding="6,0"
                                                Margin="4,0,0,0" Click="PickUiTint_Click"
                                                ToolTip="{l:T ui.pickUiTint.tip}"/>
                                        <TextBox Text="{Binding Tint, UpdateSourceTrigger=LostFocus}"
                                                 Width="86" DockPanel.Dock="Right" Margin="4,0,0,0"
                                                 ToolTip="{l:T ui.tintRRGGBBRRGGBBAAMost.tip}"/>
                                        <Border Width="20" Height="16" DockPanel.Dock="Right"
                                                BorderBrush="#888" BorderThickness="1" Margin="4,0,0,0"
                                                Background="{Binding TintBrush}"
                                                VerticalAlignment="Center"/>
                                        <!-- A box and a picker, not a dropdown.
                                             A dropdown bound to the value writes
                                             as you move through it, so merely
                                             looking put sprites nobody chose onto
                                             the undo stack - and 840 entries is
                                             not a list anyone scrolls anyway. -->
                                        <Button Content="..." DockPanel.Dock="Right" Padding="6,0"
                                                Margin="4,0,0,0" Click="PickUiSprite_Click"
                                                ToolTip="{l:T ui.pickUiSprite.tip}"/>
                                        <TextBox Text="{Binding Sprite, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{l:T ui.spriteGameHasPack.tip}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{l:T ui.text}" Width="66" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}"
                                                 Width="50" DockPanel.Dock="Right" Margin="4,0,0,0"
                                                 ToolTip="{l:T ui.fontSize.tip}"/>
                                        <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{l:T ui.whatObjectSaysClearing.tip}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4"
                                               Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{l:T ui.colour}" Width="66" VerticalAlignment="Center"/>
                                        <Button Content="..." DockPanel.Dock="Right" Padding="6,0"
                                                Margin="4,0,0,0" Click="PickUiTextColor_Click"
                                                ToolTip="{l:T ui.pickUiTint.tip}"/>
                                        <Border Width="20" Height="16" BorderBrush="#888" BorderThickness="1"
                                                Margin="0,0,4,0" Background="{Binding TextColorBrush}"
                                                VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{l:T ui.textColourRRGGBBRRGGBBAA.tip}"/>
                                    </DockPanel>

                                    <!-- When this object is on screen. Checked
                                         every frame in the game, so a shelf
                                         drops what has already been bought
                                         without a rule per item saying so - the
                                         object carries its own condition, which
                                         is where an author looks for it. -->
                                    <Expander Header="{l:T ui.shownWhen}" Margin="0,6,0,0"
                                              IsExpanded="{Binding IsGated, Mode=OneWay}">
                                        <StackPanel Margin="0,4,0,0">
                                            <Button Content="{l:T ui.addActiveCondition}" Padding="8,2"
                                                    HorizontalAlignment="Left" Margin="0,0,0,4"
                                                    Command="{Binding AddActiveConditionCommand}"
                                                    ToolTip="{l:T ui.addActiveCondition.tip}"/>
                                            <ItemsControl ItemsSource="{Binding ActiveConditions}"
                                                          ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"/>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="{l:T ui.whenOpens}" Margin="0,6,0,0"
                                              IsExpanded="{Binding Open.Animates, Mode=OneWay}">
                                        <ContentControl Content="{Binding Open}"
                                                        ContentTemplate="{StaticResource UiOpenTemplate}"
                                                        Margin="0,4,0,0"/>
                                    </Expander>

                                    <Expander Header="{l:T ui.whenCloses}" Margin="0,6,0,0"
                                              IsExpanded="{Binding Close.Animates, Mode=OneWay}">
                                        <ContentControl Content="{Binding Close}"
                                                        ContentTemplate="{StaticResource UiOpenTemplate}"
                                                        Margin="0,4,0,0"/>
                                    </Expander>

                                    <!-- What it does with the things inside it.
                                         The reason to reach for one is a list
                                         that changes: hide an item from fixed
                                         positions and it leaves a hole, while a
                                         row that arranges itself closes ranks. -->
                                    <Expander Header="{l:T ui.arrangeChildren}" Margin="0,6,0,0"
                                              IsExpanded="{Binding Arranges, Mode=OneWay}">
                                        <StackPanel Margin="0,4,0,0">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{l:T ui.arrange}" Width="66" VerticalAlignment="Center"/>
                                                <ComboBox SelectedValue="{Binding Arrange, Mode=TwoWay}"
                                                          ItemsSource="{Binding Source={x:Static vm:UiNodeViewModel.ArrangeOptions}}"
                                                          ToolTip="{l:T ui.noneLeavesEveryChild.tip}"/>
                                            </DockPanel>

                                            <StackPanel Visibility="{Binding Arranges, Converter={StaticResource BoolToVisibility}}">
                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="{l:T ui.spacing}" Width="66" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding SpacingX, UpdateSourceTrigger=LostFocus}"
                                                             Width="60" Margin="0,0,4,0"
                                                             ToolTip="{l:T ui.gapBetweenChildrenGrid.tip}"/>
                                                    <TextBox Text="{Binding SpacingY, UpdateSourceTrigger=LostFocus}"
                                                             Width="60" Margin="0,0,4,0"
                                                             Visibility="{Binding ArrangesAsGrid, Converter={StaticResource BoolToVisibility}}"/>
                                                    <ComboBox SelectedValue="{Binding ArrangeAlign, Mode=TwoWay}"
                                                              ItemsSource="{Binding Source={x:Static vm:UiNodeViewModel.AlignOptions}}"
                                                              ToolTip="{l:T ui.whereArrangedBlockSits.tip}"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,0,0,4">
                                                    <TextBlock Text="{l:T ui.padding}" Width="66" VerticalAlignment="Center"
                                                               ToolTip="{l:T ui.padding.tip}"/>
                                                    <TextBox Text="{Binding PadLeft, UpdateSourceTrigger=LostFocus}" Width="44" Margin="0,0,3,0"/>
                                                    <TextBox Text="{Binding PadRight, UpdateSourceTrigger=LostFocus}" Width="44" Margin="0,0,3,0"/>
                                                    <TextBox Text="{Binding PadTop, UpdateSourceTrigger=LostFocus}" Width="44" Margin="0,0,3,0"/>
                                                    <TextBox Text="{Binding PadBottom, UpdateSourceTrigger=LostFocus}" Width="44"/>
                                                </DockPanel>

                                                <!-- Rows and columns only. -->
                                                <WrapPanel Margin="0,0,0,4"
                                                           Visibility="{Binding ArrangesInLine, Converter={StaticResource BoolToVisibility}}">
                                                    <CheckBox IsChecked="{Binding SetsChildWidth}" Content="{l:T ui.setWidth}" Margin="0,0,10,0"
                                                              ToolTip="{l:T ui.setWidth.tip}"/>
                                                    <CheckBox IsChecked="{Binding SetsChildHeight}" Content="{l:T ui.setHeight}" Margin="0,0,10,0"/>
                                                    <CheckBox IsChecked="{Binding SharesWidth}" Content="{l:T ui.shareWidth}" Margin="0,0,10,0"
                                                              ToolTip="{l:T ui.shareWidth.tip}"/>
                                                    <CheckBox IsChecked="{Binding SharesHeight}" Content="{l:T ui.shareHeight}" Margin="0,0,10,0"/>
                                                    <CheckBox IsChecked="{Binding ArrangeReversed}" Content="{l:T ui.reverse}"
                                                              ToolTip="{l:T ui.reverse.tip}"/>
                                                </WrapPanel>

                                                <!-- Grid only. -->
                                                <DockPanel Margin="0,0,0,4"
                                                           Visibility="{Binding ArrangesAsGrid, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{l:T ui.cell}" Width="66" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding ArrangeConstraintCount, UpdateSourceTrigger=LostFocus}"
                                                             Width="44" DockPanel.Dock="Right"
                                                             ToolTip="{l:T ui.howManyColumnsHow.tip}"/>
                                                    <TextBox Text="{Binding CellWidth, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,4,0"/>
                                                    <TextBox Text="{Binding CellHeight, UpdateSourceTrigger=LostFocus}" Width="60" Margin="0,0,4,0"/>
                                                    <ComboBox SelectedValue="{Binding ArrangeConstraint, Mode=TwoWay}"
                                                              ItemsSource="{Binding Source={x:Static vm:UiNodeViewModel.ConstraintOptions}}"
                                                              Margin="0,0,4,0"
                                                              ToolTip="{l:T ui.flexibleFitsManyAcross.tip}"/>
                                                </DockPanel>

                                                <CheckBox IsChecked="{Binding CentersLastLine}"
                                                          Margin="0,0,0,4"
                                                          Visibility="{Binding ArrangesAsGrid, Converter={StaticResource BoolToVisibility}}"
                                                          ToolTip="{l:T ui.nineteenThingsRowsSeven.tip}">
                                                    <TextBlock Text="{l:T ui.centreLastRowNot}"
                                                               TextWrapping="Wrap"/>
                                                </CheckBox>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- What clicking it does. Empty means the
                                         object is decoration and the pointer
                                         passes straight through it, which is
                                         what most of a screen should do. -->
                                    <Expander Header="{l:T ui.whenClicked}" Margin="0,6,0,0"
                                              IsExpanded="{Binding IsClickable, Mode=OneWay}">
                                        <StackPanel Margin="0,4,0,0">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{l:T ui.hover}" Width="66" VerticalAlignment="Center"/>
                                                <Button Content="..." DockPanel.Dock="Right" Padding="6,0"
                                                        Margin="4,0,0,0" Click="PickUiHoverTint_Click"
                                                        ToolTip="{l:T ui.pickUiTint.tip}"/>
                                                <Border Width="20" Height="16" DockPanel.Dock="Right"
                                                        BorderBrush="#888" BorderThickness="1" Margin="4,0,0,0"
                                                        Background="{Binding HoverTintBrush}"
                                                        VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding HoverTint, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="{l:T ui.tintWhilePointerOver.tip}"/>
                                            </DockPanel>

                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{l:T ui.sound}" Width="66" VerticalAlignment="Center"/>
                                                <ComboBox IsEditable="True"
                                                          Text="{Binding ClickSound, UpdateSourceTrigger=PropertyChanged}"
                                                          ItemsSource="{Binding DataContext.ButtonSoundOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          ToolTip="{l:T ui.whatObjectSoundsLike.tip}"/>
                                            </DockPanel>

                                            <!-- The question the button asks before
                                                 it acts: "is there enough money".
                                                 Without it, anything conditional
                                                 had to be pushed out into a rule
                                                 per item, with the click reduced
                                                 to writing down what was asked. -->
                                            <Button Content="{l:T ui.addClickCondition}" Padding="8,2"
                                                    HorizontalAlignment="Left" Margin="0,0,0,4"
                                                    Command="{Binding AddClickConditionCommand}"
                                                    ToolTip="{l:T ui.addClickCondition.tip}"/>
                                            <ItemsControl ItemsSource="{Binding ClickConditions}"
                                                          ItemTemplateSelector="{StaticResource ConditionTemplateSelector}"
                                                          Margin="0,0,0,4"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Button Content="{l:T ui.addAction}" Padding="8,2" Margin="0,0,4,0"
                                                        Command="{Binding AddActionCommand}"
                                                        ToolTip="{l:T ui.addAction.tip}"/>
                                                <Button Content="{l:T ui.copyActions}" Padding="8,2" Margin="0,0,4,0"
                                                        Command="{Binding CopyActionsCommand}"/>
                                                <Button Content="{l:T ui.pasteNode}" Padding="8,2" Margin="0,0,4,0"
                                                        Command="{Binding PasteActionsCommand}"/>
                                                <Button Content="{l:T ui.overwriteActions}" Padding="8,2"
                                                        Command="{Binding OverwriteActionsCommand}"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Actions}"
                                                          ItemTemplate="{StaticResource ActionRowTemplate}"/>
                                        </StackPanel>
                                    </Expander>

                                    <DockPanel Margin="0,0,0,2"
                                               Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{l:T ui.font}" Width="66" VerticalAlignment="Center"/>
                                        <!-- PropertyChanged, not LostFocus. An undo
                                             step is marked when focus leaves, so
                                             committing on focus loss TOO means the
                                             open/close of the dropdown lands
                                             mid-browse and each visit leaves steps
                                             for values nobody chose. Tracking the
                                             highlight live and checkpointing once
                                             on the way out gives one step holding
                                             what was actually picked. -->
                                        <ComboBox IsEditable="True"
                                                  Text="{Binding Font, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding Source={x:Static rend:VanillaUiLibrary.FontNames}}"
                                                  ToolTip="{l:T ui.textmeshproFontAssetNot.tip}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ctl:UiPreview x:Name="UiScreenPreview"
                                       view:TutorialAnchor.Id="preview:ui"
                                       BaseToken="{Binding SelectedUiPreviewToken}"
                                       AuthoredRoot="{Binding SelectedUi.RootNode}"
                                       Revision="{Binding SelectedUi.Revision}"
                                       Highlight="{Binding SelectedUi.SelectedModel}"
                                       CanvasWidth="{Binding SelectedUi.CanvasWidth}"
                                       CanvasHeight="{Binding SelectedUi.CanvasHeight}"
                                       Margin="4"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 QUESTS TAB
                 The pack's own quests, shown in the game's journal beside
                 the game's. What happens to one is authored elsewhere, with
                 the Quest action and the quest conditions; this tab says
                 what the quest IS - its title, its description, and its
                 tasks in the order the journal lists them.
                 ════════════════════════════════════════════════════ -->
            <TabItem Header="{l:T quests.quests}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: the pack's quests, and its changes to the game's -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*" MinHeight="90"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Text="{l:T quests.quests}"
                                       FontWeight="Bold" Margin="6,4,0,2"/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button view:TutorialAnchor.Id="btn:addQuest" Content="{l:T quests.addQuest}" Command="{Binding AddQuestCommand}"/>
                                <Button Content="{l:T quests.unitAddFolder}" Tag="{Binding QuestTree}" Click="UnitAddFolder_Click"
                                        ToolTip="{l:T quests.unitAddFolder.tip}"/>
                                <Button Content="{l:T quests.unitRenameFolder}" Tag="{Binding QuestTree}" Click="UnitRenameFolder_Click"
                                        ToolTip="{l:T quests.unitRenameFolder.tip}"/>
                                <Button x:Name="RemoveQuestButton" Content="{l:T quests.removeQuest}" Command="{Binding RemoveQuestCommand}"
                                        ToolTip="{l:T quests.removeQuest.tip}"/>
                            </ToolBar>
                            <ContentControl DockPanel.Dock="Top" Focusable="False"
                                            DataContext="{Binding QuestTree.Filter}"
                                            Template="{StaticResource SidebarSearchTemplate}"/>
                            <TreeView x:Name="QuestTreeView"
                                      ItemsSource="{Binding QuestTree.Tree}"
                                      ItemContainerStyle="{StaticResource UnitTreeItemStyle}"
                                      AllowDrop="True"
                                      ToolTip="{l:T quests.questTreeView.tip}"/>
                        </DockPanel>

                        <GridSplitter Grid.Row="1" Height="4" Background="LightGray"
                                      HorizontalAlignment="Stretch"/>

                        <!-- Changes to quests the game already has. Listed apart from
                             the pack's own because they are a different kind of thing:
                             these are the game's, named by the game, and folders mean
                             nothing to them. -->
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Text="{l:T quests.vanillaQuests}"
                                       FontWeight="Bold" Margin="6,4,0,2"
                                       ToolTip="{l:T quests.vanillaQuests.tip}"/>
                            <ToolBar DockPanel.Dock="Top">
                                <Button x:Name="AddVanillaQuestButton" Content="{l:T quests.addVanillaQuest}" Command="{Binding AddVanillaQuestCommand}"
                                        ToolTip="{l:T quests.addVanillaQuest.tip}"/>
                                <Button x:Name="RemoveVanillaQuestButton" Content="{l:T quests.removeQuest}" Command="{Binding RemoveVanillaQuestCommand}"
                                        ToolTip="{l:T quests.removeQuest.tip2}"/>
                            </ToolBar>
                            <ListBox x:Name="VanillaQuestList"
                                     ItemsSource="{Binding VanillaQuestEntries}"
                                     SelectedItem="{Binding SelectedVanillaQuest, Mode=TwoWay}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QuestViewModel}">
                                        <DockPanel ToolTip="{Binding ChangeSummary}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChangeSummary}"
                                                       Foreground="Gray" FontSize="10"
                                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            <TextBlock Text="{Binding VanillaListName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="4" Background="LightGray" HorizontalAlignment="Stretch"/>

                    <ScrollViewer view:TutorialAnchor.Id="panel:questDetail" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedQuest}"
                                  Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                        <StackPanel Margin="8">
                            <!-- One of the game's own quests, extended. The quest, its tasks
                                 and what finishes them are the game's; everything here is
                                 what the pack says about it as the player works through it. -->
                            <GroupBox x:Name="VanillaQuestPanel" Header="{l:T quests.vanillaQuestPanel}"
                                      Visibility="{Binding ShowsVanillaPanel, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:T quests.quest}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="QuestSourcePicker" Grid.Row="0" Grid.Column="1" IsEditable="True"
                                              ItemsSource="{x:Static vm:QuestViewModel.VanillaQuestOptions}"
                                              Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="{l:T quests.questSourcePicker.tip}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,4"
                                               Text="{Binding SourceNote}"/>

                                    <TextBlock Text="{l:T quests.gameSays}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,3,6,0"
                                               TextWrapping="Wrap"/>
                                    <TextBox x:Name="VanillaQuestDescriptionShown" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                                             Text="{Binding TheGamesDescription, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             BorderThickness="0" Background="Transparent" Padding="0"
                                             Foreground="Gray" Cursor="Arrow"
                                             TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                             ToolTip="{l:T quests.vanillaQuestDescriptionShown.tip}"/>

                                    <TextBlock Text="{l:T quests.description}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <DockPanel Grid.Row="3" Grid.Column="1">
                                        <Button x:Name="VanillaQuestDescriptionReset" DockPanel.Dock="Right" Content="{l:T quests.resetDescription}"
                                                Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Top"
                                                Command="{Binding ResetDescriptionCommand}"
                                                Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="{l:T quests.resetDescription.tip}"/>
                                        <TextBox x:Name="VanillaQuestDescriptionBox"
                                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="{l:T quests.vanillaQuestDescriptionBox.tip}"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Text="{Binding DescriptionNote}"/>
                                    <!-- How much the entry changes, and the way back from all of it -
                                         the same header a changed conversation has. -->
                                    <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <TextBlock Text="{l:T quests.changes}" Width="140" VerticalAlignment="Center"/>
                                        <Button x:Name="VanillaQuestResetAll" DockPanel.Dock="Right" Content="{l:T quests.vanillaQuestResetAll}" Padding="8,1"
                                                Click="ResetVanillaQuest_Click" IsEnabled="{Binding HasChanges}"
                                                ToolTip="{l:T quests.vanillaQuestResetAll.tip}"/>
                                        <TextBlock x:Name="VanillaQuestChangeSummary" Text="{Binding ChangeSummary}"
                                                   VerticalAlignment="Center" Foreground="Gray"/>
                                    </DockPanel>
                                    <!-- Said wherever the entry changes the quest's shape, because
                                         that is what can leave a player's save unable to finish it. -->
                                    <Border x:Name="QuestTreeChangeWarning" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                            Margin="0,6,0,0" Padding="6,4" BorderThickness="1"
                                            BorderBrush="#FFB06A00" Background="#1FB06A00"
                                            Visibility="{Binding WarnsOnLoad, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Foreground="#FFB06A00" FontSize="11" TextWrapping="Wrap"
                                                   Text="{Binding LoadWarningText}"/>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="{l:T quests.quest2}"
                                      Visibility="{Binding ShowsOwnPanel, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:T quests.title}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="QuestTitleBox" Grid.Row="0" Grid.Column="1"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{l:T quests.questTitleBox.tip}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,4"
                                               Text="{l:T quests.textParenthesesDrawnPink}"/>

                                    <TextBlock Text="{l:T quests.runtimeName}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="2" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="{l:T quests.renameQuest}" Padding="8,0" Margin="6,0,0,0"
                                                Command="{Binding DataContext.RenameQuestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{l:T quests.renameQuest.tip}"/>
                                        <TextBox Text="{Binding Key, Mode=OneWay}"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 Foreground="Gray" Cursor="Arrow" VerticalAlignment="Center"
                                                 ToolTip="{l:T quests.whatActionsConditionsLog.tip}"/>
                                    </DockPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#FFB06A00" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,4"
                                               Text="{l:T quests.gameSavesPlayerS}"/>

                                    <TextBlock Text="{l:T quests.description}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <TextBox x:Name="QuestDescriptionBox" Grid.Row="4" Grid.Column="1"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="{l:T quests.questDescriptionBox.tip}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox view:TutorialAnchor.Id="panel:questStart" Header="{l:T quests.questStart}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{Binding StartNote}"/>
                                    <ContentControl Focusable="False" Content="{Binding StartConditions}"
                                                    ContentTemplate="{StaticResource ConditionListTemplate}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- The other half of a repeatable quest: when a started one goes back
                                 to not started. -->
                            <GroupBox x:Name="QuestResetPanel" Header="{l:T quests.questResetPanel}" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="QuestResetNote" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{Binding ResetNote}"/>
                                    <ContentControl x:Name="QuestResetConditions" Focusable="False" Content="{Binding ResetConditions}"
                                                    ContentTemplate="{StaticResource ConditionListTemplate}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- A later version of the pack giving a finished quest more steps: what
                                 happens to the players who had finished it. Only on a quest of the
                                 pack's own; the game's quests stay as the player left them. -->
                            <GroupBox x:Name="QuestStepsAddedPanel" Header="{l:T quests.stepsAdded}" Margin="0,6,0,0"
                                      Visibility="{Binding ShowsOwnPanel, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T quests.stepsAdded.intro}"/>
                                    <RadioButton x:Name="StepsAddedLeave" Content="{l:T quests.stepsAdded.leave}"
                                                 IsChecked="{Binding StepsAddedLeaveFinished, Mode=TwoWay}"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,4"
                                               Text="{l:T quests.stepsAdded.leave.note}"/>
                                    <RadioButton x:Name="StepsAddedReopen" Content="{l:T quests.stepsAdded.reopen}"
                                                 IsChecked="{Binding StepsAddedReopen, Mode=TwoWay}"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,4"
                                               Text="{l:T quests.stepsAdded.reopen.note}"/>
                                    <RadioButton x:Name="StepsAddedStartOver" Content="{l:T quests.stepsAdded.startOver}"
                                                 IsChecked="{Binding StepsAddedStartOver, Mode=TwoWay}"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,0"
                                               Text="{l:T quests.stepsAdded.startOver.note}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- What the game itself does with its quest, read-only: the
                                 places that start it or put it back, with what each needs. -->
                            <GroupBox x:Name="GameQuestSitesPanel" Header="{l:T quests.gameQuestSitesPanel}" Margin="0,6,0,0"
                                      Visibility="{Binding IsVanillaExtension, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock x:Name="GameQuestSitesNote" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                               Text="{Binding GameSitesNote}"
                                               Visibility="{Binding HasGameSitesNote, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl x:Name="GameQuestSiteGroups" ItemsSource="{Binding GameSites}"
                                                  ItemTemplate="{StaticResource GameQuestSiteGroupTemplate}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T quests.tasks}" Margin="0,6,0,0"
                                      Visibility="{Binding ShowsOwnPanel, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T quests.topLevelTasksRun}"/>
                                    <ToolBar>
                                        <Button view:TutorialAnchor.Id="btn:addQuestTask" Content="{l:T quests.addTask}" Command="{Binding AddTaskCommand}"
                                                ToolTip="{l:T quests.addTask.tip}"/>
                                        <Button Content="{l:T quests.addSubtask}" Command="{Binding AddSubtaskCommand}"
                                                ToolTip="{l:T quests.addSubtask.tip}"/>
                                        <Button Content="▲" Command="{Binding MoveTaskUpCommand}" ToolTip="{l:T quests.moveTaskUp.tip}"/>
                                        <Button Content="▼" Command="{Binding MoveTaskDownCommand}" ToolTip="{l:T quests.moveTaskDown.tip}"/>
                                        <Button Content="{l:T quests.removeQuest}" Command="{Binding RemoveTaskCommand}"
                                                ToolTip="{l:T quests.removeQuest.tip3}"/>
                                    </ToolBar>
                                    <ListBox x:Name="QuestTaskList" MinHeight="90" MaxHeight="320" Margin="0,2,0,0"
                                             ItemsSource="{Binding TaskRows}"
                                             SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:QuestTaskViewModel}">
                                                <TextBlock Text="{Binding RowText}" Margin="{Binding Indent}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </GroupBox>

                            <!-- The game's quest as the pack leaves it: the game's tasks, with
                                 what the pack says about each, and the pack's own tasks among
                                 them. The game's rows cannot be edited or moved; the pack's can. -->
                            <GroupBox x:Name="VanillaTasksPanel" Header="{l:T quests.tasks}" Margin="0,6,0,0"
                                      Visibility="{Binding ShowsVanillaPanel, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{l:T quests.gameSTasksGame}"/>
                                    <ToolBar>
                                        <Button x:Name="AddExtensionTaskButton" Content="{l:T quests.addTask}" Command="{Binding AddTaskCommand}"
                                                ToolTip="{l:T quests.addTask.tip2}"/>
                                        <Button x:Name="AddExtensionSubtaskButton" Content="{l:T quests.addSubtask}" Command="{Binding AddSubtaskCommand}"
                                                ToolTip="{l:T quests.addSubtask.tip2}"/>
                                        <Button Content="▲" Command="{Binding MoveTaskUpCommand}" ToolTip="{l:T quests.moveTaskUp.tip2}"/>
                                        <Button Content="▼" Command="{Binding MoveTaskDownCommand}" ToolTip="{l:T quests.moveTaskDown.tip2}"/>
                                        <Button x:Name="RemoveExtensionRowButton" Content="{l:T quests.removeQuest}" Command="{Binding RemoveTaskCommand}"
                                                ToolTip="{l:T quests.removeQuest.tip4}"/>
                                    </ToolBar>
                                    <ListBox x:Name="VanillaTaskList" MinHeight="90" MaxHeight="360" Margin="0,2,0,0"
                                             ItemsSource="{Binding ExtensionRows}"
                                             SelectedItem="{Binding SelectedExtensionRow, Mode=TwoWay}">
                                        <ListBox.Resources>
                                            <DataTemplate DataType="{x:Type vm:VanillaTaskRowViewModel}">
                                                <DockPanel Margin="{Binding Indent}">
                                                <TextBlock DockPanel.Dock="Left" Text="&#x25CF;" Width="10" FontSize="10"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource Theme.Accent}"
                                                           ToolTip="{Binding ChangedFieldsText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding RowText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutOfSight}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsTakenOut}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                            <DataTemplate DataType="{x:Type vm:QuestTaskViewModel}">
                                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                                    <Border Background="#FF2F6FB0" CornerRadius="2" Padding="3,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{l:T quests.yours}" Foreground="White" FontSize="9"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding RowText}" Foreground="#FF2F6FB0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.Resources>
                                    </ListBox>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{l:T quests.questNotOneModforge}"
                                               Visibility="{Binding HasNoVanillaTasks, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{l:T quests.selectedTask}" Margin="0,6,0,0"
                                      DataContext="{Binding SelectedTask}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{l:T quests.text}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="QuestTaskNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{l:T quests.questTaskNameBox.tip}"/>

                                    <TextBlock Text="{l:T quests.runtimeName}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,2">
                                        <Button DockPanel.Dock="Right" Content="{l:T quests.renameQuest}" Padding="8,0" Margin="6,0,0,0"
                                                Command="{Binding DataContext.RenameQuestTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                ToolTip="{l:T quests.renameQuest.tip2}"/>
                                        <TextBox Text="{Binding Key, Mode=OneWay}"
                                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                                 BorderThickness="0" Background="Transparent" Padding="0"
                                                 Foreground="Gray" Cursor="Arrow" VerticalAlignment="Center"
                                                 ToolTip="{l:T quests.whatQuestActionsConditions.tip}"/>
                                    </DockPanel>

                                    <!-- What the journal shows while the player is part way through.
                                         The description is the quest's, changed by a task being done;
                                         the tick is a subtask's, since the game's journal already leaves
                                         out a top-level task that has not started. -->
                                    <TextBlock Text="{l:T quests.questDescriptionOnceDone}" Grid.Row="2" Grid.Column="0"
                                               VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,2,6,0"/>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,4">
                                        <TextBox x:Name="QuestTaskDescriptionBox"
                                                 Text="{Binding QuestDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36"
                                                 VerticalScrollBarVisibility="Auto"
                                                 ToolTip="{l:T quests.questTaskDescriptionBox.tip}"/>
                                        <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                                   Text="{l:T quests.severalTasksCanHave}"/>
                                    </StackPanel>

                                    <TextBlock Text="{l:T quests.journal}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,4">
                                        <StackPanel Visibility="{Binding IsSubtask, Converter={StaticResource BoolToVisibility}}">
                                            <CheckBox x:Name="QuestTaskHiddenBox" Content="{l:T quests.questTaskHiddenBox}"
                                                      IsChecked="{Binding HideUntilStarted}"
                                                      ToolTip="{l:T quests.questTaskHiddenBox.tip}"/>
                                            <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,4"
                                                       Text="{Binding HideUntilStartedNote}"/>
                                        </StackPanel>
                                        <!-- Hidden until conditions of the pack's own pass: the same
                                             condition list every polled list uses. Once shown it stays
                                             shown for that save, unless the author asks for it to
                                             follow the conditions live. -->
                                        <CheckBox x:Name="QuestTaskHiddenUntilConditionsBox" Content="{l:T quests.questTaskHiddenUntilConditionsBox}"
                                                  IsChecked="{Binding HideUntilConditions}"
                                                  ToolTip="{l:T quests.questTaskHiddenUntilConditionsBox.tip}"/>
                                        <StackPanel x:Name="QuestTaskShowConditions" Margin="16,2,0,0"
                                                    Visibility="{Binding HideUntilConditions, Converter={StaticResource BoolToVisibility}}">
                                            <ContentControl Focusable="False" Content="{Binding ShowConditions}"
                                                            ContentTemplate="{StaticResource ConditionListTemplate}"/>
                                            <CheckBox x:Name="QuestTaskShowLiveBox" Content="{l:T quests.questTaskShowLiveBox}" Margin="0,4,0,0"
                                                      IsChecked="{Binding ShowConditionsLive}"
                                                      ToolTip="{l:T quests.questTaskShowLiveBox.tip}"/>
                                            <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                                       Text="{Binding ShowConditionsNote}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{l:T quests.completes}" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="QuestTaskCompletionPicker" Grid.Row="4" Grid.Column="1" Margin="0,0,0,2"
                                              ItemsSource="{x:Static vm:QuestTaskViewModel.Completions}"
                                              SelectedItem="{Binding Completion, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding HasSubtasks}"
                                              ToolTip="{l:T quests.questTaskCompletionPicker.tip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=completion}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Text="{Binding CompletionNote}"/>

                                    <TextBlock Text="{l:T quests.counter}" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,2">
                                        <CheckBox x:Name="QuestTaskCountsBox" Content="{l:T quests.questTaskCountsBox}" VerticalAlignment="Center"
                                                  IsChecked="{Binding Counts}"
                                                  ToolTip="{l:T quests.questTaskCountsBox.tip}"/>
                                        <TextBox Width="60" Margin="6,0,0,0"
                                                 Text="{Binding CountToText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Counts}"/>
                                    </StackPanel>
                                    <!-- What sets the count: Quest actions, or a number variable it
                                         follows. The variable row is the Variable condition's own
                                         shape - Source, then a name picker whose list follows it,
                                         with the note saying what the chosen variable holds. -->
                                    <TextBlock Text="{l:T quests.counted}" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding Counts, Converter={StaticResource BoolToVisibility}}"/>
                                    <ComboBox x:Name="QuestTaskCounterSourcePicker" Grid.Row="7" Grid.Column="1" Margin="0,0,0,2"
                                              ItemsSource="{x:Static vm:QuestTaskViewModel.CounterSources}"
                                              SelectedItem="{Binding CounterSource, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding Counts, Converter={StaticResource BoolToVisibility}}"
                                              ToolTip="{l:T quests.questTaskCounterSourcePicker.tip}">
                                                  <ComboBox.ItemTemplate>
                                                      <DataTemplate>
                                                          <TextBlock Text="{Binding Converter={x:Static l:KeyTextConverter.Instance}}"/>
                                                      </DataTemplate>
                                                  </ComboBox.ItemTemplate>
                                              </ComboBox>

                                    <TextBlock Text="{l:T quests.variable}" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"
                                               Visibility="{Binding CountsFromVariable, Converter={StaticResource BoolToVisibility}}"/>
                                    <DockPanel x:Name="QuestTaskCountVariableRow" Grid.Row="8" Grid.Column="1" Margin="0,0,0,2"
                                               Visibility="{Binding CountsFromVariable, Converter={StaticResource BoolToVisibility}}">
                                        <ComboBox DockPanel.Dock="Left" Width="80" Margin="0,0,4,0"
                                                  ItemsSource="{x:Static vm:QuestTaskViewModel.CountVariableSources}"
                                                  SelectedItem="{Binding CountVariableSource, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{l:T quests.packOnePackS.tip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={x:Static l:ChoiceTextConverter.Instance}, ConverterParameter=variableSource}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountVariableKindNote}"
                                                   FontSize="10" Opacity="0.75" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="{l:T quests.whatVariableHoldsCounter.tip}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CountVariableKindNote}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox x:Name="QuestTaskCountVariablePicker" IsEditable="True"
                                                  Text="{Binding CountVariable, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{l:T quests.questTaskCountVariablePicker.tip}">
                                            <ComboBox.GroupStyle>
                                                <StaticResource ResourceKey="MusicOriginGroupStyle"/>
                                            </ComboBox.GroupStyle>
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource GroupedComboBox}">
                                                    <Setter Property="ItemsSource"
                                                            Value="{Binding DataContext.VariableNameOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCountVariableVanilla}" Value="True">
                                                            <Setter Property="ItemsSource"
                                                                    Value="{Binding DataContext.VanillaGameVariableOptionsGrouped, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </DockPanel>

                                    <TextBlock Grid.Row="9" Grid.Column="1" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                               Text="{Binding CounterNote}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CounterNote}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Only a task with no subtasks has these: one with subtasks
                                         finishes through them, and the runtime does not check it. -->
                                    <StackPanel x:Name="QuestTaskCompletionLists" view:TutorialAnchor.Id="panel:questTaskCompletion"
                                                Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                                Visibility="{Binding HasOwnCompletion, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{l:T quests.completesWhen}" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                        <ContentControl Focusable="False" Content="{Binding CompletionConditions}"
                                                        ContentTemplate="{StaticResource ConditionListTemplate}"/>
                                        <TextBlock Text="{l:T quests.whenCompletes}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                        <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                                   Text="{l:T quests.runsWheneverTaskCompletes}"/>
                                        <ContentControl Focusable="False" Content="{Binding CompletionActions}"
                                                        ContentTemplate="{StaticResource ActionListTemplate}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="QuestTaskNoCompletionNote" Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                                               Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="{Binding NoOwnCompletionNote}"
                                               Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}"/>
                                    <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                                                Visibility="{Binding IsAddedToGameQuest, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock x:Name="AddedTaskStartsNote" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Text="{Binding StartsNote}"
                                                   Visibility="{Binding HasStartsNote, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock x:Name="AddedTaskNote"
                                                   Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="{l:T quests.taskYoursGameS}"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <GroupBox x:Name="VanillaTaskPanel" Header="{l:T quests.vanillaTaskPanel}" Margin="0,6,0,0"
                                      DataContext="{Binding SelectedVanillaTask}"
                                      Visibility="{Binding Converter={x:Static conv:NullToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Text="{Binding Note}"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                                    <!-- What the pack changes about this task, each with its own way
                                         back, like a changed line of a conversation. -->
                                    <DockPanel x:Name="VanillaTaskChanges" Margin="0,4,0,0"
                                               Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="&#x25CF;" Width="10" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.Accent}"/>
                                        <Button x:Name="VanillaTaskResetButton" DockPanel.Dock="Right" Content="{l:T quests.resetDescription}" Padding="8,0"
                                                Command="{Binding ResetCommand}"
                                                ToolTip="{l:T quests.resetDescription.tip2}"/>
                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding ResettableFields}" Margin="2,0,4,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" FontSize="9" Padding="4,0" Margin="2,0,0,0"
                                                            Command="{Binding Reset}"
                                                            ToolTip="{Binding Label, Converter={x:Static l:FormatConverter.Instance}, ConverterParameter=quests.resetTaskPart.tip}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding ChangedFieldsText}" Foreground="Gray" FontSize="10"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                    <TextBlock x:Name="VanillaTaskStartsNote" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="{Binding StartsNote}"
                                               Visibility="{Binding HasStartsNote, Converter={StaticResource BoolToVisibility}}"/>

                                    <!-- The game's own steps on this task, read-only. -->
                                    <TextBlock Text="{l:T quests.gameQuestSitesPanel}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="VanillaTaskSitesNote" Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                               Text="{Binding GameSitesNote}"
                                               Visibility="{Binding HasGameSitesNote, Converter={StaticResource BoolToVisibility}}"/>
                                    <ItemsControl x:Name="VanillaTaskSiteGroups" ItemsSource="{Binding GameSites}"
                                                  ItemTemplate="{StaticResource GameQuestSiteGroupTemplate}"/>

                                    <CheckBox x:Name="VanillaTaskRemovedBox" Content="{l:T quests.vanillaTaskRemovedBox}" Margin="0,8,0,0"
                                              IsChecked="{Binding IsRemoved}" IsEnabled="{Binding CanChooseRemoved}"
                                              ToolTip="{l:T quests.vanillaTaskRemovedBox.tip}"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Text="{Binding RemovedNote}"/>

                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="{l:T quests.journal}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox x:Name="VanillaTaskVisibilityPicker"
                                                  ItemsSource="{Binding VisibilityOptions}"
                                                  SelectedItem="{Binding Visibility, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanChooseVisibility}"
                                                  ToolTip="{l:T quests.vanillaTaskVisibilityPicker.tip}">
                                                  <ComboBox.ItemTemplate>
                                                      <DataTemplate>
                                                          <TextBlock Text="{Binding Converter={x:Static l:KeyTextConverter.Instance}}"/>
                                                      </DataTemplate>
                                                  </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DockPanel>
                                    <StackPanel x:Name="VanillaTaskShowConditions" Margin="16,4,0,0"
                                                Visibility="{Binding IsHiddenUntilConditions, Converter={StaticResource BoolToVisibility}}">
                                        <ContentControl Focusable="False" Content="{Binding ShowConditions}"
                                                        ContentTemplate="{StaticResource ConditionListTemplate}"/>
                                        <CheckBox x:Name="VanillaTaskShowLiveBox" Content="{l:T quests.questTaskShowLiveBox}" Margin="0,4,0,0"
                                                  IsChecked="{Binding ShowConditionsLive}"
                                                  ToolTip="{l:T quests.questTaskShowLiveBox.tip}"/>
                                    </StackPanel>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Text="{Binding VisibilityNote}"/>

                                    <TextBlock Text="{l:T quests.questDescriptionOnceDone2}" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                    <TextBox x:Name="VanillaTaskDescriptionBox"
                                             Text="{Binding QuestDescription, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36"
                                             VerticalScrollBarVisibility="Auto"
                                             ToolTip="{l:T quests.vanillaTaskDescriptionBox.tip}"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Text="{l:T quests.journalShowsOneTask}"/>

                                    <TextBlock Text="{l:T quests.whenGameCompletes}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                                    <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,2"
                                               Text="{l:T quests.runsOnceMomentGame}"/>
                                    <ContentControl Focusable="False" Content="{Binding Actions}"
                                                    ContentTemplate="{StaticResource ActionListTemplate}"/>
                                </StackPanel>
                            </GroupBox>

                            <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="2,8,0,0"
                                       Visibility="{Binding ShowsVanillaPanel, Converter={StaticResource BoolToVisibility}}"
                                       Text="{l:T quests.gameStillMovesOwn}"/>

                            <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="2,8,0,0"
                                       Visibility="{Binding ShowsOwnPanel, Converter={StaticResource BoolToVisibility}}"
                                       Text="{l:T quests.questMovesAlongItself}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
            <StackPanel x:Name="EditingLanguageBar" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,10,0">
                <TextBlock Text="{l:T editingLanguage.label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="EditingLanguagePicker" MinWidth="180"
                          ItemsSource="{Binding EditingLanguageOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectedValue="{Binding EditingLanguage, Mode=TwoWay}"
                          SelectionChanged="EditingLanguagePicker_SelectionChanged"
                          ToolTip="{l:T editingLanguage.tip}"/>
                <!-- The pack's translations in a list of their own: how far
                     along each is, and Transfer and Delete. -->
                <Button x:Name="EditTranslationsButton" Content="{l:T editingLanguage.edit}" Padding="8,0"
                        Margin="6,0,0,0" ToolTip="{l:T editingLanguage.edit.tip}"
                        Click="EditPackTranslations_Click"/>
            </StackPanel>
        </Grid>
    </DockPanel>

        <!-- Save-confirmation toast. Starts hidden (Opacity 0); the code-behind
             fades it in and back out whenever MainViewModel.Saved fires. It never
             intercepts input (IsHitTestVisible=False) and floats top-right just
             under the menu strip. -->
        <!-- Guided tutorials. Above the app, but below the save toast, so a
             step that asks the author to save still shows them it worked.
             Collapsed until a tutorial runs. -->
        <ctl:TutorialOverlay x:Name="Tutorial"/>

        <!-- The update line. Same shape and place as the Saved toast, in blue
             rather than green: this one is not the result of anything the
             author just did, so it should not read as their action having
             succeeded. It also STAYS - a download is not an event, it is a
             thing in progress - and is taken down when it finishes. -->
        <Border x:Name="UpdateToast"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,30,16,0" Padding="10,5"
                CornerRadius="4"
                Background="#E22B6CB0" BorderBrush="#40FFFFFF" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⭳" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="UpdateToastText" Foreground="White" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border x:Name="SaveToast"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,30,16,0" Padding="10,5"
                CornerRadius="4"
                Background="#E2277A3C" BorderBrush="#40FFFFFF" BorderThickness="1"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💾" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{l:T shell.saved}" Foreground="White" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <!-- The version it was saved AS. With auto-versioning on, this
                     is the moment the number moves, so it is the moment worth
                     showing it. -->
                <TextBlock x:Name="SaveToastVersion" Foreground="#DDFFFFFF"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
