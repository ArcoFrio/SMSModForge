<Window x:Class="SMSModForge.View.PackTranslationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:l="clr-namespace:SMSModForge.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{l:T packTranslations.title}" Width="640" Height="440"
        MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Text="{l:T packTranslations.intro}"/>

        <!-- What to do with the one picked: copy it over another language, or
             take it away. Both ask first. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{l:T packTranslations.close}" MinWidth="80"
                    IsCancel="True" Click="Close_Click"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T packTranslations.transferTo}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="TargetPicker" MinWidth="170" DisplayMemberPath="Label" SelectedValuePath="Code"
                          SelectionChanged="Selection_Changed"/>
                <Button x:Name="TransferButton" Content="{l:T packTranslations.transfer}" Padding="10,2" Margin="6,0,0,0"
                        ToolTip="{l:T packTranslations.transfer.tip}" Click="Transfer_Click"/>
                <Button x:Name="DeleteButton" Content="{l:T packTranslations.delete}" Padding="10,2" Margin="16,0,0,0"
                        ToolTip="{l:T packTranslations.delete.tip}" Click="Delete_Click"/>
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <Grid Margin="0,10,0,0">
            <ListView x:Name="List" SelectionMode="Single" SelectionChanged="Selection_Changed">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{l:T packTranslations.column.language}" Width="190"
                                        DisplayMemberBinding="{Binding Language}"/>
                        <GridViewColumn Header="{l:T packTranslations.column.translated}" Width="170"
                                        DisplayMemberBinding="{Binding Translated}"/>
                        <GridViewColumn Header="{l:T packTranslations.column.outOfDate}" Width="100"
                                        DisplayMemberBinding="{Binding OutOfDate}"/>
                        <GridViewColumn Header="{l:T packTranslations.column.file}" Width="110"
                                        DisplayMemberBinding="{Binding File}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="EmptyText" TextWrapping="Wrap" Margin="10,40,10,0" Foreground="Gray"
                       HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"
                       Text="{l:T packTranslations.none}"/>
        </Grid>
    </DockPanel>
</Window>
