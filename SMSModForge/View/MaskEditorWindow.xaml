<Window x:Class="SMSModForge.View.MaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:l="clr-namespace:SMSModForge.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{l:T maskEditor.maskEditor}"
        Width="1180" Height="820"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=CanvasHost}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="UndoRedo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="UndoRedo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: layers. Drawn OVER the canvas (which spans the whole window),
             so panning slides the image behind the panel rather than stopping
             at its edge. Needs an opaque background for that to read. -->
        <Border Grid.Column="0" Panel.ZIndex="1" Background="{DynamicResource Theme.Window}">
        <DockPanel Margin="8">
            <TextBlock Text="{l:T maskEditor.layers}" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top">
                <Border BorderBrush="LightGray" BorderThickness="1" Margin="0,0,0,4" Padding="4" Background="#222">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ShowDiffuseToggle" IsChecked="True"
                                      Width="22" Height="22" Click="ShowDiffuse_Click"
                                      ToolTip="{l:T maskEditor.showDiffuseToggle.tip}">
                            <TextBlock Text="●" FontSize="14"/>
                        </ToggleButton>
                        <TextBlock Text="{l:T maskEditor.referenceLocked}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="LightGray"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#A33" BorderThickness="1" Margin="0,0,0,4" Padding="4"
                        x:Name="LayerR" Background="#331100">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ShowRToggle" IsChecked="True"
                                      Width="22" Height="22" Click="ShowR_Click"
                                      ToolTip="{l:T maskEditor.showRToggle.tip}">
                            <TextBlock x:Name="ShowRDot" Text="●" FontSize="14" Foreground="#F66"/>
                        </ToggleButton>
                        <RadioButton GroupName="ActiveChannel" x:Name="ActiveR" IsChecked="True"
                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                     Checked="ActiveR_Checked" Background="#F0F0F0" BorderBrush="#FFFFFF">
                            <TextBlock x:Name="ActiveRLabel" Text="{l:T maskEditor.bounceR}" FontSize="13" FontWeight="Bold" Foreground="#FF6666"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#3A3" BorderThickness="1" Margin="0,0,0,4" Padding="4"
                        x:Name="LayerG" Background="#113300">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ShowGToggle" IsChecked="True"
                                      Width="22" Height="22" Click="ShowG_Click"
                                      ToolTip="{l:T maskEditor.showGToggle.tip}">
                            <TextBlock Text="●" FontSize="14" Foreground="#6F6"/>
                        </ToggleButton>
                        <RadioButton GroupName="ActiveChannel" x:Name="ActiveG"
                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                     Checked="ActiveG_Checked" Background="#F0F0F0" BorderBrush="#FFFFFF">
                            <TextBlock Text="{l:T maskEditor.waveG}" FontSize="13" FontWeight="Bold" Foreground="#66FF66"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <Border BorderBrush="#36A" BorderThickness="1" Margin="0,0,0,4" Padding="4"
                        x:Name="LayerB" Background="#110033">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ShowBToggle" IsChecked="True"
                                      Width="22" Height="22" Click="ShowB_Click"
                                      ToolTip="{l:T maskEditor.showBToggle.tip}">
                            <TextBlock Text="●" FontSize="14" Foreground="#69F"/>
                        </ToggleButton>
                        <RadioButton GroupName="ActiveChannel" x:Name="ActiveB"
                                     Margin="8,0,0,0" VerticalAlignment="Center"
                                     Checked="ActiveB_Checked" Background="#F0F0F0" BorderBrush="#FFFFFF">
                            <TextBlock Text="{l:T maskEditor.noiseB}" FontSize="13" FontWeight="Bold" Foreground="#6699FF"/>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="{l:T maskEditor.clearChannel}" Click="ClearChannel_Click" Margin="0,2" Height="26"/>
                <Button Content="{l:T maskEditor.fillChannel}"  Click="FillChannel_Click"  Margin="0,2" Height="26"/>
                <!--
                    Start from another outfit of the same character rather than
                    from an empty canvas: most of them are the same bust in
                    different clothes, so the layers are nearly right already.

                    Hidden outright where there is nothing to copy from, which
                    includes every PLACE: a level's two masks are the background
                    and the foreground of one scene, and pasting one over the
                    other is a mistake with a button on it. See
                    IMaskEditorHost.OtherMasks.
                -->
                <StackPanel x:Name="CopyFromPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <!-- The theme's own text colour, like the other labels on
                         these panels: a fixed light grey vanished on a light
                         theme's panel. -->
                    <TextBlock x:Name="CopyFromLabel" Text="{l:T maskEditor.copyLayers}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CopyFromList" Height="24"
                              SelectionChanged="CopyFrom_SelectionChanged"
                              ToolTip="{l:T maskEditor.copyFromList.tip}"/>
                    <Button x:Name="CopyFromButton" Content="{l:T maskEditor.copyFrom}" Margin="0,4,0,0"
                            Height="26" Click="CopyFrom_Click" IsEnabled="False"
                            ToolTip="{l:T maskEditor.copyFrom.tip}"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
        </Border>

        <!-- CENTER: canvas. Spans every column and sits at the bottom of the
             z-order, so the working area is the whole window and a panned or
             zoomed-in canvas slides UNDER the side panels instead of being cut
             off at a column edge. ClipToBounds then only trims at the window. -->
        <!-- Holding the middle button anywhere on it pans, not only over the
             image: zoomed out, or panned away, most of it is this dark area. -->
        <Border x:Name="CanvasArea" Grid.Column="0" Grid.ColumnSpan="3" Panel.ZIndex="0"
                Background="#1a1a1a" Padding="8" ClipToBounds="True"
                MouseDown="CanvasArea_MouseDown" MouseMove="CanvasArea_MouseMove"
                MouseUp="CanvasArea_MouseUp" LostMouseCapture="CanvasArea_LostMouseCapture">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                  x:Name="CanvasHost" Width="512" Height="512"
                  RenderTransformOrigin="0.5,0.5"
                  Background="Transparent" Focusable="True"
                  MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove"
                  MouseUp="Canvas_MouseUp" MouseLeave="Canvas_MouseLeave"
                  MouseEnter="Canvas_MouseEnter" MouseWheel="Canvas_MouseWheel"
                  Cursor="None">
                <!-- Zoom AND pan are render transforms, never layout changes.
                     Growing Width/Height instead is what made zooming useless:
                     once an element with an explicit size exceeds its arrange
                     slot, WPF clips it to that slot automatically, and a render
                     transform is applied after layout — so panning slid the
                     already-clipped rectangle around instead of revealing what
                     was outside it. Scaling leaves the layout size alone, so
                     there is no layout clip and only the window trims.
                     It also keeps GetPosition against this Grid returning
                     texture-space coordinates, since render transforms sit
                     outside an element's own coordinate space — the brush
                     lands where the cursor is at any zoom, for free. -->
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomTransform"/>
                        <TranslateTransform x:Name="PanTransform"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="MaskImage" Stretch="Fill" SnapsToDevicePixels="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                    <Ellipse x:Name="BrushCursor" Width="0" Height="0"
                             Stroke="White" StrokeThickness="1" Visibility="Hidden"/>
                    <Ellipse x:Name="BrushCursorHard" Width="0" Height="0"
                             Stroke="White" StrokeThickness="1"
                             StrokeDashArray="2,2" Opacity="0.6" Visibility="Hidden"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- RIGHT: tools -->
        <Border Grid.Column="2" Panel.ZIndex="1" Background="{DynamicResource Theme.Window}">
        <DockPanel Margin="8">
            <TextBlock Text="{l:T maskEditor.tools}" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top">
                <UniformGrid Columns="2" Margin="0,0,0,8">
                    <ToggleButton x:Name="ToolBrushBtn" IsChecked="True"
                                  Content="{l:T maskEditor.toolBrush}" Click="ToolBrush_Click"
                                  Margin="0,0,2,0" Height="32"/>
                    <ToggleButton x:Name="ToolEraserBtn"
                                  Content="{l:T maskEditor.toolEraser}" Click="ToolEraser_Click"
                                  Margin="2,0,0,0" Height="32"/>
                </UniformGrid>

                <TextBlock Text="{l:T maskEditor.size}"/>
                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Right" Width="46" Margin="6,0,0,0"
                               TextAlignment="Right"
                               Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat=F0}"/>
                    <Slider x:Name="SizeSlider" Minimum="1" Maximum="80" Value="20"
                            SmallChange="1" LargeChange="5"
                            PreviewKeyDown="Slider_PreviewKeyDown"
                            ValueChanged="BrushParamChanged"/>
                </DockPanel>

                <TextBlock Text="{l:T maskEditor.hardness}" Margin="0,8,0,0"/>
                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Right" Width="46" Margin="6,0,0,0"
                               TextAlignment="Right"
                               Text="{Binding ElementName=HardnessSlider, Path=Value, StringFormat=P0}"/>
                    <Slider x:Name="HardnessSlider" Minimum="0" Maximum="1" Value="0.8"
                            SmallChange="0.01" PreviewKeyDown="Slider_PreviewKeyDown"
                            ValueChanged="BrushParamChanged"/>
                </DockPanel>

                <TextBlock Text="{l:T maskEditor.opacity}" Margin="0,8,0,0"/>
                <DockPanel Margin="0,2,0,0">
                    <TextBlock DockPanel.Dock="Right" Width="46" Margin="6,0,0,0"
                               TextAlignment="Right"
                               Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat=P0}"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.01" Maximum="1" Value="0.2"
                            SmallChange="0.01" PreviewKeyDown="Slider_PreviewKeyDown"/>
                </DockPanel>

                <CheckBox x:Name="CapToggle" Content="{l:T maskEditor.capToggle}" Margin="0,12,0,0"
                          ToolTip="{l:T maskEditor.capToggle.tip}"/>

                <TextBlock Text="{l:T maskEditor.zoom}" FontWeight="Bold" Margin="0,8,0,4"/>
                <TextBlock x:Name="ZoomDisplay" Foreground="Gray" FontSize="11" TextAlignment="Center"
                           Margin="0,0,0,4" Text="100%"/>
                <TextBlock Foreground="Gray" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Text="{l:T maskEditor.keys.zoom}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.pan}"/><LineBreak/>
                </TextBlock>

                <TextBlock Text="{l:T maskEditor.hotkeys}" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" LineHeight="16">
                    <Run Text="{l:T maskEditor.keys.brush}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.channel}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.toggle}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.brushSize}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.opacity}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.clearFill}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.undo}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.save}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.panCanvas}"/><LineBreak/>
                    <Run Text="{l:T maskEditor.keys.resetView}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock x:Name="StatusText" Foreground="Gray" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <Button Content="{l:T maskEditor.saveBtn}" Click="SaveBtn_Click" Height="32" Margin="0,2" FontWeight="Bold"/>
                <Button Content="{l:T maskEditor.closeBtn}" Click="CloseBtn_Click" Height="28" Margin="0,2"/>
            </StackPanel>
        </DockPanel>
        </Border>
    </Grid>
</Window>
