<Window x:Class="SMSModForge.View.UiTextEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SMSModForge.Localization"
        Title="{l:T uiEdit.title}" Width="720" Height="520" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <!-- Every text of the editor, by its words in English or in this language:
             the ones in menus, messages and tooltips have no pencil of their own. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{l:T uiEdit.search}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="{l:T uiEdit.search.tip}"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="ShippedButton" DockPanel.Dock="Left" Content="{l:T uiEdit.shipped}" Padding="10,2"
                    ToolTip="{l:T uiEdit.shipped.tip}" Click="Shipped_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="{l:T uiEdit.save}" Width="90" IsDefault="True" Margin="8,0,8,0" Click="Save_Click"/>
                <Button Content="{l:T uiEdit.close}" Width="90" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="TextList" Grid.Column="0" SelectionChanged="TextList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock Text="{Binding Shown}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="NothingText" Text="{l:T uiEdit.pick}" Foreground="Gray" TextWrapping="Wrap"/>
                    <TextBlock x:Name="KeyText" FontSize="10" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FormGuideText" FontSize="10" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="FormList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                    <TextBlock Text="{l:T uiEdit.english}" FontSize="11" Foreground="Gray"/>
                                    <TextBox Text="{Binding English, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             BorderThickness="0" Background="Transparent" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding LanguageLabel}" FontSize="11" Foreground="Gray"/>
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                                             AcceptsReturn="True" MinHeight="44"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
