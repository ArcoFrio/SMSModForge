<Window x:Class="SMSModForge.View.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a colour" Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Choose" Width="84" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="84" IsCancel="True"/>
        </StackPanel>

        <!-- Hex and alpha, under the wheel, because the hex box is how a colour
             gets copied between two objects and that is worth having in reach
             rather than behind a disclosure. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Hex" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="HexBox" Grid.Column="1" VerticalAlignment="Center"
                     FontFamily="Consolas" TextChanged="Hex_Changed"
                     ToolTip="#RRGGBB or #RRGGBBAA. Typing here moves the wheel."/>

            <TextBlock Text="Opacity" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="AlphaBox" Grid.Column="3" VerticalAlignment="Center"
                     TextChanged="Alpha_Changed"
                     ToolTip="0 is invisible, 255 fully solid. The game's own UI uses this for faded and disabled states."/>
        </Grid>

        <!-- The before-and-after swatch. Picking blind against the object's
             current colour is how a "small adjustment" turns out to be a big
             one; both are drawn over a chequerboard so alpha is visible. -->
        <Border DockPanel.Dock="Bottom" Height="46" Margin="0,12,0,0"
                BorderBrush="#888" BorderThickness="1">
            <Grid>
                <Rectangle x:Name="Chequer"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="WasSwatch"/>
                    <Rectangle x:Name="NowSwatch" Grid.Column="1"/>
                    <TextBlock Text="was" Margin="6,2" Opacity="0.75" FontSize="10"
                               VerticalAlignment="Bottom" Foreground="#000"/>
                    <TextBlock Text="now" Grid.Column="1" Margin="6,2" Opacity="0.75" FontSize="10"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right" Foreground="#000"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Saturation across, brightness down, with the hue beside it. Three
             layers rather than a bitmap: a flat hue, white fading out to the
             right, black fading in downwards. -->
        <Grid Height="220">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="#888" BorderThickness="1">
                <Canvas x:Name="Field" ClipToBounds="True" Background="Transparent"
                        MouseLeftButtonDown="Field_Down" MouseMove="Field_Move"
                        MouseLeftButtonUp="Field_Up">
                    <Rectangle x:Name="FieldHue"
                               Width="{Binding ActualWidth, ElementName=Field}"
                               Height="{Binding ActualHeight, ElementName=Field}"/>
                    <Rectangle Width="{Binding ActualWidth, ElementName=Field}"
                               Height="{Binding ActualHeight, ElementName=Field}"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="#FFFFFFFF"/>
                                <GradientStop Offset="1" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Width="{Binding ActualWidth, ElementName=Field}"
                               Height="{Binding ActualHeight, ElementName=Field}"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#00000000"/>
                                <GradientStop Offset="1" Color="#FF000000"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- Two rings, light on dark, so the marker is visible
                         against every colour it can sit on. -->
                    <Ellipse x:Name="Marker" Width="14" Height="14" IsHitTestVisible="False"
                             Stroke="#FFFFFF" StrokeThickness="2"/>
                    <Ellipse x:Name="MarkerInner" Width="10" Height="10" IsHitTestVisible="False"
                             Stroke="#000000" StrokeThickness="1"/>
                </Canvas>
            </Border>

            <Border Grid.Column="1" Width="22" Margin="10,0,0,0"
                    BorderBrush="#888" BorderThickness="1">
                <Canvas x:Name="HueBar" ClipToBounds="True" Background="Transparent"
                        MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move"
                        MouseLeftButtonUp="Hue_Up">
                    <Rectangle Width="{Binding ActualWidth, ElementName=HueBar}"
                               Height="{Binding ActualHeight, ElementName=HueBar}"
                               IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.000" Color="#FF0000"/>
                                <GradientStop Offset="0.167" Color="#FFFF00"/>
                                <GradientStop Offset="0.333" Color="#00FF00"/>
                                <GradientStop Offset="0.500" Color="#00FFFF"/>
                                <GradientStop Offset="0.667" Color="#0000FF"/>
                                <GradientStop Offset="0.833" Color="#FF00FF"/>
                                <GradientStop Offset="1.000" Color="#FF0000"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle x:Name="HueMarker" Height="3" IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=HueBar}"
                               Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"/>
                </Canvas>
            </Border>

            <Border Grid.Column="2" Width="22" Margin="10,0,0,0"
                    BorderBrush="#888" BorderThickness="1">
                <Canvas x:Name="AlphaBar" ClipToBounds="True" Background="Transparent"
                        MouseLeftButtonDown="Alpha_Down" MouseMove="Alpha_Move"
                        MouseLeftButtonUp="Alpha_Up">
                    <Rectangle x:Name="AlphaChequer" IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=AlphaBar}"
                               Height="{Binding ActualHeight, ElementName=AlphaBar}"/>
                    <Rectangle x:Name="AlphaRamp" IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=AlphaBar}"
                               Height="{Binding ActualHeight, ElementName=AlphaBar}"/>
                    <Rectangle x:Name="AlphaMarker" Height="3" IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=AlphaBar}"
                               Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"/>
                </Canvas>
            </Border>
        </Grid>
    </DockPanel>
</Window>
