<Window x:Class="SMSModForge.View.TranslatePackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:l="clr-namespace:SMSModForge.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{l:T translatePack.title}" Width="660" Height="640"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">

        <!-- What this is, said before anything is sent rather than after.
             Translating a pack means handing its text to somebody else's
             service, and that is a decision an author should make knowingly. -->
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="Bold"
                   Text="{l:T translatePack.headline}"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray"
                   Margin="0,6,0,0" Text="{l:T translatePack.warning}"/>

        <!-- Names are kept out of the translation unless this says otherwise:
             a translator reads a name as the word it looks like. -->
        <CheckBox x:Name="TranslateNamesBox" DockPanel.Dock="Top" Margin="0,10,0,0"
                  Content="{l:T translatePack.names}"
                  Checked="TranslateNames_Changed" Unchecked="TranslateNames_Changed"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                   Margin="20,2,0,0" Text="{l:T translatePack.names.warning}"/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AllButton" Content="{l:T translatePack.selectAll}"
                        Width="90" Click="All_Click" Margin="0,0,6,0"/>
                <Button x:Name="NoneButton" Content="{l:T translatePack.selectNone}"
                        Width="90" Click="None_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TranslateButton" Content="{l:T translatePack.translate}"
                        Width="110" IsDefault="True" Click="Translate_Click" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="{l:T translatePack.close}"
                        Width="90" IsCancel="True" Click="CloseOrStop_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Progress sits above the buttons and below the list, so it never
             moves anything when it appears. -->
        <TextBlock x:Name="ProgressText" DockPanel.Dock="Bottom" TextWrapping="Wrap"
                   Margin="0,8,0,0" MinHeight="34" VerticalAlignment="Top"/>


        <!-- The languages, and over them, when Google stops to check for a
             person, its check - for the person to answer, never ModForge. -->
        <Grid x:Name="MiddleGrid" Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="NamesRow" Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="CheckPanel" Grid.RowSpan="2" Panel.ZIndex="1" Visibility="Collapsed" BorderThickness="1"
                BorderBrush="{DynamicResource Theme.Accent}" Background="{DynamicResource Theme.Surface}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="8,6,8,6"
                           Text="{l:T translatePack.check}"/>
                <ContentControl x:Name="CheckHost"/>
            </DockPanel>
        </Border>
        <!-- Every language, always: its own height, never squeezed. -->
        <GroupBox x:Name="LanguagesBox" Grid.Row="0" Header="{l:T translatePack.languages}">
                <ItemsControl x:Name="LanguageList" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Wanted}" Margin="2,3,2,3"
                                      IsEnabled="{Binding Enabled}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Note}" Foreground="Gray" FontSize="10"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
        </GroupBox>
        <!-- How each name is written in the languages that write names in an
             alphabet of their own. Only there while names are kept and such a
             language is ticked. The one part of the window that grows with it:
             the list of names can be long, the list of languages is not. -->
        <GroupBox x:Name="NamesBox" Grid.Row="1" Header="{l:T translatePack.spellings}"
                  Margin="0,8,0,0" Visibility="Collapsed">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11"
                           Margin="4,2,4,6" Text="{l:T translatePack.spellings.help}"/>
                <ScrollViewer x:Name="SpellingScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,4,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="150" FontWeight="SemiBold" Text="{l:T translatePack.spellings.name}"/>
                            <ItemsControl x:Name="SpellingHeads">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Width="124" Margin="2,0" FontWeight="SemiBold" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl x:Name="SpellingRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Width="150" VerticalAlignment="Center" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBox Width="124" Margin="2,0"
                                                             Text="{Binding Spelling, UpdateSourceTrigger=PropertyChanged}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Suggested}" Value="True">
                                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                                        <Setter Property="ToolTip" Value="{l:T translatePack.spellings.suggested.tip}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
        </Grid>
    </DockPanel>
</Window>
