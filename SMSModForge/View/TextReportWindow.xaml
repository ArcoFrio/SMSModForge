<Window x:Class="SMSModForge.View.TextReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:l="clr-namespace:SMSModForge.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="520" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- A report somebody may want to copy out of: a read-only text box
         rather than a message box, so it scrolls and it selects. -->
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ActionButton" Padding="10,2" Margin="0,0,8,0" Click="Action_Click" Visibility="Collapsed"/>
            <Button Content="{l:T report.close}" MinWidth="74" IsCancel="True" IsDefault="True"/>
        </StackPanel>
        <TextBox x:Name="ReportBox" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
</Window>
