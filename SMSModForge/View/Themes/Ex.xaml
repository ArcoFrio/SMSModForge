<!--
    The EX look (1.8.0): the same window, the same controls doing the same
    things, drawn another way - the author's Opera to Opera GX idea, between
    a game's menus and a tool. Corners cut at an angle instead of rounded, a
    glow in the accent where something is pointed at or has the keyboard,
    boxes to type in as lines rather than outlines, a diamond for a radio
    choice, cards headed like a HUD panel, a condensed typeface.

    Every resource here REPLACES the one of the same key in App.xaml while an
    EX theme is on (Services/ThemeManager.ApplyStructure), and the Normal one
    comes back with a Normal theme. So each template keeps every named part,
    binding and trigger its Normal counterpart has - PART_Popup,
    PART_EditableTextBox, PART_ContentHost, PART_Track, PART_Header, the
    toggle bound to IsDropDownOpen - and differs only in what is drawn.
    Colours come from the same theme keys, worked out by the same palette.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:SMSModForge.View.Controls"
                    xmlns:view="clr-namespace:SMSModForge.View"
                    xmlns:conv="clr-namespace:SMSModForge.View.Converters"
                    xmlns:l="clr-namespace:SMSModForge.Localization">

    <!-- The glow round what is pointed at or focused - Ex.Glow and
         Ex.GlowSoft - is made by ThemeManager in each theme's accent.
         It is drawn from "frame", a copy of the control's shape behind it, never from a panel holding words
         or pictures: an effect renders what it holds through its own pass, and a card's art and text went
         soft while pointed at (the author, 2026-11-21). The copy follows bd's fill, border and cut. -->

    <!-- ══ Buttons ══════════════════════════════════════════════════════ -->
    <!-- How a menu opens (1.10.0): EX slides it out, Classic fades it in (App.xaml). -->
    <x:Static x:Key="Theme.MenuPopupAnimation" Member="PopupAnimation.Slide"/>

    <ControlTemplate x:Key="Theme.ButtonTemplate" TargetType="Button">
        <Grid view:Motions.Press="{TemplateBinding IsPressed}">
            <Grid x:Name="frame" IsHitTestVisible="False" view:Motions.FadeIn="{TemplateBinding IsMouseOver}">
                <ctl:ChamferBorder SnapsToDevicePixels="True"
                                   Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                               Cut="5" Corners="TopLeft, BottomRight" Padding="{TemplateBinding Padding}"
                               SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True"/>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.PrimaryButtonTemplate" TargetType="Button">
        <Grid view:Motions.Press="{TemplateBinding IsPressed}">
            <Grid x:Name="frame" IsHitTestVisible="False" Effect="{DynamicResource Ex.GlowSoft}">
                <ctl:ChamferBorder SnapsToDevicePixels="True"
                                   Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                               Cut="7" Corners="TopLeft, BottomRight" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" TextElement.FontWeight="SemiBold">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentHover}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter TargetName="frame" Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A button that stays in: Normal's, cut at the corners, and the one
         that is in glows in the accent. -->
    <ControlTemplate x:Key="Theme.ToggleButtonTemplate" TargetType="ToggleButton">
        <Grid view:Motions.Press="{TemplateBinding IsPressed}">
            <Grid x:Name="frame" IsHitTestVisible="False" view:Motions.FadeIn="{TemplateBinding IsMouseOver}">
                <ctl:ChamferBorder SnapsToDevicePixels="True"
                                   Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                               Cut="5" Corners="TopLeft, BottomRight" Padding="{TemplateBinding Padding}"
                               SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonPressed}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentHover}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
                <Setter TargetName="frame" Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A picture to pick: cut corners, and the chosen one glows. -->
    <ControlTemplate x:Key="Theme.TileTemplate" TargetType="Button">
        <Grid view:Motions.Press="{TemplateBinding IsPressed}">
            <Grid x:Name="frame" IsHitTestVisible="False">
                <ctl:ChamferBorder SnapsToDevicePixels="True"
                                   Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                               Stroke="2" Cut="8" Corners="TopRight, BottomLeft" Padding="{TemplateBinding Padding}"
                               TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter/>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ Boxes to type in: a line under the words, not a box round them ═ -->
    <ControlTemplate x:Key="Theme.TextBoxTemplate" TargetType="TextBoxBase">
        <Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                               Stroke="0" Cut="5" Corners="TopRight" SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="0,0,0,1"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </ctl:ChamferBorder>
            <Rectangle x:Name="line" Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}"
                       SnapsToDevicePixels="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="line" Property="Fill" Value="{DynamicResource Theme.TextMuted}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="line" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="line" Property="Height" Value="2"/>
                <Setter TargetName="line" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.SurfaceAlt}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The mask studio's header: the window's own colour over a bar of the
         accent (a glow here would blur the words on it too). -->
    <Style x:Key="Theme.MaskStudio.Header" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Window}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="12,7"/>
    </Style>

    <!-- ══ Dropdowns ════════════════════════════════════════════════════ -->
    <Style x:Key="Ex.ComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <ctl:ChamferBorder x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                           Stroke="0" Cut="5" Corners="TopRight"/>
                        <Rectangle x:Name="line" Height="1" VerticalAlignment="Bottom" Fill="{TemplateBinding BorderBrush}"/>
                        <!-- A chevron in a cut-off box at the right end. -->
                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                              Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.6"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="line" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="line" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="line" Property="Height" Value="2"/>
                            <Setter TargetName="line" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
                            <Setter TargetName="arrow" Property="Data" Value="M0,4 L4,0 L8,4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Theme.ComboTemplate" TargetType="ComboBox">
        <Grid>
            <ToggleButton x:Name="ToggleButton" Style="{StaticResource Ex.ComboToggle}"
                          ClickMode="Press"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="6,3,26,3" VerticalAlignment="Center" HorizontalAlignment="Left"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Hidden"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource Theme.Text}"
                     SelectionBrush="{DynamicResource Theme.Accent}"
                     Margin="4,3,26,3" VerticalAlignment="Center" Focusable="True"
                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Grid x:Name="DropDown" SnapsToDevicePixels="True" Margin="0,2,0,0"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ctl:ChamferBorder x:Name="DropDownBorder" Background="{DynamicResource Theme.Control}"
                                       BorderBrush="{DynamicResource Theme.Accent}" Cut="8" Corners="BottomRight"/>
                    <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource Theme.Accent}"/>
                    <DockPanel Margin="1,3,1,1">
                        <!-- The Normal template's NotesRow and NotesToggle (1.9.0). -->
                        <Border x:Name="NotesRow" DockPanel.Dock="Top" Padding="6,3,6,3"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1"
                                Visibility="{Binding (view:OptionNotes.Kind), RelativeSource={RelativeSource TemplatedParent},
                                             Converter={x:Static conv:VariableListToVisibilityConverter.Instance}}">
                            <CheckBox x:Name="NotesToggle" Focusable="False" FontSize="11"
                                      Content="{l:T dropdown.variableNotes}" ToolTip="{l:T dropdown.variableNotes.tip}"
                                      IsChecked="{Binding Show, Source={x:Static view:VariableNotes.Instance}}"/>
                        </Border>
                        <ScrollViewer SnapsToDevicePixels="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="28"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
            <Trigger Property="IsEditable" Value="True">
                <Setter Property="IsTabStop" Value="False"/>
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A row in a dropdown: a bar in the accent down its left edge when it
         is the one pointed at or chosen. -->
    <ControlTemplate x:Key="Theme.ComboItemTemplate" TargetType="ComboBoxItem">
        <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource SuggestionMark}"/>
                    <ContentPresenter/>
                </DockPanel>
            </Border>
            <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="Transparent"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.AccentSoft}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ Lists and trees: the same bar on the chosen row ═══════════════ -->
    <ControlTemplate x:Key="Theme.ListItemTemplate" TargetType="ListBoxItem">
        <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" view:Motions.Wash="{TemplateBinding IsSelected}"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="Transparent"
                       view:Motions.Grow="{TemplateBinding IsSelected}" view:Motions.GrowAxis="Y" view:Motions.GrowOnUse="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.SelectionInactive}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.TextMuted}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="Selector.IsSelectionActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.TreeItemTemplate" TargetType="TreeViewItem">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <!-- Rows 18 high, not 24 (the author, 1.8.0: EX's lists were "too
                 far apart" next to Classic's), each over a faint line from one
                 side of the list to the other - drawn out to the left past the
                 row's own indent, which the list's edge cuts off - so one row
                 reads from the next. The row lights up the whole way across. -->
            <!-- In the accent's tint, not grey: EX's own colour (the author). -->
            <Rectangle Grid.Column="0" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Margin="-2000,0,0,0"
                       Fill="{DynamicResource Theme.Accent}" Opacity="0.16" SnapsToDevicePixels="True"
                       IsHitTestVisible="False"/>
            <!-- A folder's children hang from a line under its arrow, each on a
                 short branch from it, so what is inside what reads at a glance
                 (the author, 1.8.0). The line ends at the last row's branch when
                 that row is a single one, as a tree's elbow does. -->
            <Rectangle x:Name="guide" Grid.Row="1" Grid.Column="0" Width="1" HorizontalAlignment="Center"
                       Margin="0,0,0,9" Fill="{DynamicResource Theme.Accent}" Opacity="0.5"
                       SnapsToDevicePixels="True" IsHitTestVisible="False"/>
            <!-- This row's branch, out from its folder's line: the line runs 8
                 to the left of the row, down the middle of the folder's arrow. -->
            <Rectangle Grid.Row="0" Grid.Column="0" Width="12" Height="1" Margin="-8,0,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource Theme.Accent}" Opacity="0.5" SnapsToDevicePixels="True" IsHitTestVisible="False"
                       Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static view:TreeBranch.Visibility}}"/>
            <ToggleButton x:Name="Expander" Style="{StaticResource Theme.TreeToggle}" ClickMode="Press"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
            <Grid Grid.Column="1" Grid.ColumnSpan="2" Background="Transparent">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" MinHeight="18" view:Motions.Wash="{TemplateBinding IsSelected}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="3,0" SnapsToDevicePixels="True">
                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                </Border>
                <Rectangle x:Name="bar" Width="3" HorizontalAlignment="Left" Fill="Transparent"
                           view:Motions.Grow="{TemplateBinding IsSelected}" view:Motions.GrowAxis="Y" view:Motions.GrowOnUse="True"/>
            </Grid>
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            view:Motions.Reveal="{TemplateBinding IsExpanded}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="guide" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="guide" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.SelectionInactive}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.TextMuted}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsSelectionActive" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selection}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ Tick boxes: square-cut; radio choices: diamonds ═══════════════ -->
    <ControlTemplate x:Key="Theme.CheckBoxTemplate" TargetType="CheckBox">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="frame" Width="15" Height="15" VerticalAlignment="Center">
                <ctl:ChamferBorder x:Name="box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                   Cut="4" Corners="TopRight, BottomLeft"/>
                <Path x:Name="mark" Data="M3.5,7.5 L6.5,10.5 L11.5,4.5" StrokeThickness="2" view:Motions.Pop="{TemplateBinding IsChecked}"
                      Stroke="{DynamicResource Theme.OnAccent}" Visibility="Collapsed"/>
                <Rectangle x:Name="dash" Width="7" Height="2" Fill="{DynamicResource Theme.OnAccent}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter x:Name="content" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
                <Setter TargetName="content" Property="Margin" Value="0"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="dash" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.RadioTemplate" TargetType="RadioButton">
        <Grid Background="Transparent" SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="frame" Width="15" Height="15" VerticalAlignment="Center">
                <Path x:Name="ring" Data="M7.5,0.5 L14.5,7.5 L7.5,14.5 L0.5,7.5 Z" Fill="{TemplateBinding Background}"
                      Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                <Path x:Name="dot" Data="M7.5,4 L11,7.5 L7.5,11 L4,7.5 Z" Fill="{DynamicResource Theme.OnAccent}" view:Motions.Pop="{TemplateBinding IsChecked}"
                      Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter x:Name="content" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
                <Setter TargetName="content" Property="Margin" Value="0"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Theme.Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ Scroll bars: thinner, the accent while held ═══════════════════ -->
    <Style x:Key="Ex.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" Background="{DynamicResource Theme.ScrollThumb}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                            <Setter TargetName="bd" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Theme.VerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Theme.PageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Ex.ScrollThumb}" Margin="4,2"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Theme.PageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="Theme.HorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Theme.PageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource Ex.ScrollThumb}" Margin="2,4"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Theme.PageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <!-- ══ Tabs: no folder tabs - the open one lit, a glowing line under it ═ -->
    <!-- The tutorial's coach in EX (1.10.0): the same parts and bindings as Classic's (App.xaml), drawn the EX
         way - cut corners and the accent's glow, a progress of one segment per step over a filling line, and the
         steps as a timeline. -->
    <ControlTemplate x:Key="Theme.TutorialCoachTemplate" TargetType="ctl:TutorialCoach">
        <Border Background="{DynamicResource Theme.Window}" BorderBrush="{DynamicResource Theme.Accent}" BorderThickness="2,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="140" ClipToBounds="True">
                    <Border Background="{DynamicResource Theme.Chrome}"/>
                    <Image Source="{Binding HeaderArt}" Stretch="UniformToFill" VerticalAlignment="Center" Opacity="0.95"/>
                    <!-- Diagonal bands in the accent, the EX look's signature, faint over the picture. -->
                    <Border Opacity="0.22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="18,18" MappingMode="Absolute" SpreadMethod="Repeat">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#66FFFFFF" Offset="0.62"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.62"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.25"/>
                                <GradientStop Color="#D8000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel VerticalAlignment="Bottom" Margin="18,0,52,14">
                        <Grid HorizontalAlignment="Left">
                            <!-- The glow from a copy behind the chip: its words stay out of the effect's pass. -->
                            <Grid IsHitTestVisible="False" Effect="{DynamicResource Ex.GlowSoft}">
                                <ctl:ChamferBorder Background="{DynamicResource Theme.Accent}" Cut="6" Corners="TopLeft, BottomRight"/>
                            </Grid>
                            <ctl:ChamferBorder Background="{DynamicResource Theme.Accent}" Cut="6" Corners="TopLeft, BottomRight" Padding="9,1">
                                <TextBlock Text="{Binding Heading}" Foreground="{DynamicResource Theme.OnAccent}" FontSize="11" FontWeight="Bold"/>
                            </ctl:ChamferBorder>
                        </Grid>
                        <TextBlock Text="{Binding Tutorial.Title}" Foreground="White" FontSize="21" FontWeight="Black"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Padding="8,2"
                            Content="&#x2715;" FontSize="12" Command="{Binding ExitCommand}" ToolTip="{l:T tutorialCoach.exit.tip}"/>
                </Grid>

                <!-- One segment per step, lit as they are reached, over a line that fills. -->
                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Progress}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding StepItems}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Rectangle x:Name="seg" Height="6" Margin="1,0" Fill="{DynamicResource Theme.Border}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="seg" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                            <Setter TargetName="seg" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                                            <Setter TargetName="seg" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <Grid Height="2" Margin="0,4,0,0">
                        <Rectangle Fill="{DynamicResource Theme.Border}" Opacity="0.5"/>
                        <Rectangle x:Name="PART_Fill" Fill="{DynamicResource Theme.Accent}"/>
                    </Grid>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{DynamicResource Theme.Chrome}" Padding="14,10,14,12">
                    <StackPanel>
                        <TextBlock Text="{Binding WaitingLabel}" FontStyle="Italic" FontSize="11" Margin="0,0,0,8"
                                   Foreground="{DynamicResource Theme.TextMuted}" TextWrapping="Wrap"
                                   Visibility="{Binding HasWaiting, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="{l:T tutorialOverlay.back}" Padding="12,4" Command="{Binding BackCommand}"/>
                            <Button DockPanel.Dock="Right" Content="{Binding NextLabel}" Padding="18,4"
                                    Style="{DynamicResource Theme.PrimaryButton}" Command="{Binding NextCommand}"/>
                            <Button HorizontalAlignment="Right" Margin="8,0,8,0" Padding="12,4"
                                    Content="{l:T tutorialOverlay.doItForMe}" ToolTip="{l:T tutorialOverlay.doItForMe.tip}"
                                    Command="{Binding DoItForMeCommand}"
                                    Visibility="{Binding CanDoItForMe, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"/>
                        </DockPanel>
                        <Button Margin="0,10,0,0" Padding="12,6" HorizontalAlignment="Stretch"
                                Style="{DynamicResource Theme.PrimaryButton}" Content="{Binding NextTutorialLabel}"
                                Command="{Binding StartNextCommand}"
                                Visibility="{Binding NextTutorial, Converter={x:Static conv:NullToVisibilityConverter.Instance}}"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,10,14,14">
                        <Grid x:Name="PART_Step">
                            <ctl:ChamferBorder Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Accent}"
                                               Cut="14" Corners="TopLeft, BottomRight" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <ctl:ChamferBorder Background="{DynamicResource Theme.AccentSoft}" Cut="5" Corners="TopLeft, BottomRight" Padding="9,1">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource Theme.AccentText}"/>
                                        </ctl:ChamferBorder>
                                        <Grid Margin="6,0,0,0" Visibility="{Binding ShowsDone, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                            <Grid IsHitTestVisible="False" Effect="{DynamicResource Ex.GlowSoft}">
                                                <ctl:ChamferBorder Background="{DynamicResource Theme.Accent}" Cut="5" Corners="TopLeft, BottomRight"/>
                                            </Grid>
                                            <ctl:ChamferBorder Background="{DynamicResource Theme.Accent}" Cut="5" Corners="TopLeft, BottomRight" Padding="9,1">
                                                <TextBlock Text="{Binding DoneLabel}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{DynamicResource Theme.OnAccent}"/>
                                            </ctl:ChamferBorder>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Step.Title}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Theme.Heading}"/>
                                    <TextBlock Text="{Binding Step.Body}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Expander x:Name="PART_More" Header="{l:T tutorialOverlay.more}" Margin="0,10,0,0"
                                              Visibility="{Binding HasMore, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding Step.More}" TextWrapping="Wrap" LineHeight="19" FontSize="12.5"
                                                   Foreground="{DynamicResource Theme.TextMuted}" Margin="18,4,0,0"/>
                                    </Expander>
                                    <ctl:ChamferBorder Background="{DynamicResource Theme.AccentSoft}" Cut="8" Corners="TopLeft, BottomRight"
                                                       Padding="12,10" Margin="0,12,0,0"
                                                       Visibility="{Binding NeedsPreparing, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock Text="{l:T tutorialOverlay.prepare.note}" TextWrapping="Wrap" FontSize="12"/>
                                            <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4"
                                                    Style="{DynamicResource Theme.PrimaryButton}" Content="{l:T tutorialOverlay.prepare}"
                                                    ToolTip="{l:T tutorialOverlay.prepare.tip}" Command="{Binding PrepareCommand}"/>
                                        </StackPanel>
                                    </ctl:ChamferBorder>
                                    <Border Padding="10,8" Margin="0,12,0,0" Background="#26FFC428" BorderBrush="#FFC428" BorderThickness="2,0,0,0"
                                            Visibility="{Binding ShowHintBox, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}">
                                        <TextBlock Text="{Binding Step.Hint}" TextWrapping="Wrap" FontSize="12"/>
                                    </Border>
                                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Foreground="#FF7A45" Margin="0,10,0,0"
                                               Visibility="{Binding HasProblem, Converter={x:Static conv:BoolToVisibilityConverter.Instance}}"/>
                                </StackPanel>
                            </ctl:ChamferBorder>
                        </Grid>

                        <TextBlock Text="{l:T tutorialCoach.steps}" FontWeight="Bold" FontSize="11" Margin="4,18,0,8"
                                   Foreground="{DynamicResource Theme.Accent}"/>
                        <!-- The steps as a timeline: a line down the left joining their markers. -->
                        <ItemsControl x:Name="PART_Steps" ItemsSource="{Binding StepItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Padding="0" Margin="0" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ctl:TutorialCoach}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="Transparent"><ContentPresenter/></Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid MinHeight="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Width="2" HorizontalAlignment="Center" Fill="{DynamicResource Theme.Border}"/>
                                            <Rectangle x:Name="mark" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Fill="{DynamicResource Theme.Window}" Stroke="{DynamicResource Theme.Border}" StrokeThickness="2">
                                                <Rectangle.LayoutTransform><RotateTransform Angle="45"/></Rectangle.LayoutTransform>
                                            </Rectangle>
                                            <TextBlock x:Name="title" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,4,0">
                                                <Run x:Name="num" Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Theme.TextMuted}"/><Run
                                                     Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                            <Setter TargetName="mark" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                                            <Setter TargetName="mark" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                            <Setter TargetName="mark" Property="Stroke" Value="{DynamicResource Theme.Accent}"/>
                                            <Setter TargetName="mark" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
                                            <Setter TargetName="title" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="title" Property="Foreground" Value="{DynamicResource Theme.Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </ControlTemplate>

    <!-- ══ The ModForge tab (1.10.0 rework), EX ═══════════════════════════
         A game's menu more than a tool's page: the strip a HUD bar on the chrome with a glowing line under it,
         the pages cut-cornered tabs that fill with the accent, cards headed like panels, the picture across Home
         cut at the corners under the accent's diagonal bands. Every part and binding of the Classic ones. -->
    <ControlTemplate x:Key="Theme.HomeStripTemplate" TargetType="ContentControl">
        <Grid>
            <Border Background="{DynamicResource Theme.Chrome}" Padding="14,8,14,10">
                <ContentPresenter/>
            </Border>
            <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource Theme.Accent}" Effect="{DynamicResource Ex.GlowSoft}"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.HomeNavTemplate" TargetType="RadioButton">
        <Grid Margin="0,0,6,0" Background="Transparent" view:Motions.Press="{TemplateBinding IsPressed}">
            <Grid x:Name="frame" IsHitTestVisible="False" view:Motions.FadeIn="{TemplateBinding IsMouseOver}">
                <ctl:ChamferBorder SnapsToDevicePixels="True"
                                   Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource Theme.Border}" Stroke="1"
                               Cut="8" Corners="TopLeft, BottomRight" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Theme.Accent}"/>
                    <ContentPresenter VerticalAlignment="Center">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </StackPanel>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.ButtonHover}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Text}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.HomeCardTemplate" TargetType="HeaderedContentControl">
        <Grid>
            <Grid x:Name="frame" IsHitTestVisible="False">
                <ctl:ChamferBorder SnapsToDevicePixels="True"
                                   Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" Stroke="1"
                               Cut="14" Corners="TopRight, BottomLeft">
                <DockPanel>
                    <!-- A panel's head: the accent's notch, the glyph, the heading in capitals' weight. -->
                    <Grid DockPanel.Dock="Top">
                        <Border Background="{DynamicResource Theme.Chrome}" Opacity="0.85"/>
                        <DockPanel Margin="0,7,18,7">
                            <Rectangle DockPanel.Dock="Left" Width="4" Fill="{DynamicResource Theme.Accent}" Margin="0,0,12,0"
                                       Effect="{DynamicResource Ex.GlowSoft}"/>
                            <TextBlock DockPanel.Dock="Left" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource Theme.Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.FontSize="14" TextElement.FontWeight="Black"
                                              TextElement.Foreground="{DynamicResource Theme.Heading}"/>
                        </DockPanel>
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Theme.Accent}" Opacity="0.5"/>
                    </Grid>
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </DockPanel>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.HomeHeroTemplate" TargetType="ContentControl">
        <Grid>
            <!-- Dark under the words in every EX theme, light ones too: the words are white. -->
            <ctl:ChamferBorder Background="#FF0B0C13" Stroke="0" Cut="22" Corners="TopLeft, BottomRight">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Background="{DynamicResource Theme.Accent}">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                <GradientStop Color="#50000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <Border Grid.Column="1">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                        Stretch="UniformToFill" AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                    <Border Grid.ColumnSpan="2" Opacity="0.2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="22,22" MappingMode="Absolute" SpreadMethod="Repeat">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#66FFFFFF" Offset="0.6"/>
                                <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Grid.Column="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0B0C13" Offset="0"/>
                                <GradientStop Color="#000B0C13" Offset="0.4"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <ContentPresenter Grid.ColumnSpan="2" Margin="{TemplateBinding Padding}"/>
                </Grid>
            </ctl:ChamferBorder>
            <Rectangle Height="3" Width="180" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,0"
                       Fill="{DynamicResource Theme.Accent}" Effect="{DynamicResource Ex.Glow}"/>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.HomeTutorialTemplate" TargetType="ContentControl">
        <Grid>
            <Grid x:Name="frame" IsHitTestVisible="False" view:Motions.FadeIn="{TemplateBinding IsMouseOver}">
                <ctl:ChamferBorder SnapsToDevicePixels="True"
                                   Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}"
                               Stroke="1" Cut="12" Corners="TopLeft, BottomRight">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="132">
                        <Border Background="{DynamicResource Theme.Chrome}"/>
                        <Border>
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                            Stretch="UniformToFill" AlignmentY="Center"/>
                            </Border.Background>
                        </Border>
                        <Rectangle Width="3" HorizontalAlignment="Right" Fill="{DynamicResource Theme.Accent}"/>
                    </Grid>
                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                </DockPanel>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Theme.TabTemplate" TargetType="TabItem">
        <!-- One header for both arrangements, so a tab whose header is a
             control is never put in two places: a strip across the top for a
             tab control inside a page, and, when its control stands them down
             the side (the window's own tabs), a rail entry - the tab's icon
             over its name. -->
        <Grid x:Name="root" Margin="1,0,1,0">
            <ctl:ChamferBorder x:Name="bd" Background="Transparent" BorderBrush="Transparent" Stroke="0"
                               Cut="7" Corners="TopRight" Padding="11,5,11,6">
                <StackPanel x:Name="stack" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- On the rail, a number worth noticing on the icon - the
                         ModForge tab's issues - and under the name how many
                         records the tab holds (the author, 1.8.0). -->
                    <Grid x:Name="icon" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,3">
                        <TextBlock x:Name="glyph" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center"
                                   Text="{Binding (view:TabIcon.Glyph), RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border x:Name="badge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-5,-16,0" Padding="4,0,4,1" CornerRadius="7" MinWidth="14"
                                Background="{DynamicResource Theme.Danger}"
                                view:Motions.Pulse="{Binding (view:TabIcon.Badge), RelativeSource={RelativeSource TemplatedParent}}">
                            <!-- In the window's colour: white measured 2.46:1 on a dark
                                 theme's light red; the window is dark there and light
                                 where the red is dark. -->
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Window}" HorizontalAlignment="Center"
                                       Text="{Binding (view:TabIcon.Badge), RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Border>
                    </Grid>
                    <ContentPresenter x:Name="header" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentPresenter.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                    <TextBlock x:Name="count" Visibility="Collapsed" FontSize="10" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Theme.TextMuted}"
                               Text="{Binding (view:TabIcon.Count), RelativeSource={RelativeSource TemplatedParent}}"/>
                </StackPanel>
            </ctl:ChamferBorder>
            <Rectangle x:Name="bar" Height="2" VerticalAlignment="Bottom" Fill="Transparent" Margin="4,0"
                       view:Motions.Grow="{TemplateBinding IsSelected}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding TabStripPlacement, RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Left">
                <Setter TargetName="root" Property="Width" Value="84"/>
                <Setter TargetName="root" Property="Margin" Value="0,1"/>
                <!-- Tight enough that every tab fits a 900 px window when none counts records (1.10.0). -->
                <Setter TargetName="bd" Property="Padding" Value="4,7,4,6"/>
                <Setter TargetName="bd" Property="Cut" Value="9"/>
                <Setter TargetName="stack" Property="Orientation" Value="Vertical"/>
                <Setter TargetName="icon" Property="Visibility" Value="Visible"/>
                <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                <Setter TargetName="count" Property="Visibility" Value="Visible"/>
                <Setter TargetName="header" Property="TextElement.FontSize" Value="11"/>
                <Setter TargetName="bar" Property="Height" Value="Auto"/>
                <Setter TargetName="bar" Property="Width" Value="3"/>
                <Setter TargetName="bar" Property="Margin" Value="0,6"/>
                <Setter TargetName="bar" Property="VerticalAlignment" Value="Stretch"/>
                <Setter TargetName="bar" Property="HorizontalAlignment" Value="Left"/>
                <Setter TargetName="bar" Property="view:Motions.GrowAxis" Value="Y"/>
            </DataTrigger>
            <!-- After the rail's, so a nought hides what the rail shows. -->
            <Trigger Property="view:TabIcon.Count" Value="0">
                <Setter TargetName="count" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="view:TabIcon.Badge" Value="0">
                <Setter TargetName="badge" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="view:TabIcon.BadgeLevel" Value="warning">
                <Setter TargetName="badge" Property="Background" Value="{DynamicResource Theme.Warning}"/>
            </Trigger>
            <Trigger Property="view:TabIcon.BadgeLevel" Value="info">
                <Setter TargetName="badge" Property="Background" Value="{DynamicResource Theme.TextMuted}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.TabActive}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="bar" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
                <!-- The accent as ink (Theme.Link): pushed until it reads, where a
                     light accent like Mint's green as it comes did not. -->
                <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Theme.Link}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.TabActiveText}"/>
                <Setter Property="Panel.ZIndex" Value="1"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="False"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.TabHover}"/>
                <Setter TargetName="bar" Property="Fill" Value="{DynamicResource Theme.TextMuted}"/>
                <Setter Property="Foreground" Value="{DynamicResource Theme.TabActiveText}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The rail's sign that it goes on (Theme.MainTabs below): the rail's own colour fading in over the tabs at
         that end, and an arrow in the accent that scrolls it. At the top unless it stands at the bottom. -->
    <ControlTemplate x:Key="Ex.RailMoreTemplate" TargetType="Button">
        <Grid Height="36" Background="Transparent" Cursor="Hand">
            <Rectangle x:Name="shade" Fill="{DynamicResource Theme.Chrome}">
                <Rectangle.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Black" Offset="0.4"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>
            <TextBlock x:Name="arrow" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                       Foreground="{DynamicResource Theme.Accent}"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="VerticalAlignment" Value="Bottom">
                <Setter TargetName="shade" Property="OpacityMask">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="Black" Offset="0.4"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
                <Setter TargetName="arrow" Property="VerticalAlignment" Value="Bottom"/>
                <Setter TargetName="arrow" Property="Margin" Value="0,0,0,4"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="arrow" Property="Effect" Value="{DynamicResource Ex.Glow}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ The window's own tabs: a rail down the side, and over the pages a
         header with the pack's name (1.8.0). The same tabs in the same order,
         picked the same way - only where they stand changes. The language the
         pack is edited in sits at the header's right (MainWindow lays it over
         the tabs' corner, and keeps the pack's name clear of it). ═════════ -->
    <Style x:Key="Theme.MainTabs" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource Theme.Window}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Background="{DynamicResource Theme.Chrome}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,1,0">
                            <Grid>
                                <ScrollViewer x:Name="RailScroll" view:ScrollEdges.Watch="True"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="0,4" Panel.ZIndex="1"
                                              KeyboardNavigation.TabIndex="1"/>
                                </ScrollViewer>
                                <!-- More tabs than the window is high (900 px with every tab
                                     counting its records): the rail fades out where it goes on,
                                     with an arrow that scrolls it - a scroll bar three pixels
                                     wide was all there was, and the last tabs looked missing. -->
                                <Button x:Name="RailMoreAbove" VerticalAlignment="Top" Visibility="Collapsed"
                                        Command="ScrollBar.PageUpCommand" CommandTarget="{Binding ElementName=RailScroll}"
                                        Focusable="False" IsTabStop="False" Template="{StaticResource Ex.RailMoreTemplate}" Tag="&#xE70E;"/>
                                <Button x:Name="RailMoreBelow" VerticalAlignment="Bottom" Visibility="Collapsed"
                                        Command="ScrollBar.PageDownCommand" CommandTarget="{Binding ElementName=RailScroll}"
                                        Focusable="False" IsTabStop="False" Template="{StaticResource Ex.RailMoreTemplate}" Tag="&#xE70D;"/>
                            </Grid>
                        </Border>
                        <DockPanel x:Name="PackHeader" Grid.Column="1" Margin="16,7,16,5" MinHeight="32">
                            <Rectangle DockPanel.Dock="Left" Width="4" Margin="0,3,10,3" Fill="{DynamicResource Theme.Accent}"/>
                            <TextBlock DockPanel.Dock="Left" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding DataContext.PackName, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <TextBlock DockPanel.Dock="Left" FontSize="13" Margin="10,0,0,4" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource Theme.TextMuted}"
                                       Text="{Binding DataContext.PackVersionText, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <!-- A command bar (the author, 1.8.0): what the File menu is
                                 opened for most, beside the pack's name, and a dot while
                                 there is something to save. -->
                            <StackPanel x:Name="Unsaved" DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,4"
                                        VerticalAlignment="Bottom" ToolTip="{l:T header.unsaved.tip}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ShowsUnsaved, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{DynamicResource Theme.Warning}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource Theme.TextMuted}" Text="{l:T header.unsaved}"/>
                            </StackPanel>
                            <StackPanel x:Name="Commands" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="0,0,6,0" Padding="9,2" ToolTip="{l:T header.save.tip}"
                                        Command="{Binding DataContext.SavePackCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:T header.save}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,6,0" Padding="9,2" ToolTip="{l:T header.validate.tip}"
                                        Command="{Binding DataContext.ValidateCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:T header.validate}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="9,2" ToolTip="{l:T header.export.tip}"
                                        Command="{Binding DataContext.ExportPackCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:T header.export}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border/>
                        </DockPanel>
                        <Border Grid.Column="1" Grid.Row="1" Background="{TemplateBinding Background}" Padding="4,0,4,4">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="RailScroll" Property="view:ScrollEdges.MoreAbove" Value="True">
                            <Setter TargetName="RailMoreAbove" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger SourceName="RailScroll" Property="view:ScrollEdges.MoreBelow" Value="True">
                            <Setter TargetName="RailMoreBelow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Groups: a HUD panel - cut corners, the accent's marks at two of
         them, the title as a strip with a rule running off it ═══════════ -->
    <ControlTemplate x:Key="Theme.GroupTemplate" TargetType="GroupBox">
        <!-- A tile: cut corners, and its title on a band of the accent's tint
             across the whole top - a page reads as a board of tiles from
             across the room. -->
        <ctl:ChamferBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                           Cut="10" Corners="TopRight, BottomLeft" SnapsToDevicePixels="True">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{DynamicResource Theme.AccentSoft}" Padding="10,5,18,5">
                    <DockPanel LastChildFill="True">
                        <Rectangle DockPanel.Dock="Left" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource Theme.Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <!-- The panel's help, behind a "?" at the band's end rather
                             than sitting in the tile (the author, 1.8.0). Shown on a
                             panel that has help: see PanelHelp and HelpText. -->
                        <ToggleButton x:Name="help" DockPanel.Dock="Right" Visibility="Collapsed" Width="18" Height="18"
                                      Margin="8,0,0,0" Focusable="False" Cursor="Hand" ToolTip="{l:T help.toggle.tip}"
                                      IsChecked="{Binding (view:PanelHelp.Open), RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ring" CornerRadius="9" BorderThickness="1" Background="Transparent"
                                            BorderBrush="{DynamicResource Theme.Accent}">
                                        <TextBlock x:Name="mark" Text="?" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.Heading}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ring" Property="BorderThickness" Value="1.5"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ring" Property="Background" Value="{DynamicResource Theme.Accent}"/>
                                            <Setter TargetName="mark" Property="Foreground" Value="{DynamicResource Theme.OnAccent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"
                                          TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Theme.Heading}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Theme.Heading}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </DockPanel>
                </Border>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </DockPanel>
        </ctl:ChamferBorder>
        <ControlTemplate.Triggers>
            <Trigger Property="view:PanelHelp.HasHelp" Value="True">
                <Setter TargetName="help" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ Expanders: a diamond that turns ═══════════════════════════════ -->
    <Style x:Key="Ex.ExpanderHeader" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="Transparent" Padding="2,2">
                        <DockPanel>
                            <Path x:Name="arrow" DockPanel.Dock="Left" Data="M0,0 L5,4.5 L0,9" Margin="2,0,8,0"
                                  Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.8"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                  view:Motions.Turn="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Theme.Hover}"/>
                            <Setter TargetName="arrow" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="Theme.ExpanderTemplate" TargetType="Expander">
        <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Style="{StaticResource Ex.ExpanderHeader}"
                          Content="{TemplateBinding Header}"
                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="content" Visibility="Collapsed" Margin="{TemplateBinding Padding}"
                              view:Motions.Reveal="{TemplateBinding IsExpanded}"/>
        </DockPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="content" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ A picture at full size (1.10.0, View/Controls/PictureViewer), EX ═══
         The rail's dark over the window, the picture held in accent brackets, its name beside an accent bar, and a cut
         bar of buttons in the accent's glow. -->
    <ControlTemplate x:Key="Theme.PictureViewerTemplate" TargetType="ctl:PictureViewer">
        <Grid>
            <Rectangle Fill="{DynamicResource Theme.Chrome}" Opacity="0.975"/>
            <Grid x:Name="PART_Root">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="28,14,16,10">
                    <Button DockPanel.Dock="Right" Command="{x:Static ctl:PictureViewer.Close}" ToolTip="{l:T pictureViewer.close}" Padding="9,5">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Rectangle Width="3" Height="18" Margin="0,0,10,0" Fill="{DynamicResource Theme.Accent}" Effect="{DynamicResource Ex.Glow}"/>
                    <TextBlock Text="{TemplateBinding Caption}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{DynamicResource Theme.Heading}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="28,4">
                    <Grid x:Name="PART_Stage" Background="Transparent" ClipToBounds="True">
                        <Image x:Name="PART_Image" Source="{TemplateBinding Source}"/>
                    </Grid>
                    <Grid IsHitTestVisible="False" Margin="-6">
                        <Path Data="M0,16 L0,0 L16,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="2"/>
                        <Path Data="M0,0 L16,0 L16,16" HorizontalAlignment="Right" VerticalAlignment="Top" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="2"/>
                        <Path Data="M0,0 L0,16 L16,16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="2"/>
                        <Path Data="M16,0 L16,16 L0,16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="2"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,14">
                    <Grid HorizontalAlignment="Center">
                        <Grid IsHitTestVisible="False" Effect="{DynamicResource Ex.GlowSoft}">
                            <ctl:ChamferBorder Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Accent}" Stroke="1"
                                               Cut="9" Corners="TopLeft, BottomRight"/>
                        </Grid>
                        <ctl:ChamferBorder Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Accent}" Stroke="1"
                                           Cut="9" Corners="TopLeft, BottomRight" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{x:Static ctl:PictureViewer.ZoomOut}" ToolTip="{l:T pictureViewer.zoomOut}" Padding="9,5" Margin="2,0">
                                    <TextBlock Text="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <TextBlock Text="{TemplateBinding ZoomText}" MinWidth="54" TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Theme.Text}" FontWeight="SemiBold"/>
                                <Button Command="{x:Static ctl:PictureViewer.ZoomIn}" ToolTip="{l:T pictureViewer.zoomIn}" Padding="9,5" Margin="2,0">
                                    <TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                                </Button>
                                <Rectangle Width="1" Margin="8,4" Fill="{DynamicResource Theme.Border}"/>
                                <Button Command="{x:Static ctl:PictureViewer.Fit}" Content="{l:T pictureViewer.fit}" ToolTip="{l:T pictureViewer.fit.tip}" Padding="10,4" Margin="2,0"/>
                                <Button Command="{x:Static ctl:PictureViewer.ActualSize}" Content="{l:T pictureViewer.actual}" ToolTip="{l:T pictureViewer.actual.tip}" Padding="10,4" Margin="2,0"/>
                            </StackPanel>
                        </ctl:ChamferBorder>
                    </Grid>
                    <TextBlock Text="{l:T pictureViewer.hint}" FontSize="11" HorizontalAlignment="Center" Margin="0,7,0,0"
                               Foreground="{DynamicResource Theme.TextMuted}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </ControlTemplate>

    <!-- A picture that opens at full size: cut corners, the glow and a cut magnifier tab on pointing. -->
    <ControlTemplate x:Key="Theme.PictureButtonTemplate" TargetType="Button">
        <Grid view:Motions.Press="{TemplateBinding IsPressed}">
            <Grid x:Name="frame" IsHitTestVisible="False" view:Motions.FadeIn="{TemplateBinding IsMouseOver}">
                <ctl:ChamferBorder Background="{Binding Background, ElementName=bd}" BorderBrush="{Binding BorderBrush, ElementName=bd}"
                                   Stroke="{Binding Stroke, ElementName=bd}" Cut="{Binding Cut, ElementName=bd}" Corners="{Binding Corners, ElementName=bd}"/>
            </Grid>
            <ctl:ChamferBorder x:Name="bd" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" Stroke="1"
                               Cut="10" Corners="TopLeft, BottomRight" Padding="1">
                <ContentPresenter/>
            </ctl:ChamferBorder>
            <ctl:ChamferBorder x:Name="badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Width="28" Height="24"
                               Cut="6" Corners="TopLeft, BottomRight" Background="{DynamicResource Theme.Accent}" Visibility="Hidden"
                               view:Motions.FadeIn="{TemplateBinding IsMouseOver}">
                <TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Theme.OnAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ctl:ChamferBorder>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="frame" Property="Effect" Value="{DynamicResource Ex.GlowSoft}"/>
                <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══ Tooltips: a cut panel with the accent down its edge ═══════════ -->
    <ControlTemplate x:Key="Theme.ToolTipTemplate" TargetType="ToolTip">
        <Grid view:Motions.Appear="True">
            <ctl:ChamferBorder Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                               Cut="7" Corners="BottomRight" Padding="{TemplateBinding Padding}">
                <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.ToolTipText}"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </ctl:ChamferBorder>
            <Rectangle Width="2" HorizontalAlignment="Left" Fill="{DynamicResource Theme.Accent}"/>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
