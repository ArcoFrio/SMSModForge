<UserControl x:Class="SMSModForge.View.Controls.TutorialOverlay"
             PreviewMouseWheel="Overlay_PreviewMouseWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!--
        Sits over the editor (not over the coach panel docked beside it: MainWindow keeps this clear of it) as a
        sibling of the save toast. The dim, one Path with the spotlight cut out of it, and the ring round the step's
        control. The step itself is in the coach (TutorialCoach, 1.10.0): the floating box that was here covered the
        very labels its steps named.
    -->
    <Grid x:Name="Root">
        <!-- The dim. Hit-test visible on purpose: it swallows clicks outside
             the lit area, which is what keeps a step on rails. The holes are
             absent from the geometry, so clicks there fall through by
             themselves.
             ~
             That makes the lit area a PERMISSION, not just a highlight — so a
             step must light every control its instruction names. Steps list the
             others in TutorialStep.AlsoAllow, and each gets its own hole. -->
        <Path x:Name="Dim" Fill="#A6000000"/>

        <!-- The ring round the spotlight, in the amber of jumping to a validation issue, so "look here" reads the
             same everywhere. Its glow is kept soft: a strong one bled over the controls inside it. -->
        <Rectangle x:Name="Ring" HorizontalAlignment="Left" VerticalAlignment="Top"
                   IsHitTestVisible="False" RadiusX="4" RadiusY="4"
                   Stroke="#FFC428" StrokeThickness="2" Visibility="Collapsed">
            <Rectangle.Effect>
                <DropShadowEffect x:Name="RingGlow" Color="#FFC428" ShadowDepth="0"
                                  BlurRadius="8" Opacity="0.55"/>
            </Rectangle.Effect>
        </Rectangle>
    </Grid>
</UserControl>
