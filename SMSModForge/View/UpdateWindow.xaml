<!--
    Shown when a check finds a newer release and the author has not asked for
    updates to install themselves. Deliberately a window rather than a toast:
    this one asks for a decision, and the notes are the reason to say yes.
-->
<Window x:Class="SMSModForge.View.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Width="620" Height="560"
        MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="HeadlineText" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Two short rows rather than one tall column. Stacking the plugin
             line, its button and the opt-out beside the buttons made the block
             taller than the window had room for, and the checkbox fell off the
             bottom edge - present in the tree, absent from the screen. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- What the update will touch besides the editor: something to
                 know, not the question being asked, so it is grey and it is not
                 beside the buttons.

                 The button appears only when the folder has never been set and
                 this release has a plugin to install. Telling somebody a menu
                 to go and find, in a window they would have to dismiss first,
                 is a dead end - so the offer is here, where the fact is. -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="PluginText" Foreground="Gray" TextWrapping="Wrap"/>
                <Button x:Name="SetFolderButton" Content="Set Starmaker Story folder…"
                        HorizontalAlignment="Left" Margin="0,5,0,0" Padding="8,2"
                        Visibility="Collapsed" Click="SetFolder_Click"
                        ToolTip="Point at your game folder and this update will replace the plugin there too, so the pair cannot drift apart. Only the plugin and what it needs is written - not BepInEx, and not your packs."/>
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <!-- Away from the buttons on purpose, the same as the save
                     dialog's opt-out: one sitting beside Update now would get
                     clicked by somebody aiming for Update now. -->
                <CheckBox x:Name="StopChecking" DockPanel.Dock="Left"
                          VerticalAlignment="Center"
                          Content="Stop checking for updates on start"
                          ToolTip="Tick this and the editor will not look for a new version again, however you close this window. Options ▸ Check for updates on start turns it back on, and Check for updates now still works either way."/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Update now" Width="110" IsDefault="True" Click="Update_Click"
                            Margin="0,0,8,0"
                            ToolTip="Download the new version, close the editor, put it in place and start it again. Anything unsaved is asked about first, the same as closing normally."/>
                    <Button Content="Not now" Width="90" IsCancel="True"
                            ToolTip="Carry on with this version. You will be told again next time the editor starts; tick the box on the left if you would rather not be."/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- The release notes, rendered. They are written as markdown, and shown
             raw they are mostly punctuation - the headings arrive as hashes and
             the emphasis as asterisks, leaving the reader to do the rendering
             in their head while deciding whether to install something.

             A FlowDocumentScrollViewer rather than a TextBlock because the text
             stays selectable, and IsToolBarVisible is off because its toolbar is
             a find bar and a zoom slider nobody needs over four paragraphs. See
             MarkdownFlow for what is and is not understood. -->
        <FlowDocumentScrollViewer x:Name="NotesView"
                                  VerticalScrollBarVisibility="Auto"
                                  IsToolBarVisible="False"
                                  IsSelectionEnabled="True"
                                  Background="{DynamicResource Theme.Control}"
                                  BorderBrush="{DynamicResource Theme.Accent}"
                                  BorderThickness="1"/>
    </DockPanel>
</Window>
