<Window x:Class="SMSModForge.View.CustomThemesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SMSModForge.Localization"
        xmlns:conv="clr-namespace:SMSModForge.View.Converters"
        Title="{l:T theme.custom.title}" Width="680" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Theme.Window}"
        Foreground="{DynamicResource Theme.Text}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:PickedConverter x:Key="Picked"/>
        <conv:PickedConverter x:Key="PickedFalse" Invert="True"/>
        <!-- One colour of the theme: what it paints, a swatch that opens the
             picker, and its value to type over. -->
        <Style x:Key="Swatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Command" Value="{Binding PickColourCommand}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{l:T theme.custom.close}" Width="90"
                    IsCancel="True" IsDefault="True" Click="Close_Click"/>
            <TextBlock Text="{l:T theme.custom.note}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{DynamicResource Theme.TextMuted}"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="NewThemeButton" Content="{l:T theme.custom.new}" ToolTip="{l:T theme.custom.new.tip}"
                            Command="{Binding NewCommand}" Margin="0,0,4,4" Padding="8,2"/>
                    <Button Content="{l:T navigator.duplicate}" ToolTip="{l:T theme.custom.duplicate.tip}"
                            Command="{Binding DuplicateCommand}" Margin="0,0,4,4" Padding="8,2"/>
                    <Button Content="{l:T theme.custom.remove}" ToolTip="{l:T theme.custom.remove.tip}"
                            Command="{Binding RemoveCommand}" Margin="0,0,4,4" Padding="8,2"/>
                </WrapPanel>
                <ListBox x:Name="ThemeList" ItemsSource="{Binding Themes}" SelectedItem="{Binding Selected}"
                         DisplayMemberPath="DisplayName"/>
            </DockPanel>

            <TextBlock Grid.Column="2" Text="{l:T theme.custom.empty}" TextWrapping="Wrap"
                       Foreground="{DynamicResource Theme.TextMuted}"
                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"/>

            <Grid x:Name="ThemeFields" Grid.Column="2" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,4,12,4"/>
                    </Style>
                    <Style x:Key="Hex" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Width" Value="90"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Text="{l:T theme.custom.name}"/>
                <TextBox x:Name="ThemeNameBox" Grid.Row="0" Grid.Column="1" MaxWidth="260" HorizontalAlignment="Left" MinWidth="200"
                         VerticalAlignment="Center" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>

                <TextBlock Grid.Row="1" Text="{l:T theme.custom.look}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{l:T theme.custom.look.tip}">
                    <RadioButton x:Name="LookEx" Content="{l:T theme.group.ex}" IsChecked="{Binding IsEx, Converter={StaticResource Picked}}" Margin="0,0,16,0"/>
                    <RadioButton x:Name="LookClassic" Content="{l:T theme.group.normal}" IsChecked="{Binding IsEx, Converter={StaticResource PickedFalse}}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{l:T theme.custom.window}" ToolTip="{l:T theme.custom.window.tip}"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Swatch}" CommandParameter="WindowColour" Background="{Binding WindowColour, Converter={x:Static conv:HexBrushConverter.Instance}}"/>
                    <TextBox x:Name="WindowColourBox" Style="{StaticResource Hex}" Text="{Binding WindowColour, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <TextBlock Grid.Row="4" Text="{l:T theme.custom.chrome}" ToolTip="{l:T theme.custom.chrome.tip}"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Swatch}" CommandParameter="ChromeColour" Background="{Binding ChromeColour, Converter={x:Static conv:HexBrushConverter.Instance}}"/>
                    <TextBox Style="{StaticResource Hex}" Text="{Binding ChromeColour, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <TextBlock Grid.Row="5" Text="{l:T theme.custom.surface}" ToolTip="{l:T theme.custom.surface.tip}"/>
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Swatch}" CommandParameter="SurfaceColour" Background="{Binding SurfaceColour, Converter={x:Static conv:HexBrushConverter.Instance}}"/>
                    <TextBox Style="{StaticResource Hex}" Text="{Binding SurfaceColour, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <TextBlock Grid.Row="6" Text="{l:T theme.custom.control}" ToolTip="{l:T theme.custom.control.tip}"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Swatch}" CommandParameter="ControlColour" Background="{Binding ControlColour, Converter={x:Static conv:HexBrushConverter.Instance}}"/>
                    <TextBox Style="{StaticResource Hex}" Text="{Binding ControlColour, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <TextBlock Grid.Row="7" Text="{l:T theme.custom.text}" ToolTip="{l:T theme.custom.text.tip}"/>
                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Swatch}" CommandParameter="TextColour" Background="{Binding TextColour, Converter={x:Static conv:HexBrushConverter.Instance}}"/>
                    <TextBox Style="{StaticResource Hex}" Text="{Binding TextColour, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <TextBlock Grid.Row="8" Text="{l:T theme.custom.accent}" ToolTip="{l:T theme.custom.accent.tip}"/>
                <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Swatch}" CommandParameter="AccentColour" Background="{Binding AccentColour, Converter={x:Static conv:HexBrushConverter.Instance}}"/>
                    <TextBox x:Name="AccentColourBox" Style="{StaticResource Hex}" Text="{Binding AccentColour, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
                <TextBlock x:Name="UnreadableNote" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="{l:T theme.custom.unreadable}" Foreground="{DynamicResource Theme.Warning}"
                           Visibility="{Binding HasUnreadable, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
