<UserControl x:Class="SMSModForge.View.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SMSModForge.Localization"
             xmlns:view="clr-namespace:SMSModForge.View"
             Background="{DynamicResource Theme.Window}">
    <!-- What the editor shows with no pack open (1.10.0, the author: "Locking the UI until there's a modpack open
         ... a page based on the ModForge tab, but only shows 2 big buttons, one for creating a new modpack ... and
         one for loading an existing one, as well as recent ones shown on a list below the 2 buttons for quick
         loading"). The menus above stay as they are. DataContext: the window's MainViewModel. -->
    <UserControl.Resources>
        <Style x:Key="StartTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="250"/>
            <Setter Property="MinHeight" Value="118"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Margin="24,48,24,24" MaxWidth="560">
            <TextBlock Text="{l:T start.title}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Theme.Heading}"/>
            <TextBlock Text="{l:T start.subtitle}" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,6,0,22" Foreground="{DynamicResource Theme.TextMuted}"/>

            <WrapPanel HorizontalAlignment="Center">
                <Button x:Name="StartNewButton" view:TutorialAnchor.Id="btn:startNew" Style="{StaticResource StartTile}" Command="{Binding NewPackCommand}"
                        ToolTip="{l:T start.new.tip}" AutomationProperties.Name="{l:T start.new}">
                    <StackPanel>
                        <TextBlock Text="＋" FontSize="30" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,0,4"/>
                        <TextBlock Text="{l:T start.new}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T start.new.sub}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="StartOpenButton" Style="{StaticResource StartTile}" Command="{Binding OpenPackCommand}"
                        ToolTip="{l:T start.open.tip}" AutomationProperties.Name="{l:T start.open}">
                    <StackPanel>
                        <TextBlock Text="⤓" FontSize="30" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,0,4"/>
                        <TextBlock Text="{l:T start.open}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T start.open.sub}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}"/>
                    </StackPanel>
                </Button>
                <!-- The first tutorial (1.10.0): it makes the pack it is followed in. -->
                <Button x:Name="StartLearnButton" Style="{StaticResource StartTile}" Command="{Binding StartFirstTutorialCommand}"
                        ToolTip="{l:T start.learn.tip}" AutomationProperties.Name="{l:T start.learn}">
                    <StackPanel>
                        <TextBlock Text="?" FontSize="30" Foreground="{DynamicResource Theme.Accent}" Margin="0,0,0,4"/>
                        <TextBlock Text="{l:T start.learn}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:T start.learn.sub}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Theme.TextMuted}"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- The packs opened lately, newest first. One that is not there any more stays, greyed, with an x to
                 take it off the list: it may be on a drive that is not plugged in. -->
            <TextBlock x:Name="StartRecentHeading" Text="{l:T start.recent}" FontSize="14" FontWeight="SemiBold"
                       Margin="8,26,8,6" Foreground="{DynamicResource Theme.Heading}"/>
            <TextBlock x:Name="StartNoRecent" Text="{l:T start.recent.none}" Margin="8,0" Foreground="{DynamicResource Theme.TextMuted}"
                       Visibility="Collapsed"/>
            <ItemsControl x:Name="StartRecentList" ItemsSource="{Binding RecentPacks}" Margin="8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="✕" Width="26" Padding="0" Margin="6,0,0,0"
                                    Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Path}" ToolTip="{l:T start.recent.remove.tip}"
                                    VerticalAlignment="Stretch"/>
                            <Button HorizontalContentAlignment="Stretch" Padding="10,6"
                                    Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Path}" IsEnabled="{Binding Exists}"
                                    ToolTip="{Binding Path}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Where}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Theme.TextMuted}"/>
                                    <TextBlock Text="{l:T start.recent.missing}" FontSize="11"
                                               Foreground="{DynamicResource Theme.Warning}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
