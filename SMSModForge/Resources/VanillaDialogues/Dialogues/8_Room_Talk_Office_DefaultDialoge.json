  "333223801": {
   "kind": "text",
   "parent": 1951542077,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "My advice? Meet them halfway. Give them what they want, but not everything.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-669297736": {
   "kind": "text",
   "parent": 1951542077,
   "actor": "Josef",
   "expressionName": "neutral",
