    }
   ]
  },
  "-624841122": {
   "kind": "text",
   "parent": -2099781492,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Just… be careful, okay? I don’t want to see you getting hurt.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "499507567": {
   "kind": "text",
   "parent": 208177227,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Well, I suppose that’s better than fighting on the streets… but don’t push yourself too hard, okay?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1375134174": {
   "kind": "text",
   "parent": -1512122725,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Are you… feeling alright? You’re not… you know, hallucinating or anything, right?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1675024024": {
   "kind": "text",
   "parent": 208177227,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "No martial arts class is worth getting hurt like this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "879006797": {
   "kind": "choice",
   "parent": -1512122725,
   "children": [
    -991756719,
    932333158
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Look, if something’s bothering you, you can talk to me....",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-991756719": {
   "kind": "text",
   "parent": 879006797,
   "children": [
    -1457600797,
    -97429941
   ],
   "actor": null,
   "text": "I’m telling the truth. I know it sounds insane, but it’s real. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1457600797": {
   "kind": "text",
   "parent": -991756719,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Okay, okay… I’m not going to push you. But, please… just be careful.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "932333158": {
   "kind": "text",
   "parent": 879006797,
   "children": [
    1105663840
   ],
   "actor": null,
   "text": "I know... Thanks, {M}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1105663840": {
   "kind": "text",
   "parent": 932333158,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Good. Whatever it is you’re dealing with, I don’t want you to get hurt.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-97429941": {
   "kind": "text",
   "parent": -991756719,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Whatever it is you’re dealing with, I don’t want you to get hurt.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-325499175": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Now, go get cleaned up. I’ll make some tea. We can talk more if you want…",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
