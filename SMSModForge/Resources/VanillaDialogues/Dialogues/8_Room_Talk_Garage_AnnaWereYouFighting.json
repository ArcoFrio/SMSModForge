 "nodes": {
  "722229769": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Oh my God, what happened to you?!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2005215822": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -2099781492,
    208177227,
    -1512122725
   ],
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Were you in a fight? I thought you’d outgrown that phase! Who did this to you?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-2099781492": {
   "kind": "text",
   "parent": -2005215822,
   "children": [
    759437899,
    -624841122
   ],
   "actor": null,
   "text": "(Lie) It’s nothing, just got into a small argument. I’m fine.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "208177227": {
   "kind": "text",
   "parent": -2005215822,
   "children": [
    -1158758885,
    499507567,
    1675024024
   ],
   "actor": null,
   "text": "(Half-Truth) I, uh… joined a martial arts class. It got a bit rough.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1512122725": {
   "kind": "text",
   "parent": -2005215822,
   "children": [
    1787788122,
    1375134174,
    879006797
   ],
   "actor": null,
   "text": "I was… fighting spirits.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1787788122": {
   "kind": "text",
   "parent": -1512122725,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Spirits? Okay, very funny. Now, seriously… what happened?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1158758885": {
   "kind": "text",
   "parent": 208177227,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Martial arts? Since when? You never mentioned that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "759437899": {
   "kind": "text",
   "parent": -2099781492,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "A small argument? Bruises like that don’t come from just words, you know. You’re not in trouble, are you?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "runActions",
     "type": "InstructionLogicRunActions",
     "title": "Run Anna_Decrease_Mood and wait",
     "fields": {
      "m_Actions": {
       "kind": "object",
       "name": "Anna_Decrease_Mood",
       "of": "GetGameObjectActions",
       "path": "10_Gameplay/Anna_Decrease_Mood"
