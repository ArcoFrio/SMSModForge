  "-1657589182": {
   "kind": "text",
   "parent": 975002162,
   "actor": "V_NormalWoman",
   "expression": 2,
   "text": "It feels fine. Some of us don’t need to flash skin to have self-worth.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-324761003": {
   "kind": "text",
   "parent": 975002162,
   "actor": "Claudia",
   "expression": 4,
   "text": "Sure, sure… but don’t you ever feel invisible standing next to women who literally jiggle for a living?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "567717673": {
   "kind": "text",
   "parent": -1,
   "children": [
    -1152986625,
    -1128234540
   ],
   "actor": "Claudia",
   "expressionName": "neutral",
   "text": "Quick question! if I gave you a designer bra and fifty thousand followers, would you start dressing like the rest of Peak City?",
