  "-1152986625": {
   "kind": "text",
   "parent": 567717673,
   "actor": "V_NormalWoman",
   "expression": 2,
   "text": "I’d burn the bra.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1128234540": {
   "kind": "text",
   "parent": 567717673,
   "actor": "Claudia",
   "expression": 4,
   "text": "Ah, a rebel! Perfect headline... “Local woman hates progress.”",
