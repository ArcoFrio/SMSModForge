 "nodes": {
  "335607199": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Hey, {PC}... Um...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-372154729": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Before you say anything, I just need to ask... Are you sure you still want this?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1159012603": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -19412192,
    1927357593,
    -2068924022
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Do you really want to keep managing my Starmaker page? And, um, being my photographer? ",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-19412192": {
   "kind": "text",
   "parent": -1159012603,
   "children": [
    274460705
   ],
   "actor": null,
   "text": "Yes, of course. I want to help {D} as much as you do.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1927357593": {
   "kind": "text",
   "parent": -1159012603,
   "children": [
    -1754148005
   ],
   "actor": null,
   "text": "Yeah, it's a lot of fun. I enjoy it. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2068924022": {
   "kind": "text",
   "parent": -1159012603,
   "children": [
    1804502281,
    -1877008037
   ],
   "actor": null,
   "text": "Are you kidding? I get to take hot photos of my {M}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1804502281": {
   "kind": "text",
   "parent": -2068924022,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I can't remember the last time someone called me hot...  ",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "incrementNumber",
     "type": "InstructionArithmeticIncrementNumber",
     "title": "Increment Mainstory[MCorruption] + 1",
     "fields": {
      "m_Set": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "MCorruption",
        "list": "Mainstory",
        "type": "number"
       }
      },
      "m_Value": {
       "kind": "value",
       "value": 1
      }
     }
    }
   ]
  },
  "-1754148005": {
   "kind": "text",
   "parent": 1927357593,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I'm really glad to hear that. Honestly, it's been fun for me too. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "274460705": {
   "kind": "text",
   "parent": -19412192,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Yes. Your {D}'s been working very hard all his life. Now we can help him...",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "incrementNumber",
     "type": "InstructionArithmeticIncrementNumber",
     "title": "Increment Mainstory[MLove] + 1",
     "fields": {
      "m_Set": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "MLove",
        "list": "Mainstory",
        "type": "number"
       }
      },
      "m_Value": {
       "kind": "value",
       "value": 1
      }
     }
    }
   ]
  },
  "-1904206521": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I've always been the housewife in the background. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1428566698": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I'm glad that's settled then. I just wanted to make sure you’re okay with it, you know?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-11789175": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I just hope it's not too much for you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1556158020": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Not that I didn't enjoy it, but it's nice to have a bit of the spotlight for a change.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1877008037": {
   "kind": "text",
   "parent": -2068924022,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "It's been over fifteen years, I think. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
