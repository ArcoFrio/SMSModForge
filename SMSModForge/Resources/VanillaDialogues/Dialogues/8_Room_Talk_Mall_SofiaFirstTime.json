  },
  "-1187538441": {
   "kind": "text",
   "parent": -937985904,
   "children": [
    1766013530
   ],
   "actor": null,
   "text": "Alright, I’m in. I’ll meet you there.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "921987836": {
   "kind": "text",
   "parent": -937985904,
   "children": [
    -1148216069
   ],
   "actor": null,
   "text": "I appreciate the offer, but a gas station? I think I’ll pass.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1766013530": {
   "kind": "text",
   "parent": -1187538441,
   "actor": "Sofia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Great! I promise you won’t regret it. See you soon, handsome.",
