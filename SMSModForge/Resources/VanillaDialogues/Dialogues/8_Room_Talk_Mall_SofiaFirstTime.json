     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1361442300": {
   "kind": "text",
   "parent": -868939171,
   "actor": null,
   "text": "You get right at it, huh?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-836215927": {
   "kind": "text",
   "parent": -868939171,
   "actor": null,
   "text": "I prefer something stronger.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "399700006": {
   "kind": "text",
   "parent": -868939171,
   "actor": null,
   "text": "What did you have in mind?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1190018941": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -205467164,
    1301369775
   ],
   "actor": "Sofia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "There’s a little gas station just outside of town. Not the most glamorous spot, but it’s got a certain charm. How about we meet there in, say, an hour?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-205467164": {
   "kind": "text",
   "parent": -1190018941,
   "actor": null,
   "text": "An interesting choice...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1301369775": {
   "kind": "text",
   "parent": -1190018941,
   "actor": null,
   "text": "That’s a bit unusual for a date, don’t you think?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-937985904": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1187538441,
    921987836
   ],
   "actor": "Sofia",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "I like to keep things interesting. You up for it, or are you scared of a little adventure?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
