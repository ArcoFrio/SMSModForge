   "actor": "Sofia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Hey there, handsome. Got a minute?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1409742668": {
   "kind": "text",
   "parent": -1,
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "I’m new in town and could use some company. You seem like the kind of guy who knows his way around. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-868939171": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1361442300,
    -836215927,
    399700006
   ],
   "actor": "Sofia",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "How about we grab a coffee, or maybe something stronger? I know a nice, quiet spot.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
