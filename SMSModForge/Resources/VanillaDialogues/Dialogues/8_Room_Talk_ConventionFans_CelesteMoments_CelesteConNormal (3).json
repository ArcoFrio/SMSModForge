  "-1880583636": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expressionName": "neutral",
   "text": "Ah. Resting? Understandable. It’s been quite the eventful day for you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1707282865": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "And let me guess—you’ve had an effortless time, as always?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "446611443": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Naturally.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-302420845": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expressionName": "neutral",
   "text": "But you? You burn. Unrefined. Unstable. But undeniably bright.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1756881340": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I wonder… how long will you last?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "717026669": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You’re an interesting one, Anna. I’ve seen many attempt to rise… most fade before they can even touch the light.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
