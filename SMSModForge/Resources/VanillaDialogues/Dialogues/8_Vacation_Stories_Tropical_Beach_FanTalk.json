  "424212925": {
   "kind": "text",
   "parent": 1800520348,
   "children": [
    1802569783
   ],
   "actor": null,
   "text": "“Super professional,” huh? Maybe you should add that to your bio.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1774108169": {
   "kind": "text",
   "parent": 1800520348,
   "children": [
    2038031733
   ],
   "actor": null,
   "text": "See? Even strangers recognize how great you are.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1893143793": {
   "kind": "text",
   "parent": 1800520348,
   "children": [
    1027783356
   ],
   "actor": null,
   "text": "Think he’ll figure it out tonight, or will it hit him in the shower?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1802569783": {
   "kind": "text",
   "parent": 424212925,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": " Oh, stop. That’s the last thing I need.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2038031733": {
   "kind": "text",
   "parent": -1774108169,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Well, let’s hope he never figures out the real reason.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1027783356": {
   "kind": "text",
   "parent": -1893143793,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Let’s hope it’s never. I’d rather keep this beach a peaceful escape.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
