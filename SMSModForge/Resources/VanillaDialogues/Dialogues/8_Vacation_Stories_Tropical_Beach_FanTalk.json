 "nodes": {
  "1252792197": {
   "kind": "text",
   "parent": -1,
   "children": [
    648860340,
    781540495,
    -537488353,
    -642770144,
    -1105979487,
    1800520348
   ],
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Uh... h-hi. Sorry to bother you, but... um... I think I know you from somewhere?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "648860340": {
   "kind": "text",
   "parent": 1252792197,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh? I don’t think we’ve met before.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "781540495": {
   "kind": "choice",
   "parent": 1252792197,
   "children": [
    -476224512,
    1931876192,
    1864309440
   ],
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Yeah, no, I mean... maybe not in person. But your face... it’s, uh, really familiar.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-476224512": {
   "kind": "text",
   "parent": 781540495,
   "children": [
    375261342,
    453910468
   ],
   "actor": null,
   "text": "Maybe she’s your long-lost crush. This could be your big moment.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "375261342": {
   "kind": "text",
   "parent": -476224512,
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Wh-what?! No, no, it’s not like that! I mean, she’s... uh... no, that’s not what I meant!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1931876192": {
   "kind": "text",
   "parent": 781540495,
   "children": [
    -1790645604,
    366081921
   ],
   "actor": null,
   "text": "Take your time, man. Happens to me all the time too.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1790645604": {
   "kind": "text",
   "parent": 1931876192,
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Right? It’s so frustrating! You know you know someone, but you can’t place it...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1864309440": {
   "kind": "text",
   "parent": 781540495,
   "children": [
    -1853945989,
    990625883
   ],
   "actor": null,
   "text": "Don’t tell me you’re about to ask for an autograph.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1853945989": {
   "kind": "text",
   "parent": 1864309440,
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Uh, I mean... should I? Is that a thing people do?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "990625883": {
   "kind": "text",
   "parent": 1864309440,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I don’t think we’re at that level yet.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "366081921": {
   "kind": "text",
   "parent": 1931876192,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "It’s okay. It’s kind of flattering, honestly.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "453910468": {
   "kind": "text",
   "parent": -476224512,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Alright, that’s enough teasing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-537488353": {
   "kind": "text",
   "parent": 1252792197,
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Oh! I’ve got it! You’re from... uh... wait, no, don’t tell me! It’s on the tip of my tongue.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-642770144": {
   "kind": "choice",
   "parent": 1252792197,
   "children": [
    2139613294,
    -454375584
   ],
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "You’re like... super professional, right? An actress? Or a ShouTuber? No, wait... maybe a Witch streamer?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "2139613294": {
   "kind": "text",
   "parent": -642770144,
   "children": [
    1944744102
   ],
   "actor": null,
   "text": "Warmer. You’re getting there. Keep guessing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-454375584": {
   "kind": "text",
   "parent": -642770144,
   "children": [
    1000503777,
    2116447519
   ],
   "actor": null,
   "text": "Careful. Guess wrong too many times, she might charge you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1000503777": {
   "kind": "text",
   "parent": -454375584,
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Wait, really? I mean, that’s fair, but—oh, man, I’m terrible at this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1944744102": {
   "kind": "text",
   "parent": 2139613294,
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Oh! I know! You’re one of those... lifestyle bloggers! You post... um, fitness tips and, like, beach photos, right?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2116447519": {
   "kind": "text",
   "parent": -454375584,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Don’t worry, I’m not that strict.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1105979487": {
   "kind": "text",
   "parent": 1252792197,
   "actor": "V_Felix",
   "expressionName": "my-expression",
   "text": "Anyway, I just wanted to say hi and... uh, keep up the great work! Whatever it is you do.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
