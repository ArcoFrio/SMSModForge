   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1782611315": {
   "kind": "text",
   "parent": -1727170374,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "Real people?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1489565015": {
   "kind": "text",
   "parent": -1727170374,
   "actor": "You",
   "expressionName": "neutral",
   "text": "The newsstand owner, the woman who shelves the books in the library, the farmer on his land.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "389311530": {
   "kind": "text",
   "parent": -1727170374,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "But what makes them more real than other?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1497612867": {
   "kind": "text",
   "parent": -1782488622,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "I always wanted to drive expensive cars and fuck hot sluts.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-598119195": {
   "kind": "text",
   "parent": -1782488622,
   "actor": "You",
   "expressionName": "neutral",
   "text": "I mean before that, what did the young tristan want to become.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1491622616": {
   "kind": "text",
   "parent": -1782488622,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "I... I always wanted to be an actor, but my father said it was for pussies.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1738119478": {
   "kind": "text",
   "parent": -1,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "Yes, that feels right... I...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1437245532": {
   "kind": "text",
   "parent": -1727170374,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Because they have their own lives, their whole existence doesn't revolve around you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1927114625": {
   "kind": "text",
   "parent": -1782488622,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "And now he's... And I could... I could...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "176783352": {
   "kind": "text",
   "parent": -1727170374,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "Around me...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1335956562": {
   "kind": "text",
   "parent": -1,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "I'm sorry for being such a beta to you, you are a real one for still helping me after all the shit I said to you...",
