  "1601698916": {
   "kind": "text",
   "parent": 1589306222,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "A clown?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1597986324": {
   "kind": "text",
   "parent": 1589306222,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Yes, a clown makes people happy and gets a lot of attention. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1438220062": {
   "kind": "text",
   "parent": 1589306222,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "T-That is true... I shall become a clown then... Thank you for your advice...",
