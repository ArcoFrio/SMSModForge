  "1714814935": {
   "kind": "text",
   "parent": -1591904858,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "Yeah... I mean you won against me in several battles of Conversation...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2093863660": {
   "kind": "text",
   "parent": -1591904858,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "So it makes sense that I should listen to you... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "118292532": {
   "kind": "text",
   "parent": -1591904858,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "Common Tristan L.",
