    "m_Options": "FromSkin"
   }
  },
  "-1382277683": {
   "kind": "text",
   "parent": 347759914,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "But they did everything I told them to do... Isn't that what real friends do?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-359148434": {
   "kind": "text",
   "parent": -1,
   "actor": "S_Tristan",
   "expressionName": "neutral",
   "text": "Fuck, I'm such a failure. I should have just choked you to death when I had the chance...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1854608225": {
   "kind": "choice",
