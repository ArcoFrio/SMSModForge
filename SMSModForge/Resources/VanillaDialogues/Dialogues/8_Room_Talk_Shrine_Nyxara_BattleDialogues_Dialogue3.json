  "-1859588243": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "You think spirits can’t feel desire? We remember what it was like… Even if we shouldn’t.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1486619838": {
   "kind": "choice",
