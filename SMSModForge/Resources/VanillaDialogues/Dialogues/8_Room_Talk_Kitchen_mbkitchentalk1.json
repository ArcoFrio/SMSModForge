 "nodes": {
  "-124361651": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "{M}, can we have truffle pasta tonight? I'm  like really craving it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1677922513": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I wish we could, Adrian, but truffles are a bit too expensive right now. You know, with Dad losing his job and all.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "515995748": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Oh, right... I forgot. Okay, I get it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-54265264": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "How about we make carbonara instead? It's not truffle pasta, but it's still pretty good.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1803277466": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "We can even add some cream.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "575461614": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Yeah, that sounds good. Thanks, {M}.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
