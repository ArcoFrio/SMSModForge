  "231960883": {
   "kind": "text",
   "parent": -1,
   "actor": "Robert",
   "expressionName": "neutral",
   "text": "…She trusts you. That is… unusual. I suppose that means I should try to trust you too.",
   "settings": {
    "m_Options": "FromSkin"
   },
