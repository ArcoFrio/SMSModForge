  "1264297685": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "See? I told you he’s real! Robert’s my bestest friend. He’s smart, and strong, and super kind. I always bring him snacks from the city.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-899737336": {
   "kind": "text",
   "parent": -976363870,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Heehee, I knew you two would get along.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1916831253": {
   "kind": "text",
   "parent": -1213350515,
   "actor": "Robert",
   "expressionName": "neutral",
   "text": "…You’re not running away. That’s… good.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-395059117": {
   "kind": "text",
   "parent": 1037710567,
   "actor": "Robert",
   "expressionName": "neutral",
   "text": "…I knew this was a mistake.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1292848520": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Oh shoot, I forgot! I promised Clay I’d help with chores back at the kitchen.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1486429748": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "You two should talk. Robert’s shy, but once he opens up, he’s the best.",
   "settings": {
    "m_Options": "FromSkin"
   },
