  "-195470993": {
   "kind": "text",
   "parent": -1,
   "actor": "Robert",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Sweet? Most people run away when they see me...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1091144071": {
   "kind": "text",
   "parent": -1,
   "actor": "Robert",
   "expressionName": "neutral",
   "text": "I like having friends. It makes the world a bit less lonely.",
   "settings": {
    "m_Options": "FromSkin"
   }
