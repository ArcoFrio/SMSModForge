  "-220693664": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Okay, here we are! Don’t be nervous, he’s super nice.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "464744457": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -976363870,
    1037710567,
    -1213350515
   ],
   "actor": "Robert",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Kirby’s… been the only person who talks to me like I matter. She brings me food. She… she makes me feel less alone.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
