 "nodes": {
  "-566383231": {
   "kind": "text",
   "parent": -1,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "Such a cozy little nest… Do you always sleep this vulnerably?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2063893654": {
   "kind": "text",
   "parent": -1,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "Relax. I didn’t come to bite. Not tonight.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1511401697": {
   "kind": "text",
   "parent": -1,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "I came to thank you.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "questTaskComplete",
     "type": "InstructionQuestsTaskComplete",
     "title": "Complete Go back home.",
     "fields": {
      "m_Journal": {
       "kind": "object",
       "name": "11_PlayerData",
       "of": "GetGameObjectInstance",
       "path": "11_PlayerData"
      },
      "m_Task": {
       "m_Quest": {
        "kind": "object",
        "name": "Astrid Quest",
        "of": "Quest"
       },
       "m_TaskId": 2076169433
      },
      "m_WaitToComplete": false
     }
    }
   ]
  },
  "-896876359": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1812392789,
    1614677584,
    1199367058,
    -819986536
   ],
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "And I can’t be that for her. I was… once. But that was a very long time ago.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1802112197": {
   "kind": "text",
   "parent": -1,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "So… thank you, little flame. Keep visiting her. Keep playing. ",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setString",
     "type": "InstructionTextSetString",
     "title": "Set Core_NoSave[Item-Received] = Goth Fishnet",
     "fields": {
      "m_Text": {
       "kind": "value",
       "value": "Goth Fishnet"
      },
      "m_Set": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "Item-Received",
        "list": "Core_NoSave",
        "type": "string"
       }
      }
     }
    }
   ]
  },
  "1786687640": {
   "kind": "text",
   "parent": -1,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "And maybe next time… come play with me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1812392789": {
   "kind": "text",
   "parent": -896876359,
   "children": [
    928804744,
    -331421203
   ],
   "actor": null,
   "text": "I didn’t know you cared about anyone but yourself.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "928804744": {
   "kind": "text",
   "parent": -1812392789,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "Oh, I don’t.Not in the way you’d hope.\n",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1614677584": {
   "kind": "text",
   "parent": -896876359,
   "children": [
    694340640
   ],
   "actor": null,
   "text": "You didn’t come here for her. You came here for me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "694340640": {
   "kind": "text",
   "parent": 1614677584,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "Careful. You’re not as forgettable as I wanted you to be. That’s dangerous. For both of us.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1199367058": {
   "kind": "text",
   "parent": -896876359,
   "children": [
    245635733
   ],
   "actor": null,
   "text": "If you’re not here to kill me, then leave.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "245635733": {
   "kind": "text",
   "parent": 1199367058,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "I could. But you’re far more interesting than your death would be.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-819986536": {
   "kind": "text",
   "parent": -896876359,
   "children": [
    1065221295
   ],
   "actor": null,
   "text": "I can entertain more than just her, y’know.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1065221295": {
   "kind": "text",
   "parent": -819986536,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "Mmm. Confidence. Dangerous... but attractive. Be careful what you offer in the dark, darling.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-331421203": {
   "kind": "text",
   "parent": -1812392789,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "But I remember what it was like to care... And I...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-575797997": {
   "kind": "text",
   "parent": -1,
   "actor": "Noire",
   "expressionName": "my-expression",
   "text": "You’ve been keeping Astrid… busy.\nLaughing. Sharp-tongued. Almost alive.\nShe needs that. A tether. Something to make her forget what she is.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
