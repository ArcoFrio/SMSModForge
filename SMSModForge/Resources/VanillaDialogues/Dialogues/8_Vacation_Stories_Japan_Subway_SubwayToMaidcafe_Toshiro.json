  "-889435250": {
   "kind": "text",
   "parent": 199126867,
   "actor": "V_Toshiro",
   "expressionName": "my-expression",
   "text": "Don’t play dumb! I know your type. Coming here, acting all cool, thinking you can just charm your way into our culture and take what you want. It’s disgusting!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
