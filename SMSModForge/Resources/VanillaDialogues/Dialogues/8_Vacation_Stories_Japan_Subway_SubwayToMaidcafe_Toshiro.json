  "-828641049": {
   "kind": "text",
   "parent": 199126867,
   "actor": "V_Toshiro",
   "expressionName": "my-expression",
   "text": "You’re gaijins, aren’t you? Here to take over and steal our Japanese women!",
   "settings": {
