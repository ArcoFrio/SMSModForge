 "nodes": {
  "-147595485": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Different? How do you mean?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-686333575": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Anna, can we talk for a minute? I've noticed you've been acting a bit different lately.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1962509301": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I don't know, just... quieter. More distant, maybe?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1386612942": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Josef, you know how it is. The situation we are in right now, there's a lot on my mind.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "679838805": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I get that, but it's not just work. It's like you're not really here sometimes.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1645306725": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You worry too much. I promise, it's nothing serious. ",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "runActions",
     "type": "InstructionLogicRunActions",
     "title": "Run Anna_Decrease_Mood ",
     "fields": {
      "m_Actions": {
       "kind": "object",
       "name": "Anna_Decrease_Mood",
       "of": "GetGameObjectActions",
       "path": "10_Gameplay/Anna_Decrease_Mood"
      },
      "m_WaitToFinish": false
     }
    }
   ]
  },
  "1205757171": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "If you say so... Sorry, I'm just worried of being a dissapointment.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1024573370": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Don't say that, I married you for a good reason.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
