 "nodes": {
  "-1263460421": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1627636339,
    -238834023
   ],
   "actor": "DrFrost",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Interesting. You’ve been exploring. I saw the vitals feed spike in containment. That means you’ve met my little prisoner.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "528224766": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1273735527,
    178849838,
    509592464
   ],
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "I assume he told you I’m some deranged monster playing god.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1273735527": {
   "kind": "text",
   "parent": 528224766,
   "children": [
    536083308
   ],
   "actor": null,
   "text": "Yeah. And you’re not denying it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "536083308": {
   "kind": "text",
   "parent": -1273735527,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Oh, he’s not lying. Most of it’s true. He opposed my methods, and I silenced him. Simple as that. But truth isn’t what matters here. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "178849838": {
   "kind": "text",
   "parent": 528224766,
   "children": [
    833537285
   ],
   "actor": null,
   "text": "He’s probably lying. You seem in control.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "833537285": {
   "kind": "text",
   "parent": 178849838,
   "actor": "DrFrost",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Loyalty. I appreciate that. He was brilliant once, but weak. Couldn’t handle the cost of discovery. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "509592464": {
   "kind": "text",
   "parent": 528224766,
   "children": [
    2097611685
   ],
   "actor": null,
   "text": "He didn’t have to lie. I can see what you’re doing here.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2097611685": {
   "kind": "text",
   "parent": 509592464,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Of course you’d think that. He tells the truth, but only half of it. If I wanted him dead, you’d have found an empty tank.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "134361379": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Weakness breeds regret, and regret breeds betrayal.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-743245690": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "You should think carefully about where you stand. He can offer guilt, maybe a moral pat on the head.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1878236622": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1098924292,
    753661643,
    1952301977
   ],
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "I can offer power, progress, results you can touch. Ask yourself what’s worth more.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1098924292": {
   "kind": "text",
   "parent": -1878236622,
   "children": [
    -246076224
   ],
   "actor": null,
   "text": "You make a strong case.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-246076224": {
   "kind": "text",
   "parent": -1098924292,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Smart answer. Morality doesn’t pay the bills. Data does.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "753661643": {
   "kind": "text",
   "parent": -1878236622,
   "children": [
    -806972655
   ],
   "actor": null,
   "text": "I’ll stand with the one who still remembers what human means.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-806972655": {
   "kind": "text",
   "parent": 753661643,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Sentimentality. Predictable, but cute. Try not to get sentimental when he dies in that tank.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1952301977": {
   "kind": "text",
   "parent": -1878236622,
   "children": [
    -508710747
   ],
   "actor": null,
   "text": "I’ll think about it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-508710747": {
   "kind": "text",
   "parent": 1952301977,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Take your time. But remember, hesitation is just another form of weakness.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1627636339": {
   "kind": "text",
   "parent": -1263460421,
   "children": [
    2091755603
   ],
   "actor": null,
   "text": "You mean Mura.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-238834023": {
   "kind": "text",
   "parent": -1263460421,
   "children": [
    -957314090
   ],
   "actor": null,
   "text": "Who?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-957314090": {
   "kind": "text",
   "parent": -238834023,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Don't play dumb, {PC}. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2091755603": {
   "kind": "text",
   "parent": -1627636339,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "So he remembered his name. Good for him.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
