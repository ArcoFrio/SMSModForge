   }
  },
  "745484272": {
   "kind": "text",
   "parent": -1550866049,
   "children": [
    642968042,
    2037346406
   ],
   "actor": null,
   "text": "Yeah… she’s different.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1435714400": {
   "kind": "text",
   "parent": -1550866049,
   "children": [
    -380835246,
    -265284477
   ],
   "actor": null,
   "text": "She’s just doing what makes her happy.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "352406838": {
   "kind": "text",
   "parent": -1550866049,
   "children": [
    -812253213,
    -538329106
   ],
   "actor": null,
   "text": "You sure you’re not just jealous?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-812253213": {
   "kind": "text",
   "parent": 352406838,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Oh, for—this isn’t about jealousy! This is about Anna!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-380835246": {
   "kind": "text",
   "parent": 1435714400,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Happy? You really think this is happiness? That’s not confidence, it’s a mask.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "642968042": {
   "kind": "text",
   "parent": 745484272,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Exactly! She’s losing herself in all of this. I don’t know if she even realizes it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-538329106": {
   "kind": "text",
   "parent": 352406838,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "You think I want to argue with her like this? That I like watching her turn into someone she’s not?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-265284477": {
   "kind": "text",
   "parent": 1435714400,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "I know Anna better than most. And this… this isn’t her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2037346406": {
   "kind": "text",
   "parent": 745484272,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "We have to do something. She needs a reminder of who she really is.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1811538778": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Just… meet me at the garage next Tuesday. Please.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
