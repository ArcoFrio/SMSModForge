   "expressionName": "neutral",
   "text": "There you are. Please tell me you see it too—she’s not the same.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
