 "nodes": {
  "1347651715": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expressionName": "neutral",
   "text": "Thinking of buying it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "974729652": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "I don’t know… It’s pretty, but…",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-409156343": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expression": 1,
   "expressionName": "Happy",
   "text": "But you’re not sure if it’s worth it? Or if it’s something you should want?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "714708330": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I guess I’m just not used to treating myself. Maybe I’m overthinking it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-402057170": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expressionName": "neutral",
   "text": "Or maybe you’re worried what people will think if you suddenly start wearing something nice, Not like you need their approval, right?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-614200629": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expression": 2,
   "expressionName": "Angry",
   "text": "{M}, are you trying to pick a fight?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "867134181": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Not at all. Just saying you deserve it. But hey—no pressure.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-438526439": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Let’s move on...",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
