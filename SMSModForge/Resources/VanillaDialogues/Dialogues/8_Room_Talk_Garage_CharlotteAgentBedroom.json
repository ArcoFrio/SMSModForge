  "-1054281079": {
   "kind": "text",
   "parent": 46459993,
   "actor": null,
   "text": "Wait… what about the wardrobe room?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1327041741": {
   "kind": "text",
   "parent": 46459993,
   "children": [
    -1606397410
   ],
   "actor": null,
   "text": "Maybe she finally ate Cheeseburger.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1606397410": {
   "kind": "text",
   "parent": 1327041741,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Oh, hilarious. Keep the jokes coming, genius, while I try to actually find it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2112586038": {
   "kind": "text",
   "parent": 46459993,
   "children": [
    -1408319018
   ],
   "actor": null,
   "text": "How about we have some fun on their bed?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1408319018": {
   "kind": "text",
   "parent": -2112586038,
   "actor": "Charlotte",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Mmm... Don't tease me, {PC}... We have to find cheeseburger...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "973491326": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "I remember her mentioning an old box at the wardrobe. Might be where she keeps her sentimental stuff.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1986279775": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "That’s it! Let’s check.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
