  "417702019": {
   "kind": "text",
   "parent": -1,
   "actor": "Kate",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I dunno. It’s kind of wild, being up here. You, this apartment, the whole vibe... sometimes I forget how far apart our lives are.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1691338046": {
   "kind": "text",
   "parent": -1,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "You’ve got all this. And I’ve got... a one-bedroom and a laundry basket that is my closet.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1339894321": {
