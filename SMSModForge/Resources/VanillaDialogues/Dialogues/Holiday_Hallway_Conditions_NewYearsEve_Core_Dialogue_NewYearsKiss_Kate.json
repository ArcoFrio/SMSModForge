   ],
   "actor": null,
   "text": "Kate. Who is here? Right next to you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1698893332": {
   "kind": "text",
   "parent": -1339894321,
   "actor": null,
