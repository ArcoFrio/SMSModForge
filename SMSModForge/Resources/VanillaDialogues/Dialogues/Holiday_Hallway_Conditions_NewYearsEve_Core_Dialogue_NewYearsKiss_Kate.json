   "parent": -1339894321,
   "actor": null,
   "text": "I know what matters to me. And it’s not the apartment.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "255485476": {
   "kind": "text",
   "parent": -1339894321,
   "children": [
