   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Moving in with Charlotte was a decision that changed everything. Her world of luxury and adventure felt like a dream, and sharing it with her made it all the more special.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
