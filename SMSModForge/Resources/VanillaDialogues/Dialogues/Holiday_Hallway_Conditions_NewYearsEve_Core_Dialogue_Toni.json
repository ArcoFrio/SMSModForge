  "-1634434716": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Toni? Wow. You look… very different tonight. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-659811732": {
   "kind": "text",
   "parent": -1,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Right?! I thought I’d try this whole ‘dress up’ thing for a spin. So far I haven’t fallen over, so that’s a win.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1186458217": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Well, it suits you. It's… bold.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "333647359": {
   "kind": "text",
   "parent": -1,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Huh? Oh, nah, just me. Figured if I’m showing up with him, I shouldn’t be covered in oil and socket wrenches.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-907670698": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh? And here I thought you were just coming to hang out with some friends.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "970463317": {
   "kind": "text",
   "parent": -1,
   "actor": "Toni",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Well yeah! Totally. Friends. And {PC}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1979554082": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Mhm. You must really like spending time with my {S}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1039820645": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "That’s... nice. I just hope you’re not playing dress-up with things that matter.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-909540676": {
   "kind": "text",
   "parent": -742440815,
   "children": [
    1386017949
   ],
   "actor": null,
   "text": "Hey! I'm glad you're here tonight.",
