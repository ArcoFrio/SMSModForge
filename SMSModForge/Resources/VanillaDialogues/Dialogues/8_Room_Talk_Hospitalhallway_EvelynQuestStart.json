   ],
   "actor": "DrFrost",
   "expression": 1,
   "expressionName": "Happy",
   "text": "There you are. Good timing.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
