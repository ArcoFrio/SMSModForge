   }
  },
  "-1872882932": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "How are you doing so well with women?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "343050955": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 3,
   "expressionName": "Sad",
   "text": "They actually talk to you. They smile at you. Some of them even… you know…",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-45405528": {
   "kind": "choice",
   "parent": -1,
   "children": [
    358695982,
    -1902585912
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Can you teach me?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "358695982": {
   "kind": "text",
   "parent": -45405528,
   "children": [
    -841829993,
    33378266,
    1549640842
   ],
   "actor": null,
   "text": "Yeah. I’ll help you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-841829993": {
   "kind": "text",
   "parent": 358695982,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Wait. Seriously?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "incrementNumber",
     "type": "InstructionArithmeticIncrementNumber",
