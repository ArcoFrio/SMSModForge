  "983353424": {
   "kind": "text",
   "parent": -43598306,
   "actor": null,
   "text": "No promises.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "493244411": {
   "kind": "text",
   "parent": -43598306,
   "actor": null,
   "text": "I won’t. Relax.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-372020511": {
   "kind": "text",
   "parent": -43598306,
   "actor": null,
   "text": "That bad, huh?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2121763212": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Meanwhile I say “hi” and it sounds like I’m apologizing for existing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1902585912": {
   "kind": "text",
   "parent": -45405528,
   "children": [
    -1494804388,
    -1395899559
   ],
   "actor": null,
   "text": "Nope. This isn’t something you can just learn.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1494804388": {
   "kind": "text",
   "parent": -1902585912,
   "actor": "Adrian",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Wow. Thanks. That’s exactly the support I needed.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "33378266": {
   "kind": "choice",
   "parent": 358695982,
   "children": [
    505448516,
    -977879655,
    1573142996
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "You’re not messing with me?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "505448516": {
   "kind": "text",
   "parent": 33378266,
   "children": [
    1646895138
   ],
   "actor": null,
   "text": "I’ll help. But you actually have to try.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1646895138": {
   "kind": "text",
   "parent": 505448516,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Okay. Yeah. I can try.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-977879655": {
   "kind": "text",
   "parent": 33378266,
   "children": [
    -823306876
   ],
   "actor": null,
   "text": "We start with basics. Posture. Voice. Eye contact.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-823306876": {
   "kind": "text",
   "parent": -977879655,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "That sounds… structured. I like that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1573142996": {
   "kind": "text",
   "parent": 33378266,
   "children": [
    -352019059,
    1265864484
   ],
   "actor": null,
   "text": "First lesson: stop panicking when boobs exist.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-352019059": {
   "kind": "text",
   "parent": 1573142996,
   "actor": "Adrian",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I DO NOT panic.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1265864484": {
   "kind": "text",
   "parent": 1573142996,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Okay maybe a little.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1549640842": {
   "kind": "text",
   "parent": 358695982,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Alright. Let’s do it. Thanks, {PC}. I'll meet you at the mall, alright?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1395899559": {
   "kind": "text",
   "parent": -1902585912,
   "actor": "Adrian",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Yeah… I figured you’d say that. Forget it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
