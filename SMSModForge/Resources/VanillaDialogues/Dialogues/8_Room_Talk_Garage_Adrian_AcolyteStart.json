   "children": [
    983353424,
    493244411,
    -372020511
   ],
   "actor": "Adrian",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I need to ask you something. And you’re not allowed to laugh.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
