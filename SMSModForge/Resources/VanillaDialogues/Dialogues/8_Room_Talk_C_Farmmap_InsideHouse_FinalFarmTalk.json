       "of": "GetGameObjectInstance",
       "path": "10_Gameplay/Raise_Stats/Raise_Stat_Charm"
      }
     }
    }
   ]
  },
  "-885914438": {
   "kind": "text",
   "parent": 542479325,
   "actor": "Kirby",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "And it’s thanks to you, {PC}. This is our farm, our family, our fight… and you made it real.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
