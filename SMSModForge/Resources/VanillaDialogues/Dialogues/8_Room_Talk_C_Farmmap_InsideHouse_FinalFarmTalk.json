   "actor": "Clay",
   "expressionName": "neutral",
   "text": "…Fifty-fifty?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Milking Save[bafa-milkdeal-secretending] = True",
