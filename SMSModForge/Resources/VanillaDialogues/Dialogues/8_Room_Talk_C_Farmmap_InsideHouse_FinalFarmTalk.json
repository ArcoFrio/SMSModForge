    1006112691
   ],
   "actor": "Kirby",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Yes! I knew you’d do the right thing! We don’t need her money, we’ll prove we can do this on our own!",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Milking Save[bafa-milkdeal-declined] = True",
