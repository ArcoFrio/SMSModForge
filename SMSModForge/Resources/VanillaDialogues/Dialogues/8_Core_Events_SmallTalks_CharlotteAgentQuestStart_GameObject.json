 "nodes": {
  "1379616374": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "I don’t even recognize you anymore. This isn’t the Anna I know.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-713503101": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh, please. The Anna you \"know\" was struggling to pay bills and had to smile through it. This Anna? She’s doing just fine.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-125919455": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "At what cost? You’ve changed. You talk differently, act differently—like none of this even bothers you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1538851890": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Because it doesn’t. You’re the only one bothered, Charlotte.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-650853014": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "You say that like it’s a good thing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1004265528": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I say that because it is. I finally stopped caring about what people like you think.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1754981602": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "People like me?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "229416618": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "The ones who pretend they’re above it all. Who whisper behind my back but secretly wish they had the guts to do what I do.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1445366918": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Anna, it's good to see you're doing well, but you're not God's chosen slut! I always really liked about you how you treated everyone the same.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1801515892": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "We're not the same. I make the same money showing my ass that you do selling a whole damn yacht. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1516777399": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "…That’s not the point.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "891836633": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "No? Feels like it is. Feels like you hate that I stopped playing by the rules and still came out on top.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2017982364": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "This isn’t a game, Anna.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-909473476": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Then why does it feel like I’m winning?",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
