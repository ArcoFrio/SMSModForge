   "expressionName": "neutral",
   "text": "You’re not scaring the customers again, are you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-992360718": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "N-no! Never! I… I was just explaining the, um, cultural significance of your… wonderful products!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "646252925": {
   "kind": "text",
   "parent": -1,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "Mhm. That’s good. I need you to be sweet to people, not terrifying.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
