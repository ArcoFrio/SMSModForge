  "465727688": {
   "kind": "text",
   "parent": 660521423,
   "children": [
    1119266498,
    -2107768514
   ],
   "actor": null,
   "text": "Proud of you, Anna. You’ve come a long way.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2059686553": {
   "kind": "text",
   "parent": 660521423,
   "children": [
    2015301326,
    -293603785
   ],
   "actor": null,
   "text": "Weirdly thrilling, huh? You thinking about doing more public stuff?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1230205184": {
   "kind": "text",
   "parent": 660521423,
   "children": [
    1894872868,
    -2034349020
   ],
   "actor": null,
   "text": "Careful, you might start enjoying the attention a little too much.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1894872868": {
   "kind": "text",
   "parent": -1230205184,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "And what if I did?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2015301326": {
   "kind": "text",
   "parent": -2059686553,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I don’t know about more public stuff… But I won’t lie, it’s kind of exciting knowing people are watching.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1119266498": {
   "kind": "text",
   "parent": 465727688,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You think so? I don’t know… Sometimes it feels like I’m still figuring out who I even am outside of being a {M} and a wife.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2107768514": {
   "kind": "text",
   "parent": 465727688,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "But… thanks. That means a lot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-293603785": {
   "kind": "text",
   "parent": -2059686553,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Maybe I just like the attention more than I thought.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2034349020": {
   "kind": "text",
   "parent": -1230205184,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Kidding! I’d never get used to this kind of thing… probably.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1083755656": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh, come on… Why do cars always have that one annoying stain that won’t come off?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-173816781": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You’d think after all the cleaning I’ve done in my life, this would be easy. But nooo, now I have an audience.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1891041400": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Alright, windows next… No pressure, Anna. Just clean like nobody’s watching. Even though they definitely are.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "282120717": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Alright… almost there. Just gotta—",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-694605726": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Hah… did it. And it actually looks pretty good.",
   "settings": {
    "m_Options": "FromSkin"
   },
