  "85588618": {
   "kind": "text",
   "parent": -1629164242,
   "actor": "Anna",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Really? You’re bringing that up now? I should pour this bucket over your head for that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1674508812": {
   "kind": "text",
   "parent": 203892632,
   "actor": "Anna",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "...Okay, maybe a little.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1611601022": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I hope this is actually helping someone. Feels like half these people just showed up to stare...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1046164162": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "You know, I never thought I’d be doing something like this. Not just the bikini part—I mean, putting myself out there like this, in public.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
