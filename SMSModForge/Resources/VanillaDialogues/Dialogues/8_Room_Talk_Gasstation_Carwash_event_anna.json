  "-816717688": {
   "kind": "text",
   "parent": 554331436,
   "children": [
    1568475335
   ],
   "actor": null,
   "text": "You look great, {M}. It’s for a good cause, just have fun with it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1206384681": {
   "kind": "text",
   "parent": 554331436,
   "children": [
    -354532747
   ],
   "actor": null,
   "text": "You sure about this? You seem a little hesitant.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "203892632": {
   "kind": "text",
   "parent": 554331436,
   "children": [
    140850600,
    -1674508812
   ],
   "actor": null,
   "text": "You’re probably the reason half these guys suddenly care about charity.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1568475335": {
   "kind": "text",
   "parent": -816717688,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You’re sweet… I just feel so exposed. But yeah, it’s for a good cause. I can handle a little embarrassment for them.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "140850600": {
   "kind": "text",
   "parent": 203892632,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh, stop… That’s not true.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-354532747": {
   "kind": "text",
   "parent": -1206384681,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I am, but it’s too late to back out now, isn’t it? Besides, Charlotte would never let me hear the end of it...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1629164242": {
   "kind": "text",
   "parent": 554331436,
   "children": [
    85588618
   ],
   "actor": null,
   "text": "Second thoughts? Too late now, ‘Joanne.’ Better start scrubbing before people get suspicious.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
