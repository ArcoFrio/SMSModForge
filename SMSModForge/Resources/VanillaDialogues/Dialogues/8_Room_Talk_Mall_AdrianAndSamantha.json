  "262358743": {
   "kind": "text",
   "parent": -1,
   "actor": "Samantha",
   "expression": 1,
   "expressionName": "Happy",
   "text": "So, Adrian, what’s it like being carried by the great ShamanMilf80 in real life?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "incrementNumber",
     "type": "InstructionArithmeticIncrementNumber",
     "title": "Increment Events_5[b-sam-meets] + 1",
     "fields": {
      "m_Set": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "b-sam-meets",
        "list": "Events_5",
        "type": "number"
       }
      },
      "m_Value": {
       "kind": "value",
       "value": 1
      }
     }
    }
   ]
  },
  "1409742668": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Honestly? Not as different as I thought it would be. I’m used to you saving my ass.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1957125268": {
   "kind": "text",
   "parent": -1,
   "actor": "Samantha",
   "expressionName": "neutral",
   "text": "But I have to admit, it’s nice hanging out in person. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1913004800": {
   "kind": "text",
   "parent": -1,
   "actor": "Samantha",
   "expressionName": "neutral",
   "text": "You’re not so bad when you’re not pulling aggro.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-467422059": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Thanks, I think. It’s been fun, though. We should do this more often.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "527185832": {
   "kind": "text",
   "parent": -1,
   "actor": "Samantha",
   "expressionName": "neutral",
   "text": "If you like you can... \"save\" my ass sometimes...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1396646291": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Gulp....",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
