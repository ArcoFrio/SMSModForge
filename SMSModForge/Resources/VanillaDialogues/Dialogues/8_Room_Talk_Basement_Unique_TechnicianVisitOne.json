     }
    }
   ]
  },
  "1408188163": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Technician",
   "expressionName": "my-expression",
   "text": "Yeah, basements are tricky for Wi-Fi. Thick walls, concrete... You’re just not getting a strong signal. Sorry, but that’s the reality.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "438303588": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Ugh, this is ridiculous. Thanks for nothing.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
