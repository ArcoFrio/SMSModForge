    }
   ]
  },
  "1630824799": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Three months. Can you believe that? By then, Celeste will probably have her own reality show. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
