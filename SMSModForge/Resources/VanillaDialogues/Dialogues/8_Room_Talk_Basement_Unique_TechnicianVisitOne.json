  "-910742074": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Technician",
   "expressionName": "my-expression",
   "text": "Between permits, logistics, and the work itself, there’s no way to speed that up.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1115756316": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Three months?! I can’t wait that long. The Wi-Fi signal is terrible down here. It’s way too slow for livestreaming.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "runActions",
     "type": "InstructionLogicRunActions",
     "title": "Run Anna_Decrease_Mood ",
