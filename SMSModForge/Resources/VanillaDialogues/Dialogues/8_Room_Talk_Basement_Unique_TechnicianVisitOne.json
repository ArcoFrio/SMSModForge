  "-938395628": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Technician",
   "expressionName": "my-expression",
   "text": "So, here’s the deal. Running dedicated internet cables down to this basement studio? It’s gonna take at least three months. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1229774887": {
   "kind": "text",
   "parent": -421252276,
   "children": [
    1719480559
   ],
   "actor": null,
   "text": "Okay, so what’s the plan?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
