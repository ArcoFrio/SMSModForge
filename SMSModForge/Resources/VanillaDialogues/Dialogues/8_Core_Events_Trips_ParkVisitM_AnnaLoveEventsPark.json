   }
  },
  "1983716952": {
   "kind": "text",
   "parent": 2007222884,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Thanks, hun. He gave me the creeps...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1436735054": {
   "kind": "text",
   "parent": 1871099126,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Let me stop you right there—",
   "settings": {
