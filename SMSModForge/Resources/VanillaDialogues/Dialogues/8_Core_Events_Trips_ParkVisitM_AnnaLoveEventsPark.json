  },
  "738866782": {
   "kind": "text",
   "parent": 456070046,
   "children": [
    -537444631,
    -1106748397
   ],
   "actor": null,
   "text": "Whoa, calm down, Anna. Let’s just leave.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-537444631": {
   "kind": "text",
   "parent": 738866782,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Fine. But only because I don’t want to spend the day at the police station.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-113670461": {
   "kind": "text",
   "parent": 456070046,
   "children": [
    -941251739,
    -1943835684
   ],
   "actor": null,
   "text": "Yeah, you heard her. Back off.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-941251739": {
   "kind": "text",
   "parent": -113670461,
   "actor": "Stranger",
   "expressionName": "neutral",
   "text": "Fine, fine. No need to get so territorial. Geez.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1554650669": {
   "kind": "text",
   "parent": 456070046,
   "children": [
    33651168
   ],
   "actor": null,
   "text": "Easy, tiger. You know I only have eyes for you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "33651168": {
   "kind": "text",
   "parent": -1554650669,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Yeah, well…  Let’s get out of here before I really lose my temper.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1633280044": {
   "kind": "text",
   "parent": 456070046,
   "children": [
    -1173836002,
    82027896,
    1338802021,
    1499962353
   ],
   "actor": null,
   "text": "I think she’s just being friendly, Anna…",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1173836002": {
   "kind": "text",
   "parent": 1633280044,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Friendly?! Is that what you call it?!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1106748397": {
   "kind": "text",
   "parent": 738866782,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Stay away from him. Next time, you won’t get off so easy.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1943835684": {
   "kind": "text",
   "parent": -113670461,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Thanks. But I could’ve handled her myself.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "82027896": {
   "kind": "text",
   "parent": 1633280044,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "If you’re interested in her ‘friendliness,’ then maybe I’ll just leave you two alone!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1338802021": {
   "kind": "text",
   "parent": 1633280044,
   "actor": "Stranger",
   "expressionName": "neutral",
   "text": "Uh… yeah, I think I’ll just… go.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1499962353": {
   "kind": "text",
   "parent": 1633280044,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "You better make it up to me",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
