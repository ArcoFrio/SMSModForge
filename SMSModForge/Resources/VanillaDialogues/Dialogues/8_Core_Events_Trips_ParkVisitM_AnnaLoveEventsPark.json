  "-1657749175": {
   "kind": "text",
   "parent": -1481902551,
   "actor": "Stranger",
   "expressionName": "neutral",
   "text": "So… what’s a good-looking guy like you doing out here? Want to grab a coffee or something? Just the two of us?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "537688923": {
   "kind": "text",
   "parent": -1481902551,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Excuse me? Do you not see that he’s with someone?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "227099307": {
   "kind": "text",
   "parent": -1481902551,
   "actor": "Stranger",
   "expressionName": "neutral",
   "text": "Oh, is she your… Grandma or something? I’m sure she won’t mind if we chat a bit.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1446147436": {
   "kind": "text",
   "parent": -1481902551,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Grandma? Grandma!?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-489792742": {
   "kind": "text",
   "parent": -1481902551,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I’m his girlfriend, you brat. And if you think I’m going to let you get away with this, you’ve got another thing coming.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1573194125": {
   "kind": "text",
   "parent": -1481902551,
   "actor": "Stranger",
   "expressionName": "neutral",
   "text": "Oh, really? Girlfriend or not, he can do a lot better.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "456070046": {
   "kind": "choice",
   "parent": -1481902551,
   "children": [
    738866782,
    -113670461,
    -1554650669,
    1633280044
   ],
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You want to fight? Because I’m more than happy to throw down right here, right now.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
