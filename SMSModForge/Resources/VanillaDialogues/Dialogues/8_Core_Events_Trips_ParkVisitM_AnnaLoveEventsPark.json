     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1163172489": {
   "kind": "text",
   "parent": -579290171,
   "actor": null,
   "text": "Sorry, pal. You better go now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1710010804": {
   "kind": "text",
   "parent": -579290171,
   "actor": null,
   "text": "She's way above your league.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1799739975": {
   "kind": "text",
   "parent": -579290171,
   "children": [
    774731739,
    1653320486
   ],
   "actor": null,
   "text": "You heard her. Time to leave, buddy. (Grope Anna)",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "774731739": {
   "kind": "text",
   "parent": 1799739975,
   "actor": "S_Jeff",
   "expressionName": "neutral",
   "text": "W-Wait, isn't he your... ",
   "settings": {
    "m_Options": "FromSkin"
   },
