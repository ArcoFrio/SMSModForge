  "-754558192": {
   "kind": "text",
   "parent": -1412903081,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Jeff? Wow, it’s been forever. How’ve you been?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "249091891": {
   "kind": "text",
   "parent": -1412903081,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I’ve been… you know, same old. But you—wow, you look amazing! I almost didn’t recognize you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-259267282": {
   "kind": "text",
   "parent": -1412903081,
   "actor": "S_Jeff",
   "expressionName": "neutral",
   "text": "Hey, um… it’s been a long time, and I was thinking… maybe we could grab a coffee sometime? Catch up a little?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1198285585": {
   "kind": "text",
   "parent": -1412903081,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Jeff, are you seriously asking me out right now? In front of my… {S}?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-925990284": {
   "kind": "text",
   "parent": -1412903081,
   "actor": "S_Jeff",
   "expressionName": "neutral",
   "text": "Oh, no—I just thought… I didn’t mean it like that—",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-37722812": {
   "kind": "text",
   "parent": -1412903081,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I think you did. But let me make this clear—I’m not interested, Jeff. Not even a little. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-579290171": {
   "kind": "choice",
   "parent": -1412903081,
   "children": [
    -1163172489,
    1710010804,
    1799739975
   ],
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I’m happy with who I’m with, so don’t embarrass yourself.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
