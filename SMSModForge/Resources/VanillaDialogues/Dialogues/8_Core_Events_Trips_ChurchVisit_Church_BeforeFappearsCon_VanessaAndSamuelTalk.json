  "-1298114285": {
   "kind": "text",
   "parent": 194945637,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "God doesn’t make mistakes. He works with them.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2019839807": {
   "kind": "text",
   "parent": -863715128,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "What did you say?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1759523284": {
   "kind": "text",
   "parent": -1833145664,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Discipline isn’t the absence of desire, Vanessa. It’s what you do despite it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1740388964": {
   "kind": "text",
   "parent": -1833145664,
   "actor": "Vanessa",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Still feels like I failed just for thinking it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2041579718": {
   "kind": "text",
   "parent": -1833145664,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Then you’ve misunderstood the test. Thoughts are wind. It’s the anchor that matters.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-603981099": {
   "kind": "text",
   "parent": -863715128,
   "actor": "Vanessa",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I panicked and said it was like… wanting too many cookies.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-172309953": {
   "kind": "text",
   "parent": -863715128,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "That’s… technically not wrong. But now that he’s probably terrified of bakeries.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-280265592": {
   "kind": "text",
   "parent": 194945637,
   "actor": "Vanessa",
   "expression": 3,
   "expressionName": "Sad",
   "text": "That sounds like something you say when you want to believe.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1402234456": {
   "kind": "text",
   "parent": 194945637,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Maybe. Or maybe it's something you say when you’ve seen enough broken people find purpose to stop doubting the process.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
