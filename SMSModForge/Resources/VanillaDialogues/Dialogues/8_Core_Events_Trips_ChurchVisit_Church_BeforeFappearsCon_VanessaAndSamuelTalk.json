    -1402234456
   ],
   "actor": "Vanessa",
   "expressionName": "neutral",
   "text": "What if I’m not supposed to be here? What if this was all a mistake?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
     "type": "ConditionMathCompareIntegers",
     "title": "If Core_NoSave2[veryshortterm-numbervar] = 3",
     "fields": {
