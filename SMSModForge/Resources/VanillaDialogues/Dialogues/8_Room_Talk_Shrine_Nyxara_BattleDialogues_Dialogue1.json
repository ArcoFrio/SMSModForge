    },
    "m_Options": "FromSkin"
   }
  },
  "-1859588243": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "You should go.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1486619838": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Before he remember what I am.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "224039749": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Before I remember.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "640624835": {
   "kind": "text",
   "parent": 673945928,
   "children": [
    -1895553598,
    1955913962
   ],
   "actor": null,
   "text": "Who are you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-445166034": {
   "kind": "text",
   "parent": 673945928,
   "children": [
    2053527113,
    -318993990
   ],
   "actor": null,
   "text": "I didn't mean to intrude… Are you okay?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1860973381": {
   "kind": "text",
   "parent": 673945928,
   "children": [
    -2070498822,
    -218283549
   ],
   "actor": null,
   "text": "Since when can spirits talk?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2070498822": {
   "kind": "text",
   "parent": -1860973381,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "You think I’m a spirit? That’s… kind.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2053527113": {
   "kind": "text",
   "parent": -445166034,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "No. But it doesn’t matter anymore.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1895553598": {
   "kind": "text",
   "parent": 640624835,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "I don’t remember.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1955913962": {
   "kind": "text",
   "parent": 640624835,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Or maybe… I don’t want to.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-318993990": {
   "kind": "text",
   "parent": -445166034,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Pain fades after a while… Even when you wish it wouldn’t.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-218283549": {
   "kind": "text",
   "parent": -1860973381,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "I used to be more. Now I’m just… what's left.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
