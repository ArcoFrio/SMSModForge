    -445166034,
    -1860973381
   ],
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "This place… it's hollow.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
