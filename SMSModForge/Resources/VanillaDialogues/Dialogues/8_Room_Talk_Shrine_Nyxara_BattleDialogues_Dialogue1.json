   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "…You… you shouldn't be here.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "673945928": {
   "kind": "choice",
   "parent": -1,
   "children": [
