  "-1213350515": {
   "kind": "text",
   "parent": 464744457,
   "actor": null,
   "text": "I'll head out, see you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-397466810": {
   "kind": "random",
   "parent": -1,
   "children": [
