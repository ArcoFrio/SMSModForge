  "-1402350841": {
   "kind": "text",
   "parent": -308038700,
   "children": [
    -2040500860
   ],
   "actor": null,
   "text": "Who are you and what have you done to Himari?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2054775052": {
   "kind": "text",
   "parent": -1,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "I saw the way she watched you. Like she’s worried I’ll swallow you whole.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2040500860": {
   "kind": "text",
   "parent": -1402350841,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "Let me try to have fun for once...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1685133961": {
   "kind": "text",
   "parent": 1623998776,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "Don't try me.",
   "settings": {
