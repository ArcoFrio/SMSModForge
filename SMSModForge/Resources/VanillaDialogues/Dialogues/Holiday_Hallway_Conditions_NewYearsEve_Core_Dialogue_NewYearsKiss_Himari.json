   }
  },
  "322794373": {
   "kind": "text",
   "parent": -1,
   "actor": "Himari",
   "expression": 3,
   "expressionName": "Sad",
   "text": "People like me don’t do soft. We don’t get comfort. We build comfort—for others. Then we sit outside it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1408382820": {
   "kind": "text",
   "parent": -1522264619,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "No. I want you aware.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "386989560": {
