  "2027825657": {
   "kind": "text",
   "parent": 482049571,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Stealing? Such an emotional word. I take what gravitates toward me. It’s not theft—it’s inevitability.",
