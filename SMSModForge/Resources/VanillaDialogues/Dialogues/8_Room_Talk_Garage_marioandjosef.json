    "m_Options": "FromSkin"
   }
  },
  "601016258": {
   "kind": "text",
   "parent": -1068044769,
   "actor": null,
   "text": "What are you saying?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-654129601": {
   "kind": "text",
   "parent": -1068044769,
   "actor": null,
   "text": "Get to the point.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1486996588": {
   "kind": "text",
   "parent": 247021972,
   "actor": null,
   "text": "What would you want in return?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-684825263": {
   "kind": "text",
   "parent": 247021972,
   "children": [
    -544534022
   ],
   "actor": null,
   "text": "Nothing is ever free.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-544534022": {
   "kind": "text",
   "parent": -684825263,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "Indeed.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1897906501": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "Just a few tasks, things that are better discussed in private. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
