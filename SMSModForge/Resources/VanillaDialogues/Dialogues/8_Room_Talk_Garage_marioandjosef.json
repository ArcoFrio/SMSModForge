  "177873075": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Mario, please. You know I’ve always been loyal. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "272902866": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Just give me another chance—put me up as CEO at any company, any position. I’ll take whatever you can give.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-500954960": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "Loyalty only goes so far, my friend. I’m sorry, but there’s nothing more I can do. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2006893428": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "This was decided by those higher up than me. You’re out, and it’s done.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "494476921": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Well then, I guess we have nothing left to discuss.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
