  "-2086428011": {
   "kind": "text",
   "parent": -1548710067,
   "actor": null,
   "text": "Yeah, that's right.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-579773839": {
   "kind": "text",
   "parent": -1548710067,
   "actor": null,
   "text": "Should I know you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "27599610": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "Your {D}’s in a tight spot, isn’t he? It’s a shame, really. But it’s not the end of the world.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1068044769": {
   "kind": "choice",
   "parent": -1,
   "children": [
    601016258,
    -654129601
   ],
   "actor": "Mario",
   "expression": 3,
   "expressionName": "Sad",
   "text": "The real problem isn’t just his job, is it? It’s the debt. Debt can crush a man, but it can also be… removed, under the right circumstances.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "247021972": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1486996588,
    -684825263,
    1149129561
   ],
   "actor": "Mario",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I’m saying that I could cleanse your {D}’s debt, make it disappear like it never existed. But, of course, I don’t do favors for free.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
