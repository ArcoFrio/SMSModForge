    "m_Options": "FromSkin"
   }
  },
  "-174298844": {
   "kind": "text",
   "parent": 1996847802,
   "actor": "Claudia",
   "expression": 1,
   "expressionName": "talk",
   "text": "Trust me, sweetheart. Your name’s been whispered in more than just inboxes. So… can I roll?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-343400222": {
   "kind": "text",
   "parent": -2045783967,
   "actor": "Claudia",
   "expression": 1,
   "expressionName": "talk",
   "text": "Then you know how good I make people look.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-730609462": {
   "kind": "text",
   "parent": 1996847802,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Y-yeah. Okay. Just... not too close, please.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-589473213": {
   "kind": "text",
   "parent": -2045783967,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "And how good you are at twisting their words. Let’s keep it cute, alright?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-271641871": {
   "kind": "text",
   "parent": -2006446748,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Only if you ask boring questions. Make it juicy, Claudia. My fans expect a show.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-160311371": {
   "kind": "text",
   "parent": -1045607814,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Then you’re getting both. Let’s make your viewers wish they had a backstage pass.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
