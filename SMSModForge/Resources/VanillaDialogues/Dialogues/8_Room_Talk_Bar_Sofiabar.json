   ],
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "{PC}, hey. Small world, huh? I was just… taking a break from it all.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
