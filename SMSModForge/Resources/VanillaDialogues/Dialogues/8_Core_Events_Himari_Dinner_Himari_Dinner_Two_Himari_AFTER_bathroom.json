  "-731640229": {
   "kind": "text",
   "parent": -2118663961,
   "actor": "HimariDad",
   "expressionName": "neutral",
   "text": "I am disappointed, Himari.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-24657011": {
   "kind": "text",
   "parent": -2118663961,
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Oh, Himari. Why did you lie to us?",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-996567038": {
   "kind": "text",
   "parent": -1,
   "actor": "HimariMom",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "No need to explain, dear! I can see the chemistry. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "212583936": {
   "kind": "text",
   "parent": -1,
   "actor": "HimariMom",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Himari has never brought anyone home before, and now she’s sneaking off to whisper with you? Fufufu~ I like you already!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1520318722": {
   "kind": "text",
   "parent": -1,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "Tch. You’re reading too much into it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-965922600": {
   "kind": "text",
   "parent": -1,
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Oh? Then why is your face red?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-136569921": {
   "kind": "text",
   "parent": -1,
   "actor": "Himari",
   "expression": 2,
   "expressionName": "Angry",
   "text": "It’s not!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "829094085": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1945991586,
    -290544976,
    1491159170
   ],
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Mmm, I don’t know… You always act so cold, but with him, I see a little warmth peeking through. How lovely!",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1439091653": {
   "kind": "text",
   "parent": -1,
   "actor": "HimariMom",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Himari needs someone like you—strong, confident, and not afraid to tease her a little. She gets too serious sometimes!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-47613019": {
   "kind": "text",
   "parent": -1,
   "actor": "Himari",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I’m sitting right here, you know.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-209844808": {
   "kind": "text",
   "parent": -1,
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Yes, yes, darling. Now eat before your food gets cold.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "613292909": {
   "kind": "text",
   "parent": -1,
   "actor": "HimariDad",
   "expressionName": "neutral",
   "text": "…So. What are your plans for the future?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "521381794": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Oh, well—",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-892050717": {
   "kind": "text",
   "parent": -1,
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Let the poor boy eat first! We’ll get to that after dessert!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1945991586": {
   "kind": "text",
   "parent": 829094085,
   "actor": null,
   "text": "Glad to hear I’m making a good impression.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-290544976": {
   "kind": "text",
   "parent": 829094085,
   "actor": null,
   "text": "It fits her. I see where Himari gets her beauty from.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1491159170": {
   "kind": "text",
   "parent": 829094085,
   "actor": null,
   "text": "(Nod)",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
