    976055003
   ],
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "What, you lost or something?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
