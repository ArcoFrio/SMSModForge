   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1698068713": {
   "kind": "text",
   "parent": -1450170566,
   "actor": "Jack",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Oh, you’re gonna regret sayin’ that. Hope you brought extra clothes, ‘cause you’re about to get soaked.",
   "jump": {
