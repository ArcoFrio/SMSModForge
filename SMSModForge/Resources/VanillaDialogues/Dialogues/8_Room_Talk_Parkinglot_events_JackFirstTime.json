  "1362734176": {
   "kind": "text",
   "parent": -1287030847,
   "children": [
    -1222009444,
    -524168599,
    -1875724650
   ],
   "actor": null,
   "text": "I’m here to race. I want Toni’s freedom.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2014518064": {
   "kind": "text",
   "parent": -1287030847,
   "children": [
    653595103,
    -322634080
   ],
   "actor": null,
   "text": "Nice little empire you got here. You love people kissing your ass.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "246430421": {
   "kind": "text",
   "parent": -1287030847,
   "children": [
    -237821945
   ],
   "actor": null,
   "text": "I heard you’re the guy to talk to if I want to make a deal.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-237821945": {
   "kind": "text",
   "parent": 246430421,
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "Depends on the deal. I don’t work cheap, and I sure as hell don’t do charity. So what is it you’re after?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "653595103": {
   "kind": "text",
   "parent": -2014518064,
   "actor": "Jack",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Heh. You got some balls talkin’ like that in my place.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1222009444": {
   "kind": "text",
   "parent": 1362734176,
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "Toni’s freedom?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-524168599": {
   "kind": "text",
   "parent": 1362734176,
   "actor": "Jack",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh, that’s cute. What, she send you to play hero for her?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1875724650": {
   "kind": "text",
   "parent": 1362734176,
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "You got any idea what you’re askin’? I don’t just let people walk outta my business for free.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-322634080": {
   "kind": "text",
   "parent": -2014518064,
   "actor": "Jack",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Keep that attitude up and your body will end up in a dumpster.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "500373138": {
   "kind": "text",
   "parent": -817842029,
   "actor": "You",
   "expressionName": "neutral",
   "text": "I want a race. If I win, you let Toni go—no strings, no bullshit.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-74875708": {
   "kind": "text",
   "parent": -817842029,
   "actor": "Jack",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Hah. You think I’m gonna put it all on one race? ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1786527571": {
   "kind": "text",
   "parent": -817842029,
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "What, you expect me to let some random punk come in and call the shots? That ain’t how it works, kid.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "40984848": {
   "kind": "choice",
   "parent": -817842029,
   "children": [
    750965727,
    367868157,
    204039776
   ],
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "And we'll do Squirt Races.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "110104908": {
   "kind": "text",
   "parent": -817842029,
   "actor": "Jack",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Three races. 20 grand per race. Entry fee. No refunds. You lose, you win, that money's mine.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "750965727": {
   "kind": "text",
   "parent": 40984848,
   "children": [
    -1239113596
   ],
   "actor": null,
   "text": "I'm sorry, did you just said \"Squirt Races\"?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "367868157": {
   "kind": "text",
   "parent": 40984848,
   "children": [
    -1111865940
   ],
   "actor": null,
   "text": "Uh... What now?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "204039776": {
   "kind": "text",
   "parent": 40984848,
   "actor": null,
   "text": "(Don't jump to any conclusions, wait for him to explain)",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1239113596": {
   "kind": "text",
   "parent": 750965727,
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "Obviously, you're clueless. Just another brainwashed city slicker.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1111865940": {
   "kind": "text",
   "parent": 367868157,
   "actor": "Jack",
   "expressionName": "neutral",
   "text": "Obviously, you're clueless. Just another brainwashed city slicker.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
