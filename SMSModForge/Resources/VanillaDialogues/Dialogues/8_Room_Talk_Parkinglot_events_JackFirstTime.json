    "m_Options": "FromSkin"
   }
  },
  "-2083190776": {
   "kind": "text",
   "parent": 925411358,
   "children": [
    229394598
   ],
   "actor": null,
   "text": "Women can't cum from that...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "229394598": {
   "kind": "text",
   "parent": -2083190776,
   "actor": "Jack",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Of course you would think that. I mean, just look at you. Come back when you’ve actually got a spine.",
   "jump": {
