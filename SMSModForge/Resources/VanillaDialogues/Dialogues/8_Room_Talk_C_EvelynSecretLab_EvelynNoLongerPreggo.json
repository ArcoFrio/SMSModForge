 "nodes": {
  "134361379": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expression": 2,
   "expressionName": "Angry",
   "text": "As you can see, I'm no longer pregnant. Extraction was successful. No complications.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-743245690": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "An off-grid facility beyond Peak City. Deep containment protocols. It will remain there.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "759633639": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "I just wanted you to know... He’s safe. Monitored. Protected. I ensured that much.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-669046461": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Where is it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1073180390": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1637928202,
    -537122700,
    971310530
   ],
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "You don’t have to care. But I needed to say it. Once.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1637928202": {
   "kind": "text",
   "parent": 1073180390,
   "children": [
    -1728803282
   ],
   "actor": null,
   "text": "Will it be worth it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1728803282": {
   "kind": "text",
   "parent": 1637928202,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "I don’t know. Science doesn’t predict worth. It calculates outcomes.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-537122700": {
   "kind": "text",
   "parent": 1073180390,
   "children": [
    -1679963823,
    -1036797316,
    1310103059
   ],
   "actor": null,
   "text": "Evelyn... you can still change.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1679963823": {
   "kind": "text",
   "parent": -537122700,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Change into what? A mother? A human?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "971310530": {
   "kind": "text",
   "parent": 1073180390,
   "children": [
    -1705748619,
    1434125229
   ],
   "actor": null,
   "text": "So? Any reward for the donor?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1705748619": {
   "kind": "text",
   "parent": 971310530,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "You already got your reward. I let you in when I never let anyone in.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1036797316": {
   "kind": "text",
   "parent": -537122700,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "I don’t know how to feel the right way.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1310103059": {
   "kind": "text",
   "parent": -537122700,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "But part of me… wants to... No. Just no, {PC}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1434125229": {
   "kind": "text",
   "parent": 971310530,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "That’s not nothing. Even if it felt like it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
