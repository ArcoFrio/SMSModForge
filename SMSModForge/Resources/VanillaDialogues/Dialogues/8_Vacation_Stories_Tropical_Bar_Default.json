    "m_Options": "FromSkin"
   }
  },
  "1944548828": {
   "kind": "text",
   "parent": -1163059009,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh, stop. Besides, you’re not off the hook either—he thought you were charming enough to match me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
