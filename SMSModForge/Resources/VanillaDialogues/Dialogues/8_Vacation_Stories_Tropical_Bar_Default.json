    "m_Options": "FromSkin"
   }
  },
  "-1163059009": {
   "kind": "text",
   "parent": -1958096528,
   "children": [
    1944548828
   ],
   "actor": null,
   "text": "Can you blame him? You don’t exactly look like someone’s {M}.",
