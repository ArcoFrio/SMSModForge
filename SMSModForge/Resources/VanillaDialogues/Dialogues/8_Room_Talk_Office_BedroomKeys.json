  "1532402705": {
   "kind": "text",
   "parent": 350003583,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Anna is no longer mine, she is ours.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "470834465": {
   "kind": "text",
   "parent": 350003583,
   "actor": "Josef",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "And I'm... I am looking forward to sharing her holes with you, my {S}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1632688363": {
