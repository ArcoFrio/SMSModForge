 "nodes": {
  "-634420264": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Charlotte invited me to her Halloween party this weekend. One of her big ones… you know how she is.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1603322919": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1248616629,
    1570754768
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "If you’re up for it...",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1248616629": {
   "kind": "text",
   "parent": 1603322919,
   "children": [
    -1738218689
   ],
   "actor": null,
   "text": "Sure, I’ll come.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1570754768": {
   "kind": "text",
   "parent": 1603322919,
   "children": [
    341443172
   ],
   "actor": null,
   "text": "No thanks. I’ll pass.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1738218689": {
   "kind": "text",
   "parent": -1248616629,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Really? That means a lot, honey. Even if it’s just for a little while—it’ll be nice having you there.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active Disable_At_StartCheck_If_Going to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "Disable_At_StartCheck_If_Going",
       "of": "GetGameObjectInstance",
       "path": "Holiday_Hallway_Conditions/Halloween_Party_Charlotte/Disable_At_StartCheck_If_Going"
      }
     }
    }
   ]
  },
  "341443172": {
   "kind": "text",
   "parent": 1570754768,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Alright. I get it. It’s not everyone’s thing. I just thought... never mind. No pressure.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1407298330": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1359935987,
    474062720,
    -2104544507
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "She asked if I was coming, and I figured… why not. It might be nice to go. But I’d rather not go alone.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "725608234": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I was thinking maybe the four of us could go—like we used to. Just for a bit. You know she always throws a big one.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Mainstory[D-LEFT-FOREVER] = True",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "D-LEFT-FOREVER",
        "list": "Mainstory",
        "type": "boolean"
       }
      },
      "m_Comparison": "Equals",
      "m_CompareTo": {
       "kind": "value",
       "value": true
      }
     }
    }
   ]
  },
  "650080846": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I already asked Adrian. I’d feel better if you came too. It’s been a while since I went to one of these without Josef.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Mainstory[D-LEFT-FOREVER] = False",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "D-LEFT-FOREVER",
        "list": "Mainstory",
        "type": "boolean"
       }
      },
      "m_Comparison": "Equals",
      "m_CompareTo": {
       "kind": "value",
       "value": false
      }
     }
    }
   ]
  },
  "-1359935987": {
   "kind": "text",
   "parent": -1407298330,
   "children": [
    -962150076
   ],
   "actor": null,
   "text": "Do I need a costume for this, or…?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "474062720": {
   "kind": "text",
   "parent": -1407298330,
   "children": [
    -1669707923
   ],
   "actor": null,
   "text": "What time is it happening?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1669707923": {
   "kind": "text",
   "parent": 474062720,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "She said people usually start showing up around seven. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-962150076": {
   "kind": "text",
   "parent": -1359935987,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Charlotte always says it’s optional, but… you know how it is. If you don’t wear one, you just feel like the odd one out.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2104544507": {
   "kind": "text",
   "parent": -1407298330,
   "children": [
    -602995404
   ],
   "actor": null,
   "text": "Will there be booze?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-602995404": {
   "kind": "text",
   "parent": -2104544507,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh there’ll be booze. Charlotte’s parties always have way too much. Just… behave yourself, alright?",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
