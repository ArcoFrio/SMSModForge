  "660064052": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Sometimes, life takes unexpected turns. {M} and I chose our path, a path that meant leaving everything and everyone behind. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-37509162": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "We knew the consequences, but the thrill of the unknown was too tempting to resist.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "251251719": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "As we drive into the sunset in my {D}’s red sports car, there’s a sense of freedom I’ve never felt before. ",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
