  },
  "1048829745": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "It’s not just about escaping—it’s about starting over, finding a new life where the past can’t catch us.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "696944652": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "We betrayed those who trusted us, but in the end, we found each other. In this moment, it’s just the two of us against the world. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1470947042": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "The road ahead is uncertain, but for now, we have each other and that’s enough.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
