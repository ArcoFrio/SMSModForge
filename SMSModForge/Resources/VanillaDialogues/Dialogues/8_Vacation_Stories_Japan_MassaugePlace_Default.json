    "m_Options": "FromSkin"
   }
  },
  "-1439240520": {
   "kind": "text",
   "parent": 2089144784,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "That is good to hear. Your body needed this, and perhaps... your mind did too.",
