    "m_Options": "FromSkin"
   }
  },
  "-66509838": {
   "kind": "text",
   "parent": -1286542845,
   "children": [
    -1341653070
   ],
   "actor": null,
   "text": "Maybe it’s not about knowing. Maybe the chase is the point.",
