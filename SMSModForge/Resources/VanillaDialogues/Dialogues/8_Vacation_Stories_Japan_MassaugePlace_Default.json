    "m_Options": "FromSkin"
   }
  },
  "2084411879": {
   "kind": "text",
   "parent": 186769485,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": " Look not with your eyes, but with your heart. The answers are waiting—they always have been.",
