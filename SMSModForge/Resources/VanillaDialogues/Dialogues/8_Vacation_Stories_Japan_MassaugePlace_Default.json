   "actor": null,
   "text": "I... I’m not sure. Sometimes I feel like I’m still figuring that out.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1513751398": {
   "kind": "text",
   "parent": 1600657305,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "That is a journey we all take, and it is not meant to be rushed.",
