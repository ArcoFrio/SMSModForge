  "387756693": {
   "kind": "text",
   "parent": 1807679559,
   "children": [
    1635446171
   ],
   "actor": null,
   "text": "Can you tell me a bit about yourself? You seem... fascinating.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1738957300": {
   "kind": "text",
   "parent": 1807679559,
   "children": [
    -695427690
   ],
   "actor": null,
   "text": "I hope this isn’t rude, but... are you really blind?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-764688217": {
   "kind": "text",
   "parent": 1807679559,
   "children": [
    1192587642
   ],
   "actor": null,
   "text": "Why did you choose to become a masseuse?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1816471931": {
   "kind": "text",
   "parent": -893011642,
   "actor": "V_Sakura",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Of course. Relax and let everything else fade away. Adrian, please wait in that room over there until we are done.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1635446171": {
   "kind": "text",
   "parent": 387756693,
   "actor": "V_Sakura",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Fascinating? Hardly. I’m just someone who listens closely to what others overlook. The quiet speaks if you know how to hear it.",
   "jump": {
    "mode": "Jump",
    "to": "sakuloop1"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-695427690": {
   "kind": "text",
   "parent": 1738957300,
   "actor": "V_Sakura",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I am. My eyes cannot see, but I experience the world in other ways—ways that often speak louder than sight.",
   "jump": {
    "mode": "Jump",
    "to": "sakuloop1"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1192587642": {
   "kind": "text",
   "parent": -764688217,
   "actor": "V_Sakura",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Because touch transcends barriers. It’s a language of its own—one that can heal in ways words never could.",
   "jump": {
    "mode": "Jump",
    "to": "sakuloop1"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
