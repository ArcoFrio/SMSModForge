   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Hey, {PC}. Can we talk for a minute?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "questTaskComplete",
     "type": "InstructionQuestsTaskComplete",
     "title": "Complete Speak with Anna when she’s drinking in the kitchen.",
