  },
  "-826670063": {
   "kind": "text",
   "parent": -570756524,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I.. I want to be with you too...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1161225265": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Let’s get back to our lives then. I promise you I’m doing better. No more evil bitch...",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
