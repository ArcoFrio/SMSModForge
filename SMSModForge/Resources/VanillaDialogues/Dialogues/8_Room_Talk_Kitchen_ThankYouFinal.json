  },
  "-968494642": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I wanted to apologize. I had too much wine recently  and I... I said some things I shouldn’t have. I’m really sorry.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setString",
     "type": "InstructionTextSetString",
     "title": "Set Core_NoSave[achivement-unlocked] = Savior",
     "fields": {
      "m_Text": {
       "kind": "value",
       "value": "Savior"
      },
      "m_Set": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "achivement-unlocked",
        "list": "Core_NoSave",
        "type": "string"
       }
      }
     }
    },
    {
     "kind": "setBool",
     "type": "InstructionBooleanSetBool",
     "title": "Set Achievements[anna-saved] = True",
     "fields": {
      "m_Set": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "anna-saved",
        "list": "Achievements",
        "type": "boolean"
       }
      },
      "m_From": {
       "kind": "value",
       "value": true
      }
     }
    }
   ]
  },
  "-1932981353": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "It’s like the floor was slipping away from under my feet, and I was.. I was being very unfair to you...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "900220318": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1120040224,
    1596701832,
    -1048452585
   ],
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "And even though I was such a bitch, you stuck by me... You helped me...",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1120040224": {
   "kind": "text",
   "parent": 900220318,
   "children": [
    905176622
   ],
   "actor": null,
   "text": "It's all good, {M}. I'm glad you are doing better.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1596701832": {
   "kind": "text",
   "parent": 900220318,
   "children": [
    1099561720
   ],
   "actor": null,
   "text": "Yeah, you were a real bitch.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1048452585": {
   "kind": "text",
   "parent": 900220318,
   "children": [
    -380213092
   ],
   "actor": null,
   "text": "No more wine from now on.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "905176622": {
   "kind": "text",
   "parent": 1120040224,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Thank you, hun. This means a lot to me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1099561720": {
   "kind": "text",
   "parent": 1596701832,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I... I know... I'm so sorry....",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-380213092": {
   "kind": "text",
   "parent": -1048452585,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Yes. Promised.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1644081933": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "There is one question I have to ask you... I just have to...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "421532700": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -570756524,
    998290606,
    1095235915,
    -31668415
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "W-What do YOU want... Why do all of this?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-570756524": {
   "kind": "text",
   "parent": 421532700,
   "children": [
    -826670063
   ],
   "actor": null,
   "text": "I want to be with you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "998290606": {
   "kind": "text",
   "parent": 421532700,
   "children": [
    278796936
   ],
   "actor": null,
   "text": "I want to help our {F}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1095235915": {
   "kind": "text",
   "parent": 421532700,
   "children": [
    1559665473
   ],
   "actor": null,
   "text": "I want to make a lot of money.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-31668415": {
   "kind": "text",
   "parent": 421532700,
   "children": [
    718852159
   ],
   "actor": null,
   "text": "I want to have fun.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "718852159": {
   "kind": "text",
   "parent": -31668415,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I... I'm glad you are having fun. I am having fun too....",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1559665473": {
   "kind": "text",
   "parent": 1095235915,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "We do make a lot of money, don't we? Hah...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "278796936": {
   "kind": "text",
   "parent": 998290606,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I want to do the same... I want us all to be happy...",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setBool",
     "type": "InstructionBooleanSetBool",
