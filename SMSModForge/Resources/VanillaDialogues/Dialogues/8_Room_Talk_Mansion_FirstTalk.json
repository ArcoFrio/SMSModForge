    "m_Options": "FromSkin"
   }
  },
  "-1125715385": {
   "kind": "text",
   "parent": -477645994,
   "actor": null,
   "text": "Sounds great.\t",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-252162134": {
   "kind": "text",
   "parent": -477645994,
   "actor": null,
   "text": "I'll give it a try, but no promises.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1259346180": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
