   "kind": "text",
   "parent": -1,
   "actor": "Haniya",
   "expressionName": "neutral",
   "text": "Well, well, what do we have here? A new protégé, Gabriel?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "918852170": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Yes, indeed. {PC}, this is my wife, Haniya.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1880844642": {
   "kind": "choice",
   "parent": -1,
   "children": [
    23885665,
    -465651188,
    1888211932
   ],
   "actor": "Haniya",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Nice to meet you, {PC}. Gabriel has been talking about finding a student like you for ages. How exciting!",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
