  "893016832": {
   "kind": "text",
   "parent": -618659924,
   "children": [
    -211232944
   ],
   "actor": null,
   "text": "We both attended the same modeling course.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1792107054": {
   "kind": "text",
   "parent": -618659924,
   "children": [
    49652736
   ],
   "actor": null,
   "text": "We met online, through a photography subreddit.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-543094953": {
   "kind": "text",
   "parent": -618659924,
   "children": [
    -481058876
   ],
   "actor": null,
   "text": "She's actually my {M}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "49652736": {
   "kind": "text",
   "parent": 1792107054,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Reddit, huh? Haven't heard of that one before.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-211232944": {
   "kind": "text",
   "parent": 893016832,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "That makes sense, you do seem a lot younger than her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-481058876": {
   "kind": "text",
   "parent": -543094953,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Hah! You are funny, I like that!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1217169616": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You know, I've been looking for someone with raw potential like yours for a long time.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-477645994": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1125715385,
    -252162134,
    1948350356
   ],
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "I'd love to teach you. All I ask in return is your attention. What do you say?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
