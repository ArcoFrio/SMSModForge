    "m_Options": "FromSkin"
   }
  },
  "5849042": {
   "kind": "text",
   "parent": 1689011880,
   "actor": null,
   "text": "Yeah. I'm {PC}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-618659924": {
   "kind": "choice",
   "parent": -1,
   "children": [
    893016832,
    1792107054,
    -543094953
   ],
   "actor": "Gabriel",
   "expression": 1,
   "expressionName": "Happy",
   "text": "{PC}! Strong name! So, how’d you end up meeting your model?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
