  "23885665": {
   "kind": "text",
   "parent": -1880844642,
   "actor": null,
   "text": "Nice to meet you too, Haniya. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-465651188": {
   "kind": "text",
   "parent": -1880844642,
   "actor": null,
   "text": "I’m looking forward to learning a lot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "27750714": {
   "kind": "text",
   "parent": -1,
   "actor": "Haniya",
   "expressionName": "neutral",
   "text": "Oh, you’re in for quite the experience. Gabriel’s an excellent teacher, and our home is always lively. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-434271268": {
   "kind": "text",
   "parent": -1,
   "actor": "Haniya",
   "expressionName": "neutral",
   "text": "Just don’t let him work you too hard, alright?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1614435871": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I’ll try to keep that in mind. We’ll balance hard work with some fun, I promise.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1741082911": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1855819971,
    -1957998931
   ],
   "actor": "Haniya",
   "expressionName": "neutral",
   "text": "Good. I’ll be here to make sure he doesn’t forget. And if you ever need a break, feel free to chat with me.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
