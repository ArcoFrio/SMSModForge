  "1855819971": {
   "kind": "text",
   "parent": 1741082911,
   "actor": null,
   "text": "I’ll keep that in mind. Thanks, Haniya.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1957998931": {
   "kind": "text",
   "parent": 1741082911,
   "actor": null,
   "text": "I can imagine...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-101143211": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Great! So, Tuesday it is. I’m looking forward to it.",
