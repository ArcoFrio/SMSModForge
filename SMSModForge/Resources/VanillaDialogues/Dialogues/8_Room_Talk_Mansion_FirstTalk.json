  "543599852": {
   "kind": "text",
   "parent": 1606907330,
   "children": [
    496999588
   ],
   "actor": null,
   "text": "Thanks for the invitation, glad to be here.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "122264326": {
   "kind": "text",
   "parent": 1606907330,
   "children": [
    -951408170
   ],
   "actor": null,
   "text": "So, how much money do you want?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "892158862": {
   "kind": "text",
   "parent": 1606907330,
   "children": [
    -982742874
   ],
   "actor": null,
   "text": "Your mansion is stunning. You have great taste.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-982742874": {
   "kind": "text",
   "parent": 892158862,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Thank you! I’ve always believed that a creative space inspires creativity. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-951408170": {
   "kind": "text",
   "parent": 122264326,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Money? Oh no, I have more than enough of that. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "496999588": {
   "kind": "text",
   "parent": 543599852,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Of course, of course. It's rare to see real, raw talent these days.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1689011880": {
   "kind": "choice",
   "parent": -1,
   "children": [
    5849042,
    1058550560
   ],
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "As mentioned in the email, I’m Gabriel. You must be Anna’s photographer, right?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
