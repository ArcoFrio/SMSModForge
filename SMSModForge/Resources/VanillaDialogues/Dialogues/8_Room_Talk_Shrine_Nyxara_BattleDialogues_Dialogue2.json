  "1084831990": {
   "kind": "text",
   "parent": -1220211546,
   "children": [
    -1420277630
   ],
   "actor": null,
   "text": "What is that sound?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-732950803": {
   "kind": "text",
   "parent": -1220211546,
   "children": [
    828311978,
    1779903327
   ],
   "actor": null,
   "text": "Is that a phone?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1509684694": {
   "kind": "text",
   "parent": -1220211546,
   "actor": null,
   "text": "(Ignore the sound)",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1456396457": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "828311978": {
   "kind": "text",
   "parent": -732950803,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "W-What? No. That was… That was the wailing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1420277630": {
   "kind": "text",
   "parent": 1084831990,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "That... That was the wailing. Of the sorrowful dead.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1779903327": {
   "kind": "text",
   "parent": -732950803,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Of the sorrowful dead. They… um… mourn hourly.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
