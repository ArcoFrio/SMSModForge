 "nodes": {
  "-164505294": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "You're here again.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "673945928": {
   "kind": "choice",
   "parent": -1,
   "children": [
    640624835,
    -445166034,
    -1860973381
   ],
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "The spirits. What did they ever do to you?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1859588243": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "What if they were lost?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1486619838": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "What if they were… like me?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "224039749": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Will you kill me too?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "640624835": {
   "kind": "text",
   "parent": 673945928,
   "children": [
    -1895553598,
    1955913962
   ],
   "actor": null,
   "text": "They’re dangerous. I do what I have to.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-445166034": {
   "kind": "text",
   "parent": 673945928,
   "children": [
    2053527113,
    -318993990
   ],
   "actor": null,
   "text": "You make it sound like I’m the villain.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1860973381": {
   "kind": "text",
   "parent": 673945928,
   "children": [
    -2070498822,
    -218283549
   ],
   "actor": null,
   "text": "Some old hermit told me to.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2070498822": {
   "kind": "text",
   "parent": -1860973381,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "It is you who invades their world.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2053527113": {
   "kind": "text",
   "parent": -445166034,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Am I wrong?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1895553598": {
   "kind": "text",
   "parent": 640624835,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Dangerous. Yes… I suppose we are.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1955913962": {
   "kind": "text",
   "parent": 640624835,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "But so are you. Maybe more than you think.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-318993990": {
   "kind": "text",
   "parent": -445166034,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "The blade sings in your hands. And when you strike… you never hesitate.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-218283549": {
   "kind": "text",
   "parent": -1860973381,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "So they bared their teeth… and you tore them apart.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-965147161": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Even after I told you to leave.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-989286968": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Tell me something. \nWhy do you slay them?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1799605938": {
   "kind": "text",
   "parent": -1,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "What if...",
   "settings": {
    "m_Options": "FromSkin"
   },
