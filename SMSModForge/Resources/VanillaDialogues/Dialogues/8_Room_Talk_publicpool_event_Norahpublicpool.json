   "children": [
    8891419
   ],
   "actor": null,
   "text": "No, actually. Not once.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "8891419": {
   "kind": "text",
   "parent": 535032524,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "Oh… I guess I shouldn't be surprised. She keeps a lot in.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1971162955": {
   "kind": "text",
   "parent": 1462419654,
   "children": [
    1494123043
   ],
   "actor": null,
   "text": "Not really, but that doesn’t mean she doesn’t care.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1494123043": {
   "kind": "text",
   "parent": 1971162955,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "That’s… thoughtful of you to say. She used to tell me everything, you know?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1478532086": {
   "kind": "text",
   "parent": 1462419654,
   "children": [
    -434755497
   ],
   "actor": null,
