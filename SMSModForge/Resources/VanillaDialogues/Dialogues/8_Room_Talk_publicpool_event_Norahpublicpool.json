    "m_Options": "FromSkin"
   }
  },
  "-1900986216": {
   "kind": "text",
   "parent": 1149965146,
   "children": [
    834400766
   ],
   "actor": null,
   "text": "Trying to interrogate me, huh?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "834400766": {
   "kind": "text",
   "parent": -1900986216,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "Oh, no! Goodness, I wouldn’t even know how. But I am a little curious about you… and her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "752941732": {
   "kind": "text",
   "parent": 1149965146,
   "children": [
    -978661691
   ],
   "actor": null,
   "text": "What do you want to know, Norah? You can ask anything.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-978661691": {
   "kind": "text",
   "parent": 752941732,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "O-oh... well, I wasn’t expecting... that kind of offer. You’re a bit bolder than I thought.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1532345239": {
   "kind": "text",
   "parent": 749496101,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "I'm Norah... I'm, uh... Alice's {M}. We know each other from church, remember?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1462419654": {
   "kind": "choice",
   "parent": 749496101,
   "children": [
