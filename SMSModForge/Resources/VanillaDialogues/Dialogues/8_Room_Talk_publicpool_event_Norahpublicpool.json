    "m_Options": "FromSkin"
   }
  },
  "-434755497": {
   "kind": "text",
   "parent": -1478532086,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "She… really said that? I—I’m glad. I was starting to feel like a stranger in her world.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1856312787": {
   "kind": "text",
   "parent": 749496101,
   "actor": "Norah",
   "expressionName": "neutral",
