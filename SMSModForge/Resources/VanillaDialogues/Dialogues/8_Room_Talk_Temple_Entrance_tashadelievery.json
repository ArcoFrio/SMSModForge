  "604306852": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Hmph. I didn’t ask for your help, girl.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1667439346": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "I know. But it doesn’t hurt to have someone around who isn’t a cranky ghost hunter.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1006217798": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You waste your time with this nonsense… but fine. It’s appreciated.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1246530849": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Anytime. Just don’t go kicking the bucket before next month, alright?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1231800517": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Tch. I’m not so fragile. But I’ll keep it in mind… for your sake.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1961719124": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Brought your monthly delivery, old man. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
