  "1620515335": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I was wondering if you could do me a little favor. You’ve got the car keys now, right?",
   "tag": "rooty",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-263427849": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1204785335,
    -347236550,
    1783845731
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "On Tuesdays, I work late at the flower shop, and getting home by bus takes forever… Would you mind picking me up? Just a quick drive, nothing too much.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1204785335": {
   "kind": "text",
   "parent": -263427849,
   "children": [
    -953381439
   ],
   "actor": null,
   "text": "Of course, I don’t mind.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-347236550": {
   "kind": "text",
   "parent": -263427849,
   "children": [
    797816696
   ],
   "actor": null,
   "text": "Can’t {D} or Adrian do it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1783845731": {
   "kind": "text",
   "parent": -263427849,
   "children": [
    1605878821
   ],
   "actor": null,
   "text": "What’s in it for me?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1605878821": {
