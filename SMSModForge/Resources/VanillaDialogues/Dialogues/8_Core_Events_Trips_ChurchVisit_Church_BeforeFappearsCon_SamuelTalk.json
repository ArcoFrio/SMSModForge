 "nodes": {
  "-217170519": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "You again.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1106649974": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1810761538,
    399082955,
    1422433476,
    1984644877,
    1276265550
   ],
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "That’s a good thing. Means you haven’t given up yet. So… what brings you in today?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1810761538": {
   "kind": "text",
   "parent": -1106649974,
   "children": [
    -1134362423,
    -544629698
   ],
   "actor": null,
   "text": "Just needed a quiet moment. And maybe a little wisdom.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1134362423": {
   "kind": "text",
   "parent": 1810761538,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Then sit. Breathe. Talk if you want, or don’t.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "399082955": {
   "kind": "text",
   "parent": -1106649974,
   "children": [
    1484385544,
    1548749117
   ],
   "actor": null,
   "text": "How do you keep doing this every day?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1484385544": {
   "kind": "text",
   "parent": 399082955,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Same way I keep breathing. One day at a time.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1422433476": {
   "kind": "text",
   "parent": -1106649974,
   "children": [
    1486037476,
    508712981
   ],
   "actor": null,
   "text": "I came to see if lightning strikes the roof when I walk in.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1486037476": {
   "kind": "text",
   "parent": 1422433476,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Ha. Roof’s still standing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1984644877": {
   "kind": "text",
   "parent": -1106649974,
   "children": [
    1601626707,
    -688234163
   ],
   "actor": null,
   "text": "Thought I’d balance out my sins with some church time.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1601626707": {
   "kind": "text",
   "parent": 1984644877,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Honest, at least.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1276265550": {
   "kind": "text",
   "parent": -1106649974,
   "children": [
    453066073,
    1833126934
   ],
   "actor": null,
   "text": "My {M} forced me here.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "453066073": {
   "kind": "text",
   "parent": 1276265550,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "That’s alright. Some folks walk in on their own. Others get dragged.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1833126934": {
   "kind": "text",
   "parent": 1276265550,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "What matters is what you do once you’re here.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-688234163": {
   "kind": "text",
   "parent": 1984644877,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "But don’t think stepping through that door resets the scoreboard. That’s not how this works.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "508712981": {
   "kind": "text",
   "parent": 1422433476,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "But if it does fall, you’re helping me fix it. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1548749117": {
   "kind": "text",
   "parent": 399082955,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "\nI’m not here because I’m perfect. I’m here because I remember who I was before grace.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-544629698": {
   "kind": "text",
   "parent": 1810761538,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "You don’t need to earn silence around here. It’s already paid for.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1270543015": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Alright. Go do what you gotta do. But remember... whatever you carry, it gets lighter when you stop pretending you're fine.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-545461462": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Samuel",
   "expressionName": "my-expression",
   "text": "Come back anytime, {PC}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
