     }
    }
   ]
  },
  "-1470947042": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "We poured everything into Starmaker, turning it into a massive success. The money flows in, more than we ever dreamed.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1780794600": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "We’ve come a long way, and there’s no turning back. We’ve made our choices, and we live with them every day. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1752840974": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Things are not always perfect, but at least when we are sad, we get to be sad inside of our expensive sports cars and luxurious mansion.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
