 "nodes": {
  "660064052": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Life doesn’t always turn out the way we expect. After everything that happened, {D} couldn’t take it. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-37509162": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "The weight of our secrets and the pressure of our lives drove him away.  He left, unable to face what we’d become.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "251251719": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Adrian, my {B}, sought a new life in Japan, chasing dreams far from the shadows of this busy city.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1048829745": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": " I can’t blame him for wanting a fresh start, away from the chaos.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "696944652": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "And now, it’s just me and {M}. The two of us, left to pick up the pieces. But we didn’t just survive – we thrived. ",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active Endingshot (4) to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "Endingshot (4)",
       "of": "GetGameObjectInstance",
       "path": "5_CG_EndingArt/Endingshot (4)"
