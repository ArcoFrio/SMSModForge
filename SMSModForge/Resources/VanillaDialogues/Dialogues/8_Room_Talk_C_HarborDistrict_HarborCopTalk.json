  "-2055603707": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Hold it right there, buddy. Harbor’s off-limits.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-635833584": {
   "kind": "text",
   "parent": -1901436921,
   "children": [
    -373234,
    -357532396
   ],
   "actor": null,
   "text": "Whoa, relax. What happened here?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1384113496": {
   "kind": "text",
   "parent": -1901436921,
   "children": [
    -1787905619,
    1196519274
   ],
   "actor": null,
   "text": "You seriously think you can stop me, old man?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1679326838": {
   "kind": "text",
   "parent": -1901436921,
   "children": [
    558639562,
    -614295561
   ],
   "actor": null,
   "text": "Lemme guess, someone drowned in the shallow end?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2077480747": {
   "kind": "text",
   "parent": -1901436921,
   "children": [
    1404892775,
    -359054007
   ],
   "actor": null,
   "text": "Crime scene, huh? Someone get fucked to death or what?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1404892775": {
   "kind": "text",
   "parent": 2077480747,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Jesus, you’re a real piece of work. Yeah, sex was involved. Always is when it goes this wrong. Girl was streaming.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "558639562": {
   "kind": "text",
   "parent": 1679326838,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Ha! Good one. Nah, no drowning. Girl named Umbra. Online model. Showed a little too much of herself to the wrong eyes.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1787905619": {
   "kind": "text",
   "parent": -1384113496,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Oh, I like you. Got that rookie arrogance... smells like burnt ambition. But here’s the deal: I’ve scraped prettier people off these docks.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-373234": {
   "kind": "text",
   "parent": -635833584,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Hah… someone with manners. Rare species these days. We’re looking for a girl... goes by Umbra. Some Starmaker hotshot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-357532396": {
   "kind": "text",
   "parent": -635833584,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Big eyes, bigger following, vanishes after a livestream by the pier. Camera kept rolling though. We watched the footage. Still trying to forget it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1196519274": {
   "kind": "text",
   "parent": -1384113496,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "So unless you want me tagging your body bag ‘dumb bastard #47,’ you’ll chill the fuck out and stay behind the tape.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-614295561": {
   "kind": "text",
   "parent": 1679326838,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Next thing you know, she’s gone. We found her phone, her bra, and a camera that won’t stop recording static. Make of that what you will.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-359054007": {
   "kind": "text",
   "parent": 2077480747,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Private subscribers. Something went off-script, and she disappeared mid-breath. Camera caught… something. Human-shaped. Maybe. You don’t want to see it, trust me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "110436794": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Cop",
   "expressionName": "my-expression",
   "text": "Back again? What’s the plan, champ... gonna solve the case with your dick, or can I get back to my coffee?",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   },
