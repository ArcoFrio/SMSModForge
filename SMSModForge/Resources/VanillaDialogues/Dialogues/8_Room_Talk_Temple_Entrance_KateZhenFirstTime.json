 "nodes": {
  "604306852": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "You are not born for this war. Your spirit is kind. Kindness breaks under claws.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1667439346": {
   "kind": "text",
   "parent": -1,
   "actor": "Kate",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Then I’ll break. But not until I’ve helped him. I don’t need your approval.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1006217798": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You risk soul, body, life… for what?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1246530849": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1812743727,
    -289046426,
    -1686577141,
    1662366101
   ],
   "actor": "Kate",
   "expression": 3,
   "expressionName": "Sad",
   "text": "For someone I care about. I don’t need any more reason than that.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1812743727": {
   "kind": "text",
   "parent": -1246530849,
   "children": [
    -1755709577
   ],
   "actor": null,
   "text": "Kate… you really want to go through this with me?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1755709577": {
   "kind": "text",
   "parent": -1812743727,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "Of course I do. You’re important to me. That’s enough reason.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-289046426": {
   "kind": "text",
   "parent": -1246530849,
   "children": [
    -2076286237
   ],
   "actor": null,
   "text": "You don’t have to get involved. This isn’t your fight.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2076286237": {
   "kind": "text",
   "parent": -289046426,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "It became my fight the second I saw how much it was hurting you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1686577141": {
   "kind": "text",
   "parent": -1246530849,
   "children": [
    162203541
   ],
   "actor": null,
   "text": "You know this isn’t a therapy hike.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "162203541": {
   "kind": "text",
   "parent": -1686577141,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "Wait~what?! There's no post-battle picnic?! ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1662366101": {
   "kind": "text",
   "parent": -1246530849,
   "children": [
    -1227705540
   ],
   "actor": null,
   "text": "No, Kate. Go back home.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1227705540": {
   "kind": "text",
   "parent": 1662366101,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "No! You can't force me!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "727419969": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "She walks into fire smiling. Foolish... but brave.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "255355014": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -907564447,
    -1217859217,
    1676742941
   ],
   "actor": "Kate",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I’m not brave. I just don't want to see {PC} getting hurt!",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-907564447": {
   "kind": "text",
   "parent": 255355014,
   "children": [
    -723411817
   ],
   "actor": null,
   "text": "How did you even find this place?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-723411817": {
   "kind": "text",
   "parent": -907564447,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "Himari told me... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1217859217": {
   "kind": "text",
   "parent": 255355014,
   "children": [
    412050585
   ],
   "actor": null,
   "text": "This isn't a rescue fantasy. You could die.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "412050585": {
   "kind": "text",
   "parent": -1217859217,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "Then teach me. I’d rather die trying than regret doing nothing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1676742941": {
   "kind": "text",
   "parent": 255355014,
   "children": [
    -1952221309
   ],
   "actor": null,
   "text": "No means no, Kate. This is too dangerous.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1952221309": {
   "kind": "text",
   "parent": 1676742941,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "This is not your decision to make, {PC}... Please.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2106154939": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "She holds no weapon... but her heart is steady. Hmph.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "273859561": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Very well. I will train her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "671096597": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "She may stand behind you. Or fall beside you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-401081016": {
   "kind": "text",
   "parent": -1,
   "actor": "Kate",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I’ll stand with him. And I won’t fall.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
