   "actor": "Tasha",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Hmmm... Hey {PC}, you ever played Dungeon Master 3E before?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
