   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Shit… you’re alive. Are you okay?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
