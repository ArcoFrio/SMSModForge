  },
  "-1886476821": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expression": 1,
   "expressionName": "Happy",
   "text": "We can try next week again, {PC}. All that matters is right now that we both made it out.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "118322800": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Thank you for the... help. Really.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1706307044": {
   "kind": "text",
   "parent": -91946828,
   "children": [
    1461771736
   ],
   "actor": null,
   "text": "Define okay. She used my face like a throne.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1461771736": {
   "kind": "text",
   "parent": -1706307044,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "...Yeah, that sounds like her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1974861111": {
   "kind": "text",
   "parent": -91946828,
   "children": [
    1158738413
   ],
   "actor": null,
   "text": "Barely. She’s stronger than you said.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1158738413": {
   "kind": "text",
   "parent": -1974861111,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "I know. I’m sorry. I panicked. Next time, we go in smarter.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "967653517": {
   "kind": "text",
   "parent": -91946828,
   "children": [
    -1575591575
   ],
   "actor": null,
   "text": "Honestly? I think I need a cigarette and a safe word.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1575591575": {
   "kind": "text",
   "parent": 967653517,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Ugh. Don’t kink-shame yourself.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
