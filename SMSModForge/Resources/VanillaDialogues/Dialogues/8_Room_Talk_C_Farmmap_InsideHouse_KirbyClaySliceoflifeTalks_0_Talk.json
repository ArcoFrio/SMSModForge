  "1960093995": {
   "kind": "text",
   "parent": -1514551683,
   "actor": "Kirby",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Heehee… I like that answer.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-252142992": {
   "kind": "text",
   "parent": -1514551683,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "I want to die...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "449307625": {
   "kind": "text",
   "parent": 1638313128,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "…The end of the world starts small. Always does.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1722838035": {
   "kind": "text",
   "parent": 509247152,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Finally. Someone thinking with their head instead of their... heart.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-419060296": {
   "kind": "text",
   "parent": -560813249,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Belief doesn’t pay debts. You’ll learn that the hard way.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-973726907": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Whatever. Don’t say I didn’t warn you when it all collapses.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-873184527": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 3,
   "expressionName": "Sad",
   "text": "And don’t say I didn’t warn you when we actually succeed!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "907345884": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Don’t listen to him. He’s always like that. I know this is going to work. With you here… it has to.",
   "settings": {
    "m_Options": "FromSkin"
   },
