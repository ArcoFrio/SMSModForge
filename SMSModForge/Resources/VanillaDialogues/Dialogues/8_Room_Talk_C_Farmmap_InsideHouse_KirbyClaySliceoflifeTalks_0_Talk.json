 "nodes": {
  "-162674534": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "This whole thing… it’s a bad idea. You’re dreaming too big again. Human milk? It’ll backfire. It always does. People will laugh, then they’ll hate you for it.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active KirbyBustDefault to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "KirbyBustDefault",
       "of": "GetGameObjectInstance",
       "path": "2_Bust_Manager/KirbyBustDefault"
      }
     }
    }
   ]
  },
  "1747323353": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You don’t know that! People already need us. The city’s thirsty. We’re helping!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-891057272": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Helping? Or humiliating yourself until they turn on you? Don’t you get it, Kirby? This farm has always chewed up hope and spit it out. Why would this be any different?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-849990055": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -560813249,
    509247152,
    1638313128,
    -1514551683
   ],
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "…Because this time, I’m not giving up. And neither is he. ",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
