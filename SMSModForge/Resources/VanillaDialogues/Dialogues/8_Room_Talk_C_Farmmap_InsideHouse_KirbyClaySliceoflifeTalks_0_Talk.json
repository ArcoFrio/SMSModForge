    },
    "m_Options": "FromSkin"
   }
  },
  "-560813249": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -1410417511,
    -419060296
   ],
   "actor": null,
   "text": "Kirby’s right. We’re going to make this work.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1410417511": {
   "kind": "text",
   "parent": -560813249,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "See? He believes in us!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "509247152": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -826723564,
    -1722838035
   ],
   "actor": null,
   "text": "Maybe Clay’s right. We should be careful.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-826723564": {
   "kind": "text",
   "parent": 509247152,
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "What? You can’t be serious!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1638313128": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -686257041,
    449307625
   ],
   "actor": null,
   "text": "Relax, Clay. It’s just milk, not the end of the world.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-686257041": {
   "kind": "text",
   "parent": 1638313128,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Hehe, see? Even he thinks you’re overreacting!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1514551683": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    1960093995,
    -252142992
   ],
   "actor": null,
   "text": "People won’t laugh once they taste Kirby’s milk. It’s too good.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
