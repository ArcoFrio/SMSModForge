   "parent": -1984917679,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "It smells fantastic. You went all out.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-459532027": {
   "kind": "text",
   "parent": -1984917679,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Thanks. Just figured it’d be nice to start the New Year right. Together.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1631758104": {
   "kind": "text",
   "parent": -1742307076,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "That will change soon, Adrian. We're expecting a few guests.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1036895475": {
   "kind": "text",
   "parent": -1742307076,
