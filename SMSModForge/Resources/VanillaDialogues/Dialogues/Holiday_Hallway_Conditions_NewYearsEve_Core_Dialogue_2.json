  "-1763782600": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Alright, snacks on the table, drinks in the fridge… I think we’re actually ready.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-742440815": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Wow. {M} throwing a party that doesn’t involve Tupperware or casseroles. That’s a first.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "951414550": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Ha-ha. Very funny. I'm allowed to have a little fun tonight too, you know.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1742307076": {
   "kind": "text",
   "parent": -1,
   "children": [
    1631758104,
    -1036895475,
    951046834
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "You earned it. Kinda nice, just us here... low-key.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
