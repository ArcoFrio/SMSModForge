   "parent": 656761915,
   "children": [
    -1784249373,
    328266575,
    765245935
   ],
   "actor": null,
   "text": "Himari is brilliant, strong, and always pushes me to be better.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-696907151": {
   "kind": "text",
   "parent": 656761915,
   "children": [
    -349040813,
    -1298895480
   ],
   "actor": null,
   "text": "Well, someone had to put up with her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-452029971": {
   "kind": "text",
   "parent": 656761915,
   "children": [
    -1350494260,
    -1462521559,
    -176142642
   ],
   "actor": null,
   "text": "She’s a cold beauty, like radiant winter—distant, yet impossible to ignore.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-349040813": {
   "kind": "text",
   "parent": -696907151,
   "actor": "Himari",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Idiot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1784249373": {
   "kind": "text",
   "parent": -1385086590,
   "actor": "HimariDad",
   "expressionName": "neutral",
   "text": "Hmph. A respectable answer.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1298895480": {
   "kind": "text",
   "parent": -696907151,
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Oh dear…",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1633178692": {
   "kind": "text",
   "parent": 656761915,
   "children": [
    162486876,
    517502635,
    -1121268043
   ],
   "actor": null,
   "text": "Because no one else is worthy of her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "497260612": {
   "kind": "text",
   "parent": 656761915,
   "children": [
