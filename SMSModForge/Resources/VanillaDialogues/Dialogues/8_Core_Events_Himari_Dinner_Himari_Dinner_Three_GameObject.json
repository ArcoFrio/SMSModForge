    -220261411,
    877159391
   ],
   "actor": null,
   "text": "It just sort of happened.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "162486876": {
   "kind": "text",
   "parent": -1633178692,
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Ooooh, I like this one!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "517502635": {
   "kind": "text",
   "parent": -1633178692,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "Tch… idiot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1121268043": {
   "kind": "text",
   "parent": -1633178692,
   "actor": "HimariDad",
   "expressionName": "neutral",
   "text": "A bold claim. I hope you’re prepared to prove it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1534330796": {
   "kind": "text",
   "parent": 497260612,
   "actor": "Himari",
   "expression": 2,
   "expressionName": "Angry",
   "text": "…What?",
   "settings": {
    "m_Options": "FromSkin"
   }
