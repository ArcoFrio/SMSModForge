  "-1127923837": {
   "kind": "text",
   "parent": -1,
   "children": [
    -1704793414,
    -1916138561
   ],
   "actor": "Claudia",
   "expression": 1,
   "expressionName": "talk",
   "text": "Peak City’s harbor district just got a little more lively, folks! A brand-new, totally mysterious gang has set up shop, and let me tell you—the economy is thriving in all the wrong ways.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
     "type": "ConditionMathCompareIntegers",
     "title": "If Core_2[news-movie] = 6",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "news-movie",
        "list": "Core_2",
        "type": "number"
       }
      },
      "m_CompareTo": {
       "m_Comparison": "Equals",
       "m_CompareTo": {
