 "nodes": {
  "561159366": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I can’t believe you, {D}! Defunding the orphanage? Those kids have nothing, and you’re taking away the little support they have!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1942589953": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "Emma, it’s just business. The money needs to go where it can do the most good for us. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "676097333": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expression": 3,
   "expressionName": "Sad",
   "text": "A sportscar? You think you can just buy me off like that? This isn’t about me, it’s about doing what’s right! You’re unbelievable, {D}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "715465388": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "Emma, you need to understand—",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1309341856": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "No, you need to understand! ! I’m done talking to you.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active Leave to True",
     "fields": {
