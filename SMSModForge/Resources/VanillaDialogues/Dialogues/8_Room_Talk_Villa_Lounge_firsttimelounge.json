       "of": "GetGameObjectInstance",
       "path": "2_Bust_Manager/Emma_Normal/D1Base/Leave"
      }
     }
    }
   ]
  },
  "1330478642": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "886103437": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expressionName": "neutral",
   "text": "Ah, {PC}. Come to my office. We’ve got things to discuss.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "388599660": {
   "kind": "text",
   "parent": -1,
   "actor": "Mario",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I’ll make it up to you, alright? How about that sportscar you’ve had your eye on?",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
