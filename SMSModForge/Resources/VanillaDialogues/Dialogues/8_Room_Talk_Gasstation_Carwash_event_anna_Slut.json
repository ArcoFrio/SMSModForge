   }
  },
  "1568475335": {
   "kind": "text",
   "parent": -816717688,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh, come on. I might have posted a teaser about it. Maybe even a little clip. But hey, all that extra funding? You’re welcome.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "140850600": {
   "kind": "text",
   "parent": 203892632,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Please, if I charged for every little peek they got, we could build Peak City twice over.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-354532747": {
   "kind": "text",
   "parent": -1206384681,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Can you blame me? I used to be terrified of things like this. Now? I kinda love the attention.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1611601022": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I hope this is actually helping someone. Feels like half these people just showed up to stare...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1046164162": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "You know… back when I started Starmaker, I never thought I’d end up here of all places. Washing cars in broad daylight, cameras flashing, people whispering.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
