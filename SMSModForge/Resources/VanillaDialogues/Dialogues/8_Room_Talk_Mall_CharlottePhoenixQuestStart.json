   }
  },
  "-9769426": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Rich CEO",
   "expressionName": "my-expression",
   "text": "Ohhh, don't be like that. You have the body, the face… the kind of assets you should not waste. Why not put them to use?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1422461351": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Rich CEO",
   "expressionName": "my-expression",
   "text": "Tch. You think you can just swoop in and steal the spotlight? ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
