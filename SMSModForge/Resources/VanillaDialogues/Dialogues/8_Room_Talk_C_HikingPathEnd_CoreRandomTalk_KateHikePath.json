    },
    "m_Options": "FromSkin"
   }
  },
  "-1919450187": {
   "kind": "text",
   "parent": -563981796,
   "actor": null,
   "text": "I think it means you should stop running from your own good ideas.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1455359408": {
   "kind": "text",
   "parent": -563981796,
   "actor": null,
   "text": "Mine’s just gonna say ‘free pizza forever.’ Deep, right?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1451643493": {
   "kind": "text",
   "parent": -563981796,
   "actor": null,
   "text": "It means you’re changing faster than you can keep up.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-299826271": {
   "kind": "text",
   "parent": -563981796,
   "actor": null,
   "text": "Maybe you should stop wasting paper first.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1910677584": {
   "kind": "text",
   "parent": 975002162,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "Heh, maybe. But hey, if one of these actually comes true, I’ll owe you a drink.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1587738478": {
   "kind": "text",
   "parent": 975002162,
   "actor": "Kate",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Now help me light this one before I lose my courage.",
