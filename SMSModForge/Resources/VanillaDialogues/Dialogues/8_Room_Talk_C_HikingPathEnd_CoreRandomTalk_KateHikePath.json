   "actor": "Kate",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I wrote, ‘Stop ghosting myself.’ Still trying to figure out what I meant.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
