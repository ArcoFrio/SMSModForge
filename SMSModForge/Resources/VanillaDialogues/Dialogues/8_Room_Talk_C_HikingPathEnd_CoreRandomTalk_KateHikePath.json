  "-1069248958": {
   "kind": "text",
   "parent": -1657589182,
   "children": [
    1599535676
   ],
   "actor": null,
   "text": "You really believe in that stuff?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1599535676": {
   "kind": "text",
   "parent": -1069248958,
   "actor": "Kate",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Believe? Nah. It’s just something to do when I’m bored and... Nevermind.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1848509161": {
   "kind": "text",
   "parent": -613031588,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "Relax, I used biodegradable stuff this time.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1080668795": {
   "kind": "text",
   "parent": -1267530331,
   "actor": "Kate",
   "expressionName": "neutral",
   "text": "Sweet? Maybe. Or just my excuse to play with fire and call it spiritual.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-563981796": {
   "kind": "choice",
   "parent": 975002162,
   "children": [
