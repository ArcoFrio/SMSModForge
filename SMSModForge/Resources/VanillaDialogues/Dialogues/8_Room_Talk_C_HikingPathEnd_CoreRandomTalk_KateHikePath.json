    "m_Options": "FromSkin"
   }
  },
  "-294890775": {
   "kind": "text",
   "parent": 1733759432,
   "actor": "Kate",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Don’t mind me, just arguing with my reflection again. She’s winning today.",
