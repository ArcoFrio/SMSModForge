  "-779361933": {
   "kind": "text",
   "parent": 1733759432,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Guess I’m becoming part of the scenery up here, huh?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-706703381": {
   "kind": "text",
   "parent": 1733759432,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Don’t mind me, just needed another round of silence.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1845653429": {
   "kind": "text",
   "parent": 1733759432,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Funny how the view never changes, but I still keep coming back.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-176119853": {
   "kind": "text",
   "parent": -1657589182,
   "children": [
    -672244184
   ],
   "actor": null,
   "text": "You okay, {D}? You look tired.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "685340995": {
   "kind": "text",
   "parent": -1657589182,
   "children": [
    -738244491
   ],
   "actor": null,
   "text": "Everyone needs an escape sometimes.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1747375636": {
   "kind": "text",
   "parent": -1657589182,
   "children": [
    735025809
   ],
   "actor": null,
   "text": "You must really hate your life, huh?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-672244184": {
   "kind": "text",
   "parent": -176119853,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Tired’s one word for it. Feels like I’ve been holding up the house on my back for years.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-738244491": {
   "kind": "text",
   "parent": 685340995,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Yeah. Up here, no one’s asking for anything. It’s just quiet, finally.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "735025809": {
   "kind": "text",
   "parent": 1747375636,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I don’t hate anyone. I just… need space. You ever get that feeling? Like you’ll snap if someone asks one more thing of you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "868002012": {
   "kind": "text",
   "parent": 975002162,
   "actor": "Josef",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I used to come here with your {M}, back when life still felt… lighter.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1277852313": {
   "kind": "choice",
   "parent": 975002162,
   "children": [
    -83886562,
    1289603451,
    -1526698448
   ],
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I guess I just wanted to remember that part of it still exists somewhere.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-83886562": {
   "kind": "text",
   "parent": 1277852313,
   "actor": null,
   "text": "You should bring her here again. She’d like that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1289603451": {
   "kind": "text",
   "parent": 1277852313,
   "actor": null,
   "text": "Memories fade when you stop making new ones.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1526698448": {
   "kind": "text",
   "parent": 1277852313,
   "actor": null,
   "text": "Then stop standing here and actually fix it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-556517294": {
   "kind": "text",
   "parent": 975002162,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Maybe you’re right. Maybe I’ve been waiting for peace to come to me instead of chasing it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1514942202": {
   "kind": "text",
   "parent": 975002162,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Thanks for listening, kid… even if I didn’t plan on talking. Let’s head back before it gets dark.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
