  "712863245": {
   "kind": "text",
   "parent": 524004018,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "It’s a hell no! You’d get eaten alive, dude! You wouldn’t last ten minutes before someone tried to scam you, rob you, or sell you a ‘magic’ carburetor that’s actually just a spray-painted rock!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "665912339": {
   "kind": "text",
   "parent": 524004018,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I-I get it... Jeez.",
