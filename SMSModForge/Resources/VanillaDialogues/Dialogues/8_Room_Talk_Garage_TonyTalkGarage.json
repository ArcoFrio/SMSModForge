  },
  "-1731202288": {
   "kind": "text",
   "parent": 1390094480,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "But—you—you used to... watch over me! You were, like… normal! What happened?!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "853841915": {
   "kind": "text",
   "parent": 1390094480,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "What happened? Life. College kicked my ass, the Badlands toughened me up, and now I fix cars for a living. Got a problem with that, kid?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
