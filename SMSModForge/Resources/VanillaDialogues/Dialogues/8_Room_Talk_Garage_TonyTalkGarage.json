  "1211623696": {
   "kind": "text",
   "parent": -1718345395,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "Yeah, well, your son made me a damn good offer. Plus, I get to work in this place? Way better than fixing up rust buckets in the Badlands.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-976809156": {
   "kind": "text",
   "parent": -1718345395,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I have to say, it’s nice seeing a familiar face from the past. I always liked you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "113848798": {
   "kind": "text",
   "parent": -1718345395,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Yeah? Guess I must’ve made a good impression back then.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "310138760": {
   "kind": "text",
   "parent": -1718345395,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "You did a hell of a job raising him, y’know? He’s not half bad.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-707601557": {
   "kind": "text",
   "parent": 524004018,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "Depends. Why? You looking to buy some stolen car parts or get an unregistered bike?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-567636992": {
   "kind": "text",
   "parent": 524004018,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I was thinking… work. Something to keep me busy.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "510672079": {
   "kind": "text",
   "parent": 524004018,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "Oh my god. You—you?! In the Badlands?! Haha... Hahaha.... HAHAHAHA!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1421022217": {
   "kind": "text",
   "parent": 524004018,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I take it that’s a no?",
