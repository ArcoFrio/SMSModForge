 "nodes": {
  "734433396": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Hey there, I... I just wanted to say thank you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1957146430": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I'm not an idiot, you know. I know that {M} and {D} put all their hopes into you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1016085332": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "They... {D} doesn't really care much about what I do. It's always just \"Sure buddy\" or \"That's nice\".",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1704107181": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "And {M}... She looks up to you. I can tell that you're her pillar as {D} struggles with life.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-759497690": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "And yet, you're taking the time to...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-705180887": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Like Alice, you know. You helped me getting close to her. I'm... I'm not sure if she's girlfriend material for me... But she's fun.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Events[threesome-done] = True",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "threesome-done",
        "list": "Events",
        "type": "boolean"
       }
      },
      "m_Comparison": "Equals",
      "m_CompareTo": {
       "kind": "value",
       "value": true
      }
     }
    }
   ]
  },
  "-1307178777": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Samantha is just the coolest. She's like the perfect woman, and I only got to really know her thanks to you.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Events_5[sam-gangbang-done] = True",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "sam-gangbang-done",
        "list": "Events_5",
        "type": "boolean"
       }
      },
      "m_Comparison": "Equals",
      "m_CompareTo": {
       "kind": "value",
       "value": true
      }
     }
    }
   ]
  },
  "912687853": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I know that you're the reason why {M} invited me in... You two could have kept a secret from me, but like...",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Mainstory[M-and-B-activated] = True",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "M-and-B-activated",
        "list": "Mainstory",
        "type": "boolean"
       }
      },
      "m_Comparison": "Equals",
      "m_CompareTo": {
       "kind": "value",
       "value": true
      }
     }
    }
   ]
  },
  "833817733": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -121123343,
    -865674403,
    -244272020
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "I'm just glad you're my {B}. ",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-154570277": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1199388148,
    1530997797,
    1442964086,
    -1989693868
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "You're taller, stronger, smarter... You work hard and you get everything done.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1879438894": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh, and if you want to visit Japan with me just let me know, yeah? Would be cool to have you around.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setBool",
     "type": "InstructionBooleanSetBool",
     "title": "Set Vacation_Save[adrian-vacation-unlocked] = True",
     "fields": {
      "m_Set": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "adrian-vacation-unlocked",
        "list": "Vacation_Save",
        "type": "boolean"
       }
      },
      "m_From": {
       "kind": "value",
       "value": true
      }
     }
    }
   ]
  },
  "-121123343": {
   "kind": "text",
   "parent": 833817733,
   "actor": null,
   "text": "You're my {B}, Adrian. I'll always be there for you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-865674403": {
   "kind": "text",
   "parent": 833817733,
   "actor": null,
   "text": "(Hug him)",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-244272020": {
   "kind": "text",
   "parent": 833817733,
   "actor": null,
   "text": "It's cool, Adrian. Really.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1199388148": {
   "kind": "text",
   "parent": -154570277,
   "actor": null,
   "text": "That's not fair, Adrian. I'm just giving my best. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1530997797": {
   "kind": "text",
   "parent": -154570277,
   "actor": null,
   "text": "It may look easy from the outside, but trust me. It's hard.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1989693868": {
   "kind": "text",
   "parent": -154570277,
   "actor": null,
   "text": "Yeah, I'm quite something.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1442964086": {
   "kind": "text",
   "parent": -154570277,
   "actor": null,
   "text": "Stop it, man. You're smarter than me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
