  "-560813249": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -1410417511,
    -419060296
   ],
   "actor": null,
   "text": "Clay, it’s helping people. Don’t overthink what happens after.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1410417511": {
   "kind": "text",
   "parent": -560813249,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Exactly! Milk is milk. It’s good for everyone.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "509247152": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -826723564,
    -1722838035
   ],
   "actor": null,
   "text": "If you’re uncomfortable, maybe you should walk away.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-826723564": {
   "kind": "text",
   "parent": 509247152,
   "actor": "Clay",
   "expression": 2,
   "expressionName": "Angry",
   "text": "…You’d like that, wouldn’t you? Less dead weight.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1638313128": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -686257041,
    449307625
   ],
   "actor": null,
   "text": "Everything gets used for weird kinks eventually. That’s the internet.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-686257041": {
   "kind": "text",
   "parent": 1638313128,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Haha! See? Even he knows!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1514551683": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    1960093995,
    -252142992
   ],
   "actor": null,
   "text": "If people want to jerk off with it, let them.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1960093995": {
   "kind": "text",
   "parent": -1514551683,
   "actor": "Kirby",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Heehee… you’re so bad.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-252142992": {
   "kind": "text",
   "parent": -1514551683,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Jesus christ...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "449307625": {
   "kind": "text",
   "parent": 1638313128,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "…That doesn’t make it better.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1722838035": {
   "kind": "text",
   "parent": 509247152,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Stop it. He’s just scared of change.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-419060296": {
   "kind": "text",
   "parent": -560813249,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Maybe you’re right. Still feels strange.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-973726907": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "You’ll see, Clay. This is good. It might look weird, but it’s the best thing that’s ever happened to the farm.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "907345884": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expression": 3,
   "expressionName": "Sad",
   "text": "…Maybe. Or maybe we’re opening a door we can’t close.",
   "settings": {
    "m_Options": "FromSkin"
   },
