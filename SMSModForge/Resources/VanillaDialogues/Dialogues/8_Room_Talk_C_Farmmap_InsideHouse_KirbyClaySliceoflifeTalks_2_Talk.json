   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Huh? What do you mean?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "295001038": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Think about it. People out there aren’t just drinking it. Some of them are… using it for their weird kinks. You know they are. And we’re the ones giving it to them.",
   "settings": {
    "m_Options": "FromSkin"
