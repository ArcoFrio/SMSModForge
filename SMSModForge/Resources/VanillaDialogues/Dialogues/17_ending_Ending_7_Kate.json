   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "As I look back on the path that led us here, I realize how far we've come. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-899059071": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Kate, with her boundless energy and quirky charm, brought a light into my life that I never knew I needed.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
