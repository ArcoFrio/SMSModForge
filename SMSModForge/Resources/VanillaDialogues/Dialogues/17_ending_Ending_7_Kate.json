  "88952544": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "We've faced challenges, learned from each other, and grown together. Starting a family with Kate feels like the most natural and fulfilling chapter of my life. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "449206811": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "From our chance encounters and awkward beginnings to the deep bond we now share, every moment has shaped our story.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1146291439": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Our home is filled with love, laughter, and a sense of belonging that I’ve always dreamed of.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "553319576": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Her grandparents, who once worried about her future, now see her surrounded by happiness and stability. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "259088967": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "And as for us, we’ve created a life where dreams are nurtured and every day is an adventure.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
