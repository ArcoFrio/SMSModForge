  "-686333575": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Thanks, but I can't accept that. Also, our Starmaker site is already generating some revenue.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1101654601": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Our? So Josef is helping you? Is he shooting the photos?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2083810105": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -861728587,
    1596859416
   ],
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "That's so naughty! You have to show me your profile later!",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
