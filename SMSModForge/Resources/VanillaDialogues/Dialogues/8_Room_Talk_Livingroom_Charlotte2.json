      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-861728587": {
   "kind": "text",
   "parent": 2083810105,
   "actor": null,
   "text": "Hello there.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1596859416": {
   "kind": "text",
   "parent": 2083810105,
   "children": [
    -1334572471
   ],
   "actor": null,
   "text": "What's Starmaker?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-879333027": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1511618464,
    -1195960412,
    -515137896
   ],
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Oh, {PC}... Tell us, what do you think of Starmaker? ",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1511618464": {
   "kind": "text",
   "parent": -879333027,
   "children": [
    1300329308
   ],
   "actor": null,
   "text": "It's always great when people can do what they love.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1195960412": {
   "kind": "text",
   "parent": -879333027,
   "children": [
    -1984146815
   ],
   "actor": null,
   "text": "Charlotte, are you thinking about setting up a page there?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-515137896": {
   "kind": "text",
   "parent": -879333027,
   "children": [
    1297170985,
    1289601875
   ],
   "actor": null,
   "text": "There are only sluts on Starmaker.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1289601875": {
   "kind": "text",
   "parent": -515137896,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1984146815": {
   "kind": "text",
   "parent": -1195960412,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Oh, no, no... My reputation as a Yacht saleswoman is way too valuable.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1300329308": {
   "kind": "text",
   "parent": -1511618464,
   "actor": "Charlotte",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Mhm... People should always do what they love...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1297170985": {
   "kind": "text",
   "parent": -515137896,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Only sluts, huh? ... Hehe...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1387877558": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Well... If you need help with your new \"project\", Anna... Give me a call...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-53029549": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I-I'm fine...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "711187473": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Sure. See you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1748325445": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Starmaker!? Oh my, Anna... I told you... you can ask me for money if you need it. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-457567846": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "U-Um... Y-Yes...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1334572471": {
   "kind": "text",
   "parent": 1596859416,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh, {PC}... It's, uh.. I don't know! Charlotte was just explaining it to me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
