 "nodes": {
  "660064052": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "After months of hard work and perseverance, I finally paid off all of {D}’s debts",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-37509162": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "It wasn’t easy, but seeing the look of relief on his face made it all worth it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "251251719": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "I’m proud of what my {M} and I  accomplished together. We faced our challenges head-on and came out stronger on the other side. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1048829745": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Sometimes she still wants to stroke me for old time's sake, but eventually normality settles in.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active Endingshot (1) to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "Endingshot (1)",
       "of": "GetGameObjectInstance",
       "path": "5_CG_EndingArt/Endingshot (1)"
