    }
   ]
  },
  "696944652": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "We were able to maintain our lifestyle and sooner or later my {D} was able to recover.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1470947042": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "But in the end we faced a highly unusual situation but made it out together.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1780794600": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "And that’s the greatest success of all.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
