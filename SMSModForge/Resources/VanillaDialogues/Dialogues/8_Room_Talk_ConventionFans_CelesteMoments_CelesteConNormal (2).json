  "1707282865": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh, this should be good.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "446611443": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expressionName": "neutral",
   "text": "You have a striking presence. But presence alone is not enough. True models don’t just exist in front of a lens—they command it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-292285133": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "So what, you think I’m just winging it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-302420845": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expressionName": "neutral",
   "text": "Aren’t you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1756881340": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Just a thought. If you ever wish to elevate yourself beyond simply being seen... learn to be remembered.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "717026669": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You need more than confidence. You need control.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
