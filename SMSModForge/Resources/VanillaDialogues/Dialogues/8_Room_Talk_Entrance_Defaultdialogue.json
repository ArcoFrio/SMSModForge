  "1408310326": {
   "kind": "text",
   "parent": -1676717553,
   "children": [
    821000622
   ],
   "actor": null,
   "text": "Things will get better, I'm sure of it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-605851050": {
   "kind": "text",
   "parent": -1676717553,
   "children": [
    -114496695
   ],
   "actor": null,
   "text": "Maybe you two are just growing apart?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-114496695": {
   "kind": "text",
   "parent": -605851050,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Don't... Don't say that. I love your {M}. maybe I must tell her more often...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "821000622": {
   "kind": "text",
   "parent": 1408310326,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I hope so.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1796106967": {
   "kind": "text",
   "parent": -679349332,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Heh. Sorry, pal.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1785816770": {
   "kind": "text",
   "parent": 1489261888,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Well, halfway through our vacation, a deal I was counting on back home fell through. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "693392316": {
   "kind": "text",
   "parent": 1489261888,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Suddenly, we were short on cash, and I didn’t want to cut the trip short or worry you and your {M}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-271526156": {
   "kind": "text",
   "parent": 1489261888,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I ended up selling my watch and my laptop. It wasn’t easy, but it was enough to cover the remainder of our trip. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1270816554": {
   "kind": "text",
   "parent": 1489261888,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I wanted to make sure we could enjoy the rest of our time there without any worries.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1753750561": {
   "kind": "text",
   "parent": 1489261888,
   "actor": "Josef",
   "expression": 3,
   "expressionName": "Sad",
   "text": "We've struggled before. But this time it's different. I feel like I'm losing everything...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1584260059": {
   "kind": "text",
   "parent": 963945231,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Ah, nice. It's even my favorite brand.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "28088277": {
   "kind": "text",
   "parent": -1921546724,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Thanks, {PC}. But one is more than enough for today.",
