      }
     }
    }
   ]
  },
  "-1891041400": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "NOTHING LIKE A FUN, FAMILY-FRIENDLY CHARITY CAR WASH!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "282120717": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": " RAISING MONEY FOR A GOOD CAUSE, WHILE ALSO GETTING A LITTLE WET AND WILD—DON’T THINK ABOUT THAT TOO MUCH!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-694605726": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "...Okay. That may have been overkill.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
    {
     "type": "InstructionParticleSystemStopParticleSystem",
     "title": "Stop gasstation bubbles Particle System",
