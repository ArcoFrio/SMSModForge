  "-1506482489": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "WOW! LOOK AT THIS AMAZING CAR! LOOK AT THESE SUDS! LOOK AT THIS INCREDIBLE COMMUNITY COMING TOGETHER FOR CHARITY!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1954928736": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "AND YOU KNOW WHAT MAKES A CAR WASH EVEN BETTER? A LITTLE WATER ACTION!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1489584": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "WOW! SO MUCH DIRT! GOOD THING I’M HERE TO CLEAN IT WITH THIS SUPER EFFECTIVE SPONGE!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2141715566": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "...There. That should boost donations by at least twenty percent.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-522799361": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "NOW, EVERY GREAT CAR WASH NEEDS A BIG FINALE!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-674433488": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Circular motions prevent streaks… Hood first, windshield next… Can’t risk water drying unevenly...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1240567371": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Alright... Time for the show, huh?",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
