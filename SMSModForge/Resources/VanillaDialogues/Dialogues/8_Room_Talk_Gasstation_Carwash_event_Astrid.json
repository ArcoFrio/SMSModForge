   "parent": -1,
   "actor": "Astrid",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Because apparently, that’s what’s necessary to keep this event running. Washing a car. In a bikini",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
