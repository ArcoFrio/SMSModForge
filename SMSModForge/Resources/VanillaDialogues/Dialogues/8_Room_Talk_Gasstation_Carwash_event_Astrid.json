     }
    }
   ]
  },
  "365146111": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Well. At least the car is clean now. And nobody can say I didn’t commit.",
   "settings": {
    "m_Options": "FromSkin"
   },
