  "-1083755656": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Car washes are inefficient. Sponges retain bacteria. The soap runoff is an environmental hazard. And people are donating for the wrong reasons.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active ImgCarwashAstrid (1) to True",
     "fields": {
