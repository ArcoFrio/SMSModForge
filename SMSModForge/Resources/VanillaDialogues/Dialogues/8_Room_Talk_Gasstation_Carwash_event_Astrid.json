      },
      "m_GameObject": {
       "kind": "object",
       "name": "ImgCarwashAstrid (1)",
       "of": "GetGameObjectInstance",
       "path": "4_CG_Manager-Sexy_Three/ImgCarwashAstrid (1)"
      }
     }
    }
   ]
  },
  "-173816781": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "BUT HEY, WHAT A GREAT EVENT, HUH?!",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active ImgCarwashAstrid (2) to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "ImgCarwashAstrid (2)",
