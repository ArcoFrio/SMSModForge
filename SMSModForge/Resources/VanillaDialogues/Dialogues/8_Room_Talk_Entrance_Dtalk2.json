  "-1322263769": {
   "kind": "text",
   "parent": 1965100072,
   "children": [
    -1929163042
   ],
   "actor": null,
   "text": "Yeah, but she's a good bit older than me...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-651451739": {
   "kind": "text",
   "parent": 1965100072,
   "children": [
    164667574
   ],
   "actor": null,
   "text": "There's this girl from work. Amelia.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1925052782": {
   "kind": "text",
   "parent": 1965100072,
   "children": [
    -729778891
   ],
   "actor": null,
   "text": "Not right now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-729778891": {
   "kind": "text",
   "parent": 1925052782,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Heh, you're young and in your best years. You have all the time in the world right now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "164667574": {
   "kind": "text",
   "parent": -651451739,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "You should tell her how you feel like. You never know when it's too late.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1929163042": {
   "kind": "text",
   "parent": -1322263769,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Don't let that stop you. Your {M} is in her fourties but she's still quite the beauty.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "971808862": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -588743870,
    -1172336221,
    1879470330
   ],
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I remember when I was your age. I was a bit of a player, you know.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
