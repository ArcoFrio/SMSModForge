    "m_Options": "FromSkin"
   }
  },
  "-2143075526": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "You can't hit the shots you don't take, {S}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-588743870": {
   "kind": "text",
   "parent": 971808862,
   "children": [
    1932475469,
    274213433
   ],
   "actor": null,
   "text": "Why did you settle for {M}  in the end?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1172336221": {
   "kind": "text",
   "parent": 971808862,
   "children": [
    1674018630,
    1784728103
   ],
   "actor": null,
   "text": "Tell me about your best fuck.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1879470330": {
   "kind": "text",
   "parent": 971808862,
   "children": [
    -187219471
   ],
   "actor": null,
   "text": "I really don't want to know, {D}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1932475469": {
   "kind": "text",
   "parent": -588743870,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Just look at her. She's flawless. Even if things have been a little... quiet in the bedroom lately.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1674018630": {
   "kind": "text",
   "parent": -1172336221,
   "children": [
    -1244938743
   ],
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "My best? Heh... I'm not giving you the play-by-play, but there was this girl. Isabella.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-187219471": {
   "kind": "text",
   "parent": 1879470330,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I know, I know... Just remember.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "274213433": {
   "kind": "text",
   "parent": -588743870,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Ah, damn, I shouldn't be saying that around you, huh? Heh, forget I said anything.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1244938743": {
   "kind": "text",
   "parent": 1674018630,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Total firecracker. Hot as hell, but way too much drama. Didn't last long.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1784728103": {
   "kind": "text",
   "parent": -1172336221,
   "children": [
    -1502425199
   ],
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You’ve actually met her. Isabella. So yeah, you probably get it now. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1502425199": {
   "kind": "text",
   "parent": 1784728103,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "She’s insane... but her holes? Absolutely addicted to attention.",
