  "-1434914489": {
   "kind": "text",
   "parent": 775139897,
   "children": [
    1080038915
   ],
   "actor": null,
   "text": "It already is, thanks to you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "831538625": {
   "kind": "text",
   "parent": 1828922304,
   "children": [
    -46784790
   ],
   "actor": null,
   "text": "If it’s from you, I already know I’ll love it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1245216900": {
   "kind": "text",
   "parent": 1828922304,
   "children": [
    1282046708
   ],
   "actor": null,
   "text": "Wardrobe rendezvous? Sounds a little suspicious.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "966698414": {
   "kind": "text",
   "parent": 1828922304,
   "children": [
    1121935515
   ],
   "actor": null,
   "text": "Alright. What are you up to this time?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1544235693": {
   "kind": "text",
   "parent": 775139897,
   "children": [
    854425368
   ],
   "actor": null,
   "text": "Thanks. Really. I needed this today.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1338779930": {
   "kind": "text",
   "parent": 775139897,
   "children": [
    297507634
   ],
   "actor": null,
   "text": "You didn’t have to go through the trouble...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "297507634": {
   "kind": "text",
   "parent": 1338779930,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You’re worth every bit of it. Always have been.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "854425368": {
   "kind": "text",
   "parent": -1544235693,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Then I’m glad I did it. You deserve more days like this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1080038915": {
   "kind": "text",
   "parent": -1434914489,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "That’s all I wanted to hear. Just relax today, okay?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1121935515": {
   "kind": "text",
   "parent": 966698414,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You’ll see soon enough. I just hope it makes you... smile.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1282046708": {
   "kind": "text",
   "parent": 1245216900,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Maybe it is. Maybe I’m feeling a little bold today. You’ll just have to come and find out.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-46784790": {
   "kind": "text",
   "parent": 831538625,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You always know what to say, don’t you? Just... don’t keep me waiting too long, alright?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
