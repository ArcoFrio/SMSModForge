   "parent": -284190311,
   "children": [
    -1062101439,
    1242555134
   ],
   "actor": null,
   "text": "You two heading out? Hope it goes well.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1358242688": {
   "kind": "text",
   "parent": -284190311,
   "children": [
    -1588377806,
    -1130034971
   ],
   "actor": null,
   "text": "Valentine’s dinner? Thought you guys weren’t doing that this year.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "539419542": {
   "kind": "text",
   "parent": -284190311,
   "children": [
    744000623,
    909667145
   ],
   "actor": null,
   "text": "Well, look at you two. Hot date?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1062101439": {
   "kind": "text",
   "parent": -1878476000,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Yeah, thanks. It’s been... a rough week.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "744000623": {
   "kind": "text",
   "parent": 539419542,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Depends how much wine they serve.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1588377806": {
   "kind": "text",
   "parent": -1358242688,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Plans change.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "909667145": {
   "kind": "text",
   "parent": 539419542,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Stop...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1130034971": {
   "kind": "text",
   "parent": -1358242688,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "We almost didn’t... but here we are.",
