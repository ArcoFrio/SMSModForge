  "-699695079": {
   "kind": "text",
   "parent": -1027398386,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Yes, just let me grab my coat...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "950572303": {
   "kind": "text",
   "parent": -1027398386,
   "actor": "Josef",
   "expression": 3,
   "expressionName": "Sad",
   "text": "You sure you're up for this? We could stay in.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "699511451": {
   "kind": "text",
   "parent": -1027398386,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "No, I want to. We need this. Even if it feels...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2144644466": {
   "kind": "text",
   "parent": -1027398386,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Ah. Look who’s lurking in the hallway.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
