    "m_Options": "FromSkin"
   }
  },
  "1242555134": {
   "kind": "text",
   "parent": -1878476000,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "We’ll try to enjoy it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1181011401": {
   "kind": "text",
   "parent": -1027398386,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "We shouldn’t be too late. Don’t wait up, okay?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "322982545": {
   "kind": "text",
   "parent": -1027398386,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "And maybe try not to burn the place down while we’re gone.",
