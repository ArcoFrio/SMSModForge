   }
  },
  "1582443607": {
   "kind": "text",
   "parent": -997774146,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "There should be a room reserved on my name, here are the details.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1808009704": {
   "kind": "text",
   "parent": -997774146,
   "actor": "S_Carina",
   "expressionName": "neutral",
   "text": "Ah, yes, Mrs. Anna. I'd need both of your IDs.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1651304162": {
   "kind": "text",
   "parent": -997774146,
   "actor": "S_Carina",
   "expressionName": "neutral",
   "text": "Oh, that's your {S}. Looks like there's been a mix-up. The room only has a single double bed.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1295503299": {
   "kind": "text",
   "parent": -997774146,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "That's not a mistake. We would like that room.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-973984504": {
   "kind": "text",
   "parent": -997774146,
   "actor": "S_Carina",
   "expressionName": "neutral",
   "text": "O-Oh... Umm... S-Sure...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "80952440": {
   "kind": "text",
   "parent": -997774146,
   "actor": "S_Carina",
   "expressionName": "neutral",
   "text": "Here are the keys, please enjoy your stay!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1350516995": {
   "kind": "text",
   "parent": -997774146,
   "actor": "S_Carina",
   "expressionName": "neutral",
   "text": "Oh, and one more thing! You'll have the stage at 9 pm for twenty minutes to promote your Starmaker page. Good luck!",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
