  "106246622": {
   "kind": "text",
   "parent": 71511627,
   "actor": null,
   "text": "Absolutely! What are we starting with?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1940365825": {
   "kind": "text",
   "parent": 71511627,
   "actor": null,
   "text": "I guess...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1741118987": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Today, we’re going to focus on portrait photography. And, as a special treat, Haniya has agreed to be our model.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active Haniya_dress to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "Haniya_dress",
       "of": "GetGameObjectInstance",
       "path": "2_Bust_Manager/Haniya_dress"
      }
     }
    }
   ]
  },
  "1942586729": {
   "kind": "choice",
   "parent": -1,
   "children": [
    970881719,
    1187707306,
    -130524267
   ],
   "actor": "Haniya",
   "expressionName": "neutral",
   "text": "It’s my pleasure. I thought it would be fun to help out. Plus, it gives me a chance to wear this dress.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
