  "-1843469377": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "That’s looking good. Now, remember to adjust your camera settings. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "173333501": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Use a wide aperture to create a shallow depth of field, which will keep Haniya in sharp focus while blurring the background.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-769833333": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Always communicate with your model. Haniya, try turning around so {PC} can get a good shot of your ass.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
