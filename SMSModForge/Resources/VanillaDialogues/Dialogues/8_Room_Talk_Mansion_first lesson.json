    },
    "m_Options": "FromSkin"
   }
  },
  "970881719": {
   "kind": "text",
   "parent": 1942586729,
   "children": [
    1095886056
   ],
   "actor": null,
   "text": "You look incredible, Haniya.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1187707306": {
   "kind": "text",
   "parent": 1942586729,
   "children": [
    -93968567
   ],
   "actor": null,
   "text": "Wouldn't a professional model be the better choice?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-93968567": {
   "kind": "text",
   "parent": 1187707306,
   "actor": "Haniya",
   "expressionName": "neutral",
   "text": "Oh, don't worry your little head. I have more than enough experience in this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1095886056": {
   "kind": "text",
   "parent": 970881719,
   "actor": "Haniya",
   "expressionName": "neutral",
   "text": "Thanks...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "324660085": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Great. First, let’s talk about lighting. For portraits, it’s essential to get the lighting just right. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2049178501": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "We’ll use a softbox to create a soft, even light on Haniya’s face",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1110173829": {
   "kind": "text",
   "parent": -1,
   "actor": "Continue",
   "expressionName": "neutral",
   "text": "",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active gabrielshoot1 to True",
     "fields": {
      "m_Active": {
       "kind": "value",
