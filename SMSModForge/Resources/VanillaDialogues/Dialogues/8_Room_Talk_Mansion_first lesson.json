  "929728447": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Next, we need to consider composition. A good portrait draws the viewer’s attention to the subject’s eyes. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2002239528": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Try positioning Haniya slightly off-center to create a more dynamic shot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "827437500": {
   "kind": "text",
   "parent": -1,
   "actor": "Continue",
