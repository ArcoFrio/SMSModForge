   ],
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "{PC}!? {PC}!?? Good news? Pleaseeeee... ",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
