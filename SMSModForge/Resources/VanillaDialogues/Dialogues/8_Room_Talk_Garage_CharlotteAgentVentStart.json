  },
  "-680925906": {
   "kind": "text",
   "parent": 1435741997,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Oh, for— Can you focus for one second? This isn’t a date, it’s a mission!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-263469357": {
   "kind": "text",
   "parent": -375942425,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Unlike you, apparently.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "294292991": {
   "kind": "text",
   "parent": 240820257,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "This is about reminding Anna of who she really is.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1103295353": {
   "kind": "text",
   "parent": 1435741997,
   "actor": "Charlotte",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Though… I do look good, don’t I?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1343433158": {
   "kind": "choice",
   "parent": -1,
   "children": [
    997460367,
    -466231978
   ],
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Our objective? Cheeseburger.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
