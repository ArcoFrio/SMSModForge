   "children": [
    -1185077275,
    -263469357
   ],
   "actor": null,
   "text": "Uh… what the hell are you wearing?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1185077275": {
   "kind": "text",
   "parent": -375942425,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "This is a tactical infiltration outfit. We’re about to execute a high-risk mission, and I came prepared.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "240820257": {
   "kind": "text",
   "parent": -2108645743,
   "children": [
    1564685304,
    294292991
   ],
   "actor": null,
   "text": "Alright, what’s the plan?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1564685304": {
   "kind": "text",
   "parent": 240820257,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Good, you’re in the right mindset. We need precision, stealth, and zero distractions.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1435741997": {
   "kind": "text",
   "parent": -2108645743,
   "children": [
    -680925906,
    1103295353
   ],
   "actor": null,
   "text": "(Lewd) Damn, you should have told me that you're into BDSM.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
     "type": "ConditionMathCompareIntegers",
     "title": "If Traits[newtrait-Lewd] ≥ 3",
     "fields": {
      "m_Value": {
