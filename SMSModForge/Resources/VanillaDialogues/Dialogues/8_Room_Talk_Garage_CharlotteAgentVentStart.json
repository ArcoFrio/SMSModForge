   }
  },
  "997460367": {
   "kind": "text",
   "parent": -1343433158,
   "children": [
    768062528,
    -1161499286
   ],
   "actor": null,
   "text": "…What?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "768062528": {
   "kind": "text",
   "parent": 997460367,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Not an actual cheeseburger, you idiot. Cheeseburger—Anna’s old stuffed bear.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-466231978": {
   "kind": "text",
   "parent": -1343433158,
   "children": [
    1227678561,
    604342514
   ],
   "actor": null,
   "text": "Okay, what’s that?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1227678561": {
   "kind": "text",
   "parent": -466231978,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "A stuffed bear. Anna had it all through college. She cuddled it whenever she got bullied or stressed out.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1161499286": {
   "kind": "text",
   "parent": 997460367,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Back in college, whenever she was having a rough time, that thing never left her side.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "604342514": {
   "kind": "text",
   "parent": -466231978,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "It reminded her of who she really was—what really mattered. And I’m betting it still can.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1676196682": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "We sneak into her bedroom, find Cheeseburger, and leave it somewhere she can’t ignore.",
   "settings": {
    "m_Options": "FromSkin"
   },
