  "1396185522": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Alright, alright, stop buttering him up. He’s already got an ego from me gassing him up earlier.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1224924491": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expression": 1,
   "expressionName": "Happy",
   "text": "But seriously, thanks again. I owe you big time.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1746843108": {
   "kind": "text",
   "parent": -1,
   "actor": "Jasper",
   "expressionName": "neutral",
   "text": "You better not owe him too much.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1210832921": {
   "kind": "text",
   "parent": -1,
