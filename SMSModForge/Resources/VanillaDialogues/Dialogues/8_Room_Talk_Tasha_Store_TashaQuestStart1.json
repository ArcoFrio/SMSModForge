    "m_Options": "FromSkin"
   }
  },
  "-612258930": {
   "kind": "text",
   "parent": -2036811334,
   "children": [
    1010593586
   ],
   "actor": null,
   "text": "I'm glad I was able to help.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1010593586": {
   "kind": "text",
   "parent": -612258930,
   "actor": "Jasper",
   "expressionName": "neutral",
   "text": "Glad to be helped. I'm Tasha's boyfriend by the way. Name's Jasper, nice to meet you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-750356716": {
