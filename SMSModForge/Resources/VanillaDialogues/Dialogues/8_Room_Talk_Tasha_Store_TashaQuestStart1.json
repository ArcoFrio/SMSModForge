   }
  },
  "-392345871": {
   "kind": "text",
   "parent": -1,
   "actor": "Jasper",
   "expressionName": "neutral",
   "text": "So, this is the guy who made you look like a rockstar in that ad?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1680292314": {
   "kind": "text",
   "parent": -1,
   "actor": "Jasper",
   "expressionName": "neutral",
   "text": "Nice work. I’ve been hearing her brag about it all week.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1690522583": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Brag? Please. It’s not bragging if it’s true.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1666030493": {
   "kind": "text",
   "parent": -1,
   "actor": "Jasper",
   "expressionName": "neutral",
   "text": "Fair enough.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
