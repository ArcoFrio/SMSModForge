  "383798984": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "By the way, those photos you took? Total game-changer. I’ve already got a bunch of new customers coming in. Some of them even mentioned the ad.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-372773586": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Guess that means you’ve got a bit of magic in you, huh? Makes me wonder what else you’re good at...",
   "settings": {
    "m_Options": "FromSkin"
   },
