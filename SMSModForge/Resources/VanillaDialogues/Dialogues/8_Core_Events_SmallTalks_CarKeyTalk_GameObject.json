    "m_Options": "FromSkin"
   }
  },
  "1470297262": {
   "kind": "text",
   "parent": 1267984952,
   "actor": "Josef",
   "expression": 3,
   "expressionName": "Sad",
   "text": "No, I insist. You're working hard, and I'm still job hunting. You can make better use of the car than I can right now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1725991086": {
