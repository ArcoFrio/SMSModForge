   "parent": 1596706586,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Well, this is your chance.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1216034661": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Enjoy yourself, and if you happen to go by the mall, could you pick up some groceries on your way back?",
