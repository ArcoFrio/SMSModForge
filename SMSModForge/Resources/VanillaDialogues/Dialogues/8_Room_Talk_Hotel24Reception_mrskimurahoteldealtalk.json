    "m_Options": "FromSkin"
   }
  },
  "2091954520": {
   "kind": "text",
   "parent": 945419072,
   "children": [
    1735696777
   ],
   "actor": null,
   "text": "Because I’m not selling you milk. I’m selling you exclusivity.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1735696777": {
   "kind": "text",
   "parent": 2091954520,
   "actor": "HimariMom",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "…Ah. Now that… that is the answer I was waiting for. You’re not just bold. You’re dangerous. Exactly the sort of man I enjoy dealing with.",
   "settings": {
    "m_Options": "FromSkin"
   }
