  "660064052": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Standing here at the apex of my achievements, I can hardly believe the journey that has brought me to this moment. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-899059071": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Today, I ascend to become the God of Wealth. A higher being, embodying the principles of abundance, prosperity, and growth. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "88952544": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "No longer bound by the limitations of human existence, I will be a beacon of hope for those who seek to rise above their circumstances.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "449206811": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "From humble beginnings, I amassed wealth beyond imagination, mastering the art of fortune and influence.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1146291439": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "My legacy will be etched in the annals of history, not just as a man who amassed wealth, but as a deity who understood its true purpose and power.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "553319576": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "For I have ascended.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
