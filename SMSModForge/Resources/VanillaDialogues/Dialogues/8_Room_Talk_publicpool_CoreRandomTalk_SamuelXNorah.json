  "479959932": {
   "kind": "text",
   "parent": 702077308,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "O-oh! No, don’t be silly. We’re just... Vibing? That's how Alice would call it, right? It’s not like… that.",
