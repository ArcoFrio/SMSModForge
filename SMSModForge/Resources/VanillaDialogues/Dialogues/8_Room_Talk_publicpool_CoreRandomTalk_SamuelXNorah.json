    "m_Options": "FromSkin"
   }
  },
  "-1698159060": {
   "kind": "text",
   "parent": -1798299928,
   "actor": "Norah",
   "expressionName": "neutral",
   "text": "I suppose it is. But we just ended up next to each other. It’s a small pool.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1116558689": {
   "kind": "text",
   "parent": -1337116424,
   "children": [
