  "714191161": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Oh! I can carry three hay bales at once. Four if I don’t mind falling over after.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "263767968": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Clay says I’m naive, but I don’t even know what that means. Is it a kind of pie?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1973321582": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "I forget stuff a lot, but it’s fine because I usually remember something else! It’s like a surprise party in my brain.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-883958584": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "I once tried to measure how many fingers I could fit… got distracted and lost count.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-130452270": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "I don’t really get the point of underwear. It just gets in the way when people want to touch you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
