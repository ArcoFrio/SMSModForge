   "kind": "text",
   "parent": -911625792,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "…Impossible. For centuries I hunted her, prayed for her death… and you… you chained her with words.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "312728549": {
   "kind": "text",
   "parent": -911625792,
   "actor": "Master Zhen",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I don’t know whether to strangle you or fall to my knees in gratitude.",
