  "1268916009": {
   "kind": "text",
   "parent": -617916454,
   "actor": null,
   "text": "It's not your fault, no one can prepare for that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1249253209": {
   "kind": "text",
   "parent": -617916454,
   "actor": null,
   "text": "Well, you are lucky that I was stronger.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1554324129": {
   "kind": "text",
   "parent": -617916454,
   "actor": null,
   "text": "(Say nothing)",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1413124489": {
   "kind": "text",
   "parent": -1893188789,
   "children": [
    -1919045805,
    1741944918
   ],
   "actor": null,
   "text": "I only did what you trained me to do.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2092040869": {
   "kind": "text",
   "parent": -1893188789,
   "children": [
    -726881739,
    1186316436
   ],
   "actor": null,
   "text": "You don’t have to carry this guilt alone, Master.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "634456544": {
   "kind": "text",
   "parent": -1893188789,
   "children": [
    118873125,
    2121351404
   ],
   "actor": null,
   "text": "I told you I’d be strong enough to face her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1919045805": {
   "kind": "text",
   "parent": 1413124489,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Hmph. It’s not easy to see through a demon’s deceit. But you did it. That shows strength of mind and spirit. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-726881739": {
   "kind": "text",
   "parent": 2092040869,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Hmph. I appreciate that… but it’s not that simple. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "118873125": {
   "kind": "text",
   "parent": 634456544,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Heh, so you did. I thought it was just bravado, but… you’ve proven me wrong.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2121351404": {
   "kind": "text",
   "parent": 634456544,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "You’re stronger than I ever was at your age. And smarter, too. Maybe there’s hope for this world after all.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1186316436": {
   "kind": "text",
   "parent": 2092040869,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "But… knowing that someone understands, someone stood where I once stood and made the right choice… it makes the weight a little easier to bear.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1741944918": {
   "kind": "text",
   "parent": 1413124489,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "You’ve exceeded my expectations.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1951946913": {
   "kind": "text",
   "parent": 58281359,
   "actor": "Master Zhen",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I’ve spent so long guarding this place, driven only by anger and regret… but maybe it’s time for something else.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-922077086": {
   "kind": "text",
   "parent": 58281359,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I think I’ll stay. Not as a warrior, but as a caretaker. I want to turn this temple into a place of peace, where others can come to rest and find some solace.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "513613388": {
   "kind": "choice",
   "parent": 58281359,
   "children": [
    283794603,
    -280382715,
    -1062397321
   ],
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": " I’ve already started planning a garden.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
