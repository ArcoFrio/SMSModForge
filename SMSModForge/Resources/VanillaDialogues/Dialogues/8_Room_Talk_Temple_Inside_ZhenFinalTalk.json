   }
  },
  "1439652403": {
   "kind": "text",
   "parent": 58281359,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Thank you… for helping an old man find peace again.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "283794603": {
   "kind": "text",
   "parent": 513613388,
   "children": [
    -1368065852
   ],
   "actor": null,
   "text": "That sounds fantastic.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-280382715": {
   "kind": "text",
   "parent": 513613388,
   "children": [
    53388998
   ],
   "actor": null,
   "text": "A gardener? A man of your talents?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1062397321": {
   "kind": "text",
   "parent": 513613388,
   "children": [
    -93169298
   ],
   "actor": null,
   "text": "Where's my reward?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-93169298": {
   "kind": "text",
   "parent": -1062397321,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Of course. You may keep my blade, may it serve you well.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "53388998": {
   "kind": "text",
   "parent": -280382715,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "My talents are no longer needed. The spirits have calmed down.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1368065852": {
   "kind": "text",
   "parent": 283794603,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Yes. A bit of peace. If I deserve it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
