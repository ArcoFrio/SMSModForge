  "67048734": {
   "kind": "text",
   "parent": -911625792,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Both worlds are safe. For the first time in a thousand years… the curse is broken. You have done what I could not.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "288176303": {
   "kind": "text",
   "parent": -911625792,
   "actor": "Master Zhen",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I’ve spent so long guarding this place, driven only by anger and regret… but maybe it’s time for something else.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2064914766": {
   "kind": "text",
   "parent": -911625792,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I think I’ll stay. Not as a warrior, but as a caretaker. I want to turn this temple into a place of peace, where others can come to rest and find some solace.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "450778395": {
   "kind": "text",
   "parent": -911625792,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": " I’ve already started planning a garden.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-190705340": {
   "kind": "text",
   "parent": -911625792,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Thank you… for helping an old man find peace again.",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1762951874": {
