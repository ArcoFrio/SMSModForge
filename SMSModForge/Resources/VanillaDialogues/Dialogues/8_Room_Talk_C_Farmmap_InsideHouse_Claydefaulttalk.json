    "m_Options": "FromSkin"
   }
  },
  "538344663": {
   "kind": "text",
   "parent": 464744457,
   "children": [
    966168729,
    1013165443
   ],
   "actor": null,
   "text": "Tell me something about yourself.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1094871650": {
   "kind": "text",
   "parent": 660694740,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Banning animal milk… ridiculous. But hey, people will swallow anything if the right suit tells them to.",
   "jump": {
    "mode": "Jump",
    "to": "claytree"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "966168729": {
   "kind": "random",
   "parent": 538344663,
