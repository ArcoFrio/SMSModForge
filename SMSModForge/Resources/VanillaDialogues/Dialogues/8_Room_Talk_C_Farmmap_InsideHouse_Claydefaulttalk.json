   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Seriously?",
   "settings": {
    "m_AllowRepeat": true,
    "m_Options": "FromSkin"
   }
  },
  "1013165443": {
   "kind": "text",
   "parent": 538344663,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Happy now?",
   "jump": {
    "mode": "Jump",
    "to": "claytree"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "714191161": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "I used to dream about leaving this place. Then I realized dreams are just lies you tell yourself to keep moving.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "263767968": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "I can drink a bottle of whiskey in one night. Doesn’t fix anything, but it makes the silence louder.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1973321582": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Kirby says I’m too negative. I say she’s too positive. Guess that makes us balanced.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-883958584": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "I tried praying once. Didn’t hear anything back. Figures.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-130452270": {
   "kind": "text",
   "parent": 966168729,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "My favorite hobby? Watching fences rot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1875200176": {
   "kind": "text",
   "parent": -976363870,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "It’s… not dead anymore. Kirby’s running around, you’re helping. ",
