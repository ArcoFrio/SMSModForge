  "1581845216": {
   "kind": "text",
   "parent": -220693664,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "…Oh. It’s you. Thought I heard footsteps.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-560583500": {
   "kind": "text",
   "parent": -220693664,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Back again? Guess you didn’t get lost on the way.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1948874276": {
   "kind": "text",
   "parent": -220693664,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Don’t expect me to smile. This is the best I can do.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1706084251": {
   "kind": "text",
   "parent": -397466810,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Later. Or never. Either works.",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1746938625": {
   "kind": "text",
   "parent": -397466810,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Try not to die out there. One funeral’s enough paperwork.",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-997935392": {
   "kind": "text",
   "parent": -397466810,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Go bother Kirby, she lives for company.",
