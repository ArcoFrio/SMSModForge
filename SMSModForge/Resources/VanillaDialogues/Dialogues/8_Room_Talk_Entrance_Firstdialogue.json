  "1731804760": {
   "kind": "text",
   "parent": 302218041,
   "actor": null,
   "text": "I thought you quit? {M} wouldn't like that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "869547352": {
   "kind": "text",
   "parent": 302218041,
   "actor": null,
   "text": "Fresh air with a cigarette?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "837950559": {
   "kind": "text",
   "parent": 302218041,
   "actor": null,
   "text": "You look stressed out.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-526762295": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Yeah, you caught me. I was trying to keep this a secret.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1728905685": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I thought I had it all under control, but sometimes it feels like too much.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2138927666": {
   "kind": "choice",
   "parent": -1,
   "children": [
    368151381,
    -714320256,
    1106707732
   ],
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Smoking... it’s a stupid way to cope, I know.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
