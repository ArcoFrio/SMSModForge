  },
  "368151381": {
   "kind": "text",
   "parent": -2138927666,
   "children": [
    89846579
   ],
   "actor": null,
   "text": "You don’t have to go through this alone.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-714320256": {
   "kind": "text",
   "parent": -2138927666,
   "children": [
    1580149953
   ],
   "actor": null,
   "text": "I get it, life’s tough. Just don't give up.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "89846579": {
   "kind": "text",
   "parent": 368151381,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Thanks, {PC}. It means a lot to hear you say that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1580149953": {
   "kind": "text",
   "parent": -714320256,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I know. I’ll try to be better. For you and for myself.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1106707732": {
   "kind": "text",
   "parent": -2138927666,
   "children": [
    2060976553
   ],
   "actor": null,
   "text": "I’ll keep this between us... for 200 bucks.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2060976553": {
   "kind": "text",
   "parent": 1106707732,
   "actor": "Josef",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Fine. Here’s the money. But you better not say a word.",
   "settings": {
    "m_Options": "FromSkin"
   },
