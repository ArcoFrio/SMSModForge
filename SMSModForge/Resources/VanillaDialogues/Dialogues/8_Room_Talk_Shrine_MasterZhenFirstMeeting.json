  "-297815425": {
   "kind": "text",
   "parent": -1254963323,
   "children": [
    179349106,
    -620293919
   ],
   "actor": null,
   "text": "What happens if I lose?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "179349106": {
   "kind": "text",
   "parent": -297815425,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "You won’t die. Your body stays here, untouched. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1629757056": {
   "kind": "text",
   "parent": -1254963323,
   "children": [
    733313867
   ],
   "actor": null,
   "text": "How can I tell how dangerous it is?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "733313867": {
   "kind": "text",
   "parent": -1629757056,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "You’ll know. If the air turns red and thick like blood, if it feels like every shadow’s watching you… that’s when you turn around. ",
   "jump": {
    "mode": "Jump",
    "to": "rootshrine"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "881623768": {
   "kind": "text",
   "parent": -1254963323,
   "children": [
    -1493092992
   ],
   "actor": null,
   "text": "How do I know if we’re making progress?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1493092992": {
   "kind": "text",
   "parent": 881623768,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "I’ll sense it. When you weaken the spirits, I’ll feel the shift. Until then, keep cutting them down.",
   "jump": {
    "mode": "Jump",
    "to": "rootshrine"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-632148219": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Good. Enough talking. Go do what you came here to do.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-518566460": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Listen. The spirits are like the weather—always shifting. Some days it’s calm… other days, the air is filled with red mist, and the whole place becomes a death trap.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-530934289": {
   "kind": "text",
   "parent": -1254963323,
   "actor": null,
   "text": "I don’t have any more questions.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-620293919": {
   "kind": "text",
   "parent": -297815425,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "But the spirits will take their payment in a different form—they’ll steal some of your coin. Call it a toll for your failure.",
   "jump": {
    "mode": "Jump",
    "to": "rootshrine"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "339672217": {
   "kind": "text",
   "parent": -1254963323,
   "children": [
    -1726879383
   ],
   "actor": null,
   "text": "How much time we have left?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1726879383": {
   "kind": "text",
   "parent": 339672217,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Do not worry about time. While I cannot cleanse the curse ahead, I can protect the city behind us.",
   "jump": {
    "mode": "Jump",
    "to": "rootshrine"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
