  "-842992157": {
   "kind": "text",
   "parent": -1618551032,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Gotta say though... It still kinda sucks, I hope he's not doing too bad....",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-146885534": {
   "kind": "text",
   "parent": -1272547459,
   "children": [
    -1343369418
   ],
   "actor": null,
   "text": "Yeah, he can't compete with us.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "196484473": {
   "kind": "text",
   "parent": -1272547459,
   "children": [
    1152178882
   ],
   "actor": null,
   "text": "I'm sure we can keep her more than satisfied.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1672905548": {
   "kind": "text",
   "parent": -1272547459,
   "children": [
    -1821173588
   ],
   "actor": null,
   "text": "I'm the new {D} of the house.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1821173588": {
   "kind": "text",
   "parent": 1672905548,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "I see... B-But don't expect me to call you daddy.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1152178882": {
   "kind": "text",
   "parent": 196484473,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "True... I don't think that {D} is rocking two dicks...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1343369418": {
   "kind": "text",
   "parent": -146885534,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Y-Yeah... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2048029332": {
   "kind": "text",
   "parent": 1272281259,
   "actor": "Adrian",
   "expression": 2,
   "expressionName": "Angry",
   "text": "No, no, no... L-Leave me alone. I don't want to see your fucking face in my room.... Leave, man...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1104347733": {
   "kind": "text",
   "parent": -489623680,
   "children": [
    1320657082
   ],
   "actor": null,
   "text": "She was lonely, Adrian... And {D} wasn't there for her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-719500794": {
   "kind": "text",
   "parent": -489623680,
   "children": [
    -64785939
   ],
   "actor": null,
   "text": "We started a Starmaker page to deal with the debt and then... Well, you know the rest.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "290914577": {
   "kind": "text",
   "parent": -489623680,
   "children": [
    352719746
   ],
   "actor": null,
   "text": "{M}'s mine now, Adrian. You better get used to it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "352719746": {
   "kind": "text",
   "parent": 290914577,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Y-You're joking, right? W-What's wrong with YOU!? I.. I...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-64785939": {
   "kind": "text",
   "parent": -719500794,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "I-I don't care, I don't want to hear it, {PC}... I... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1320657082": {
   "kind": "text",
   "parent": -1104347733,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "S-So you decided you had to FUCK her!? A-Are you insane, and {M} is... Oh god...",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
