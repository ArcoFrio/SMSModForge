   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "If you don't want to help him, then I will....",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1618551032": {
   "kind": "text",
   "parent": -1,
   "children": [
    -1272547459,
    -842992157
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "So... Uh, looks like {D} left... ",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
