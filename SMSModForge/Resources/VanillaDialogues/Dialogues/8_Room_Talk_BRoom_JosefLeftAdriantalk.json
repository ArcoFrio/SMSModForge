  "377380401": {
   "kind": "text",
   "parent": -1038916358,
   "children": [
    -425346312
   ],
   "actor": null,
   "text": "Maybe you should. He could need some support.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-425346312": {
   "kind": "text",
   "parent": 377380401,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Y-Yeah, he's probably lonely as fuck right now...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "146019027": {
   "kind": "text",
   "parent": -1038916358,
   "children": [
    1030272027
   ],
   "actor": null,
   "text": "Forget about {D}. He's a loser.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1030272027": {
   "kind": "text",
   "parent": 146019027,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "W-What? I can't... What's wrong with you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "854694299": {
   "kind": "text",
   "parent": -1264333564,
   "children": [
    853252059
   ],
   "actor": null,
   "text": "We did nothing. I think the stress made him go crazy.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "853252059": {
   "kind": "text",
   "parent": 854694299,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "Y-Yeah... I thought so... Shit... I need to find a way to help him...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "693987619": {
   "kind": "text",
   "parent": -1264333564,
   "children": [
    -144066513,
    -1576350770
   ],
   "actor": null,
   "text": "He probably couldn't handle being an useless loser.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-144066513": {
   "kind": "text",
   "parent": 693987619,
   "actor": "Adrian",
   "expression": 2,
   "expressionName": "Angry",
   "text": "H-He's our {D}, man... What are you talking about... Jesus.... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1272281259": {
   "kind": "text",
   "parent": -1264333564,
   "children": [
    -489623680,
    -2048029332
   ],
   "actor": null,
   "text": "I fucked {M}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-489623680": {
   "kind": "choice",
   "parent": 1272281259,
   "children": [
    -1104347733,
