   "children": [
    854694299,
    693987619,
    1272281259
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "I... I gotta think about it... Jesus, man. What did you do?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
