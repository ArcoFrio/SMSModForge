   "children": [
    -146885534,
    196484473,
    1672905548
   ],
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "That means it's now our job to keep {M} satisfied?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
