  "34468190": {
   "kind": "text",
   "parent": 1756292676,
   "children": [
    -156444381
   ],
   "actor": null,
   "text": "Someone new I guess?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1893032266": {
   "kind": "text",
   "parent": 1756292676,
   "children": [
    -1724149882
   ],
   "actor": null,
   "text": "I'll ask Anna.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1724149882": {
   "kind": "text",
   "parent": 1893032266,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "No, no. Anna is a natural. I can tell by her work on your Starmaker page. It has to be someone new.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-156444381": {
   "kind": "text",
   "parent": 34468190,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Yes, someone new. Someone who has never done a real photo shoot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
