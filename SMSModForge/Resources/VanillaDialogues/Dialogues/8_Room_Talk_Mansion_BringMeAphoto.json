  "-1433514064": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "I’ve got a new challenge for you. This one’s going to test your skills in a different way.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1756292676": {
   "kind": "choice",
   "parent": -1,
   "children": [
    34468190,
    1893032266
   ],
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "I want you to take a photo of someone who isn’t a model and doesn’t have any experience in front of the camera. ",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-308241791": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1536868468,
    337078732,
    -1416621438
   ],
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Your goal is to make the photo look fantastic despite that. Capture their essence and make them shine. Once you’ve done that, bring the photo back to me.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1536868468": {
   "kind": "text",
   "parent": -308241791,
   "children": [
    811311008
   ],
   "actor": null,
   "text": "Easy enough, I'll return with a great photo.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "337078732": {
   "kind": "text",
   "parent": -308241791,
   "children": [
    -1045036208
   ],
   "actor": null,
   "text": "That sounds interesting. Any tips?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1416621438": {
   "kind": "text",
   "parent": -308241791,
   "children": [
    -853952144
   ],
   "actor": null,
   "text": "Maybe. If I have the time.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-853952144": {
   "kind": "text",
   "parent": -1416621438,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Well, it is your choice. But if you want to become better, you should follow my advice.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1045036208": {
   "kind": "text",
   "parent": 337078732,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Focus on making them feel comfortable and bringing out their natural personality. Everyone has a unique beauty – it’s your job to find it and capture it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "811311008": {
   "kind": "text",
   "parent": 1536868468,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "I’m sure you will. Go out there and make magic happen!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1252572070": {
   "kind": "text",
   "parent": -1,
   "actor": "Gabriel",
   "expressionName": "neutral",
   "text": "Good luck, {PC}. I’m looking forward to seeing what you come up with.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
