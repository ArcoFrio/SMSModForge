 "nodes": {
  "-1938415780": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You’re still here. Hmph… most would’ve quit by now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1244344430": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Maybe… there’s more to you than I thought.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-922723394": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "When I was young, I thought I’d be a warrior forever. That I’d protect my people, my home… but life doesn’t care about our plans.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "108607056": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I lost everything because I couldn’t stop one spirit. It’s why I’m here. Why I’ve dedicated my life to guarding this gate. The spirits took my family, my friends… everything.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1255931922": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -2062718308,
    883992187,
    -834202004
   ],
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Don’t make the same mistake I did. Be stronger than I was.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-2062718308": {
   "kind": "text",
   "parent": 1255931922,
   "children": [
    -1194657389,
    786533713
   ],
   "actor": null,
   "text": "I’m sorry, Master Zhen. That must have been hard.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "883992187": {
   "kind": "text",
   "parent": 1255931922,
   "children": [
    714321708
   ],
   "actor": null,
   "text": "I won’t let that happen to me. I’ll be ready.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-834202004": {
   "kind": "text",
   "parent": 1255931922,
   "children": [
    1975664777,
    -454926246
   ],
   "actor": null,
   "text": "Which spirit was it? What happened?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1194657389": {
   "kind": "text",
   "parent": -2062718308,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "It was. But regret is a useless emotion. It’s better to focus on the battle ahead.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "714321708": {
   "kind": "text",
   "parent": 883992187,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Good. Keep that fire. You’ll need it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1975664777": {
   "kind": "text",
   "parent": -834202004,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "A spirit, unlike any other—a massive, blue beast. It tore through everything… ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "786533713": {
   "kind": "text",
   "parent": -2062718308,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Get some rest. Tomorrow, we fight again.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-454926246": {
   "kind": "text",
   "parent": -834202004,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "But focus on what’s in front of you, not what’s behind me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
