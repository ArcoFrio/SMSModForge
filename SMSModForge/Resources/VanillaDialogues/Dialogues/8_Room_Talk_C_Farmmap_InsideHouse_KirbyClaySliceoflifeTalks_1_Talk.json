 "nodes": {
  "-162674534": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Look! We did it! The very first milk, Clay. Proof that this works. Isn’t it amazing?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active KirbyBustDefault to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "KirbyBustDefault",
       "of": "GetGameObjectInstance",
       "path": "2_Bust_Manager/KirbyBustDefault"
      }
     }
    }
   ]
  },
  "1747323353": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expression": 2,
   "expressionName": "Angry",
   "text": "It’s a bottle of liquid. That’s all. One drop doesn’t mean this place won’t burn down tomorrow.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-849990055": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -560813249,
    509247152,
    1638313128,
    -1514551683
   ],
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "He’s not imaginary! He’s… he’s always been there. You just can’t see him like I do.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-560813249": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -1410417511,
    -419060296
   ],
   "actor": null,
   "text": "If Robert helps Kirby stay positive, who cares?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1410417511": {
   "kind": "text",
   "parent": -560813249,
   "actor": "Kirby",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Exactly! See? He gets it!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "509247152": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -826723564,
    -1722838035
   ],
   "actor": null,
   "text": "Kirby… Clay’s right. Imaginary friends won’t fix the farm.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-826723564": {
   "kind": "text",
   "parent": 509247152,
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You don’t understand… he’s real to me. That matters.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1638313128": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    -686257041,
    449307625
   ],
   "actor": null,
   "text": "Wait, does Robert get his own cowprint outfit too?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-686257041": {
   "kind": "text",
   "parent": 1638313128,
   "actor": "Kirby",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Hehe… maybe! He would look cute in one.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1514551683": {
   "kind": "text",
   "parent": -849990055,
   "children": [
    1960093995,
    -252142992
   ],
   "actor": null,
   "text": "If Robert’s real, maybe he wants a taste of your milk too.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1960093995": {
   "kind": "text",
   "parent": -1514551683,
   "actor": "Kirby",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Heehee… naughty! I don’t think he’d mind.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-252142992": {
   "kind": "text",
   "parent": -1514551683,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "…Kill me now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "449307625": {
   "kind": "text",
   "parent": 1638313128,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "…I’m surrounded by lunatics.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1722838035": {
   "kind": "text",
   "parent": 509247152,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "Finally. Someone talking sense.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-419060296": {
   "kind": "text",
   "parent": -560813249,
   "actor": "Clay",
   "expressionName": "neutral",
   "text": "You’re both insane.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-973726907": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Believe what you want. Robert and I know this farm is just getting started. And with him — and you — by my side, nothing can stop us.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-873184527": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Imaginary friends and milk bottles. What a circus.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "907345884": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Don’t listen to him. This is history. And we’re the ones making it.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active Leave to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "Leave",
       "of": "GetGameObjectInstance",
       "path": "2_Bust_Manager/KirbyBustDefault/MBase1/Leave"
      }
     }
    }
   ]
  },
  "202139950": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "You never change. You don’t believe in anything! Well… Robert believes in me. And that’s enough.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-82742848": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expression": 2,
   "expressionName": "Angry",
   "text": "…What? Robert?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-21025336": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Yeah! He says this is just the beginning. That soon the farm will be overflowing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-960991979": {
   "kind": "text",
   "parent": -1,
   "actor": "Clay",
   "expression": 2,
   "expressionName": "Angry",
   "text": "…Kirby. Are you crazy? Robert isn’t real. You’re too old to still be talking about imaginary friends.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
