  "-814309047": {
   "kind": "text",
   "parent": 1847781476,
   "children": [
    1922125310
   ],
   "actor": null,
   "text": "Sure. You’re allowed to do that?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-530588176": {
   "kind": "text",
   "parent": 1847781476,
   "children": [
    -919035354
   ],
   "actor": null,
   "text": "What if some of my sins involve you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-919035354": {
   "kind": "text",
   "parent": -530588176,
   "actor": "Vanessa",
   "expressionName": "neutral",
   "text": "Th-that’s not how this works… Not that I haven’t… wondered what you'd say.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1922125310": {
   "kind": "text",
   "parent": -814309047,
   "actor": "Vanessa",
   "expressionName": "neutral",
   "text": "Not officially. I’m not a priest. But… I can listen. Sometimes that’s enough.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-941462583": {
   "kind": "text",
   "parent": 1847781476,
   "children": [
    1858792308
   ],
   "actor": null,
   "text": "I'm good, Vanessa. But thank you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1858792308": {
   "kind": "text",
   "parent": -941462583,
   "actor": "Vanessa",
   "expressionName": "neutral",
   "text": "I should get back to my duties... but thank you for speaking with me. ",
