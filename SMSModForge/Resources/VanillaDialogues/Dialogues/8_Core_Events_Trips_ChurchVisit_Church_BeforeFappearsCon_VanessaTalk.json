  "1187359981": {
   "kind": "text",
   "parent": 690543,
   "children": [
    756962371,
    -1765349258
   ],
   "actor": null,
   "text": "Just checking in. You looked a little stressed.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "756962371": {
   "kind": "text",
   "parent": 1187359981,
   "actor": "Vanessa",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Stressed? Me? Just because I spilled wine on the communion cloth and told a child demons live under the pews?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "152084930": {
   "kind": "text",
   "parent": 690543,
   "children": [
    -1473344869
   ],
   "actor": null,
   "text": "What exactly do you do here?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1473344869": {
   "kind": "text",
   "parent": 152084930,
   "actor": "Vanessa",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I help with worship, run the church library, and… mostly try not to be a distraction.\nFailing at that last one, according to Samuel.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-780178056": {
   "kind": "text",
   "parent": 690543,
   "children": [
    -1666689266
   ],
   "actor": null,
   "text": "I came to confess, but I forgot the sin. Can I wing it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1666689266": {
   "kind": "text",
   "parent": -780178056,
   "actor": "Vanessa",
   "expressionName": "neutral",
   "text": "Winging sin sounds like a modern denomination. I’ll get you a pamphlet.\nMaybe call it “Freestyle Catholicism.”",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1658512200": {
   "kind": "text",
   "parent": 690543,
   "children": [
    -1437591033,
    -1376912437,
    -1564220067
   ],
   "actor": null,
   "text": "Depends. Is thinking about you in church a sin?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1437591033": {
   "kind": "text",
   "parent": 1658512200,
   "actor": "Vanessa",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Wh-what—yes! I mean, probably. Definitely.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1306066358": {
   "kind": "text",
   "parent": -1,
   "actor": "Vanessa",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I should get back to my duties... but thank you for speaking with me. It’s nice, having someone listen.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1376912437": {
   "kind": "text",
   "parent": 1658512200,
   "actor": "Vanessa",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Why are you like this?!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1564220067": {
   "kind": "text",
   "parent": 1658512200,
   "actor": "Vanessa",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "<size=60%>…Don’t stop though.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1765349258": {
   "kind": "text",
   "parent": 1187359981,
   "actor": "Vanessa",
   "expressionName": "neutral",
   "text": "Okay, fine. Yes. A little.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
