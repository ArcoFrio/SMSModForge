  },
  "899640346": {
   "kind": "text",
   "parent": 1374653520,
   "actor": "Vanessa",
   "expression": 1,
   "expressionName": "Happy",
   "text": "That’s kind of you to say. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1393835517": {
   "kind": "text",
   "parent": -591664220,
   "children": [
    -928798853
   ],
   "actor": null,
   "text": "Cute introduction. You rehearse that in front of the mirror?",
