  },
  "-928798853": {
   "kind": "text",
   "parent": 1393835517,
   "actor": "Vanessa",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Maybe… just the “full-time mess” part. The rest was improv. Don’t judge me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2130308786": {
