  "1461872054": {
   "kind": "text",
   "parent": -1677922513,
   "children": [
    -1948247608,
    1766995311
   ],
   "actor": null,
   "text": "Adrian is subscribed to your Starmaker.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "209703002": {
   "kind": "text",
   "parent": -1677922513,
   "children": [
    -1675259167
   ],
   "actor": null,
   "text": "It's all good, {M}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1675259167": {
   "kind": "text",
   "parent": 209703002,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "That's great! And if you ever need to talk, I'm always here for you.",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1948247608": {
   "kind": "text",
   "parent": 1461872054,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh my god... A-Adrian? My Adrian? No—no way... That can't be true...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2118908521": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "Yes, I found some photos from your page on his computer.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-571872805": {
   "kind": "choice",
   "parent": -1,
   "children": [
    2103677254,
    2018611953
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "This is... W-What should we do? I... I don't know what to do, {PC}... ",
   "settings": {
