  "812756743": {
   "kind": "text",
   "parent": -239947464,
   "actor": "Anna",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "F-Fuck... If he's even half your size, we could've had so much fun together...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "666173743": {
   "kind": "text",
   "parent": 1364167196,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I don't want him to suffer... Oh god, did you go through this too? I just want what's best for you and Adrian. Always...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1600756773": {
   "kind": "text",
   "parent": 456803976,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I know how this ends. It's only a matter of time before he realizes it's you behind the camera... not Josef.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1151990690": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "God... Al—alright, fine. I'll do it. But I... I want to do this my way, okay? Let's talk to your brother in his room.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1210539282": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I can't believe this is actually happening... What the hell am I doing...",
   "settings": {
    "m_Options": "FromSkin"
   },
