  "456803976": {
   "kind": "text",
   "parent": -1125864606,
   "children": [
    -1600756773
   ],
   "actor": null,
   "text": "Having him join us is safer than leaving him jealous.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1364167196": {
   "kind": "text",
   "parent": -1125864606,
   "children": [
    666173743
   ],
   "actor": null,
   "text": "Poor guy's suffering, watching his {M}'s tits bounce around all day...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-239947464": {
   "kind": "text",
   "parent": -1125864606,
   "children": [
    812756743
   ],
   "actor": null,
   "text": "Don't you want both your {S}'s stretching you open? Filling every hole of yours...",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
