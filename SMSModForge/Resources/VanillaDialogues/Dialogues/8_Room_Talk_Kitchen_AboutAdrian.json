  "2103677254": {
   "kind": "text",
   "parent": -571872805,
   "actor": null,
   "text": "Maybe you should seduce him? (Start sharing route)",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2018611953": {
   "kind": "text",
   "parent": -571872805,
   "children": [
    73398531,
    1192199223
   ],
   "actor": null,
   "text": "Nothing at all. I'm sure he won't snitch.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "73398531": {
   "kind": "text",
   "parent": 2018611953,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "It's strange, isn't it? Now whenever we have breakfast together... I'll keep remembering he saw me like that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1192199223": {
   "kind": "text",
   "parent": 2018611953,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You're right... Adrian would never hurt me.",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1125864606": {
   "kind": "choice",
   "parent": -1,
   "children": [
    456803976,
    1364167196,
    -239947464
   ],
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "W-What? N-No way... I could never... He's my Adrian... I mean, you're definitely attractive, but he's... he's...",
   "settings": {
