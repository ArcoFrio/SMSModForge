    }
   ]
  },
  "-1394043109": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Huh. She must be lactose intolerant.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "134227955": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1705737056,
    -1641877623,
    -144871043,
    1016060132
   ],
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Hey stranger! You drink milk?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1705737056": {
   "kind": "text",
   "parent": 134227955,
   "children": [
    469164122
   ],
   "actor": null,
   "text": "Depends. What kind of milk are we talking about here?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1641877623": {
   "kind": "text",
   "parent": 134227955,
   "children": [
    -1015210008
   ],
   "actor": null,
   "text": "Did you seriously just ask that woman to join a milk farm?!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1016060132": {
   "kind": "text",
   "parent": 134227955,
   "children": [
    710138770,
    -1804040373
   ],
   "actor": null,
   "text": "Only if it’s the kind that comes fresh and warm.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-144871043": {
   "kind": "text",
   "parent": 134227955,
   "children": [
    -652449171
   ],
   "actor": null,
   "text": "If this is some weird protein cult, I’m already in two.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-652449171": {
   "kind": "text",
   "parent": -144871043,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Oooh, cult! That’s what Clay says! He’s my {B}. He calls it a ‘teat cult.’ That’s a compliment, right?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "710138770": {
   "kind": "text",
   "parent": 1016060132,
   "actor": "Kirby",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Ooooh, you get it! You’ve got a farmer’s heart. Or maybe a farmer’s... tongue?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1015210008": {
   "kind": "text",
   "parent": -1641877623,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Well yeah! It’s a real farm with real girls makin' real milk! Nothing shady. I got buckets, tubes, a cooler, and a handshake policy. You ever seen a happier cow?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "469164122": {
   "kind": "text",
   "parent": -1705737056,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "All kinds! Goat, cow, almond, girlfriend—wait no, not almond. I mean real girls. Wait, I mean... you know what I mean!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1804040373": {
   "kind": "text",
   "parent": 1016060132,
   "actor": "Kirby",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Either way, I like your udd-er enthusiasm!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "962753100": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Here! Come by the farm sometime! We’re building a new barn for the girls. It’s gonna be moo-gnificent!",
   "settings": {
    "m_Options": "FromSkin"
   },
