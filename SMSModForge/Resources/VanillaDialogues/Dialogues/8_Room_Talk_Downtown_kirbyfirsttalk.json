 "nodes": {
  "779332055": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expression": 1,
   "expressionName": "Happy",
   "text": "So I wake up at four, I pump 'em, then I weigh the jugs and label 'em!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-220693664": {
   "kind": "text",
   "parent": -1,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "It's only me at the farm right now, but I’m looking for one more with real strong output! You look like you got good udd—uh, I mean potential! Wanna join my milk farm?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "349476793": {
   "kind": "text",
   "parent": -1,
   "actor": "Liz",
   "expressionName": "neutral",
   "text": "Oh god~ Oh god~ Oh god~ Ahhhhaaahhhh!",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
