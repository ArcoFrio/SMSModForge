    1025930738,
    -1979350855,
    -543265654,
    918381206,
    -500127952
   ],
   "actor": null,
   "text": "Do you ever miss the way things used to be? ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1963669032": {
   "kind": "text",
   "parent": 1993322081,
