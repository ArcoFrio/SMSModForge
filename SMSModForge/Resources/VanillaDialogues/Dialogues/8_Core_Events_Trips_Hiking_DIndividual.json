  "-1436414309": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Looks like Adrian is done collecting firewood. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "755258133": {
   "kind": "text",
   "parent": -2146194675,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Never take anything for granted. Life can change in an instant, and you have to appreciate what you have while you have it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1382922952": {
   "kind": "text",
   "parent": 1008858734,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I must admit that I do miss the days when I was able to think and talk about other things besides my struggles with finding a new job.",
