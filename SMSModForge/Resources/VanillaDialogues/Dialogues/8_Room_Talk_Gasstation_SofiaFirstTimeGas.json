  "-1087953041": {
   "kind": "text",
   "parent": 1256278956,
   "children": [
    563280361
   ],
   "actor": null,
   "text": "Why should I help you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2002251568": {
   "kind": "text",
   "parent": 1256278956,
   "children": [
    2022775872
   ],
   "actor": null,
   "text": "Me and my family would be in danger.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1961779153": {
   "kind": "text",
   "parent": 1256278956,
   "children": [
    -2005159533
   ],
   "actor": null,
   "text": "Any reward?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1568890910": {
   "kind": "text",
   "parent": 1256278956,
   "children": [
    1847866379
   ],
   "actor": null,
   "text": "Why are you so eager to bring him down?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2007088876": {
   "kind": "text",
   "parent": 1256278956,
   "actor": null,
   "text": "I have no more questions.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "563280361": {
   "kind": "text",
   "parent": -1087953041,
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "You’ll be doing something good, something that matters. This isn’t just about taking down one man—it’s about giving this city a chance to breathe again.",
   "jump": {
    "mode": "Jump",
    "to": "sofquest"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2022775872": {
   "kind": "text",
   "parent": -2002251568,
   "actor": "Sofia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "If you help me, I’ll make sure you’re protected. You can trust me, I have a team behind my back.",
   "jump": {
    "mode": "Jump",
    "to": "sofquest"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2005159533": {
   "kind": "text",
   "parent": 1961779153,
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "You are not facing any charges. Instead, you will be recognised as a highly valuable helper in this operation, which could open up a world of possibilities for you.",
   "jump": {
    "mode": "Jump",
    "to": "sofquest"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1847866379": {
   "kind": "text",
   "parent": 1568890910,
   "actor": "Sofia",
   "expression": 2,
   "expressionName": "Angry",
   "text": "It's not about... He... He destroyed my hometown after he cut off funding to various projects. He deserves to be burned.",
   "jump": {
    "mode": "Jump",
    "to": "sofquest"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-759080456": {
   "kind": "text",
   "parent": -1606214636,
   "children": [
    1007916143
   ],
   "actor": null,
   "text": "Alright, Sofia. I’m in. Let’s take him down.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1365074131": {
   "kind": "text",
   "parent": -1606214636,
   "children": [
    -328586266
   ],
   "actor": null,
   "text": "Sorry, Sofia, but I can’t do that. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-328586266": {
   "kind": "text",
   "parent": -1365074131,
   "actor": "Sofia",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I hoped you’d see reason, but I won’t stop until he’s brought to justice. Just know, if you’re with him, you’re against everything that’s right.",
