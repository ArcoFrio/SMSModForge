  "1979188435": {
   "kind": "text",
   "parent": 262358743,
   "children": [
    1115856709
   ],
   "actor": null,
   "text": "Sofia? You’re… a cop?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "260785871": {
   "kind": "text",
   "parent": 262358743,
   "children": [
    163172068
   ],
   "actor": null,
   "text": "Am I under arrest?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "923364374": {
   "kind": "text",
   "parent": 262358743,
   "children": [
    912242745
   ],
   "actor": null,
   "text": "Quite the costume, Sofia. You're kinky.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1115856709": {
   "kind": "text",
   "parent": 1979188435,
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "That’s right. Officer Sofia Reyes, Peak City PD. The little rendezvous at the gas station was just a way to get your attention. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "163172068": {
   "kind": "text",
   "parent": 260785871,
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "Officer Sofia Reyes, PeakCity PD. And no, you're not under arrest.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "912242745": {
   "kind": "text",
   "parent": 923364374,
   "actor": "Sofia",
   "expression": 2,
   "expressionName": "Angry",
   "text": "It's not a costume, {PC}. Officer Sofia Reyes, PeakCity PD. We need to talk.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "567760436": {
   "kind": "text",
   "parent": -1,
   "actor": "Sofia",
   "expression": 2,
   "expressionName": "Angry",
   "text": "It’s about Mario di Luca. You’ve been working for him, but I’m guessing you know by now that he’s corrupt to the core. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "311519383": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1183356416,
    326534926
   ],
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": " I’m here to bring him down, and I need your help to do it.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1183356416": {
   "kind": "text",
   "parent": 311519383,
   "actor": null,
   "text": "You’re asking me to betray him?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "326534926": {
   "kind": "text",
   "parent": 311519383,
   "children": [
    590948108
   ],
   "actor": null,
   "text": "You are aware that he's the fucking governor?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "590948108": {
   "kind": "text",
   "parent": 326534926,
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "Trust me, I am. And you are my best shot at him.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1982611356": {
   "kind": "text",
   "parent": -1,
   "actor": "Sofia",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I’m asking you to do the right thing. Mario’s not just a crooked politician—he’s a danger to this city. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "659237430": {
   "kind": "text",
   "parent": -1,
   "actor": "Sofia",
   "expression": 3,
   "expressionName": "Sad",
   "text": "He’s manipulating people, ruining lives, and getting away with it because no one’s been brave enough to stand up to him. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1256278956": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1087953041,
    -2002251568,
    1961779153,
    1568890910,
    2007088876
   ],
   "actor": "Sofia",
   "expressionName": "neutral",
   "text": "But with your help, we can change that.",
   "tag": "sofquest",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
