     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-2062718308": {
   "kind": "text",
   "parent": 1255931922,
   "children": [
    -1194657389
   ],
   "actor": null,
   "text": "I’m sorry for your loss. I’ll make sure we’re ready.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "883992187": {
   "kind": "text",
   "parent": 1255931922,
   "children": [
    714321708
   ],
   "actor": null,
   "text": "I’ll be strong, for you and your son.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-834202004": {
   "kind": "text",
   "parent": 1255931922,
   "children": [
    1975664777,
    -454926246
   ],
   "actor": null,
   "text": "I thought spirits can't fully manifest in our world?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1194657389": {
   "kind": "text",
   "parent": -2062718308,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Good. The only way to honor the fallen is to keep moving forward.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "714321708": {
   "kind": "text",
   "parent": 883992187,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Don’t fight for the dead. Fight for the living—and for yourself.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1975664777": {
   "kind": "text",
   "parent": -834202004,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "The blue one is different... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-454926246": {
   "kind": "text",
   "parent": -834202004,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "If she was able to enter our world before, she can do it again... And you need to be ready.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
