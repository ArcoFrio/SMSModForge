  "1244344430": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "My son. When the blue spirit attacked, he was the first to fall. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-922723394": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "My son tried to resist her, but he was too young… too untrained",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "108607056": {
   "kind": "text",
   "parent": -1,
   "actor": "Master Zhen",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I’ve been guarding this gate ever since. It’s the next target. When the blue spirit returns, it’ll come for the people here, just like it came for my village.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1255931922": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -2062718308,
    883992187,
    -834202004
   ],
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "That’s why I push you so hard. I can’t afford to lose another student…",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
