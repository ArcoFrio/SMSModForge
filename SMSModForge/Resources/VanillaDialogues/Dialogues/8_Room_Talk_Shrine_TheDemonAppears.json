    "m_Options": "FromSkin"
   }
  },
  "-1437032901": {
   "kind": "text",
   "parent": -813396575,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "…Clever. Damn you… clever little human.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "253070541": {
   "kind": "text",
   "parent": -813396575,
   "actor": "Nyxara",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You’ve cornered me. Outplayed me. I hate it...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "971256771": {
   "kind": "text",
   "parent": -813396575,
   "actor": "Nyxara",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "...and yet… I love it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1650041524": {
   "kind": "text",
   "parent": -813396575,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Very well. I will keep my promise.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1326380285": {
   "kind": "text",
   "parent": -813396575,
   "actor": "Nyxara",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I'll see you... That's a promise.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2138295503": {
   "kind": "text",
   "parent": 1791607674,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Ahhh— y-yes…! Keep licking, slave, don’t you dare stop now!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-424288224": {
   "kind": "text",
   "parent": 1791607674,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "Drowning under me… hahhh… you were born for this!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1250942144": {
   "kind": "text",
   "parent": 1791607674,
   "actor": "Nyxara",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Look at you… drenched in me. What a pitiful sight.",
   "settings": {
    "m_Options": "FromSkin"
   },
