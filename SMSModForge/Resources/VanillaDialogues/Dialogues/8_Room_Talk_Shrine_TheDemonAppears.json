  "744158924": {
   "kind": "text",
   "parent": 1791607674,
   "actor": "Nyxara",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "You begged for this, and now you lie there like a dog licking up scraps.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "561871006": {
   "kind": "text",
   "parent": 1791607674,
   "actor": "Nyxara",
   "expressionName": "neutral",
   "text": "You thought you were the one asking for a wish. But really… I’m the one who got everything I wanted.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-660595425": {
   "kind": "text",
   "parent": 1791607674,
   "actor": "Nyxara",
   "expression": 4,
   "expressionName": "Flirty",
