  "1568475335": {
   "kind": "text",
   "parent": -816717688,
   "actor": "Amelia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Of course I’m having fun! It’s not every day I get to work in a bikini. You should be thanking me for boosting the charity fund.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "140850600": {
   "kind": "text",
   "parent": 203892632,
   "actor": "Amelia",
   "expressionName": "neutral",
   "text": "If they crash while looking at me, that’s their fault. I take no responsibility for being this distracting.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-354532747": {
   "kind": "text",
   "parent": -1206384681,
   "actor": "Amelia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "What can I say? I commit to a job. Besides, if I’m going to be stared at, I might as well make it worth their time.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1611601022": {
   "kind": "text",
   "parent": -1,
   "actor": "Amelia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Okay, I’ll admit it… this is kinda fun.",
   "settings": {
    "m_Options": "FromSkin"
   },
