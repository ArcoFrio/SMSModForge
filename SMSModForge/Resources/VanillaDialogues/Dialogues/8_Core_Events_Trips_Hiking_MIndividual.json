  "-755954637": {
   "kind": "text",
   "parent": -2146194675,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Not everything in life is an \"or\" decision. But we often pretend it is because we're just a little lazy, aren't we?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1086959956": {
   "kind": "text",
   "parent": 1993322081,
   "actor": null,
   "text": "[Just enjoy the silence]",
   "settings": {
    "m_Options": "FromSkin"
   }
