       "value": false
      }
     }
    }
   ]
  },
  "1294050063": {
   "kind": "text",
   "parent": -2031689458,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I loved painting. It was my escape and my way to express myself. Maybe I should pick it up again.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "29506581": {
   "kind": "text",
   "parent": -2031689458,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "It's been so many years since I've last painted... ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1632928628": {
   "kind": "text",
   "parent": -1963669032,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I've... I've been into you even before we've started our Starmaker page... You're handsome, kind and... I'm really lucky...",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
