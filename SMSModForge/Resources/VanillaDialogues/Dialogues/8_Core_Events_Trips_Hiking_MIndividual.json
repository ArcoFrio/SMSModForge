  "-2146194675": {
   "kind": "text",
   "parent": 1993322081,
   "children": [
    755258133,
    -755954637
   ],
   "actor": null,
   "text": "What’s the one thing you wish you could have done differently in your life?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1008858734": {
   "kind": "text",
   "parent": 1993322081,
   "children": [
    1382922952,
    -543265654,
    497252669
   ],
   "actor": null,
   "text": "Do you think things have changed for the better or worse over the weeks?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1963669032": {
   "kind": "text",
   "parent": 1993322081,
   "children": [
    1030336074,
    -1632928628
   ],
   "actor": null,
   "text": "What’s something you’ve always wanted to tell me, but never had the chance?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2031689458": {
   "kind": "text",
   "parent": 1993322081,
   "children": [
    1294050063,
    29506581
   ],
   "actor": null,
   "text": "What was your favorite thing to do before we came along?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1436414309": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Ah, Adrian's coming with the firewood. Let's catch up with them.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "755258133": {
   "kind": "text",
   "parent": -2146194675,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I wish I had pursued some of my own dreams earlier....",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1382922952": {
   "kind": "text",
   "parent": 1008858734,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Things have been... better. Your {D} isn't doing well, Adrian has been struggling too. I hope we can turn it around.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Mainstory[M-Stage-4-sex] = False",
     "fields": {
