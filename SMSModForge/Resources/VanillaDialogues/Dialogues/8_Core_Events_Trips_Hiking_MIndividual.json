   ]
  },
  "1030336074": {
   "kind": "text",
   "parent": -1963669032,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "That I’m proud of you, every single day. I don’t say it enough, but I hope you know it.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Mainstory[M-Stage-4-sex] = False",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "M-Stage-4-sex",
        "list": "Mainstory",
        "type": "boolean"
       }
      },
      "m_Comparison": "Equals",
      "m_CompareTo": {
