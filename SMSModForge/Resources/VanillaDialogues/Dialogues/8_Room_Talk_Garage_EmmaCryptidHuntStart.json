 "nodes": {
  "-668886847": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Oh. Hi. Can I help you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-43598306": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "I’m sorry, I know this is weird, but I really need to talk to your {S}. Right now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1872882932": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "…About what, exactly?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "343050955": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Something important. Private. It can’t wait.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-45405528": {
   "kind": "choice",
   "parent": -1,
   "children": [
    358695982,
    -1421327336,
    644828492
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Uh-huh. You know, because from my side, this sounds a lot like you showed up unannounced to see a boy you barely know.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "358695982": {
   "kind": "text",
   "parent": -45405528,
   "children": [
    -841829993
   ],
   "actor": null,
   "text": "{M}, it’s okay. I know her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-841829993": {
   "kind": "text",
   "parent": 358695982,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You do?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1421327336": {
   "kind": "text",
   "parent": -45405528,
   "children": [
    -1352709730
   ],
   "actor": null,
   "text": "Wow, already labeled a stalker. New record.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1352709730": {
   "kind": "text",
   "parent": -1421327336,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I am not calling her a stalker. I’m just… asking reasonable questions.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "644828492": {
   "kind": "text",
   "parent": -45405528,
   "children": [
    45554510
   ],
   "actor": null,
   "text": "She’s not a fangirl, if that’s what you’re thinking.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "45554510": {
   "kind": "text",
   "parent": 644828492,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I was thinking it, yes. You have that effect on people lately.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1598278140": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I’m sorry about that, Emma. I’ll give you two some privacy.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onFinish": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
