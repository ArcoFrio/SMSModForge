  "-525183192": {
   "kind": "text",
   "parent": -543912177,
   "children": [
    -1168710911
   ],
   "actor": null,
   "text": "What about Roxy?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "466486683": {
   "kind": "text",
   "parent": -543912177,
   "children": [
    -1801109792
   ],
   "actor": null,
   "text": "Tasha, I don’t know where this is coming from, but let’s talk about it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1691419291": {
   "kind": "text",
   "parent": -543912177,
   "children": [
    -256930173
   ],
   "actor": null,
   "text": "Jealous of Roxy? Didn’t know you cared that much.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-256930173": {
   "kind": "text",
   "parent": -1691419291,
   "actor": "Tasha",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Oh, I cared. But now? You’re just another guy who thinks he can get away with anything.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1801109792": {
   "kind": "text",
   "parent": 466486683,
   "actor": "Tasha",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Oh, we’re talking. I’m just waiting to hear what excuse you’ll pull out of your ass.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1168710911": {
   "kind": "text",
   "parent": -525183192,
   "actor": "Tasha",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Don’t play dumb. I know what went down. Or do you think I wouldn’t find out?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-764391141": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expression": 3,
   "expressionName": "Sad",
   "text": "You know, I actually liked you. Stupid me for thinking you weren’t like every other scumbag out there.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1410622871": {
   "kind": "text",
   "parent": -1,
   "children": [
    -313173846,
    -844397614,
    -1040883120
   ],
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Why her? Like, I wasn't expecting to have you all for myself... But why did you had to fuck that dirty bitch?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-313173846": {
   "kind": "text",
   "parent": 1410622871,
   "children": [
    1227785649
   ],
   "actor": null,
   "text": "Tasha, I made a mistake. I’m sorry. I want to fix this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-844397614": {
   "kind": "text",
   "parent": 1410622871,
   "children": [
    521909785
   ],
   "actor": null,
   "text": "If you want to blow this out of proportion, that’s on you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1040883120": {
   "kind": "text",
   "parent": 1410622871,
   "children": [
    -374397945
   ],
   "actor": null,
   "text": "You're like a 7/10 and she's a 10/10.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-374397945": {
   "kind": "text",
   "parent": -1040883120,
   "actor": "Tasha",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Fuck you, {PC}. We're done.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "521909785": {
   "kind": "text",
   "parent": -844397614,
   "actor": "Tasha",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Wow. You’re not just a cheater; you’re an asshole too. Good to know.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1227785649": {
   "kind": "text",
   "parent": -313173846,
   "actor": "Tasha",
   "expression": 3,
   "expressionName": "Sad",
   "text": "You don’t get to fix it. This isn’t some comic book where you can just rewrite the ending.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-309886496": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Just... Leave, man. I don't want to see you anymore.",
   "settings": {
    "m_Options": "FromSkin"
   },
