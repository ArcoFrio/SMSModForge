   "actor": "Isabella",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Well, well, if it isn’t {PC}. You're Josef's {S}, am I right?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
