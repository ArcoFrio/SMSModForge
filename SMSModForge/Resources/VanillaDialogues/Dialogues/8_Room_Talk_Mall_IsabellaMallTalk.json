   }
  },
  "1575629457": {
   "kind": "text",
   "parent": 693024040,
   "actor": null,
   "text": "Yes, that's right.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1916541989": {
   "kind": "text",
   "parent": 693024040,
   "actor": null,
   "text": "You're the woman that was at my {D}'s office.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "262358743": {
   "kind": "text",
   "parent": -1,
   "actor": "Isabella",
   "expressionName": "neutral",
   "text": "Hmm...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2038969881": {
   "kind": "text",
   "parent": -1,
   "actor": "Isabella",
   "expressionName": "neutral",
   "text": "Yes, you should do nicely. Actually, you're an even finer choice than he is...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "512198485": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1483173181,
    1778917928
   ],
   "actor": "Isabella",
   "expressionName": "neutral",
   "text": "Josef always did have a knack for making poor choices. Like leaving me for this Anna Whore.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1483173181": {
   "kind": "text",
   "parent": 512198485,
   "children": [
    -2120912365
   ],
   "actor": null,
   "text": "You're an ex of my {D}?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1778917928": {
   "kind": "text",
   "parent": 512198485,
   "children": [
    1630787745
   ],
   "actor": null,
   "text": "Hey, watch your mouth.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1630787745": {
   "kind": "text",
   "parent": 1778917928,
   "actor": "Isabella",
   "expressionName": "neutral",
   "text": "Or what?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2120912365": {
   "kind": "text",
   "parent": -1483173181,
   "actor": "Isabella",
   "expressionName": "neutral",
   "text": "Oh, he didn't tell you? That's just splendid.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-482918405": {
   "kind": "text",
   "parent": -1,
   "actor": "Isabella",
   "expression": 2,
   "expressionName": "Angry",
   "text": "You know, I always knew Josef would end up in a mess, especially with you lot dragging him down.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1409124936": {
   "kind": "text",
   "parent": -1,
   "actor": "Isabella",
   "expressionName": "neutral",
   "text": "But I'm here to save the day, to help out in this dire financial situation you lot are trapped in...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "383388440": {
   "kind": "choice",
