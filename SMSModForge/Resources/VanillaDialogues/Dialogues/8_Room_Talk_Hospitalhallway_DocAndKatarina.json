 "nodes": {
  "-1625103779": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expressionName": "neutral",
   "text": "Doctor, I need to discuss a matter of utmost importance… my face.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1061625545": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "You’re aging. It happens. What do you want me to do?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-191549024": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expressionName": "neutral",
   "text": "A facelift, obviously. I can’t afford to look… tired.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1263460421": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Your skin elasticity is shot, and fillers won’t do much anymore. A facelift’s your best bet if you want anything remotely effective.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1043470389": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expressionName": "neutral",
   "text": "How subtle can you make it? I don’t want to look… done.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "528224766": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "There’s no magic trick. If you want subtle, expect less dramatic results. Decide if you want natural or noticeable.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1086985418": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expressionName": "neutral",
   "text": "Fine. Schedule me in. I can’t stand looking at these wrinkles a day longer.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
