  "-151915469": {
   "kind": "text",
   "parent": -645803710,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I do trust you, sweetheart. I just don’t trust them. This whole place screams bad news.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-603268257": {
   "kind": "text",
   "parent": -412284777,
   "actor": "Anna",
   "expressionName": "neutral",
