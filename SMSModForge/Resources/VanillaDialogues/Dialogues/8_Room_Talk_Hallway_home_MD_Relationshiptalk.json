 "nodes": {
  "2101874582": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "So, uh… since you’ve, uh, already… slept with someone else... does that mean I can… do the same?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-83234042": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh, you’re looking for permission now? I didn’t think you’d be so eager.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "282063882": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I just… I mean, if we’re already breaking rules, maybe we should talk about changing them?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1800659585": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Mmm, I like where this is going. We’ve both had a taste of something new… why not just embrace it?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1899698778": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Wait, seriously? You’re okay with this?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1205917681": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "More than okay! Think about it… no more guilt, no more sneaking around.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "592894055": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Who are you and what did you do with my wife?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1828155942": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Ask your {S}. His fat cock fucked some clarity into my life...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1689513412": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "I... I really enjoy this new side of you...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1385973384": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Good. She won't be leaving anytime soon....",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
