  "-872208652": {
   "kind": "text",
   "parent": -226651364,
   "children": [
    820780445
   ],
   "actor": null,
   "text": "I’ll look around. No promises.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "820780445": {
   "kind": "text",
   "parent": -872208652,
   "actor": "Mura",
   "expressionName": "neutral",
   "text": "Fine. But don’t take too long. Every hour she keeps me alive, she learns a new way to break someone.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setBool",
     "type": "InstructionBooleanSetBool",
     "title": "Set Events_10[agreedtohelp-drmura] = True",
     "fields": {
