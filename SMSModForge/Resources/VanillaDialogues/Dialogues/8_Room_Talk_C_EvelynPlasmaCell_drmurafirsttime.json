  "-942482422": {
   "kind": "text",
   "parent": -1273735527,
   "actor": "Mura",
   "expressionName": "neutral",
   "text": "I believed in the research until she started using people like toys. She said pain and pleasure were just data points. Look at me now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "835854667": {
   "kind": "text",
   "parent": 178849838,
   "actor": "Mura",
   "expressionName": "neutral",
   "text": "Used to work with her before she started crossing every moral line there is. She kept the science, stripped out the soul.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "892947146": {
   "kind": "text",
   "parent": 509592464,
   "actor": "Mura",
   "expressionName": "neutral",
   "text": "What she’s really doing is turning people into sex lab rats. I tried to stop her. Now I’m.. Fuck.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "406353460": {
   "kind": "text",
   "parent": -1098924292,
   "actor": "Mura",
   "expressionName": "neutral",
   "text": "That’s not progress, that’s hell wearing a lab coat.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "795819740": {
   "kind": "text",
   "parent": 753661643,
   "actor": "Mura",
   "expressionName": "neutral",
   "text": "Once I’m free, I can expose everything she’s been doing. What she calls science would make a demon blush.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "351941451": {
   "kind": "text",
   "parent": 1952301977,
   "actor": "Mura",
   "expressionName": "neutral",
   "text": "If you see her private chambers, you’ll understand. Just… don’t let her catch you in there.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
