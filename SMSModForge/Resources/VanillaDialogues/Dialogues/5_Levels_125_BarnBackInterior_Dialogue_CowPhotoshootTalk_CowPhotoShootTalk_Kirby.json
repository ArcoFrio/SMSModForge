  "-1317928835": {
   "kind": "text",
   "parent": -275872523,
   "children": [
    507214162
   ],
   "actor": null,
   "text": "I’ll admit… I’d milk you any day.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "507214162": {
   "kind": "text",
   "parent": -1317928835,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Hahaha! You’re so weird. But hey, I don’t mind if you wanna try~",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1238489625": {
   "kind": "text",
   "parent": 1804836794,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Well duh! If you’re gonna do a thing, you gotta do it all the way! Moo or bust!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "349400872": {
   "kind": "text",
   "parent": -1552967570,
   "actor": "Kirby",
   "expressionName": "neutral",
   "text": "Aww, thanks! I think it’s ‘cause I already spend half my life with cows anyway. Now I get to be one!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-562047180": {
