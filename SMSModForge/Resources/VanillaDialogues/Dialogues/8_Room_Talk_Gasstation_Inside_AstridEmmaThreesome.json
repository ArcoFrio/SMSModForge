 "nodes": {
  "-529980126": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Well, look who wandered in from the shadows.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1095895923": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "We’re not here to cause trouble. I just... need some answers. About my {D}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-663754385": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "That’s new. Who’s daddy, sweetheart?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "364410575": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "Mario di Luca. He ran experiments... awful ones.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1218866625": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "We found something in the sewers recently... and I think he made it. And you... {PC} told me you're not just human.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1284074298": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Mario di Luca… Sorry, darling. That name means nothing to me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-534739572": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "I’m not one of his toys. I’m something a little older than science.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1842746136": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "If you’re really not part of it, then I’m sorry for assuming. I’m trying to fix what my {D} broke. All of it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "458502519": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "That’s a heavy promise. You’ve got a good heart, Emma. I can smell it from here. Warm… Very warm...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-610500847": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "Warm... Why do I feel weird? {PC}?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "267536935": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Mmm… there it is. That heartbeat. It’s singing through you, Emma.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "579346382": {
   "kind": "text",
   "parent": -1,
   "actor": "Emma",
   "expressionName": "neutral",
   "text": "I... I can feel it. It’s like... everything’s pulsing.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "705110271": {
   "kind": "text",
   "parent": -1,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Don’t fight it. Let it move through you.",
   "settings": {
    "m_Options": "FromSkin"
   },
