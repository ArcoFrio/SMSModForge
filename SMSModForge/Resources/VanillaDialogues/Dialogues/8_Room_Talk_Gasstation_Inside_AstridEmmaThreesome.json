  "-916667571": {
   "kind": "text",
   "parent": -1328918412,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Maybe I do. But don’t worry, sweet things... this isn’t pain.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "437541760": {
   "kind": "text",
   "parent": -931623324,
   "children": [
    -402172559
   ],
   "actor": null,
   "text": "It’s okay. Let her feel it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-402172559": {
   "kind": "text",
   "parent": 437541760,
   "actor": "Astrid",
