 "nodes": {
  "2101874582": {
   "kind": "text",
   "parent": -1,
   "actor": "Samantha",
   "expressionName": "neutral",
   "text": "These aches in my back are getting unbearable.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-83234042": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Your posture is atrocious. That’s what happens when you’re carrying around excess weight.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "282063882": {
   "kind": "text",
   "parent": -1,
   "actor": "Samantha",
   "expressionName": "neutral",
   "text": "Excess—? You mean my boobs?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1800659585": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "Exactly. You could consider surgery. Or invest in better support. Either way, complaining won’t fix it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1899698778": {
   "kind": "text",
   "parent": -1,
   "actor": "Samantha",
   "expressionName": "neutral",
   "text": "Surgery, huh? Never thought I’d hear a doctor suggest going under the knife for this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1205917681": {
   "kind": "text",
   "parent": -1,
   "actor": "DrFrost",
   "expressionName": "neutral",
   "text": "I suggest what works. You can keep whining or take action. It’s your choice.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
