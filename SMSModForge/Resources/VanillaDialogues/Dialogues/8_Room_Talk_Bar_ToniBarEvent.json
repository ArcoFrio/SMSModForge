    "m_Options": "FromSkin"
   }
  },
  "1776604649": {
   "kind": "text",
   "parent": -741951282,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "Eh. Guess we’ll never know.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-323704596": {
   "kind": "text",
   "parent": -633738341,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Honestly? I think I’d get the hell out of Peak City. ",
