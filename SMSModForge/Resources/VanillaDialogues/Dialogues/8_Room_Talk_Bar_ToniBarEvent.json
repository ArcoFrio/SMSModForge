  "-1080021571": {
   "kind": "text",
   "parent": -633738341,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "First instinct? Buy a ridiculous car, trick it out, and drive like a maniac. But…",
