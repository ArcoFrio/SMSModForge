  "788695922": {
   "kind": "text",
   "parent": -741951282,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "I dunno. Antonia was… easy. She smiled a lot, wore nice clothes, played the part. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1232386234": {
   "kind": "text",
   "parent": -741951282,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "People liked her. But she wasn’t really me—or maybe I just wasn’t her.",
   "settings": {
