 "nodes": {
  "269398912": {
   "kind": "text",
   "parent": -1,
   "actor": "You",
   "expressionName": "neutral",
   "text": "... And that's why I'm here, asking for a job.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "434309470": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -323314762,
    -693824868,
    -357679764
   ],
   "actor": "Amelia",
   "expressionName": "neutral",
   "text": "Oh, bummer. That sucks. Well, we need more hands with the Summer rush, so if you’re cool with that, you can start here.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "792751817": {
   "kind": "choice",
   "parent": -1,
   "children": [
    767706436,
    361161473
   ],
   "actor": "Amelia",
   "expressionName": "neutral",
   "text": "Yeah, but just so you know, the pay’s kinda low. Like, minimum wage low. It’s not great, but it’s something.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "767706436": {
   "kind": "text",
   "parent": 792751817,
   "children": [
    1477199120
   ],
   "actor": null,
   "text": "That's fine, anything helps.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "361161473": {
   "kind": "text",
   "parent": 792751817,
   "children": [
    107414760
   ],
   "actor": null,
   "text": "Uh, minimum wage? I didn’t expect that.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-323314762": {
   "kind": "text",
   "parent": 434309470,
   "actor": null,
   "text": "That would be great!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-693824868": {
   "kind": "text",
   "parent": 434309470,
   "actor": null,
   "text": "Better than nothing I guess.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "107414760": {
   "kind": "text",
   "parent": 361161473,
   "actor": "Amelia",
   "expressionName": "neutral",
   "text": "Yeah, I know. It’s pretty meh, but hey, money’s money, right? So, you in or what?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1477199120": {
   "kind": "text",
   "parent": 767706436,
   "actor": "Amelia",
   "expressionName": "neutral",
   "text": "That's the right attitude! Keep that smile up!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "73066552": {
   "kind": "text",
   "parent": -1,
   "actor": "Amelia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Cool, then. I’ll need your details and stuff. Let’s get you started.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1479001000": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1848572428,
    1053630788
   ],
   "actor": "Amelia",
   "expressionName": "neutral",
   "text": "Oh, and you can call me Amelia by the way!",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1848572428": {
   "kind": "text",
   "parent": -1479001000,
   "children": [
    477531236
   ],
   "actor": null,
   "text": "Thanks, Amelia.\t",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1053630788": {
   "kind": "text",
   "parent": -1479001000,
   "children": [
    -1574956896
   ],
   "actor": null,
   "text": "Let's get to it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "477531236": {
   "kind": "text",
   "parent": 1848572428,
   "actor": "Amelia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Yeah, yeah, whatever. Just show up on time and don’t mess up!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1574956896": {
   "kind": "text",
   "parent": 1053630788,
   "actor": "Amelia",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Hell yeah!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-357679764": {
   "kind": "text",
   "parent": 434309470,
   "children": [
    -740833103
   ],
   "actor": null,
   "text": "(Lewd) I’m good with my hands. Want a demonstration?",
