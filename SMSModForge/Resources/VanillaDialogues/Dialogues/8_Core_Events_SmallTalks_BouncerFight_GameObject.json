    "m_Options": "FromSkin"
   }
  },
  "-622713172": {
   "kind": "text",
   "parent": 717926934,
   "actor": "S_Bouncer",
   "expressionName": "neutral",
   "text": "I commend you for your awareness, young warrior. Now go and return once you have the strength to best me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
