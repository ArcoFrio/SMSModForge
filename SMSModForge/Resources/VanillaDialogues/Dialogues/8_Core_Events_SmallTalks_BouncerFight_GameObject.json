   "children": [
    867717238
   ],
   "actor": null,
   "text": "I've got so much rizz, my friends call me the Rizzler.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "415298240": {
   "kind": "text",
   "parent": -520890690,
   "children": [
    -148436205
   ],
   "actor": null,
   "text": "Yo, King {PC} is in the house. Let me through or i'll eat your mouse.",
