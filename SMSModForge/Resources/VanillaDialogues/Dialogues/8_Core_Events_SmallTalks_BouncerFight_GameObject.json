    "m_Options": "FromSkin"
   }
  },
  "717926934": {
   "kind": "text",
   "parent": -520890690,
   "children": [
    -622713172
   ],
   "actor": null,
   "text": "I'll return and next time I'll be prepared.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "867717238": {
   "kind": "text",
   "parent": 1054351445,
   "actor": "S_Bouncer",
   "expressionName": "neutral",
   "text": "Your rizz is weak, no cap. Go home, boy.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-148436205": {
   "kind": "text",
   "parent": 415298240,
   "actor": "S_Bouncer",
   "expressionName": "neutral",
   "text": "Impressive, you made me cringe.... but that is not enough. Leave.",
