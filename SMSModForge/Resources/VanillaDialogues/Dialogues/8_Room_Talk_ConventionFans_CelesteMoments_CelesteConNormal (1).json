 "nodes": {
  "-1880583636": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expressionName": "neutral",
   "text": "Ah, Anna. You made it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1707282865": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Of course I did. Why wouldn’t I?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "446611443": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expressionName": "neutral",
   "text": "Oh, no reason. I suppose I just wasn’t sure if you were… accustomed to events of this scale. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-292285133": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I can handle a crowd just fine.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-302420845": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expressionName": "neutral",
   "text": "Of course. Confidence is essential. Just remember, dear—they don’t just look at you. They study you. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1756881340": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Every movement, every breath… if you can’t hold their gaze, they’ll forget you the moment you leave.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "717026669": {
   "kind": "text",
   "parent": -1,
   "actor": "Celeste",
   "expression": 1,
   "expressionName": "Happy",
   "text": "The cameras, the pressure, the expectations. It takes a certain presence to command a stage like this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
