 "nodes": {
  "1662536399": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "How can you desire me when all I have done is reflect your own being back at you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1359766598": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1533730512,
    -68304661,
    -274035782
   ],
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "You do not know who I am. What I have done. The truths I carry... and the lies I may hide.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1533730512": {
   "kind": "text",
   "parent": -1359766598,
   "actor": null,
   "text": "(Charming) Then show me who you are.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
     "type": "ConditionMathCompareIntegers",
     "title": "If Traits[newtrait-Charming] ≥ 5",
     "fields": {
      "m_Value": {
       "kind": "variable",
