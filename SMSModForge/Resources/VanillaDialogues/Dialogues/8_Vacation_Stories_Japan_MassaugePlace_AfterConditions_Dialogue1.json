   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1155051300": {
   "kind": "text",
   "parent": 663384275,
   "actor": null,
   "text": "Y-You're so skilled, Sakura. I'm about to... I'm...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1943005306": {
