   ]
  },
  "-274035782": {
   "kind": "text",
   "parent": -1359766598,
   "children": [
    1103505169,
    101525534,
    1485053344
   ],
   "actor": null,
   "text": "You are right, I'm sorry.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1103505169": {
   "kind": "text",
   "parent": -274035782,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "Do not apologize for opening your heart to me. I am fond of you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "101525534": {
   "kind": "text",
   "parent": -274035782,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "But I believe we should stop for today. A change of wind may carry a storm with it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1485053344": {
   "kind": "text",
   "parent": -274035782,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "Please visit me again.",
   "jump": {
    "mode": "Exit"
   },
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1057761543": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
