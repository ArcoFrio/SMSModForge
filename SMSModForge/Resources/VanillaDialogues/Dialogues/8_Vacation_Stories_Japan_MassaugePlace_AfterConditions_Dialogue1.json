  "286804398": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "Do you know what that means? What you’re asking? ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "948627139": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "To see someone is not a fleeting moment. It’s to step into the shadows of everything they’ve been through... everything they carry.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active SakuraNewMassage (2) to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "SakuraNewMassage (2)",
       "of": "GetGameObjectInstance",
       "path": "4_CG_Manager-Sexy_Two/SakuraNewMassage (2)"
      }
     }
    }
   ]
  },
  "213468118": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "I am not just a kind voice or gentle hands. I am scars and mistakes. I am choices I can’t take back and a past I can’t outrun.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2143592655": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "I... I...",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
