  "836328318": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "I miss colors. The way the world bursts into life when the sun rises. I miss faces... seeing joy, sadness, love in someone’s expression.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1216540259": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "I miss... tears. Mwwhmmm... My own tears. Watching them fall.... Mmmuahmm....",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
     "kind": "setActive",
     "type": "InstructionGameObjectSetActive",
     "title": "Set Active SakuraFun (3) to True",
     "fields": {
      "m_Active": {
       "kind": "value",
       "value": true
      },
      "m_GameObject": {
       "kind": "object",
       "name": "SakuraFun (3)",
       "of": "GetGameObjectInstance",
       "path": "4_CG_Manager-Sexy_Two/SakuraFun (3)"
      }
     }
    }
   ]
  },
  "-1272432620": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "It’s such a simple thing, isn’t it? But I can’t see them anymore... Mmmmhmm... Glpph....",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "884091540": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "All that I have left is the smell and taste of you... Mmmwuah... Your large... needy...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "287578625": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "That’s who I am. A woman who can’t even remember the colors of her own eyes.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1614415823": {
   "kind": "text",
   "parent": -1,
   "actor": "V_Sakura",
   "expressionName": "neutral",
   "text": "Yes... Mmmmghhmm... It's so pure... I can taste it.. ",
   "settings": {
    "m_Options": "FromSkin"
   },
