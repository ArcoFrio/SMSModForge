   "parent": -1550866049,
   "children": [
    642968042,
    2037346406
   ],
   "actor": null,
   "text": "Anna's my {M}. Of course I will help.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "352406838": {
   "kind": "text",
   "parent": -1550866049,
   "children": [
    -812253213,
    -538329106
   ],
   "actor": null,
   "text": "You care about her. I wasn’t gonna let you do this alone.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-812253213": {
   "kind": "text",
   "parent": 352406838,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Yeah… I do. And I know she’s stubborn, but deep down, she needed this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "642968042": {
   "kind": "text",
   "parent": 745484272,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "She's very lucky to have you, you know that?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-538329106": {
   "kind": "text",
   "parent": 352406838,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "And I guess… I needed it too.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2037346406": {
   "kind": "text",
   "parent": 745484272,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "And even more so to have me. I'm pretty awesome, right?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1811538778": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Anyway. Thanks. I mean it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "984028835": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "You know, if it wasn't for Anna, I would have already put a ring on your finger. You're one in a million, {PC}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
