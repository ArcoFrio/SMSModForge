 "nodes": {
  "248643391": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "You got fired!?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1782929517": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Oh, Adrian? It's, uh, It's not as bad as it seems.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-454141267": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Don't lie to them, Josef. They are adults...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "952365487": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "It's quite bad, we might have to move soon...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2051395342": {
   "kind": "text",
   "parent": -1,
   "actor": "Adrian",
   "expressionName": "neutral",
   "text": "That's fine... As long as I get to keep my PC...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1529380447": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You won't have to sell your computer, honey. I promise.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-578756154": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1315419229,
    -1821762634,
    1656588506
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "But we all need to pitch in and support {D} right now. Maybe we can find some part-time jobs to help bring in extra income.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1315419229": {
   "kind": "text",
   "parent": -578756154,
   "children": [
    808908496
   ],
   "actor": null,
   "text": "Of course, {M}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1821762634": {
   "kind": "text",
   "parent": -578756154,
   "children": [
    -403891431
   ],
   "actor": null,
   "text": "Do we really have to?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "808908496": {
   "kind": "text",
   "parent": 1315419229,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You're a good {S}... See Josef, you're not alone.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-403891431": {
   "kind": "text",
   "parent": -1821762634,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Yes, and no backtalk. It will only be for a short time until {D} finds another job.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1656588506": {
   "kind": "text",
   "parent": -578756154,
   "children": [
    -1780439983
   ],
   "actor": null,
   "text": "(Smart) We might not need jobs if we optimize what we’ve got.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
     "type": "ConditionMathCompareIntegers",
