  "-2007054851": {
   "kind": "text",
   "parent": 834224195,
   "children": [
    -773941567,
    1248860720
   ],
   "actor": null,
   "text": "Wait… Antonia?! No way, I remember now!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2008559679": {
   "kind": "text",
   "parent": 834224195,
   "children": [
    281880676,
    -164851977
   ],
   "actor": null,
   "text": "Uh… you look kinda familiar, but I don’t know…",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1878796622": {
   "kind": "text",
   "parent": 834224195,
   "children": [
    206998037,
    1164514724
   ],
   "actor": null,
   "text": "Huh. You were cute back then. What happened?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "206998037": {
   "kind": "text",
   "parent": -1878796622,
   "actor": "Toni",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Hah! Cute, huh? Yeah, yeah, I know I was adorable.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "281880676": {
   "kind": "text",
   "parent": 2008559679,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Pfft—‘kinda familiar’ my ass! I used to be the coolest person you knew!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-773941567": {
   "kind": "text",
   "parent": -2007054851,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "YES! There we go! I was about to be offended! Man, you seriously grew! ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1248860720": {
   "kind": "text",
   "parent": -2007054851,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "Last time I saw you, you barely came up to my shoulder, and now—jeez, you might actually be taller than me. No fair!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-164851977": {
   "kind": "text",
   "parent": 2008559679,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "I taught Adrian how to do a proper jump kick, and I definitely beat your ass at video games more than once. That ringin’ any bells?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1164514724": {
   "kind": "text",
   "parent": -1878796622,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "The damn Badlands happened, dude. You think I’m here for fun? Nobody ends up here by choice... well, almost nobody.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1816236467": {
   "kind": "choice",
   "parent": -1,
   "children": [
    108311162,
    286441880,
    -1210122976
   ],
   "actor": "Toni",
   "expression": 2,
   "expressionName": "Angry",
   "text": "What the hell are you doin’ all the way out here? This ain’t downtown, dude—this place chews people up. You should turn around while you still can.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
