  "-339793903": {
   "kind": "text",
   "parent": -1,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You were always running around doing your own thing, but c’mon! We totally hung out!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "834224195": {
   "kind": "choice",
