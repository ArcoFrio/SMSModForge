    },
    "m_Options": "FromSkin"
   }
  },
  "-1388464279": {
   "kind": "text",
   "parent": 1710992345,
   "actor": null,
   "text": "Uh… do I know you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1270540102": {
   "kind": "text",
   "parent": 1710992345,
   "actor": null,
   "text": "I'm {PC}... Uh, nice to meet you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1717405267": {
   "kind": "text",
   "parent": 1710992345,
   "actor": null,
   "text": "(Take a few steps back)",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-224622316": {
   "kind": "text",
   "parent": -1,
   "actor": "Toni",
   "expression": 3,
   "expressionName": "Sad",
   "text": "WHAT?! You don’t remember me? I used to look after Adrian for a while!",
   "settings": {
    "m_Options": "FromSkin"
   },
