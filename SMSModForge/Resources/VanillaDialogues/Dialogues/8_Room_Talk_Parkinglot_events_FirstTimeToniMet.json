  "2101874582": {
   "kind": "text",
   "parent": -1,
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oi! What’s a city boy like you doin’ out here in the wasteland?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-983492382": {
   "kind": "text",
   "parent": -1,
   "actor": "Toni",
   "expressionName": "neutral",
   "text": "No. Freakin’. Way.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1710992345": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -1388464279,
    -1270540102,
    1717405267
   ],
   "actor": "Toni",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Holy crap! You’re you! No way! Dude, you were a total twig last time I saw you! What the hell happened? Did you eat a whole gym?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
