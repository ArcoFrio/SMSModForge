  "406497057": {
   "kind": "text",
   "parent": -1,
   "children": [
    -761382205,
    -776424374,
    -523894462,
    -59731892,
    -1430852661,
    -189431505
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "You know… I always wondered why you started this garden. It feels like there’s more to it than just wanting a beautiful place.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
     "type": "ConditionMathCompareIntegers",
     "title": "If Events_6[anna-garden] = 4",
     "fields": {
      "m_Value": {
       "kind": "variable",
       "variable": {
        "scope": "global",
        "name": "anna-garden",
        "list": "Events_6",
        "type": "number"
       }
      },
      "m_CompareTo": {
       "m_Comparison": "Equals",
       "m_CompareTo": {
        "kind": "value",
        "value": 4
       }
      }
     }
    }
   ]
  },
  "-1146380865": {
   "kind": "text",
   "parent": 679254736,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Yes, they are. You’ve brought life back to this place. It’s… calming.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1275772417": {
   "kind": "text",
   "parent": 679254736,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I’m glad. I wasn’t sure if I’d be of much help, honestly. You seem like someone who’s used to doing things on his own.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1357310193": {
   "kind": "text",
   "parent": 679254736,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Hmph. I’ve had to be. But… having someone like you here isn’t so bad.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-761382205": {
   "kind": "text",
   "parent": 406497057,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "This garden is more than just flowers. It’s a way to honor someone I lost long ago. She loved nature… and I’m trying to recreate a piece of what she cherished.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-776424374": {
   "kind": "text",
   "parent": 406497057,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "But there’s something more now, too. When you’ve spent years focused on protecting a city from a threat that no one else could see, it’s hard to see beyond that duty.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-523894462": {
   "kind": "text",
   "parent": 406497057,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "I never imagined I’d see the day where that threat was truly contained. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-59731892": {
   "kind": "text",
   "parent": 406497057,
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Your… {S} made sure of that. He helped give me—and this city—a chance to focus on something other than just surviving.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1430852661": {
   "kind": "text",
   "parent": 406497057,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I’m glad he could help. And I’m glad you’re here, turning this place into something peaceful.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-189431505": {
   "kind": "text",
   "parent": 406497057,
   "actor": "Master Zhen",
   "expressionName": "neutral",
   "text": "Yes… me too. I think my wife would be proud to see this, and proud of those who fought to keep it safe.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
