  "-39350822": {
   "kind": "text",
   "parent": -1961719124,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Alright, where’s this garden in need of rescuing?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "679254736": {
   "kind": "text",
   "parent": -1,
   "children": [
    -1146380865,
    -1275772417,
    1357310193
   ],
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "The flowers are finally coming together, don’t you think?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
     "type": "ConditionMathCompareIntegers",
