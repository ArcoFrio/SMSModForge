   "children": [
    1667439346,
    -1006217798
   ],
   "actor": "Master Zhen",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Thank you for coming. The soil is good, but… the gardener is inexperienced. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1667439346": {
   "kind": "text",
   "parent": 604306852,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "No worries! Everyone starts somewhere. Let’s see what we can do to make these plants feel at home.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1006217798": {
   "kind": "text",
   "parent": 604306852,
   "actor": "Master Zhen",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Thank you. I'm Xun Zhen, allow me to show you my temple.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1961719124": {
   "kind": "text",
   "parent": -1,
   "children": [
    -39350822,
    604306852
   ],
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh my goodness, this place is absolutely gorgeous! I can't believe we have such a beautiful forest just outside of the city.",
   "settings": {
    "m_Options": "FromSkin"
   },
