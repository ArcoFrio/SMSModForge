    "m_Options": "FromSkin"
   }
  },
  "-687177205": {
   "kind": "text",
   "parent": 1878605931,
   "children": [
    1772806627,
    101103978,
    -403162793
   ],
   "actor": null,
   "text": "Damn right! You earned this, Anna.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "238665456": {
   "kind": "text",
   "parent": 1878605931,
   "children": [
    -910832754,
    -403868756,
    -1754156126,
    -1389361059,
    2131434898
   ],
   "actor": null,
   "text": "Careful, you’re starting to sound like her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-262073907": {
   "kind": "text",
   "parent": 1878605931,
   "children": [
    1066747449,
    1201229823,
    -1806320126
   ],
   "actor": null,
   "text": "And… does it feel as good as you thought it would?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1066747449": {
   "kind": "text",
   "parent": -262073907,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "…Yeah. Of course it does.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-910832754": {
   "kind": "text",
   "parent": 238665456,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh, please. There’s a huge difference between me and her.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1772806627": {
   "kind": "text",
   "parent": -687177205,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "I know, right?! I worked my ass off for this! And now, all those people—her people—they chose me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "101103978": {
   "kind": "text",
   "parent": -687177205,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I finally won. And no one—not even Celeste—can take this from me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-403162793": {
   "kind": "text",
   "parent": -687177205,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Damn, this feels good.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-403868756": {
   "kind": "text",
   "parent": 238665456,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "…I mean, sure, maybe I’m enjoying this a little too much, but can you blame me? After everything she pulled?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1754156126": {
   "kind": "text",
   "parent": 238665456,
   "actor": "Anna",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I think I deserve a little gloating.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1389361059": {
   "kind": "text",
   "parent": 238665456,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Don’t worry, I won’t start talking like I’m a goddess or anything.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2131434898": {
   "kind": "text",
   "parent": 238665456,
   "actor": "Anna",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "Unless… that’d be hot?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1201229823": {
   "kind": "text",
   "parent": -262073907,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I mean… this is what I wanted. To beat her. To prove that I could do it. And I did. So… yeah. I feel great.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1806320126": {
   "kind": "text",
   "parent": -262073907,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "…Shouldn’t I?",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
