  "-1549140071": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Celeste is done. All that smugness, all that superior crap—gone! And now? I’m the one on top!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1702422324": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "God, I can’t even explain how good this feels. After everything, after all the crap she pulled, I—",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1878605931": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -687177205,
    238665456,
    -262073907
   ],
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "She must be dying knowing I took her place.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
