    },
    "m_Options": "FromSkin"
   }
  },
  "746618368": {
   "kind": "text",
   "parent": -1318247213,
   "actor": null,
   "text": "You’re not human, but… you seem alive to me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-806507636": {
   "kind": "text",
   "parent": -1318247213,
   "actor": null,
   "text": "Good question. What are you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "455716120": {
   "kind": "text",
   "parent": -2033588275,
   "actor": "Cerise",
   "expressionName": "neutral",
   "text": "I feel… different. This is my first time… being awake. Everything is so… new.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "787607459": {
   "kind": "choice",
   "parent": -2033588275,
   "children": [
    -1676943925,
    1192237872,
    -910527361
   ],
   "actor": "Cerise",
   "expressionName": "neutral",
   "text": "So many questions… so much to learn. Who created me? And why am I here?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "-1676943925": {
   "kind": "text",
   "parent": 787607459,
   "children": [
    -1565249696
   ],
   "actor": null,
   "text": "We can figure it out together.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1192237872": {
   "kind": "text",
   "parent": 787607459,
   "children": [
    193495002
   ],
   "actor": null,
   "text": "Just shut up. I need to think...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-910527361": {
   "kind": "text",
   "parent": 787607459,
   "children": [
    -722247086
   ],
   "actor": null,
   "text": "(Lewd) I see two very good reasons for why you were created...",
   "settings": {
    "m_Options": "FromSkin"
   },
