  "604633556": {
   "kind": "text",
   "parent": -2033588275,
   "actor": "Cerise",
   "expressionName": "neutral",
   "text": "Where… am I? Who… are you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "855871786": {
   "kind": "text",
   "parent": -2033588275,
   "actor": "You",
   "expressionName": "neutral",
   "text": "You’re in a lab… beneath Mario’s mansion. I’m {PC}. I guess I just woke you up.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1318247213": {
   "kind": "choice",
   "parent": -2033588275,
   "children": [
    746618368,
    -806507636,
    6409402
   ],
   "actor": "Cerise",
   "expressionName": "neutral",
   "text": "Woke me up? Am I… alive?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
