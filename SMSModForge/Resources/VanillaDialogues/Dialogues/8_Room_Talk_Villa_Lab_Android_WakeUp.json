  "-722247086": {
   "kind": "text",
   "parent": -910527361,
   "actor": "Cerise",
   "expressionName": "neutral",
   "text": "Breasts… What are they for? Why do I have them?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "193495002": {
   "kind": "text",
   "parent": 1192237872,
   "actor": "Cerise",
   "expressionName": "neutral",
   "text": "I.. I apologize... All of this is new to me...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1565249696": {
   "kind": "text",
   "parent": -1676943925,
   "actor": "Cerise",
   "expressionName": "neutral",
   "text": "Thank you, {PC}. I’m… grateful.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
