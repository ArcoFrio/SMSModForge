    },
    "m_Options": "FromSkin"
   }
  },
  "-1145148300": {
   "kind": "text",
   "parent": -1521354212,
   "children": [
    -810741066,
    -2048303721
   ],
   "actor": null,
   "text": "I gotta say, this is the best infiltration mission I’ve ever been on.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-810741066": {
   "kind": "text",
   "parent": -1145148300,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Oh, shut up. Stay focused. And keep your hands off the walls—I don’t need you slipping and grabbing me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-187938352": {
   "kind": "text",
   "parent": -1521354212,
   "children": [
    517401315
   ],
   "actor": null,
   "text": "Can you move any faster? I’m getting a face-full of… you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "517401315": {
   "kind": "text",
   "parent": -187938352,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Oh, I’m sorry, do you want to lead instead? Be my guest. Oh wait, you can’t, because we’re in a duct barely wider than my hips!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-111091138": {
   "kind": "text",
   "parent": -1521354212,
   "children": [
    -1217349904,
    236440723
   ],
   "actor": null,
   "text": "If this is part of the mission, I’m suddenly way more invested.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1217349904": {
   "kind": "text",
   "parent": -111091138,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Tch. If I hear one more comment, I’m kicking you back down the vent.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "236440723": {
   "kind": "text",
   "parent": -111091138,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "…And don’t pretend like you wouldn’t enjoy it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-398947477": {
   "kind": "choice",
   "parent": -1,
   "children": [
    1100009331,
    534725875
   ],
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Shit. Okay, no more talking. Just… keep crawling. And eyes up.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
      "kind": "value",
      "value": 10
     },
     "m_Timeout": "ChooseRandom"
    },
    "m_Options": "FromSkin"
   }
  },
  "1100009331": {
   "kind": "text",
   "parent": -398947477,
   "actor": null,
   "text": "Can’t. There’s something huge blocking my view.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "534725875": {
   "kind": "text",
   "parent": -398947477,
   "actor": null,
   "text": "Right. Silent mode activated.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2048303721": {
   "kind": "text",
   "parent": -1145148300,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Or maybe I do... N-No, let's keep focused!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1879068031": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expressionName": "neutral",
   "text": "Wait! I think this is it!",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
