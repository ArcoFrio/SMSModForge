    "m_Options": "FromSkin"
   }
  },
  "523702715": {
   "kind": "text",
   "parent": -1921833789,
   "actor": "Tasha",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Oh, you’re one of those guys. Here’s the deal—I’m here to run a business, not listen to your weak pickup lines.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1553401824": {
   "kind": "text",
   "parent": 1272695372,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "It is. But I’m not exactly the type to sit around waiting for things to happen. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1891045618": {
   "kind": "text",
   "parent": 1274176175,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Unique’s the goal. If you’re gonna be here, better appreciate what you’re looking at.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1660771034": {
   "kind": "text",
   "parent": -1921833789,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Got something worth saying, or are you done?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-543912177": {
   "kind": "text",
   "parent": -1,
   "actor": "Tasha",
   "expressionName": "neutral",
   "text": "Well, I'm here if you decide to buy anything.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
