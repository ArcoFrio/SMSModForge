    1446251507
   ],
   "actor": "HimariMom",
   "expressionName": "neutral",
   "text": "Ah… my daughter’s beloved. I knew I’d find you at the center of something extraordinary.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareNumber",
