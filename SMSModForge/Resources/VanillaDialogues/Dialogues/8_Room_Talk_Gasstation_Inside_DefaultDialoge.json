  "-678574527": {
   "kind": "text",
   "parent": 1208107803,
   "children": [
    745081760,
    -1781509729
   ],
   "actor": null,
   "text": "So... working late at a gas station. Must be boring?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "166668157": {
   "kind": "text",
   "parent": 1208107803,
   "children": [
    1858329251,
    -1284820259
   ],
   "actor": null,
   "text": "What’s with the whole goth thing?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1957116280": {
   "kind": "text",
   "parent": 1208107803,
   "children": [
    652541773,
    2105006229
   ],
   "actor": null,
   "text": "What’s someone like you even do after a shift like this?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "652541773": {
   "kind": "text",
   "parent": -1957116280,
   "actor": "Astrid",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Exciting? Not quite. But I do enjoy a good walk to clear my head. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1858329251": {
   "kind": "text",
   "parent": 166668157,
   "actor": "Astrid",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Goth? Huh. I guess I do fit the part, don’t I? ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "745081760": {
   "kind": "text",
   "parent": -678574527,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "It’s quiet, mostly. I don’t mind it, though. Nights have their own rhythm.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1781509729": {
   "kind": "text",
   "parent": -678574527,
   "actor": "Astrid",
   "expression": 1,
   "expressionName": "Happy",
   "text": "You just have to pay attention to catch it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1284820259": {
   "kind": "text",
   "parent": 166668157,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "Honestly, it’s not on purpose—I just don’t exactly thrive in sunlight.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2105006229": {
   "kind": "text",
   "parent": -1957116280,
   "actor": "Astrid",
   "expressionName": "neutral",
   "text": "The town’s so different when everyone else is asleep. It feels... alive, in a way.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
