  "-577777360": {
   "kind": "text",
   "parent": 1737088190,
   "children": [
    -943017397
   ],
   "actor": null,
   "text": "Just needed gas and maybe a snack. Quiet night here?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-648369697": {
   "kind": "text",
   "parent": 1737088190,
   "children": [
    -1780307705
   ],
   "actor": null,
   "text": "Maybe destiny brought me here so I could meet you.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-2093864264": {
   "kind": "text",
   "parent": 1737088190,
   "children": [
    1979479642
   ],
   "actor": null,
   "text": "‘Ungodly hour? What, are you a poet or something?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-943017397": {
   "kind": "text",
   "parent": -577777360,
   "actor": "Astrid",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Oh, it’s never quiet. Not when you’re truly listening. But maybe you just don’t have the right ears for it... yet.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1780307705": {
   "kind": "text",
   "parent": -648369697,
   "actor": "Astrid",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Careful what you wish for. Around here, destiny tends to bite back... hard.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1979479642": {
   "kind": "text",
   "parent": -2093864264,
   "actor": "Astrid",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Poet? No. But I do appreciate fine art when it stands before me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
