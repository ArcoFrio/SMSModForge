  "-694251095": {
   "kind": "text",
   "parent": 1396628883,
   "children": [
    2028991883
   ],
   "actor": null,
   "text": "Thanks, {D}. That means a lot.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "246971144": {
   "kind": "text",
   "parent": 1396628883,
   "children": [
    -1514388538
   ],
   "actor": null,
   "text": "Appreciate it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-664722582": {
   "kind": "text",
   "parent": 1396628883,
   "children": [
    -369330720
   ],
   "actor": null,
   "text": "You’re not getting soft on me, are you?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1828615676": {
   "kind": "text",
   "parent": 1396628883,
   "children": [
    -1880735332
   ],
   "actor": null,
   "text": "You sure you even know who I am anymore?",
   "settings": {
    "m_Options": "FromSkin"
   },
   "conditions": [
    {
     "kind": "compareBool",
     "type": "ConditionMathCompareBooleans",
     "title": "If Mainstory[M-and-D-activated] = False",
     "fields": {
