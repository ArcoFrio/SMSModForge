  "-369330720": {
   "kind": "text",
   "parent": -664722582,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Soft? Never. But I guess even I can say a kind word once a year.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1514388538": {
   "kind": "text",
   "parent": 246971144,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "Good. Just... Try to make the most of today. We don't get many like it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "2028991883": {
   "kind": "text",
   "parent": -694251095,
   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Heh. You’ve grown up a lot. More than I ever gave you credit for. I’m... trying, alright?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1880735332": {
   "kind": "text",
   "parent": 1828615676,
   "actor": "Josef",
   "expression": 3,
   "expressionName": "Sad",
   "text": "...No. But I want to. I haven’t been the {D} you needed, and I know that. I’m not asking for forgiveness... just a chance to do better.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "633504678": {
   "kind": "text",
   "parent": -1,
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "And... I know I don’t say this enough, but—thank you. For stepping in with the debt. I should’ve handled it myself, but you... you saved us. ",
   "settings": {
    "m_Options": "FromSkin"
   },
