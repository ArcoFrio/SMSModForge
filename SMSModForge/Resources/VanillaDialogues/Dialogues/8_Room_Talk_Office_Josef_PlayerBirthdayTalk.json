   "actor": "Josef",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Hey. Just wanted to say... happy birthday, {S}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1396628883": {
   "kind": "choice",
   "parent": 1070248893,
   "children": [
