    246971144,
    -664722582,
    1828615676
   ],
   "actor": "Josef",
   "expressionName": "neutral",
   "text": "I know things haven't exactly been easy lately, but I’m proud of the person you’re becoming.",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
