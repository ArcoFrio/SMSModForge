   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1816445301": {
   "kind": "text",
   "parent": 1383101289,
   "children": [
    -1584856106
   ],
   "actor": null,
   "text": "I’m {PC} and I need your strongest potions.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1584856106": {
   "kind": "text",
   "parent": 1816445301,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "Potions? Oh no, sweetie. We're not selling any potions here.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1602107999": {
   "kind": "text",
   "parent": 1153363246,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "Curiosity, huh? That’s a good start. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1865755685": {
   "kind": "text",
   "parent": -1,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "Name’s Miss Zero. I run this joint. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "126367263": {
   "kind": "choice",
   "parent": -1,
   "children": [
    -606460945,
    -398996034,
    -1498001952
   ],
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "We’ve got everything you can imagine and a few things you probably can’t. So, what’s your pleasure?",
   "settings": {
    "m_HideUnavailable": false,
    "m_HideVisited": false,
    "m_SkipChoice": false,
    "m_ShuffleChoices": false,
    "m_TimedChoice": {
     "m_TimedChoice": false,
     "m_Duration": {
