   }
  },
  "-606460945": {
   "kind": "text",
   "parent": 126367263,
   "children": [
    -494547407
   ],
   "actor": null,
   "text": "What’s your most popular item?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-398996034": {
   "kind": "text",
   "parent": 126367263,
   "children": [
    813427908
   ],
   "actor": null,
   "text": "Got anything that’s fun and... unexpected?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1498001952": {
   "kind": "text",
   "parent": 126367263,
   "children": [
    1679673888
   ],
   "actor": null,
   "text": "It’s my first time in a place like this.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-494547407": {
   "kind": "text",
   "parent": -606460945,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "Popular, huh? Well, our Suc Suction Suckers are a big hit. Top of the line, fully customizable. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "813427908": {
   "kind": "text",
   "parent": -398996034,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "Oh, I’ve got plenty of unexpected. How about our VR fantasy simulator? Takes you places you’ve only dreamed of.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1679673888": {
   "kind": "text",
   "parent": -1498001952,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "No worries, sweetie. Everyone’s got a first time. Let’s find something that’ll blow your... mind. ",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1908903045": {
   "kind": "text",
   "parent": -1,
   "actor": "Miss Zero",
   "expressionName": "neutral",
   "text": "You can ring the bell if you see anything you would like to... buy.",
   "settings": {
    "m_Options": "FromSkin"
   }
  }
 },
