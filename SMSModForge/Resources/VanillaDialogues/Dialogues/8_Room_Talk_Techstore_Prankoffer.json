  "1170019263": {
   "kind": "text",
   "parent": -1455431201,
   "actor": "Joey",
   "expressionName": "neutral",
   "text": "…Alright, you got me. It’s not just about the prank. I mean, yeah, I wanna see her flustered, but… she’s always so calm, so perfect.",
