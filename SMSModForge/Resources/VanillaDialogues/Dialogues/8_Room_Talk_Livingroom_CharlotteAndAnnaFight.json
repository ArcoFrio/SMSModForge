  "-2055696562": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "I'm not going to steal him from you, Anna. We're best friends. You can't think so little of me.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1802019380": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "I... I...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "74312450": {
   "kind": "text",
   "parent": -934080880,
   "children": [
    1999260625,
    1887114652
   ],
   "actor": null,
   "text": "I love both of you, please don't make me choose.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1999260625": {
   "kind": "text",
   "parent": 74312450,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I.. I don't want to make you choose, {PC}.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-901819922": {
   "kind": "text",
   "parent": -934080880,
   "children": [
    -1643971793,
    -748947728,
    -1531205620,
    -1842982916
   ],
   "actor": null,
   "text": "There's quite some sexual tension between you two.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1643971793": {
   "kind": "text",
   "parent": -901819922,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Of course. If it weren't for Josef, I would have pursued you, Anna...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1887114652": {
   "kind": "text",
   "parent": 74312450,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Neither do I...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1842982916": {
   "kind": "text",
   "parent": -901819922,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "I... I was different back then, Charlotte. I was... prude and insecure...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-431067301": {
   "kind": "text",
   "parent": -861728587,
   "actor": "Charlotte",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "I want to be with you. I want to be with both of you!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-748947728": {
   "kind": "text",
   "parent": -901819922,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Y-You... What? ...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1531205620": {
   "kind": "text",
   "parent": -901819922,
   "actor": "Charlotte",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "We had so much fun back then... And then you changed.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "698825637": {
   "kind": "text",
   "parent": -861728587,
   "actor": "Anna",
   "expression": 4,
   "expressionName": "Flirty",
   "text": "I... I would love that...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-14635645": {
   "kind": "text",
   "parent": -861728587,
   "actor": "Charlotte",
   "expression": 1,
   "expressionName": "Happy",
   "text": "Then it's settled... Well, {PC}. I hope you realize what you've just gotten yourself into.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "555454726": {
   "kind": "text",
   "parent": -861728587,
   "actor": "Anna",
   "expression": 1,
   "expressionName": "Happy",
   "text": "He won't last a year with the two of us...",
   "jump": {
    "mode": "Exit"
