  "1780800763": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "Charlotte, we need to talk. Now.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "198358867": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 3,
   "expressionName": "Sad",
   "text": "Anna, I never meant to hurt you. But {PC} is an adult, capable of making his own decisions.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1437858911": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expression": 3,
   "expressionName": "Sad",
   "text": "He may be an adult, but he’s still my {S}. And you’re supposed to be my best friend. How could you do this?",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-616647460": {
   "kind": "text",
   "parent": -1,
   "actor": "Charlotte",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Please, Anna. You just want to have his massive cock all for yourself, don't be such a greedy bitch!",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1869940896": {
   "kind": "text",
   "parent": -1,
   "actor": "Anna",
   "expressionName": "neutral",
   "text": "That's not it! I... I don't want him to leave me. He's the best thing that has ever happened to me.",
   "settings": {
    "m_Options": "FromSkin"
   },
   "onStart": [
    {
