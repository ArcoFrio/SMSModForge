    "m_Options": "FromSkin"
   }
  },
  "97946459": {
   "kind": "text",
   "parent": 706904402,
   "actor": null,
   "text": "I’m sorry, but I think you’re mistaking me for someone else.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1964941615": {
   "kind": "text",
   "parent": 706904402,
   "actor": null,
   "text": "Let me finish. I'm not the gardener.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1739824634": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expressionName": "neutral",
   "text": "You think I care? Everyone who comes to this house is beneath me. Just do what you’re told and leave.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "720586671": {
   "kind": "text",
   "parent": -1,
   "actor": "Katarina",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Now, get lost. I have more important things to deal with than some nobody loitering around.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "1471349429": {
   "kind": "text",
   "parent": -1765140637,
   "actor": "Katarina",
   "expression": 2,
   "expressionName": "Angry",
   "text": "Don’t speak unless you’re spoken to! I don’t care who you are, just get out of my sight.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
