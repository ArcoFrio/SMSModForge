  "1546033156": {
   "kind": "text",
   "parent": 1283780274,
   "children": [
    -1985042834
   ],
   "actor": null,
   "text": "Actually, I’m not the...",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1765140637": {
   "kind": "text",
   "parent": 1283780274,
   "children": [
    1471349429
   ],
   "actor": null,
   "text": "But...",
   "settings": {
    "m_Options": "FromSkin"
   }
