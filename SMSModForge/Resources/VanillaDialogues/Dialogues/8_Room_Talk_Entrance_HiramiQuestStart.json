  "-597892726": {
   "kind": "text",
   "parent": 98055483,
   "children": [
    372799828,
    -52798259
   ],
   "actor": null,
   "text": "Nah. You're an evil bitch and don't deserve my help.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "372799828": {
   "kind": "text",
   "parent": -597892726,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "…I see.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1083428542": {
   "kind": "text",
   "parent": -963663812,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "Dinner is tomorrow at eight. My place. fifth floor.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-1930316294": {
   "kind": "text",
   "parent": -963663812,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "…Kimura. Himari Kimura. Don’t forget it.",
   "settings": {
    "m_Options": "FromSkin"
   }
  },
  "-52798259": {
   "kind": "text",
   "parent": -597892726,
   "actor": "Himari",
   "expressionName": "neutral",
   "text": "Forget I asked. It was a stupid idea anyway.",
   "settings": {
    "m_Options": "FromSkin"
   },
