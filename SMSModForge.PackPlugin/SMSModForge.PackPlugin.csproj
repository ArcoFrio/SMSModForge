    <Compile Include="PackNodeConditions.cs" />
    <Compile Include="DialogueBuilder.cs" />
    <Compile Include="DialogueDispatcher.cs" />
    <Compile Include="SceneRegistry.cs" />
    <Compile Include="SceneFactory.cs" />
    <Compile Include="WallpaperRegistry.cs" />
    <Compile Include="WallpaperFactory.cs" />
    <Compile Include="MusicFactory.cs" />
    <Compile Include="SfxRegistry.cs" />
    <Compile Include="SfxFactory.cs" />
    <Compile Include="GameAudio.cs" />
    <Compile Include="PackComponents.cs" />
    <Compile Include="WeatherRuntime.cs" />
    <Compile Include="LevelHooksRuntime.cs" />
    <Compile Include="DailyChanceRegistry.cs" />
    <Compile Include="TimerRuntime.cs" />
    <Compile Include="UpdateRulesRegistry.cs" />
    <Compile Include="UpdateRulesFactory.cs" />
    <Compile Include="TransformExtensions.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <!--
    Ship the vanilla scene frame catalog next to the plugin DLL. The PNGs
    are sourced from the editor's Resources\VanillaFrames\ folder (the
    editor's csproj has its own Content include for the same files;
    these two stay in lockstep — same filenames in both places). At
    runtime SceneFactory looks for them in <dll-dir>\VanillaFrames\.
  -->
  <ItemGroup>
    <Content Include="..\SMSModForge\Resources\VanillaFrames\*.png;..\SMSModForge\Resources\VanillaFrames\*.PNG">
      <Link>VanillaFrames\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameLibs)BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
