  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="CheckLocalPaths" BeforeTargets="_CheckForInvalidConfigurationAndPlatform">
    <Error Condition="'$(GameLibs)' == ''"
           Text="GameLibs is not set. Copy Directory.Build.props.example to Directory.Build.props and point GameLibs at the game's managed assemblies. (The SMSModForge editor builds without this.)" />
    <Error Condition="'$(PluginOutputPath)' == ''"
           Text="PluginOutputPath is not set. Copy Directory.Build.props.example to Directory.Build.props and point PluginOutputPath at your BepInEx plugins folder." />
  </Target>
</Project>
