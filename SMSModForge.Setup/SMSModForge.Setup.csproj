<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModForge's installer (1.8.0), as well as the two zips: asks for the
    Starmaker Story folder and checks it is the game, asks where the editor
    goes, puts the plugin in the game and the editor there, and leaves an
    uninstaller in Windows' Apps list. The same program, built without what it
    installs, is that uninstaller.

    What it installs is put in at release (Tools/Release/make-setup.ps1):
      -p:EditorZip=<editor zip> -p:PluginZip=<plugin zip> -p:Uninstaller=<the payload-free build>
    Built without them, it looks for the two zips beside itself.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SMSModForge.Setup</AssemblyName>
    <RootNamespace>SMSModForge.Setup</RootNamespace>
    <ApplicationIcon>..\SMSModForge\Resources\SMSModForge.ico</ApplicationIcon>
    <StartupObject>SMSModForge.Setup.Program</StartupObject>
    <!-- ForgeVersion.cs is shared with the plugin, whose compiler has no
         nullable annotations: its null returns are meant. -->
    <NoWarn>$(NoWarn);CS8603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one version number, the editor's and the plugin's. -->
    <Compile Include="..\Shared\ForgeVersion.cs" Link="Shared\ForgeVersion.cs" />
  </ItemGroup>

  <!--
    Its own words (1.9.0): the setup.* lines of every language the editor ships,
    so a setup that downloads what it installs speaks the player's language before
    it has anything else. Only those lines - the files are megabytes of the editor's
    texts.
  -->
  <UsingTask TaskName="KeepSetupTexts" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFolder ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputFolder);
        foreach (var item in Sources)
        {
            var kept = File.ReadAllLines(item.ItemSpec).Where(l => l.StartsWith("setup.")).ToArray();
            File.WriteAllLines(Path.Combine(OutputFolder, Path.GetFileName(item.ItemSpec)), kept, new System.Text.UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <ItemGroup>
    <SetupLanguage Include="..\SMSModForge\Languages\en.txt;..\SMSModForge\Languages\de.txt;..\SMSModForge\Languages\es.txt;..\SMSModForge\Languages\fr.txt;..\SMSModForge\Languages\ja.txt;..\SMSModForge\Languages\ko.txt;..\SMSModForge\Languages\pt-BR.txt;..\SMSModForge\Languages\ru.txt;..\SMSModForge\Languages\zh-Hans.txt" />
  </ItemGroup>
  <!-- Before the build, not before PrepareResources: that target's own dependencies
       have already collected the resources by the time a BeforeTargets hook runs. -->
  <Target Name="EmbedSetupTexts" BeforeTargets="BeforeBuild">
    <KeepSetupTexts Sources="@(SetupLanguage)" OutputFolder="$(IntermediateOutputPath)setup-texts" />
    <ItemGroup>
      <_SetupText Include="$(IntermediateOutputPath)setup-texts\*.txt" />
      <EmbeddedResource Include="@(_SetupText)" LogicalName="setup.texts.%(_SetupText.Filename).txt" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(EditorZip)' != ''">
    <EmbeddedResource Include="$(EditorZip)" LogicalName="payload.editor.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(PluginZip)' != ''">
    <EmbeddedResource Include="$(PluginZip)" LogicalName="payload.plugin.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(Uninstaller)' != ''">
    <EmbeddedResource Include="$(Uninstaller)" LogicalName="payload.uninstall.exe" />
  </ItemGroup>

</Project>
